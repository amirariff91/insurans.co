---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Hero from '../../components/Hero.astro';
import Ikon from '../../components/Ikon.astro';
import PageAnswer from '../../components/edisi/PageAnswer.astro';
import comparisons from '../../data/comparisons.json';

const companyNames: Record<string, string> = {
  etiqa: 'Etiqa',
  allianz: 'Allianz',
  'tokio-marine': 'Tokio Marine',
  aia: 'AIA',
  'great-eastern': 'Great Eastern',
  zurich: 'Zurich',
  prudential: 'Prudential',
  'takaful-malaysia': 'Takaful Malaysia',
  'berjaya-sompo': 'Berjaya Sompo',
  msig: 'MSIG',
  rhi: 'RHB Insurance',
  lonpac: 'Lonpac',
};

function companyName(slug: string) {
  return companyNames[slug] ?? slug;
}

// Preserve the read-only data's limitations as practical checks for the buyer.
function buyerCopy(text: string) {
  return text.replace(
    /tidak disahkan(?: dalam sumber rasmi yang kami semak)?|[Ss]umber yang disemak/g,
    (phrase) => phrase.startsWith('tidak')
      ? 'tidak dinyatakan dalam rujukan kami; semak terus dengan penyedia'
      : (phrase.startsWith('S') ? 'Maklumat produk yang tersedia' : 'maklumat produk yang tersedia'),
  );
}

export function getStaticPaths() {
  return comparisons.map((comp, i) => ({
    params: { slug: comp.slug },
    props: {
      comp,
      related: comparisons.filter((_, j) => j !== i).slice(0, 3),
    },
  }));
}

const { comp, related } = Astro.props;
const nameA = companyName(comp.company1);
const nameB = companyName(comp.company2);
const titleSuffix = ' | Insurans.co';
// Each pair names its deciding difference (comparisons.json seoTitle, ≤ 60 characters, always with
// "insurans" or "takaful"), taken from that pair's own facts.
const comparisonTitle: string = (comp as any).seoTitle ?? `${nameA} vs ${nameB} 2026: Mana Lebih Sesuai?`;
const showSiteSuffix = comparisonTitle.length + titleSuffix.length <= 60;
const comparisonDescription: string = (comp as any).metaDescription
  ?? `${nameA} vs ${nameB}: banding pilihan takaful, cara tuntutan dan aplikasi digital. Semak manfaat serta syarat polisi sebelum memilih perlindungan.`;
const comparisonOgImageAlt = `${nameA} vs ${nameB} 2026 — pilihan takaful, tuntutan dan aplikasi digital.`;

function formatDate(value: string): string {
  const date = new Date(`${value}T00:00:00Z`);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat('ms-MY', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(date);
}

// Answer box. finding = the first sentence of the page's own summary. facts = only criteria where both sides
// state a concrete value in the criterion text shown below (same buyerCopy wording): the first phone number in
// "Tuntutan dan bantuan jalan", the first app name in "Aplikasi digital", the AM Best / RAM rating in
// "Kestabilan kewangan dan rating". A criterion is left out when either side has no such value. No verdict.
type Dimension = { label: string; a: string; b: string; note: string };
const dims = comp.dimensions as Dimension[];
const APP_NAMES = ['Etiqa+', 'MyAllianz', 'MyTokioApp', 'AIA+', 'GEC app', 'Great Eastern Corporate', 'MyZurich', 'Zurich MyMed', 'Prudential Malaysia App', 'Tele Bantuan', 'MySOMPO', 'MY MSIG app', 'RHB Insurance app'];
const PHONE = /\b(?:1-?[38]00|03)[- ][0-9][0-9 -]{5,}[0-9]/;
const RATING = /(AM Best(?: kekuatan kewangan)?(?: kumpulan)? A\+{0,2}|RAM AA\d)/;
function firstApp(text: string) {
  return APP_NAMES.map((name) => ({ name, at: text.indexOf(name) })).filter((hit) => hit.at >= 0).sort((x, y) => x.at - y.at)[0]?.name;
}
const extractors: Record<string, (text: string) => string | undefined> = {
  'Tuntutan dan bantuan jalan': (text) => text.match(PHONE)?.[0],
  'Aplikasi digital': firstApp,
  'Kestabilan kewangan dan rating': (text) => text.match(RATING)?.[1],
};
const answerFacts = dims.flatMap((dimension) => {
  const extract = extractors[dimension.label];
  if (!extract) return [];
  const valueA = extract(buyerCopy(dimension.a));
  const valueB = extract(buyerCopy(dimension.b));
  if (!valueA || !valueB) return [];
  return [{ label: dimension.label, value: `${nameA}: ${valueA} / ${nameB}: ${valueB}` }];
});
const finding = comp.summary.split(/(?<=\.)\s/)[0];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: comparisonTitle,
      description: comp.summary,
      url: `https://insurans.co/perbandingan/${comp.slug}/`,
      datePublished: '2026-01-01',
      dateModified: comp.asAt,
      inLanguage: 'ms',
      publisher: { '@type': 'Organization', name: 'Insurans.co', url: 'https://insurans.co' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
        { '@type': 'ListItem', position: 2, name: 'Perbandingan', item: 'https://insurans.co/perbandingan/' },
        {
          '@type': 'ListItem',
          position: 3,
          name: `${nameA} vs ${nameB}`,
          item: `https://insurans.co/perbandingan/${comp.slug}/`,
        },
      ],
    },
  ],
};
---

<Base
  title={comparisonTitle}
  description={comparisonDescription}
  siteSuffix={showSiteSuffix}
  schema={schema}
  ogType="article"
  ogImage={`/og/perbandingan/${comp.slug}.png`}
  ogImageAlt={comparisonOgImageAlt}
  publishedTime="2026-01-01"
  modifiedTime={comp.asAt}
  ads={true}
>
  <Hero title={comparisonTitle}>
    <Breadcrumbs slot="breadcrumbs" items={[{ label: 'Utama', href: '/' }, { label: 'Perbandingan', href: '/perbandingan/' }, { label: `${nameA} vs ${nameB}` }]} />
    <PageAnswer slot="answer" finding={finding} facts={[...answerFacts, { label: 'Tarikh semakan', value: formatDate(comp.asAt), role: 'term' }]} />
    <Byline slot="byline" dateModified={comp.asAt} />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-700">{comp.summary}</p>
  </Hero>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
      <div class="lg:col-span-2">
        <section class="prose-editorial prose-bars mb-8">
          <h2>Skop perbandingan</h2>
          <p>
            Semak siapa mengeluarkan polisi, pilihan takaful, manfaat motor, saluran tuntutan dan urusan
            digital bagi setiap penyedia. Untuk produk yang anda pertimbangkan, minta jadual manfaat
            dan dokumen polisi terkini supaya anda boleh membandingkan perlindungan yang sama.
          </p>
        </section>

        <section aria-labelledby="dimensions-heading" class="mb-12">
          <div class="prose-editorial prose-bars mb-5">
            <h2 id="dimensions-heading">Perbezaan mengikut kriteria</h2>
            <p>
              Setiap kad menunjukkan fakta untuk kedua-dua pihak dan nota tentang cara mentafsir bezanya.
              Tiada skor atau pemenang tunggal: pilihan bergantung pada kontrak, keperluan dan sebut harga
              yang tersedia kepada anda.
            </p>
          </div>
          <div class="compare-rows">
            {dims.map((dimension) => (
              <article class="compare-row">
                <h3 class="compare-row-t">{dimension.label}</h3>
                <div class="compare-cols">
                  <div>
                    <h4 class="compare-name">{nameA}</h4>
                    <p>{buyerCopy(dimension.a)}</p>
                  </div>
                  <div>
                    <h4 class="compare-name">{nameB}</h4>
                    <p>{buyerCopy(dimension.b)}</p>
                  </div>
                </div>
                <p class="compare-note">
                  <strong>Cara membaca perbezaan ini:</strong> {buyerCopy(dimension.note)}
                </p>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="choose-heading" class="mb-12">
          <div class="prose-editorial prose-bars mb-5">
            <h2 id="choose-heading">Pilih berdasarkan keperluan anda</h2>
            <p>
              Senarai ini bukan pengesyoran keseluruhan atau penarafan syarikat. Ia memadankan ciri yang
              disahkan dengan keutamaan tertentu supaya anda boleh menyemak sama ada polisi yang ditawarkan
              benar-benar memenuhi keperluan tersebut.
            </p>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <section class="bg-stone-50 border border-stone-200 p-5">
              <h3 class="font-semibold text-stone-900 mb-3">Pilih {nameA} jika…</h3>
              <ul class="list-disc pl-5 space-y-3 text-base text-stone-700 leading-relaxed">
                {comp.chooseA.map((item: string) => <li>{item}</li>)}
              </ul>
            </section>
            <section class="bg-stone-50 border border-stone-200 p-5">
              <h3 class="font-semibold text-stone-900 mb-3">Pilih {nameB} jika…</h3>
              <ul class="list-disc pl-5 space-y-3 text-base text-stone-700 leading-relaxed">
                {comp.chooseB.map((item: string) => <li>{item}</li>)}
              </ul>
            </section>
          </div>
        </section>

        <section aria-labelledby="both-heading" class="info-box mb-12">
          <h2 id="both-heading" class="font-serif text-xl text-stone-900 mb-3">Sama untuk kedua-dua</h2>
          <ul class="list-disc pl-5 space-y-3 text-base text-stone-700 leading-relaxed">
            {comp.sameForBoth.map((item: string) => <li>{item}</li>)}
          </ul>
        </section>

        <section aria-labelledby="faq-heading" class="mb-12">
          <div class="prose-editorial prose-bars mb-5">
            <h2 id="faq-heading">Soalan lazim tentang {nameA} vs {nameB}</h2>
          </div>
          <div>
            {comp.faqs.map((faq: { q: string; a: string }, index: number) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{buyerCopy(faq.a)}</p>
              </details>
            ))}
          </div>
        </section>

        <section aria-labelledby="sources-heading" class="mb-10">
          <div class="prose-editorial prose-bars mb-4">
            <h2 id="sources-heading">Sumber</h2>
            <p>Sumber rasmi dan rujukan yang digunakan untuk fakta di atas. Tarikh semakan: {formatDate(comp.asAt)}.</p>
          </div>
          <ul class="tap-links list-disc pl-5 space-y-2 text-sm">
            {comp.sources.map((source: { label: string; url: string }) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-hijau-700 underline">
                  {source.label}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <aside class="info-box mb-8">
          <p class="text-base text-stone-700 leading-relaxed">
            <strong>Nota editorial:</strong> Perbandingan ini menyusun fakta daripada sumber yang disenaraikan
            dan bukan sokongan atau pengesyoran kepada mana-mana syarikat. Semak dokumen polisi dan kelayakan
            semasa sebelum membeli. Untuk harga, banding sebut harga melalui platform perbandingan yang diluluskan BNM atau terus daripada penyedia; platform ialah saluran perbandingan, bukan
            pengesyoran terhadap produk tertentu.
          </p>
        </aside>

        {related.length > 0 && (
          <section aria-labelledby="related-heading">
            <div class="prose-editorial prose-bars mb-4">
              <h2 id="related-heading">Perbandingan lain</h2>
            </div>
            <div class="space-y-3">
              {related.map((r: { slug: string; company1: string; company2: string }) => (
                <a href={`/perbandingan/${r.slug}/`} class="card-editorial group block">
                  <span class="font-medium text-stone-900 group-hover:text-hijau-700 transition-colors">
                    {companyName(r.company1)} vs {companyName(r.company2)}
                  </span>
                  <Ikon name="i-kanan" size={16} class="ml-2 inline text-hijau-700" />
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-20 space-y-6">
          <section class="bg-white border-2 border-stone-900 p-5">
            <h2 class="font-serif text-lg text-stone-900 mb-4">Ringkasan perbandingan</h2>
            <div class="space-y-4 text-sm">
              <div>
                <p class="font-semibold text-stone-900 mb-1">Syarikat dalam perbandingan</p>
                <ul class="text-stone-600 space-y-1">
                  <li>{nameA}</li>
                  <li>{nameB}</li>
                </ul>
              </div>
              <div class="border-t border-stone-100 pt-4">
                <p class="font-semibold text-stone-900 mb-1">Tarikh semakan</p>
                <p class="text-stone-600">{formatDate(comp.asAt)}</p>
              </div>
            </div>
          </section>

          <section class="card-editorial">
            <h2 class="font-semibold text-sm text-stone-900 mb-3">Halaman syarikat</h2>
            <div class="space-y-2">
              <a href={`/companies/${comp.company1}/`} class="block btn-outline text-sm text-center">
                Info lengkap {nameA}
              </a>
              <a href={`/companies/${comp.company2}/`} class="block btn-outline text-sm text-center">
                Info lengkap {nameB}
              </a>
            </div>
          </section>

          <section class="card-editorial">
            <h2 class="font-semibold text-sm text-stone-900 mb-3">Baca juga</h2>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/perbandingan/" class="text-hijau-700 hover:text-hijau-600">Semua perbandingan</a></li>
              <li><a href="/companies/" class="text-hijau-700 hover:text-hijau-600">Semua syarikat insurans</a></li>
              <li><a href="/car-insurance/" class="text-hijau-700 hover:text-hijau-600">Panduan insurans kereta</a></li>
              <li><a href="/guides/ncd-explained/" class="text-hijau-700 hover:text-hijau-600">NCD — panduan lengkap</a></li>
            </ul>
          </section>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .compare-rows { border-top: 2px solid var(--ink, #111); }
  .compare-row { padding-block: 1.25rem; border-bottom: 1px solid rgb(0 0 0 / 0.2); }
  .compare-row-t { font: 800 1.125rem/1.25 var(--fd, inherit); color: var(--ink, #111); margin: 0 0 0.75rem; }
  .compare-cols { display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 48rem) {
    .compare-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; }
    .compare-cols > div + div { border-left: 1px solid rgb(0 0 0 / 0.2); padding-left: 1.25rem; }
    .compare-cols > div:first-child { padding-right: 1.25rem; }
  }
  .compare-name { font-weight: 700; color: var(--ink, #111); margin: 0 0 0.35rem; }
  .compare-cols p, .compare-note { font-size: 1rem; line-height: 1.55; color: var(--ink, #111); margin: 0; }
  .compare-note { margin-top: 0.9rem; color: var(--ink-2, #3a3a3a); }
</style>
