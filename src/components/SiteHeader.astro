          </g>
      </svg>
    </a>
    {currentPath !== '/' && <p class="mast-tag">Bukan ejen. Bukan broker.</p>}
    <button
      id="mobile-menu-btn"
      type="button"
      class="menu-btn"
      aria-label="Buka menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg class="menu-i" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <span aria-hidden="true">Menu</span>
    </button>
  </div>

  <nav class="tabs" aria-label="Navigasi utama">
    <ul>
      {navLinks.map((link) => (
        <li>
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div id="mobile-menu" hidden class="menu-panel">
    <nav aria-label="Navigasi utama mudah alih">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <noscript>
    <nav aria-label="Navigasi utama mudah alih" class="menu-panel menu-panel-nojs">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </noscript>
</header>

<style>
  .mast { background: var(--paper); color: var(--ink); border-bottom: 1px solid var(--rule); }
  .mast-in {
    --wm-h: 2.75rem;
    max-width: var(--page-max); margin: 0 auto;
    display: grid; grid-template-columns: auto 1fr auto; align-items: end; gap: 0 0.75rem;
    padding: 0.3rem var(--gutter) 0.45rem;
  }
  .wm-a { display: block; border-radius: var(--r-1); color: var(--ink); }
  .wm-a:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .wm-svg { display: block; height: var(--wm-h); width: auto; overflow: visible; }
  .ins-word { fill: var(--ink); }
  .ins-knob { fill: var(--knob); }
  .mast-tag { display: none; }

  .menu-btn {
    grid-column: 3; align-self: center;
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; padding: 0 0.9rem 0 0.75rem;
    border: 1.5px solid var(--ink); border-radius: var(--r-pill); background: var(--card); color: var(--ink);
    font: 600 1rem/1 var(--f); cursor: pointer;
    transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out);
  }
  .menu-btn[aria-expanded='true'] { background: var(--ink); color: #fff; }
  .menu-i { width: 1.25rem; height: 1.25rem; }

  .menu-panel { border-top: 1px solid var(--rule); background: var(--card); }
  .menu-panel ul { margin: 0; padding: 0.5rem var(--gutter) 0.75rem; list-style: none; display: grid; }
  .menu-panel li + li { border-top: 1px solid var(--chip); }
  .menu-panel a {
    display: flex; align-items: center; min-height: 3rem; padding: 0 0.25rem;
    color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1.0625rem;
  }
  .menu-panel a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.25em; text-decoration-color: var(--sel); }

  .tabs { display: none; }

  @media (min-width: 48rem) {
    .mast-in { --wm-h: 4.25rem; grid-template-columns: auto auto 1fr; padding: 0.35rem var(--gutter) 0.6rem; }
    .mast-tag {
      display: block; grid-column: 2; margin: 0 0 0.55rem 0.25rem; padding-left: 1rem;
      border-left: 1.5px solid var(--rule); font-weight: 600; line-height: 1.2; color: var(--ink);
    }
    .menu-btn, .menu-panel { display: none; }

    /* Section tabs: a strip on tablet, a glass capsule on desktop (glass only on navigation). */
    .tabs { display: block; padding: 0 var(--gutter) 0.6rem; }
    .tabs ul {
      display: flex; gap: 0.125rem; width: fit-content; max-width: 100%; margin: 0 auto; padding: 0.25rem;
      list-style: none; border-radius: var(--r-pill); overflow-x: auto; scrollbar-width: none;
      background: var(--glass);
      box-shadow: 0 0 0 1px var(--glass-edge), 0 12px 28px -14px rgb(var(--shade) / 0.5), inset 0 1px 0 var(--glass-spec), inset 0 0 0 1px var(--glass-rim);
    }
    .tabs li { flex: none; }
    .tabs li + li { position: relative; }
    .tabs li + li::before { content: ''; position: absolute; left: -1px; top: 28%; bottom: 28%; width: 1px; background: rgb(var(--shade) / 0.2); }
    .tabs a {
      display: flex; align-items: center; min-height: 2.75rem; padding: 0 0.95rem; white-space: nowrap; border-radius: var(--r-pill);
      color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1rem;
      transition: background-color 150ms var(--ease-out);
    }
    .tabs a[aria-current='page'] { background: var(--ink); color: #fff; }
    .tabs a:focus-visible { outline: 3px solid var(--focus); outline-offset: -3px; }
    .tabs a[aria-current='page']:focus-visible { outline-color: var(--sel); }
    @media (hover: hover) and (pointer: fine) {
      .tabs a:not([aria-current]):hover { background: rgb(var(--shade) / 0.08); }
    }
  }

  @media (min-width: 70rem) {
    .mast-in { --wm-h: 4.5rem; padding-bottom: 0.75rem; }
    .mast { position: relative; z-index: 41; display: contents; }
    .mast-in { background: var(--paper); max-width: none; padding-inline: max(var(--gutter), calc((100% - var(--page-max)) / 2 + var(--gutter))); }
    .tabs { position: sticky; top: 0.5rem; z-index: 40; margin-top: -0.4rem; padding-bottom: 0; pointer-events: none; }
    .tabs ul { pointer-events: auto; }
    @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .tabs ul { background: var(--glass-t); -webkit-backdrop-filter: blur(16px) saturate(180%); backdrop-filter: blur(16px) saturate(180%); }
    }
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .tabs ul { background: var(--card) !important; -webkit-backdrop-filter: none !important; backdrop-filter: none !important; box-shadow: 0 0 0 1.5px var(--ink); }
  }
</style>

<script>
  const menuButton = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuButton instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
    const setMenuState = (open: boolean) => {
      mobileMenu.hidden = !open;
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    };

    menuButton.addEventListener('click', () => {
      setMenuState(Boolean(mobileMenu.hidden));
    });

    mobileMenu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        setMenuState(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !mobileMenu.hidden) {
        setMenuState(false);
        if (menuButton.offsetParent !== null) menuButton.focus();
      }
    });
  }
</script>
