const faqItems = [
  {
    q: "Kemalangan kecil pun perlu laporan polis?",
    a: "Panduan kemalangan Etiqa menyatakan laporan polis perlu dibuat dalam 24 jam, tanpa mengira siapa yang bersalah. Buat laporan walaupun anda sedang mempertimbangkan untuk membayar pembaikan sendiri. Laporan polis dan pemberitahuan kepada syarikat insurans ialah dua urusan berasingan."
  },
  {
    q: "Boleh terus hantar ke bengkel biasa saya?",
