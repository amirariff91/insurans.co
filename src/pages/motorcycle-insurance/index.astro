---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import motorcycleInsurance from '../../data/motorcycle-insurance.json';
import { buildDescription, buildTitle } from '../../lib/seo';

const records = motorcycleInsurance.records;
const asAt = motorcycleInsurance.asAt;
const jpjSource = 'https://www.jpj.gov.my/wp-content/uploads/2022/11/Garis-Panduan-Pengiraan-LKM-Bajet-20092.pdf';
const roadtaxCalculatorUrl = '/tools/kalkulator-roadtax-motosikal/';
const typeOrder = ['third-party', 'comprehensive', 'comprehensive-takaful'];
const typeLabels: Record<string, string> = {
  'third-party': 'Third party',
  comprehensive: 'Comprehensive',
  'comprehensive-takaful': 'Comprehensive / takaful',
};
const typeDescriptions: Record<string, string> = {
  'third-party': 'Liabiliti kepada pihak ketiga; motosikal sendiri tidak termasuk dalam cover asas.',
  comprehensive: 'Perlindungan motosikal sendiri dan liabiliti pihak ketiga, tertakluk pada wording polisi.',
  'comprehensive-takaful': 'Struktur perlindungan berasaskan sijil takaful; semak manfaat dan pengecualian setiap produk.',
};
const recordGroups = typeOrder
  .map((type) => ({
    type,
    label: typeLabels[type],
    description: typeDescriptions[type],
    records: records.filter((record) => record.type === type),
  }))
  .filter((group) => group.records.length > 0);
const sourceLinks = [
  { label: 'JPJ — Garis Panduan LKM', url: jpjSource },
  ...records.flatMap((record) =>
    record.sources.map((url) => ({
      label: new URL(url).hostname.replace(/^www\./, ''),
      url,
    })),
  ),
].filter((source, index, sources) => sources.findIndex((candidate) => candidate.url === source.url) === index);
const outboundLinks = records.map((record) => ({
  label: record.insurer.replace(' Insurance Berhad', '').replace(' Insurance (Malaysia) Bhd', ''),
  href: record.sources[0],
  relationship: 'unpaid' as const,
}));
const sompoExample = records.find((record) => record.slug === 'berjaya-sompo-motorcycle');
const pageTitle = 'Insurans Motosikal Malaysia 2026';
const title = buildTitle(pageTitle, { max: 59 });
const description = buildDescription(
  'Panduan insurans motosikal Malaysia: kadar roadtax JPJ ikut cc, beza third party, comprehensive dan takaful, contoh premium yang disahkan serta cara renew.',
);
const canonicalUrl = 'https://insurans.co/motorcycle-insurance/';
const faqs = [
  {
    q: 'Bagaimana renew insurans motosikal online?',
    a: 'Sediakan nombor pendaftaran, maklumat pemilik, polisi lama dan rekod NCD. Semak quotation terus dengan penyedia melalui pautan rasmi, kemudian periksa jenis cover, jumlah diinsuranskan, add-on dan tarikh kuat kuasa sebelum membayar. Selepas sijil atau cover note sah dikeluarkan, barulah teruskan pembaharuan roadtax melalui saluran JPJ yang sesuai.',
  },
  {
    q: 'Apa beza third party dengan comprehensive untuk motosikal?',
    a: 'Third party melindungi liabiliti kepada pihak lain dan tidak melindungi motosikal sendiri dalam cover asas. Comprehensive turut merangkumi kerosakan atau kehilangan motosikal sendiri mengikut wording, selain liabiliti pihak ketiga. Sesetengah produk turut menyediakan TPFT atau add-on; semak PDS dan quotation sebenar.',
  },
  {
    q: 'Berapa jumlah roadtax dan insurans untuk Y15 atau motosikal 150cc?',
    a: 'Untuk ≤150cc, jadual JPJ yang dirujuk menulis “kadar sedia ada” tanpa menyatakan semula angka. Premium insurans pula tiada jadual awam mengikut cc yang boleh kami sahkan; ia bergantung pada faktor seperti NCD, cc, umur dan lokasi. Jadi jumlah untuk Y15 atau motosikal 150cc perlu datang daripada quotation sebenar, bukan angka rekaan.',
  },
  {
    q: 'Bagaimana NCD motosikal mempengaruhi premium?',
    a: 'NCD ialah salah satu faktor rating yang dinyatakan dalam PDS Kurnia. PDS Berjaya Sompo yang kami baca menggunakan NCD 25% dalam satu contoh Honda Airblade, tetapi contoh tunggal itu bukan jadual kelayakan universal. Sahkan NCD yang terpakai pada polisi anda dalam quotation atau rekod insurer.',
  },
  {
    q: 'Adakah add-on pembonceng atau pillion diperlukan?',
    a: 'Jangan anggap semua polisi memberi skop pembonceng yang sama. PDS Kurnia menyatakan add-on penumpang atau pillion, manakala rekod Berjaya Sompo menyenaraikan liabiliti pillion sebagai add-on. Semak wording, had dan keadaan pemakaian sebelum menambahkannya.',
  },
  {
    q: 'Bagaimana cari insurans motosikal murah dengan cara yang jujur?',
    a: 'Tiada angka premium per-cc awam yang boleh kami sahkan sebagai kadar umum. Bandingkan quotation sebenar berdasarkan jenis cover, jumlah diinsuranskan, NCD, excess, add-on, SST dan setem yang dinyatakan oleh penyedia. Harga rendah tanpa memahami skop cover bukan ukuran yang mencukupi.',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: '2026-02-01',
  dateModified: asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Motosikal', item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime="2026-02-01"
  modifiedTime={asAt}
>
  <section class="border-b border-stone-200 bg-white">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { label: 'Utama', href: '/' },
          { label: 'Insurans Motosikal' },
        ]}
      />
      <p class="label mb-3">Panduan Data</p>
      <h1 class="mb-4 font-serif text-headline-lg text-stone-900 sm:text-headline-xl">Insurans Motosikal Malaysia 2026</h1>
      <Byline dateModified={asAt} />
      <p class="mt-4 max-w-2xl text-lg leading-7 text-stone-600">
        Rujukan neutral, bukan ejen: semak jadual roadtax JPJ, jenis perlindungan, satu contoh premium yang benar-benar
        diterbitkan dan pautan quotation rasmi. Tiada jadual premium motosikal mengikut cc direka.
      </p>
      <div class="mt-4 max-w-2xl">
        <EditorialStamp articleDate={asAt} sources={sourceLinks} sourcesLabel="Sumber" showReviewed={false} />
      </div>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div class="lg:col-span-2">
        <article class="prose-editorial">
          <h2 id="apa-itu">Insurans motosikal (bukan ejen)</h2>
          <p class="text-lg leading-7 text-stone-700">
            Insurans motosikal melindungi risiko yang dinyatakan dalam polisi; minimum yang diperlukan untuk kegunaan
            jalan raya ialah perlindungan liabiliti pihak ketiga yang sah. Insurans.co bukan ejen atau broker. Halaman ini
            memisahkan angka yang ada sumber daripada premium yang hanya boleh diketahui melalui quotation.
          </p>
          <p>
            {records.length} rekod produk di bawah datang daripada sumber rasmi yang dikenal pasti. Klik kad untuk melihat ringkasan
            dan sumber setiap rekod. Jika sumber yang dibaca belum cukup untuk mengesahkan manfaat atau harga, kami tandakan
            perkara itu dan tidak mengisinya dengan anggaran.
          </p>

          <h2 id="roadtax">Kadar roadtax motosikal JPJ ikut cc</h2>
          <p>
            Jadual berikut ialah kadar Lesen Kenderaan Motor untuk motosikal persendirian mengikut kapasiti enjin. Angka
            berbeza mengikut wilayah; semak dokumen JPJ sebelum membayar.
          </p>
        </article>

        <div class="my-6 overflow-x-auto">
          <table class="table-editorial">
            <thead>
              <tr>
                <th scope="col">Kapasiti enjin</th>
                <th scope="col">Semenanjung</th>
                <th scope="col">Sabah / Sarawak</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="font-medium text-stone-900">≤150cc</td>
                <td>Kadar sedia ada</td>
                <td>Kadar sedia ada</td>
              </tr>
              <tr>
                <td class="font-medium text-stone-900">151–200cc</td>
                <td>RM30</td>
                <td>RM9</td>
              </tr>
              <tr>
                <td class="font-medium text-stone-900">201–250cc</td>
                <td>RM50</td>
                <td>RM12</td>
              </tr>
              <tr>
                <td class="font-medium text-stone-900">251–500cc</td>
                <td>RM180</td>
                <td>RM30</td>
              </tr>
              <tr>
                <td class="font-medium text-stone-900">501–800cc</td>
                <td>RM250</td>
                <td>RM40</td>
              </tr>
              <tr>
                <td class="font-medium text-stone-900">&gt;800cc</td>
                <td>RM350</td>
                <td>RM42</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="info-box">
          <p class="text-sm leading-6 text-stone-700">
            <strong>Nota kadar ≤150cc:</strong> JPJ menulis “kadar sedia ada” dalam jadual yang dirujuk. Kami tidak
            menukar frasa itu kepada angka yang tidak dinyatakan semula dalam sumber. Pangkor dan Langkawi menggunakan
            pelarasan tersendiri bagi julat tertentu, manakala Labuan menggunakan 50% kadar Sabah; rujuk
            <a href={jpjSource}>Garis Panduan Pengiraan LKM JPJ</a> untuk konteks penuh.
          </p>
          <p class="mt-3 text-sm leading-6 text-stone-700">
            <a href={roadtaxCalculatorUrl} class="font-semibold text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">
              Buka kalkulator roadtax motosikal →
            </a>
            <span class="block text-stone-600">Kalkulator khusus motosikal menggunakan jadual ini; premium insurans tetap perlu quotation.</span>
          </p>
        </div>

        <article class="prose-editorial">
          <h2 id="harga">Berapa harga insurans motosikal sebenarnya?</h2>
          <p>
            Tiada jadual premium motosikal mengikut cc yang dapat disahkan daripada sumber primer yang dibaca. PDS Kurnia
            menyenaraikan faktor rating seperti cc, NCD, umur dan lokasi tanpa menerbitkan jadual; perlindungan
            comprehensive pula bergantung pada risiko dan jumlah diinsuranskan. Jangan tukar jadual roadtax kepada jadual
            premium.
          </p>
        </article>

        <div class="my-6 border-2 border-stone-900 bg-white p-5 sm:p-6">
          <p class="label">Satu contoh yang diterbitkan</p>
          <h3 class="mt-2 font-serif text-headline-sm text-stone-900">Berjaya Sompo · contoh PDS</h3>
          <p class="mt-4 font-serif text-3xl text-hijau-800">{sompoExample?.workedExample}</p>
          <p class="mt-3 text-sm leading-6 text-stone-600">
            Ini contoh untuk pemboleh ubah yang dinyatakan, bukan jadual harga atau quotation untuk semua motosikal.
            Semak jumlah akhir dengan penyedia; pautan quotation rasmi diletakkan di bawah.
          </p>
        </div>

        <article class="prose-editorial">
          <h2 id="jenis">Third party vs comprehensive vs takaful</h2>
        </article>
        <div class="my-6 grid gap-4 sm:grid-cols-3">
          <div class="card-editorial">
            <h3 class="font-serif text-headline-sm text-stone-900">Third party</h3>
            <p class="mt-3 text-sm leading-6 text-stone-600">
              Fokus pada liabiliti kepada pihak lain. Kerosakan atau kehilangan motosikal sendiri tidak termasuk dalam
              cover asas.
            </p>
          </div>
          <div class="card-editorial">
            <h3 class="font-serif text-headline-sm text-stone-900">Comprehensive</h3>
            <p class="mt-3 text-sm leading-6 text-stone-600">
              Boleh melindungi motosikal sendiri serta liabiliti pihak ketiga, tertakluk pada sum insured, excess,
              pengecualian dan wording polisi.
            </p>
          </div>
          <div class="card-editorial">
            <h3 class="font-serif text-headline-sm text-stone-900">Takaful</h3>
            <p class="mt-3 text-sm leading-6 text-stone-600">
              Menggunakan struktur sijil takaful. Bandingkan skop manfaat, pengecualian, caruman dan proses tuntutan
              dalam sijil atau PDS, bukan berdasarkan label sahaja.
            </p>
          </div>
        </div>

        <article class="prose-editorial">
          <h2 id="produk">Senarai produk</h2>
          <p>
            Produk dikelompokkan mengikut jenis rekod. Setiap kad membawa ke halaman butiran; status figure verified
            menunjukkan sama ada angka atau manfaat boleh diringkaskan daripada sumber yang dibaca.
          </p>
        </article>

        <div class="mt-6 space-y-10">
          {recordGroups.map((group) => (
            <section id={group.type}>
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div>
                  <h3 class="font-serif text-headline-md text-stone-900">{group.label}</h3>
                  <p class="mt-1 text-sm text-stone-600">{group.description}</p>
                </div>
                <span class="text-sm text-stone-500">{group.records.length} rekod</span>
              </div>

              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {group.records.map((record) => (
                  <a href={`/motorcycle-insurance/${record.slug}/`} class="card-editorial group block">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <h4 class="font-semibold text-stone-900 group-hover:text-hijau-700">{record.planName}</h4>
                        <p class="mt-1 text-xs leading-5 text-stone-500">{record.insurer}</p>
                      </div>
                      <span class="shrink-0 border border-stone-300 px-2 py-1 text-xs font-semibold text-stone-600">
                        {group.label}
                      </span>
                    </div>
                    {record.figureVerified ? (
                      <p class="mt-4 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">{record.coversWhat}</p>
                    ) : (
                      <p class="mt-4 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">
                        Manfaat dan premium belum disahkan daripada sumber primer yang dibaca.
                      </p>
                    )}
                    <span class="mt-4 inline-block text-sm font-semibold text-hijau-700">Lihat butiran →</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>

        <article class="prose-editorial">
          <h2 id="renew">Cara renew</h2>
          <p>
            Renew secara tertib supaya cover dan roadtax tidak terputus. Saluran dan maklumat yang diminta boleh berbeza
            antara penyedia.
          </p>
          <ol class="list-decimal space-y-3 pl-5">
            <li>Sediakan nombor pendaftaran, maklumat pemilik, polisi lama dan NCD yang hendak disahkan.</li>
            <li>Dapatkan quotation daripada penyedia; pilih jenis cover dan add-on hanya selepas membaca skopnya.</li>
            <li>Semak nama pemilik, nombor pendaftaran, tempoh, jumlah diinsuranskan, excess dan pengecualian pada dokumen.</li>
            <li>Simpan e-policy atau cover note yang sah, kemudian uruskan roadtax melalui saluran JPJ yang berkenaan.</li>
          </ol>
          <p>
            Pautan penyedia di bawah ialah pautan luar tanpa hubungan berbayar. Insurans.co tidak mengeluarkan quotation,
            menerima bayaran atau bertindak sebagai ejen.
          </p>
        </article>

        <section id="faq" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>FAQ insurans motosikal</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>

        <div class="mt-10 sm:mt-14">
          <CtaBand
            heading="Semak quotation dengan penyedia"
            body="Premium motosikal tidak boleh dikira daripada jadual cc awam. Gunakan pautan rasmi di bawah untuk semakan quotation dan terma terkini."
            primary={{ label: 'Kira roadtax motosikal →', href: roadtaxCalculatorUrl }}
            outbound={outboundLinks}
            disclosure="Pautan luar ini adalah rujukan tanpa hubungan berbayar atau affiliate. Insurans.co bukan ejen; quotation dan pembelian dibuat di laman penyedia."
          />
        </div>
      </div>

      <aside class="lg:col-span-1">
        <div class="space-y-6 lg:sticky lg:top-20">
          <div class="border-2 border-stone-900 bg-white p-5">
            <h3 class="font-serif text-headline-sm text-stone-900">Ringkasan</h3>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-stone-500">Bilangan rekod</dt>
                <dd class="font-semibold text-stone-900">{records.length} produk</dd>
              </div>
              <div>
                <dt class="text-stone-500">Jadual roadtax</dt>
                <dd class="font-semibold text-stone-900">JPJ ikut cc dan wilayah</dd>
              </div>
              <div>
                <dt class="text-stone-500">Premium motosikal</dt>
                <dd class="font-semibold text-stone-900">Perlu quotation</dd>
              </div>
              <div>
                <dt class="text-stone-500">Data dikemas kini</dt>
                <dd class="font-semibold text-hijau-700">{asAt}</dd>
              </div>
            </dl>
          </div>
          <div class="card-editorial">
            <h3 class="font-semibold text-sm text-stone-900">Baca juga</h3>
            <ul class="mt-3 space-y-2.5 text-sm">
              <li><a href="/personal-accident/" class="text-hijau-700 hover:text-hijau-600">Insurans kemalangan diri</a></li>
              <li><a href="/health-insurance/" class="text-hijau-700 hover:text-hijau-600">Insurans kesihatan</a></li>
              <li><a href="/takaful/" class="text-hijau-700 hover:text-hijau-600">Insurans vs takaful</a></li>
              <li><a href={roadtaxCalculatorUrl} class="text-hijau-700 hover:text-hijau-600">Kalkulator roadtax motosikal</a></li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
