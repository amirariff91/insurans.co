---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Byline from '../../../components/Byline.astro';
import EditorialStamp from '../../../components/EditorialStamp.astro';
import Hero from '../../../components/Hero.astro';
import PageAnswer from '../../../components/edisi/PageAnswer.astro';
import { buildDescription, buildTitle } from '../../../lib/seo';

const asAt = '2026-09-12';
const pageTitle = 'Travel Insurance: Bila Perlu, Bila Membazir?';
const title = buildTitle(pageTitle);
const description = buildDescription(
  'Nak tahu bila travel insurance berbaloi dan bila membazir? Panduan financial planning Malaysia: domestik vs overseas, annual-trip math, evakuasi & Schengen.',
);
const h1 = 'Travel Insurance: Bila Perlu, Bila Membazir?';
const canonicalUrl = 'https://insurans.co/literasi-kewangan/travel-bila-perlu/';
const sources = [
  { label: 'Etiqa TripCare 360', url: 'https://www.etiqa.com.my/travel/tripcare-360-insurance' },
  { label: 'Zurich Z-Travel', url: 'https://www.zurich.com.my/insurance-products/protection/for-my-travel/z-travel-insurance-international' },
  { label: 'MSIG Travel SafeGuard', url: 'https://takeiteasy.msig.com.my/spa-assets/travelAddOnResource/Travel%20SafeGuard%20-%20Policy%20Wording_Single_No%20SD@16.06.26.pdf' },
];

const faqs = [
  {
    q: 'Travel domestik perlu travel insurance tak?',
    a: 'Bergantung pada trip: semak ambang jarak (contoh Zurich domestik ≥50km dari rumah) dan apa yang dilindungi: delay, bagasi, kemasukan hospital. Nilai kos yang mungkin tidak boleh dipulangkan, manfaat yang diperlukan dan syarat perjalanan domestik sebelum membandingkan harga.',
  },
  {
    q: 'Frequent flyer — single atau annual?',
    a: 'Kira: jumlahkan semua single-trip setahun, dan bandingkan dengan harga annual (Zurich dan Zurich Takaful ada varian annual). Jumlahkan harga polisi satu perjalanan yang diperlukan sepanjang tahun, kemudian bandingkan dengan polisi tahunan yang memberi perlindungan setara. Semak juga penalti pembatalan polisi tahunan (mengikut jadual kadar tempoh pendek, bukan bayaran balik penuh).',
  },
  {
    q: 'Travel insurance cover COVID sekarang?',
    a: 'Perlu disemak satu per satu: Zurich Z-Travel dan Etiqa TripCare 360 = add-on berbayar; Generali = rider Pandemic Cover (luar negara sahaja); Allianz Shopee = sudah termasuk dalam polisi, tetapi hanya untuk yang divaksin penuh, dan perlu diagnosis doktor serta laporan makmal. Jangan anggap COVID dilindungi secara automatik.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: asAt,
  dateModified: asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Literasi Kewangan', item: 'https://insurans.co/literasi-kewangan/' },
      { '@type': 'ListItem', position: 3, name: h1, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={asAt}
  modifiedTime={asAt}
>
  <Hero title={h1}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Literasi Kewangan', href: '/literasi-kewangan/' },
        { label: h1 },
      ]}
    />
    <Byline slot="byline" dateModified={asAt} />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      Travel insurance berbaloi bila satu kejadian boleh menghasilkan bil perubatan, evakuasi atau kerugian trip yang besar;
      trip murah dan dekat tidak semestinya memerlukan polisi.
    </p>
    <PageAnswer
      slot="answer"
      finding="Nilai risiko, bukan jarak"
      facts={[
        { label: 'Biasanya perlukan semakan serius', value: 'Overseas dengan bil mahal, Schengen, aktiviti lasak atau trip yang mahal' },
        { label: 'Mungkin tidak berbaloi', value: 'Domestik dekat dengan risiko rendah' },
      ]}
    />
    <div class="mt-4 mr-2">
      <EditorialStamp articleDate={asAt} sources={sources} sourcesLabel="Rujukan" showReviewed={false} />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <article class="prose-editorial prose-bars">
      <p class="text-lg leading-7 text-stone-700">
        Pelan perjalanan biasanya membayar empat perkara: <strong>bil perubatan di luar negara, evakuasi atau repatriasi, pembatalan
        trip, dan kelewatan (delay) atau bagasi</strong>. Jarak dekat atau jauh bukan penentu. Potensi bil dan kerugianlah yang menentukan.
      </p>
      <p class="note-plain text-sm leading-6">
        <strong>Kami bukan ejen, bukan broker. Maklumat am sahaja.</strong> Semak had, pengecualian dan hotline dalam wording
        polisi sebelum terbang.
      </p>

      <h2 id="membazir">Bila membazir (atau hampir)</h2>
      <ul>
        <li>
          <strong>Domestik dekat, sihat, trip murah</strong>: untuk perjalanan bawah 50km dari rumah, ambil perhatian bahawa Zurich Travel
          Takaful domestik hanya aktif pada <strong>≥50km dari rumah</strong> (pergi-balik kerja tidak dikira). Jika trip seperti ini,
          semak dahulu sama ada polisi itu aktif untuk perjalanan anda sebelum membayar.
        </li>
        <li>
          <strong>Kerap melakukan perjalanan</strong>: jika kerap melakukan perjalanan, jumlahkan harga polisi satu perjalanan dan bandingkan dengan polisi tahunan yang memberi perlindungan setara (contoh
          Zurich Z-Travel dan Zurich Travel Takaful ada varian single dan annual).
        </li>
        <li>
          <strong>Jangkaan salah</strong>: perlindungan rawatan pesakit luar (demam, GP) bergantung pada manfaat, had dan pengecualian pelan; semak PDS serta polisi.
        </li>
      </ul>

      <h2 id="perlu">Bila perlu (jangan langkau)</h2>
      <ul>
        <li>
          <strong>Luar negara jauh atau bil mahal</strong>: had perubatan mesti munasabah. Contoh data sebenar: Zurich Z-Travel
          Lite Basic RM100,000 hingga Diamond unlimited; evakuasi RM1 juta (Lite) atau unlimited (plan penuh). Pilih had ikut
          destinasi, bukan ikut harga termurah.
        </li>
        <li>
          <strong>Schengen (Eropah)</strong>: ini syarat visa, bukan pilihan. Minimum <strong>€30,000 (~RM150k)</strong>
          perubatan + repatriasi, sah di semua negara Schengen, sepanjang tempoh visa. Sijil polisi perlu ditunjukkan semasa memohon.
        </li>
        <li>
          <strong>Sukan lasak, COVID atau Haji</strong>: plan penuh Zurich melindungi sukan amatur (scuba, winter sports, bungee);
          COVID pula berbeza ikut plan. Zurich Z-Travel dan Etiqa TripCare 360 meletakkan COVID sebagai add-on, manakala Allianz (Shopee)
          sudah memasukkannya dalam polisi, tetapi hanya untuk yang divaksin penuh. Satu pengecualian yang kurang diketahui: Etiqa TripCare 360 mengecualikan perjalanan
          Haji.
        </li>
      </ul>

      <h3 id="claim">Dua peraturan yang selamatkan claim</h3>
      <ol>
        <li>
          <strong>Evakuasi mesti melalui hotline 24-jam insurer.</strong> Jika anda menyusunnya sendiri (contoh menyewa pengangkutan perubatan),
          claim boleh ditolak. Contoh yang disahkan: polisi MSIG mewajibkan evakuasi diselaraskan melalui hotline +603-2166 3080 dan tidak membayar
          evakuasi dari Malaysia ke destinasi asing. Simpan nombor itu dalam telefon dan sebagai salinan fizikal.
        </li>
        <li>
          <strong>Ambang delay sangat berbeza:</strong> Etiqa membayar secara automatik mulai <strong>2 jam</strong>; Zurich bayar mulai
          <strong>6 jam</strong>. Bandingkan ambang masa, bukan jumlah sahaja. Polisi tahunan yang anda batalkan sendiri pula tidak mendapat
          bayaran balik penuh. Zurich Travel Takaful mengira mengikut jadual kadar tempoh pendek (berkuat kuasa ≤2 bulan: caj 40%; &gt;6 bulan: 100%).
        </li>
      </ol>
      <p>
        Formula mudah. Trip murah + dekat + sihat: simpan duit premium. Trip jauh + bil mahal + visa + aktiviti: beli, dan
        baca klausa evakuasi serta COVID sebelum bayar.
      </p>
    </article>

    <nav class="mt-8 border-t border-stone-200 pt-6" aria-label="Bacaan berkaitan">
      <p class="text-sm text-stone-500">Baca juga:</p>
      <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
        <li><a href="/travel-insurance/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Banding plan travel sebenar</a></li>
        <li><a href="/insurans-online/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Beli travel online</a></li>
        <li><a href="/medical-cards/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Medical domestik berbanding travel medical</a></li>
        <li><a href="/critical-illness/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Kalau sakit di luar negara macam mana?</a></li>
        <li><a href="/guides/how-to-claim/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Disiplin dokumen claim</a></li>
      </ul>
    </nav>

    <section id="faq" class="mt-10 sm:mt-14">
      <div class="prose-editorial prose-bars">
        <h2>Soalan lazim travel insurance</h2>
      </div>
      <div class="mt-5">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
