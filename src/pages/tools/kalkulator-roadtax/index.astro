---
import Ikon from '../../../components/Ikon.astro';
import '../../../components/edisi-tools/edisi-tools.css';
import Base from '../../../layouts/Base.astro';
import TrustStrip from '../../../components/edisi/TrustStrip.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { docName, readerDate } from '../../../components/edisi-tools/labels';
import ToolOpening from '../../../components/edisi-tools/ToolOpening.astro';
import rates from '../../../data/roadtax-rates.json';
import { calcRoadtax, type RoadtaxBand, type RoadtaxBody, type RoadtaxRegion } from '../../../lib/roadtax';

const canonicalUrl = 'https://insurans.co/tools/kalkulator-roadtax/';
const pageTitle = 'Harga roadtax kereta ikut cc 2026 + kalkulator JPJ';
const description = 'Jadual harga roadtax kereta ikut cc daripada JPJ: Semenanjung, Sabah dan Sarawak, saloon dan MPV/SUV. 1.5L RM90, 1,800cc RM280. Kalkulator percuma.';
const intro = 'Roadtax kereta persendirian di Semenanjung ialah RM20 setahun untuk enjin 1,000cc ke bawah, RM70 untuk 1.3L dan RM90 untuk 1.5L hingga 1,600cc. Saloon 1,800cc membayar RM280 dan 2,000cc RM380. Di Sabah dan Sarawak, kereta 1.5L membayar RM72.';
const faqs = [
  {
    q: 'Roadtax ini untuk kereta apa?',
    a: 'Kalkulator ini untuk kereta persendirian sahaja: saloon seperti sedan dan hatchback, atau non-saloon seperti MPV, SUV dan pikap. Kenderaan syarikat, EV dan motosikal menggunakan jadual berasingan.',
  },
  {
    q: 'Macam mana kadar roadtax dikira?',
    a: 'Kami pilih band cc mengikut wilayah dan jenis badan, kemudian gunakan formula kadar asas + kadar per-cc × (cc − (min cc − 1)). Nilai sen dikekalkan dan tidak dibundarkan ke RM penuh.',
  },
  {
    q: 'Kenapa kadar Semenanjung berbeza daripada Sabah & Sarawak?',
    a: 'Jadual kadar JPJ berbeza mengikut wilayah. Pilih wilayah pendaftaran kereta anda untuk menggunakan jadual yang sepadan.',
  },
  {
    q: 'Langkawi, Pangkor dan Labuan dikira di sini ke?',
    a: 'Tidak. Wilayah duty-free bukan cabang kiraan dalam alat ini. Langkawi, Pangkor dan Labuan mempunyai aturan kadar khas; semak portal JPJ untuk pengesahan sebelum renew.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Kalkulator Roadtax Kereta',
  description,
  url: canonicalUrl,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'MYR' },
  inLanguage: 'ms',
  dateModified: rates.asAt,
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://insurans.co/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Kalkulator Roadtax Kereta', item: canonicalUrl },
    ],
  },
};
// Reader-facing ringgit: no sen when whole (RM280), sen kept otherwise (RM200.40), as docs/gaya-bahasa.md.
const round2 = (v: number) => Math.round(v * 100) / 100;
const fmtRm = (v: number) => `RM${Number.isInteger(round2(v)) ? round2(v).toLocaleString('en-MY') : round2(v).toLocaleString('en-MY', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const fmtCc = (v: number) => v.toLocaleString('en-MY');
const rt = (region: RoadtaxRegion, body: RoadtaxBody, cc: number) => calcRoadtax(region, body, cc).rate;
const bandLabel = (b: RoadtaxBand) => b.minCc === 0 ? `${fmtCc(b.maxCc)}cc ke bawah` : b.maxCc === 99999 ? `Melebihi ${fmtCc(b.minCc - 1)}cc` : `${fmtCc(b.minCc)}–${fmtCc(b.maxCc)}cc`;
const rateLabel = (b: RoadtaxBand) => b.perCc === 0 ? `${fmtRm(b.base)} rata` : `${fmtRm(b.base)} + RM${b.perCc.toFixed(2)} setiap cc melebihi ${fmtCc(b.minCc - 1)}cc`;
const topLabel = (b: RoadtaxBand) => b.maxCc === 99999 ? 'Tiada had' : fmtRm(b.base + b.perCc * (b.maxCc - (b.minCc - 1)));
// Quick table: the engine sizes searchers ask for. Every figure comes from calcRoadtax on the JPJ bands.
const commonCc = [1000, 1300, 1500, 1600, 1800, 2000, 2500, 3000];
const regionList: { key: RoadtaxRegion; label: string }[] = [
  { key: 'semenanjung', label: 'Semenanjung' },
  { key: 'sabahSarawak', label: 'Sabah dan Sarawak' },
];
// Full JPJ tables in the order of the PDF (section numbers in each note).
const fullTables: { id: string; title: string; note: string; bands: RoadtaxBand[] }[] = [
  { id: 'jadual-semenanjung-saloon', title: 'Semenanjung: saloon milik individu', note: 'Kod kegunaan AB, seksyen 1.1.2 PDF JPJ.', bands: rates.rates.semenanjung.saloon },
  { id: 'jadual-semenanjung-nonsaloon', title: 'Semenanjung: bukan saloon (MPV, SUV, pikap)', note: 'Kod AD (individu) dan AE (syarikat), seksyen 1.1.4. Kadar sama untuk individu dan syarikat.', bands: rates.rates.semenanjung.nonSaloon },
  { id: 'jadual-semenanjung-syarikat', title: 'Semenanjung: saloon milik syarikat', note: 'Kod AC, seksyen 1.1.3. Kalkulator di atas tidak mengira jadual ini.', bands: rates.companySaloonSemenanjung },
  { id: 'jadual-sabah-sarawak-saloon', title: 'Sabah dan Sarawak: saloon', note: 'Kod AB (individu) dan AC (syarikat), seksyen 2.1.2 (Sabah) dan 3.2 (Sarawak). Kadar sama untuk individu dan syarikat.', bands: rates.rates.sabahSarawak.saloon },
  { id: 'jadual-sabah-sarawak-nonsaloon', title: 'Sabah dan Sarawak: bukan saloon (MPV, SUV, pikap)', note: 'Kod AD dan AE, seksyen 2.1.3 (Sabah) dan 3.3 (Sarawak).', bands: rates.rates.sabahSarawak.nonSaloon },
];
const sourcePdf = rates.sources[0];
// Worked example for the method sentence, from the same rate table (Semenanjung saloon, 1,601-1,800cc band).
const exBand = rates.rates.semenanjung.saloon.find((b) => b.minCc === 1601)!;
const exRate = exBand.base + exBand.perCc * (exBand.maxCc - (exBand.minCc - 1));
---

<Base
  title={pageTitle}
  siteSuffix={false}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  pageType="tool"
>
  <ToolOpening title="Harga roadtax kereta ikut cc 2026 dan kalkulator">
    <TrustStrip slot="trust" date={rates.asAt} sources={rates.sources.map((url) => ({ url }))} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Tools', href: '/tools/' },
        { label: 'Kalkulator Roadtax Kereta' },
      ]}
    />
    <p class="et-lede">{intro}</p>
  </ToolOpening>

  <div class="container-wide py-10 sm:py-14 et">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div class="lg:col-span-2">
        <noscript><style is:inline>.et .et-wait { display: none; }</style></noscript>
        <section id="calculator" aria-labelledby="calculator-heading" class="et-panel et-calc">
          <div class="et-bar"><h2 id="calculator-heading" class="et-bar-t">Roadtax kereta ikut cc, wilayah dan jenis badan: saloon {exBand.maxCc.toLocaleString("en-MY")}cc di Semenanjung RM{exRate.toFixed(2)}</h2></div>
          <p class="label">Kalkulator percuma</p>
          <p class="mt-2 text-sm leading-5 text-stone-600">Masukkan maklumat dalam geran atau VOC kereta. Pilih kategori yang paling tepat.</p>

          <noscript><p class="mt-4 note-warn et-noscript">Kalkulator ini memerlukan JavaScript. Hidupkan JavaScript dalam pelayar anda.</p></noscript>
          <form id="roadtax-form" method="dialog" class="mt-6 space-y-5">
            <div>
              <label for="engine-cc" class="mb-1.5 block text-sm font-semibold text-stone-700">
                Kapasiti enjin (cc)
              </label>
              <p id="engine-cc-hint" class="et-hint">cth: 1498 atau 1.5</p>
              <input
                type="text"
                id="engine-cc"
                name="cc"
                inputmode="decimal"
                enterkeyhint="go"
                autocomplete="off"
                required
                aria-describedby="engine-cc-hint engine-cc-help engine-cc-understood"
                class="w-full px-4 py-3 text-lg font-medium text-stone-900"
              />
              <p id="engine-cc-help" class="mt-1.5 text-sm text-stone-700">Tengok dalam geran/VOC kereta anda. Tulis dalam cc (cth: 1496) atau liter (cth: 1.5).</p>
              <p class="et-worked">Contoh: kereta saloon {exBand.maxCc.toLocaleString("en-MY")}cc di Semenanjung berada dalam band {exBand.minCc.toLocaleString("en-MY")}–{exBand.maxCc.toLocaleString("en-MY")}cc, iaitu RM{exBand.base} + RM{exBand.perCc.toFixed(2)} × {exBand.maxCc - (exBand.minCc - 1)}cc = <strong>RM{exRate.toFixed(2)}</strong>.</p>
              <p id="engine-cc-understood" class="et-msg" aria-live="polite"></p>
            </div>

            <fieldset>
              <legend class="mb-2 block text-sm font-semibold text-stone-700">Wilayah</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                <label class="flex min-h-11 items-center gap-2 border border-stone-300 px-3 py-3 text-sm text-stone-700 transition-colors hover:border-hijau-500">
                  <input type="radio" name="region" value="semenanjung" checked required class="h-4 w-4 accent-hijau-700" />
                  <span>Semenanjung</span>
                </label>
                <label class="flex min-h-11 items-center gap-2 border border-stone-300 px-3 py-3 text-sm text-stone-700 transition-colors hover:border-hijau-500">
                  <input type="radio" name="region" value="sabahSarawak" class="h-4 w-4 accent-hijau-700" />
                  <span>Sabah &amp; Sarawak</span>
                </label>
              </div>
              <p class="mt-2 et-note">
                <strong>Nota:</strong> {rates.displayNotes.dutyFree}
              </p>
            </fieldset>

            <fieldset>
              <legend class="mb-2 block text-sm font-semibold text-stone-700">Jenis badan</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                <label class="flex min-h-11 items-center gap-2 border border-stone-300 px-3 py-3 text-sm text-stone-700 transition-colors hover:border-hijau-500">
                  <input type="radio" name="body" value="saloon" checked required class="h-4 w-4 accent-hijau-700" />
                  <span>Saloon (sedan/hatchback)</span>
                </label>
                <label class="flex min-h-11 items-center gap-2 border border-stone-300 px-3 py-3 text-sm text-stone-700 transition-colors hover:border-hijau-500">
                  <input type="radio" name="body" value="nonSaloon" class="h-4 w-4 accent-hijau-700" />
                  <span>Non-saloon (MPV/SUV/pikap)</span>
                </label>
              </div>
            </fieldset>

            <button type="submit" class="w-full bg-stone-900 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-stone-800">
              Kira Roadtax Saya
            </button>
          </form>

          <div class="et-out" role="status" aria-live="polite" aria-atomic="true" style="min-height:10rem">
<p class="et-wait" aria-hidden="true">Hasil kiraan akan muncul di sini.</p>
<div
            id="roadtax-result"
            class="mt-6 hidden border border-hijau-200 bg-hijau-50 p-5"
          >
            <p id="roadtax-error" hidden class="border border-red-200 bg-red-50 p-4 text-sm text-red-700"></p>
            <p id="roadtax-value" class="font-serif text-4xl font-bold text-hijau-700"></p>
            <p id="roadtax-breakdown" class="mt-4 border-t border-hijau-200 pt-4 text-sm leading-5 text-stone-600"></p>
          </div>
</div>

          <p class="mt-5 border-t border-stone-200 pt-4 text-sm leading-5 text-stone-700">
            Roadtax + premium insurans (selepas NCD) = belanja renew tahun ini.
            <a href="/tools/ncd-calculator/" class="font-semibold text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-ink">Semak NCD →</a>
          </p>
          <p id="roadtax-handoff-note" hidden role="alert" class="mt-4 et-note"></p>
        </section>

        <div class="et-after">
          <p>Roadtax (cukai jalan) ialah Lesen Kenderaan Motor (LKM) yang dikeluarkan oleh JPJ. Angka di halaman ini roadtax sahaja, belum termasuk premium insurans. Semua kadar diambil daripada garis panduan kadar LKM yang JPJ terbitkan.</p>
        </div>

        <article class="prose-editorial mt-10">
          <h2 id="harga-ikut-cc">Harga roadtax kereta ikut cc yang biasa</h2>
          <p>Jadual ini menunjukkan roadtax setahun untuk kereta persendirian milik individu, pada cc yang paling kerap dicari. Bahan api petrol dan diesel menggunakan jadual yang sama untuk kereta persendirian.</p>
          {regionList.map((region) => (
            <div class="rt-wrap">
              <table class="rt-table">
                <caption>{region.label}: roadtax setahun ikut cc</caption>
                <thead>
                  <tr>
                    <th scope="col">Enjin</th>
                    <th scope="col" class="num">Saloon</th>
                    <th scope="col" class="num">MPV/SUV/pikap</th>
                  </tr>
                </thead>
                <tbody>
                  {commonCc.map((cc) => (
                    <tr>
                      <th scope="row">{fmtCc(cc)}cc</th>
                      <td class="num">{fmtRm(rt(region.key, 'saloon', cc))}</td>
                      <td class="num">{fmtRm(rt(region.key, 'nonSaloon', cc))}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
          <p>Enjin 3.0L diesel milik individu di Semenanjung membayar {fmtRm(rt('semenanjung', 'saloon', 3000))} (saloon) atau {fmtRm(rt('semenanjung', 'nonSaloon', 3000))} (pikap atau SUV), sama seperti enjin petrol. Untuk cc lain, masukkan angka dalam geran ke dalam kalkulator di atas.</p>

          <h2 id="jadual-penuh">Jadual penuh kadar JPJ: kadar asas dan kadar progresif</h2>
          <p>Lajur terakhir ialah roadtax pada cc tertinggi dalam band itu. Di skrin kecil, leret jadual ke kiri untuk melihat semua lajur.</p>
          {fullTables.map((table) => (
            <>
              <h3 id={table.id}>{table.title}</h3>
              <div class="rt-wrap">
                <table class="rt-table">
                  <caption class="sr-only">{table.title}</caption>
                  <thead>
                    <tr>
                      <th scope="col">Kapasiti enjin</th>
                      <th scope="col">Kadar setahun</th>
                      <th scope="col" class="num">Pada cc tertinggi</th>
                    </tr>
                  </thead>
                  <tbody>
                    {table.bands.map((band) => (
                      <tr>
                        <th scope="row">{bandLabel(band)}</th>
                        <td>{rateLabel(band)}</td>
                        <td class="num">{topLabel(band)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="rt-note">{table.note}</p>
            </>
          ))}

          <h2 id="contoh-model">Contoh roadtax untuk model popular</h2>
          <p>Contoh ini menggunakan cc nominal model. Semak cc tepat dalam geran atau VOC kereta anda, kerana band ditentukan oleh angka itu.</p>
          <ul>
            <li><a href="/car-insurance/perodua-axia/">Perodua Axia</a> 998cc (saloon): {fmtRm(rt('semenanjung', 'saloon', 998))} di Semenanjung, {fmtRm(rt('sabahSarawak', 'saloon', 998))} di Sabah dan Sarawak.</li>
            <li><a href="/car-insurance/perodua-myvi/">Perodua Myvi</a> 1.3L: {fmtRm(rt('semenanjung', 'saloon', 1300))} di Semenanjung, {fmtRm(rt('sabahSarawak', 'saloon', 1300))} di Sabah dan Sarawak. Myvi 1.5L: {fmtRm(rt('semenanjung', 'saloon', 1500))} dan {fmtRm(rt('sabahSarawak', 'saloon', 1500))}.</li>
            <li><a href="/car-insurance/proton-saga/">Proton Saga</a> 1,332cc: {fmtRm(rt('semenanjung', 'saloon', 1332))} di Semenanjung. Saga 1,499cc: {fmtRm(rt('semenanjung', 'saloon', 1499))}.</li>
            <li><a href="/car-insurance/proton-persona/">Proton Persona</a> 1,597cc: {fmtRm(rt('semenanjung', 'saloon', 1597))} di Semenanjung, {fmtRm(rt('sabahSarawak', 'saloon', 1597))} di Sabah dan Sarawak. Enjin ini masih dalam band rata 1,401–1,600cc.</li>
            <li><a href="/car-insurance/toyota-vios/">Toyota Vios</a> 1.5L: {fmtRm(rt('semenanjung', 'saloon', 1500))} di Semenanjung, {fmtRm(rt('sabahSarawak', 'saloon', 1500))} di Sabah dan Sarawak.</li>
            <li><a href="/car-insurance/toyota-hilux/">Toyota Hilux</a> (pikap diesel, bukan saloon): jika geran menunjukkan 2,400cc, roadtax di Semenanjung ialah {fmtRm(rt('semenanjung', 'nonSaloon', 2400))}. Pada 2,800cc, ia {fmtRm(rt('semenanjung', 'nonSaloon', 2800))}. Di Sarawak, angka itu {fmtRm(rt('sabahSarawak', 'nonSaloon', 2400))} dan {fmtRm(rt('sabahSarawak', 'nonSaloon', 2800))}. Untuk pacuan empat roda diesel di Sabah, lihat nota di bawah.</li>
          </ul>

          <h2 id="cara-kira">Cara JPJ mengira roadtax: kadar asas + kadar progresif</h2>
          <p>Enjin 1,600cc ke bawah membayar kadar rata mengikut band. Enjin melebihi 1,600cc membayar kadar asas band, ditambah kadar progresif bagi setiap cc melebihi had bawah band. Contohnya, had bawah band 1,601–1,800cc ialah 1,600cc.</p>
          <ul>
            <li>Contoh: kereta saloon {exBand.maxCc.toLocaleString("en-MY")}cc di Semenanjung berada dalam band {exBand.minCc.toLocaleString("en-MY")}–{exBand.maxCc.toLocaleString("en-MY")}cc, iaitu RM{exBand.base} + RM{exBand.perCc.toFixed(2)} × {exBand.maxCc - (exBand.minCc - 1)}cc = RM{exRate.toFixed(2)}.</li>
            <li>Saloon 2,500cc di Semenanjung: {fmtRm(380)} + RM1.00 × 500cc = {fmtRm(rt('semenanjung', 'saloon', 2500))}.</li>
            <li>Nilai sen dikekalkan. Kalkulator ini tidak membundarkan kadar ke ringgit penuh.</li>
          </ul>
          <p>Lompatan besar berlaku pada 1,601cc. Saloon di Semenanjung naik daripada {fmtRm(rt('semenanjung', 'saloon', 1600))} pada 1,600cc kepada {fmtRm(rt('semenanjung', 'saloon', 1601))} pada 1,601cc. Selepas itu, kadar asas setiap band sama dengan roadtax pada cc tertinggi band sebelumnya, jadi roadtax naik sedikit demi sedikit.</p>

          <h2 id="wilayah">Sabah, Sarawak, Langkawi, Pangkor dan Labuan ada kadar sendiri</h2>
          <ul>
            <li><strong>Sabah dan Sarawak</strong> menggunakan jadual yang lebih rendah daripada Semenanjung. Saloon milik syarikat membayar kadar yang sama dengan saloon milik individu.</li>
            <li><strong>Langkawi dan Pangkor:</strong> kereta 1,000cc ke bawah membayar RM20. Melebihi 1,000cc, kadarnya 50% daripada kadar petrol Semenanjung. Contoh: saloon 1.5L membayar {fmtRm(rt('semenanjung', 'saloon', 1500) / 2)}.</li>
            <li><strong>Labuan:</strong> kereta 1,000cc ke bawah membayar RM20. Melebihi 1,000cc, kadarnya 50% daripada kadar petrol Sabah. Contoh: saloon 1.5L membayar {fmtRm(rt('sabahSarawak', 'saloon', 1500) / 2)}.</li>
            <li><strong>Pacuan empat roda diesel di Sabah</strong> kekal pada kadar sedia ada, menurut PDF JPJ. Angkanya tidak tertera dalam PDF itu, jadi kalkulator ini tidak sesuai untuk kenderaan tersebut. Semak dengan JPJ Sabah.</li>
          </ul>
          <p>Kalkulator di atas hanya mengira Semenanjung serta Sabah dan Sarawak. Untuk pulau bebas cukai, JPJ meminta borang perakuan kawasan pengisytiharan dan pengisytiharan kastam (K3) atau resit pelabuhan semasa renew di kaunter.</p>

          <h3>Perkara penting</h3>
          <ul>
            <li>{rates.displayNotes.company} Jadual saloon syarikat Semenanjung ada di atas.</li>
            <li>{rates.displayNotes['>3000cc']}</li>
          </ul>

          <h2 id="ev-motosikal">Kereta elektrik dan motosikal guna jadual lain</h2>
          <ul>
            <li>{rates.displayNotes.ev} <a href="/tools/kalkulator-roadtax-ev/">Kira roadtax kereta elektrik ikut kW →</a></li>
            <li>{rates.displayNotes.motorcycle} <a href="/tools/kalkulator-roadtax-motosikal/">Kira roadtax motosikal ikut cc →</a></li>
          </ul>

          <h2 id="cara-renew">Renew roadtax melalui MyJPJ, MyEG atau kaunter</h2>
          <p>Syarat renew roadtax kereta persendirian, menurut panduan pembaharuan LKM JPJ dan soalan lazim MyJPJ:</p>
          <ul>
            <li>Roadtax anda akan tamat dalam masa kurang daripada dua bulan.</li>
            <li>Insurans kereta sah untuk tempoh roadtax yang dipohon, iaitu enam atau 12 bulan.</li>
            <li>Kenderaan atau pemilik tidak disekat oleh JPJ.</li>
            <li>Jika roadtax terakhir luput lebih tiga tahun, kereta mesti lulus pemeriksaan PUSPAKOM dahulu.</li>
          </ul>
          <p>Saluran renew yang JPJ senaraikan: aplikasi MyJPJ, portal mySIKAP, kaunter JPJ, pejabat pos, MyEG, PUSPAKOM, kios JPJ dan JPJ Mobile. MyJPJ hanya untuk kereta persendirian milik individu warganegara Malaysia. Bayaran di MyJPJ guna kad kredit atau kad debit tempatan. Roadtax digital (e-LKM) dipaparkan dalam MyJPJ, dan anda tidak perlu melekatkan cakera roadtax pada cermin.</p>
          <p>Insurans perlu dibeli dahulu. Langkah penuh ada dalam <a href="/panduan/renew-insurans-roadtax/">panduan renew insurans dan roadtax</a>, dan anda boleh <a href="/tools/ncd-calculator/">menyemak NCD (diskaun tanpa tuntutan)</a> sebelum membeli.</p>

          <h2 id="tidak-pasti">Apa yang kami tidak pasti</h2>
          <ul>
            <li>PDF JPJ tidak mentakrifkan jenis badan "saloon". Kami anggap sedan dan hatchback sebagai saloon, serta MPV, SUV dan pikap sebagai bukan saloon. Ikut kategori dalam geran atau VOC anda.</li>
            <li>PDF itu tidak menyatakan tarikh kuat kuasa. JPJ masih menerbitkannya di halaman panduan kadar LKM pada 27 Nov 2026.</li>
            <li>Kami tidak menemui jumlah denda atau kompaun untuk roadtax tamat tempoh dalam halaman JPJ yang kami baca. Kami tidak menerbitkan angka itu.</li>
            <li>Kadar renew enam bulan untuk kereta persendirian tidak dinyatakan dalam sumber yang kami baca, jadi kami tidak mengiranya.</li>
            <li>Untuk saloon syarikat di Langkawi dan Pangkor, PDF menyebut "50% dari kadar LKM petrol Semenanjung" tanpa menyatakan jadual individu atau syarikat.</li>
            <li>Kadar pacuan empat roda diesel di Sabah tidak tertera dalam PDF.</li>
          </ul>

          <div class="info-box mt-8">
            <p class="mb-0 text-sm leading-5 text-stone-700">
              <strong>Disemak {readerDate(rates.asAt)}:</strong> kami membaca semula <a href={sourcePdf} target="_blank" rel="noopener">PDF Garis Panduan Pengiraan LKM JPJ</a> (pindaan selepas Bajet 2009) dan memadankan setiap band kereta persendirian Semenanjung, Sabah dan Sarawak dengan kalkulator ini. Semua band sepadan. Kami juga membaca halaman panduan kadar LKM, panduan pembaharuan LKM dan soalan lazim e-LKM MyJPJ di laman JPJ pada hari yang sama.
            </p>
            <p class="mt-3 mb-0 text-sm leading-5 text-stone-700">
              <strong>Penafian:</strong> Anggaran ikut jadual kadar JPJ awam. Roadtax sahaja, bukan premium insurans. Kadar muktamad ikut JPJ/MyEG. Kami bukan ejen, bukan broker.
            </p>
            <div class="mt-3 text-sm leading-5 text-stone-700">
              <strong>Sumber (dibaca {readerDate(rates.asAt)}):</strong>
              <ul class="mt-1 list-disc pl-5">
                {rates.sources.map((source) => (
                  <li><a href={source} target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-ink">{docName(source)}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </article>

        <section id="faq" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Soalan lazim kalkulator roadtax</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:col-span-1">
        <div class="space-y-6 lg:sticky lg:top-20">
          <div class="border-2 border-stone-900 bg-white p-5">
            <h2 class="font-serif text-headline-sm text-stone-900">Cara guna</h2>
            <ol class="mt-4 space-y-3 text-sm text-stone-600">
              <li class="flex gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center bg-stone-900 text-xs font-bold text-white">1</span>
                <span>Semak kapasiti enjin dalam <strong>geran/VOC</strong>.</span>
              </li>
              <li class="flex gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center bg-stone-900 text-xs font-bold text-white">2</span>
                <span>Pilih <strong>wilayah</strong> pendaftaran kereta.</span>
              </li>
              <li class="flex gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center bg-stone-900 text-xs font-bold text-white">3</span>
                <span>Pilih badan kereta dan tekan <strong>Kira Roadtax Saya</strong>.</span>
              </li>
            </ol>
          </div>

          <div class="card-editorial">
            <h2 class="text-sm font-semibold text-stone-900">Semakan awal: sahkan dengan JPJ atau MyEG</h2>
            <p class="mt-2 text-sm leading-5 text-stone-600">Angka ini semakan awal berdasarkan jadual kadar awam. Untuk bayaran dan pengesahan, rujuk JPJ atau MyEG.</p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>

<style>
  .rt-wrap { overflow-x: auto; margin: 1rem 0 0.5rem; border: 1px solid var(--rule); }
  .rt-table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; line-height: 1.35; margin: 0; }
  .rt-table caption { text-align: left; font-weight: 600; padding: 0.5rem 0.75rem; }
  .rt-table th, .rt-table td { padding: 0.5rem 0.75rem; border-top: 1px solid var(--line); text-align: left; vertical-align: top; }
  .rt-table thead th { border-top: 0; border-bottom: 2px solid var(--ink); font-weight: 600; }
  .rt-table .num { text-align: right; white-space: nowrap; }
  .rt-table tr > :first-child { position: sticky; left: 0; background: var(--paper); white-space: nowrap; }
  .rt-table tbody th { font-weight: 600; }
  .rt-note { font-size: 0.875rem; color: var(--mute); margin-top: 0.25rem; }
</style>

<script>
  import { calcRoadtax, type RoadtaxBody, type RoadtaxRegion } from '../../../lib/roadtax';
  import { track } from '../../../lib/track';

  const regionLabels: Record<RoadtaxRegion, string> = {
    semenanjung: 'Semenanjung',
    sabahSarawak: 'Sabah & Sarawak',
  };

  function getElement(id: string): HTMLElement | null {
    const element = document.getElementById(id);
    return element instanceof HTMLElement ? element : null;
  }

  function getInput(id: string): HTMLInputElement | null {
    const element = document.getElementById(id);
    return element instanceof HTMLInputElement ? element : null;
  }

  function getCheckedRadio(name: string): HTMLInputElement | null {
    const element = document.querySelector(`input[name="${name}"]:checked`);
    return element instanceof HTMLInputElement ? element : null;
  }

  function isRegion(value: string): value is RoadtaxRegion {
    return value === 'semenanjung' || value === 'sabahSarawak';
  }

  function isBody(value: string): value is RoadtaxBody {
    return value === 'saloon' || value === 'nonSaloon';
  }

  function formatCc(value: number): string {
    return value.toLocaleString('ms-MY');
  }

  function formatRate(value: number): string {
    return `RM\u00a0${value.toLocaleString('ms-MY', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  /**
   * Accepts the engine size as cc ("1496", "1,496", "1496cc") or litres ("1.5", "1,5", "1.5l", "1.5 liter").
   * An explicit unit wins. A bare number from 0.5 to 9.9 is read as litres, from 50 to 9999 as cc;
   * anything else (for example 15 or 15cc) is rejected and the reader is asked for cc.
   */
  function parseEngineSize(raw: string): { cc: number; note: string } {
    const compact = raw.trim().replace(/\s+/g, '').toLowerCase();
    if (compact === '') return { cc: Number.NaN, note: '' };
    const unitMatch = compact.match(/^(.*?)(cc|liter|litre|l)?$/);
    const text = unitMatch ? unitMatch[1] : compact;
    const unit = unitMatch && unitMatch[2] ? (unitMatch[2] === 'cc' ? 'cc' : 'l') : null;
    let normalised = text;
    if (/^\d{1,3}(,\d{3})+$/.test(text)) normalised = text.replace(/,/g, '');
    else if (/^\d+,\d+$/.test(text)) normalised = text.replace(',', '.');
    const value = /^\d+(\.\d+)?$/.test(normalised) ? Number(normalised) : Number.NaN;
    if (!Number.isFinite(value) || value <= 0) return { cc: Number.NaN, note: '' };
    const asLitres = unit === 'l' || (unit === null && value >= 0.5 && value <= 9.9);
    const asCc = unit === 'cc' || (unit === null && value >= 50 && value <= 9999);
    if (asLitres && value >= 0.5 && value <= 9.9) {
      const cc = Math.round(value * 1000);
      return {
        cc,
        note: `Kami baca "${raw.trim()}" sebagai ${value.toLocaleString('ms-MY')} liter = ${formatCc(cc)}cc. Untuk band yang tepat, guna cc dalam geran (cth: 1,496cc).`,
      };
    }
    if (asCc && value >= 50 && value <= 9999) {
      const cc = Number.isInteger(value) ? value : Math.round(value);
      return { cc, note: `Dikira sebagai ${formatCc(cc)}cc.` };
    }
    return {
      cc: Number.NaN,
      note: `Kami tidak dapat membaca "${raw.trim()}" sebagai kapasiti enjin kereta. Tulis dalam cc seperti dalam geran/VOC (cth: 1,496cc).`,
    };
  }

  function showMessage(message: string): void {
    const resultEl = getElement('roadtax-result');
    const errorEl = getElement('roadtax-error');
    const valueEl = getElement('roadtax-value');
    const breakdownEl = getElement('roadtax-breakdown');
    if (!resultEl || !errorEl || !valueEl || !breakdownEl) return;

    resultEl.classList.remove('hidden');
    errorEl.hidden = false;
    errorEl.textContent = message;
    valueEl.hidden = true;
    breakdownEl.hidden = true;
    valueEl.textContent = '';
    breakdownEl.textContent = '';
  }

  function calculateFromForm(): void {
    const engineInput = getInput('engine-cc');
    const regionInput = getCheckedRadio('region');
    const bodyInput = getCheckedRadio('body');
    const resultEl = getElement('roadtax-result');
    const errorEl = getElement('roadtax-error');
    const valueEl = getElement('roadtax-value');
    const breakdownEl = getElement('roadtax-breakdown');
    if (!resultEl || !errorEl || !valueEl || !breakdownEl) return;

    const parsed = parseEngineSize(engineInput ? engineInput.value : '');
    const understoodEl = getElement('engine-cc-understood');
    if (understoodEl) understoodEl.textContent = parsed.note;
    const cc = parsed.cc;
    if (!Number.isFinite(cc) || cc <= 0 || !regionInput || !bodyInput || !isRegion(regionInput.value) || !isBody(bodyInput.value)) {
      showMessage('Sila isi kapasiti enjin yang sah dan pilih wilayah serta jenis badan.');
      return;
    }

    const region = regionInput.value;
    const body = bodyInput.value;
    try {
      const result = calcRoadtax(region, body, cc);
      const maxCc = result.band.maxCc === 99999 ? '∞' : formatCc(result.band.maxCc);
      const additionalCc = cc - (result.band.minCc - 1);

      resultEl.classList.remove('hidden');
      errorEl.hidden = true;
      valueEl.hidden = false;
      breakdownEl.hidden = false;
      valueEl.textContent = `Roadtax setahun: ${formatRate(result.rate)}`;
      breakdownEl.textContent = `Enjin ${formatCc(cc)}cc · ${regionLabels[region]} · band ${formatCc(result.band.minCc)}–${maxCc}cc · kadar ${formatRate(result.band.base)} asas + ${formatRate(result.band.perCc)} × ${formatCc(additionalCc)}cc`;

      track('roadtax_calculate', {
        region,
        body,
        cc,
        rate: result.rate,
        band_min_cc: result.band.minCc,
        band_max_cc: result.band.maxCc,
      });
    } catch {
      showMessage('Kapasiti enjin ini tidak sepadan dengan band kadar JPJ yang tersedia. Semak angka dalam geran/VOC.');
    }
  }

  function setRadioValue(name: string, value: string): boolean {
    const radios = Array.from(document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`));
    const radio = radios.find((candidate) => candidate.value === value);
    if (!radio) return false;
    radio.checked = true;
    return true;
  }

  function applyUrlParams(): void {
    const params = new URLSearchParams(window.location.search);
    const invalidParams: string[] = [];
    const engineInput = getInput('engine-cc');
    const engineParamName = ['cc', 'engineCC', 'engineCc'].find((name) => params.has(name));

    if (engineParamName) {
      const raw = params.get(engineParamName);
      const value = raw && raw.trim() !== '' ? Number(raw) : Number.NaN;
      if (!Number.isFinite(value) || value <= 0) {
        invalidParams.push(engineParamName);
      } else if (engineInput) {
        engineInput.value = String(value);
      }
    }

    const regionParam = params.get('region');
    if (regionParam !== null && !setRadioValue('region', regionParam)) invalidParams.push('region');

    const bodyParam = params.get('body');
    if (bodyParam !== null && !setRadioValue('body', bodyParam)) invalidParams.push('body');

    const handoffNote = getElement('roadtax-handoff-note');
    if (invalidParams.length > 0 && handoffNote) {
      handoffNote.textContent = `Parameter ${invalidParams.join(' dan ')} tidak sah dan diabaikan.`;
      handoffNote.hidden = false;
    }
  }

  const form = document.getElementById('roadtax-form');
  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      calculateFromForm();
    });
  }

  applyUrlParams();
</script>
