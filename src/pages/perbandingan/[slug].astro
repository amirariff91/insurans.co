---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Base from '../../layouts/Base.astro';
import TrustStrip from '../../components/edisi/TrustStrip.astro';
import Hero from '../../components/Hero.astro';
import LogoTile from '../../components/LogoTile.astro';
import Ikon from '../../components/Ikon.astro';
import PageAnswer from '../../components/edisi/PageAnswer.astro';
import comparisons from '../../data/comparisons.json';

const companyNames: Record<string, string> = {
  etiqa: 'Etiqa',
  allianz: 'Allianz',
  'tokio-marine': 'Tokio Marine',
  aia: 'AIA',
  'great-eastern': 'Great Eastern',
  zurich: 'Zurich',
  prudential: 'Prudential',
  'takaful-malaysia': 'Takaful Malaysia',
  'berjaya-sompo': 'Berjaya Sompo',
  msig: 'MSIG',
  rhi: 'RHB Insurance',
  lonpac: 'Lonpac',
};

function companyName(slug: string) {
  return companyNames[slug] ?? slug;
}

// The data states each source limit as its own sentence about what we found ("Kami tidak menemui … dalam
// sumber yang kami semak"). No phrase is rewritten at render time, so no limit can be joined into another clause.
function buyerCopy(text: string) {
  return text;
}

export function getStaticPaths() {
  return comparisons.map((comp, i) => ({
    params: { slug: comp.slug },
    props: {
      comp,
      related: comparisons.filter((_, j) => j !== i).slice(0, 3),
    },
  }));
}

const { comp, related } = Astro.props;
const nameA = companyName(comp.company1);
const nameB = companyName(comp.company2);
const titleSuffix = ' | Insurans.co';
// Each pair names its deciding difference (comparisons.json seoTitle, ≤ 60 characters, always with
// "insurans" or "takaful"), taken from that pair's own facts.
const comparisonTitle: string = (comp as any).seoTitle ?? `${nameA} vs ${nameB} 2026: Mana Lebih Sesuai?`;
const showSiteSuffix = comparisonTitle.length + titleSuffix.length <= 60;
const comparisonDescription: string = (comp as any).metaDescription
  ?? `${nameA} vs ${nameB}: banding pilihan takaful, cara tuntutan dan aplikasi digital. Semak manfaat serta syarat polisi sebelum memilih perlindungan.`;
const comparisonOgImageAlt = `${nameA} vs ${nameB} 2026 — pilihan takaful, tuntutan dan aplikasi digital.`;

function formatDate(value: string): string {
  const date = new Date(`${value}T00:00:00Z`);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat('ms-MY', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(date);
}

// Answer box. finding = the first sentence of the page's own summary. facts = only criteria where both sides
// state a concrete value in the criterion text shown below (same buyerCopy wording): the service phone number in
// "Tuntutan dan bantuan jalan" (see servicePhone), the first app name in "Aplikasi digital", the AM Best / RAM rating in
// "Kestabilan kewangan dan rating". A criterion is left out when either side has no such value. No verdict.
type Dimension = { label: string; a: string; b: string; note: string };
const dims = comp.dimensions as Dimension[];
const APP_NAMES = ['Etiqa+', 'MyAllianz', 'MyTokioApp', 'AIA+', 'GEC app', 'Great Eastern Corporate', 'MyZurich', 'Zurich MyMed', 'Prudential Malaysia App', 'Tele Bantuan', 'MySOMPO', 'MY MSIG app', 'RHB Insurance app'];
const PHONE = /\b(?:1-?[38]00|03)[- ][0-9][0-9 -]{5,}[0-9]/;
const RATING = /(AM Best(?: kekuatan kewangan)?(?: kumpulan)? A\+{0,2}|RAM AA\d)/;
function firstApp(text: string) {
  return APP_NAMES.map((name) => ({ name, at: text.indexOf(name) })).filter((hit) => hit.at >= 0).sort((x, y) => x.at - y.at)[0]?.name;
}
// The claims/breakdown number, not merely the first one: when a criterion lists several numbers, a
// customer-service line is skipped and the chosen number keeps its own service label from the text
// ("talian kerosakan 24 jam 1-800-18-8033"), so the answer never blurs two services. One number: as written.
const PHONE_ALL = new RegExp(PHONE.source, 'g');
function servicePhone(text: string) {
  const hits = [...text.matchAll(PHONE_ALL)].map((m) => {
    const label = text.slice(0, m.index).match(/.*\b((?:talian|meja|hotline)\b[^,;.]*?)\s*$/i)?.[1];
    return { number: m[0], label };
  });
  if (hits.length === 0) return undefined;
  if (hits.length === 1) return hits[0].number;
  const hit = hits.find((h) => !/pelanggan/i.test(h.label ?? '')) ?? hits[0];
  return hit.label ? `${hit.label} ${hit.number}` : hit.number;
}
const extractors: Record<string, (text: string) => string | undefined> = {
  'Tuntutan dan bantuan jalan': servicePhone,
  'Aplikasi digital': firstApp,
  'Kestabilan kewangan dan rating': (text) => text.match(RATING)?.[1],
};
const answerFacts = dims.flatMap((dimension) => {
  const extract = extractors[dimension.label];
  if (!extract) return [];
  const valueA = extract(buyerCopy(dimension.a));
  const valueB = extract(buyerCopy(dimension.b));
  if (!valueA || !valueB) return [];
  return [{ label: dimension.label, value: `${nameA}: ${valueA} / ${nameB}: ${valueB}` }];
});
// Title bar: the concrete difference the page's own criteria text states for this pair, about 60 characters,
// no verdict. Each phrase is in that pair's criteria cards or summary below. A pair without an entry falls back
// to the first sentence of its neutral summary.
const FINDINGS: Record<string, string> = {
  'etiqa-vs-allianz': 'Etiqa: tunda percuma hingga 200 km. Allianz: Road Rangers 24/7.',
  'tokio-marine-vs-msig': 'Tunda: Tokio Marine melalui Auto Partner; MSIG melalui Smart Towing.',
  'allianz-vs-zurich': 'Bantuan jalan 24 jam: Allianz Road Rangers; Zurich Roadside Assistance.',
  'aia-vs-great-eastern': 'Sumber kami lebih terperinci tentang kesihatan dan takaful berbanding motor.',
  'etiqa-vs-tokio-marine': 'Tunda: Etiqa percuma hingga 200 km; Tokio Marine melalui Auto Partner.',
  'msig-vs-zurich': 'MSIG: Smart Towing. Zurich: bantuan jalan melalui MyZurich.',
  'allianz-vs-aia': 'Bantuan jalan 24 jam: Allianz Road Rangers; AIA bantuan jalan digital.',
  'etiqa-vs-msig': 'Etiqa: tunda percuma hingga 200 km. MSIG: Smart Towing.',
  'berjaya-sompo-vs-lonpac': 'Bantuan jalan 24 jam: Berjaya Sompo talian kerosakan; Lonpac Road Assist.',
  'prudential-vs-aia': 'Prudential: motor am tidak ditemui dalam sumber kami. AIA: motor melalui AIA General.',
  'tokio-marine-vs-allianz': 'Tunda: Tokio Marine melalui Auto Partner; Allianz melalui Road Rangers.',
  'etiqa-vs-zurich': 'Tunda: Etiqa percuma hingga 200 km; Zurich melalui Roadside Assistance.',
  'takaful-malaysia-vs-etiqa': 'Takaful Malaysia: Tele Bantuan. Etiqa: tunda hingga 200 km.',
  'great-eastern-vs-msig': 'Bantuan jalan 24 jam: MSIG Motor Assist; Great Eastern General bantuan tepi jalan.',
  'aia-vs-msig': 'Bantuan jalan 24 jam: MSIG Motor Assist; AIA bantuan jalan digital.',
};
const finding = FINDINGS[comp.slug] ?? comp.summary.split(/(?<=\.)\s/)[0];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: comparisonTitle,
      description: comp.summary,
      url: `https://insurans.co/perbandingan/${comp.slug}/`,
      datePublished: '2026-01-01',
      dateModified: comp.asAt,
      inLanguage: 'ms',
      publisher: { '@type': 'Organization', name: 'Insurans.co', url: 'https://insurans.co' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
        { '@type': 'ListItem', position: 2, name: 'Perbandingan', item: 'https://insurans.co/perbandingan/' },
        {
          '@type': 'ListItem',
          position: 3,
          name: `${nameA} vs ${nameB}`,
          item: `https://insurans.co/perbandingan/${comp.slug}/`,
        },
      ],
    },
  ],
};
---

<Base
  title={comparisonTitle}
  description={comparisonDescription}
  siteSuffix={showSiteSuffix}
  schema={schema}
  ogType="article"
  ogImage={`/og/perbandingan/${comp.slug}.png`}
  ogImageAlt={comparisonOgImageAlt}
  publishedTime="2026-01-01"
  modifiedTime={comp.asAt}
  ads={true}
>
  <Hero title={comparisonTitle}>
    <Fragment slot="mark">
      <LogoTile company={comp.company1} size="l" eager wordmark />
      <span class="px-1 font-bold text-stone-700" aria-hidden="true">vs</span>
      <LogoTile company={comp.company2} size="l" eager wordmark />
    </Fragment>
    <Breadcrumbs slot="breadcrumbs" items={[{ label: 'Utama', href: '/' }, { label: 'Perbandingan', href: '/perbandingan/' }, { label: `${nameA} vs ${nameB}` }]} />
    <PageAnswer slot="answer" finding={finding} facts={[...answerFacts, { label: 'Tarikh semakan', value: formatDate(comp.asAt) }]} />
    <TrustStrip slot="trust" date={comp.asAt} />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-700">{comp.summary}</p>
  </Hero>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
      <div class="lg:col-span-2">
        <section aria-labelledby="dimensions-heading" class="mb-12">
          <div class="prose-editorial prose-bars mb-5">
            <h2 id="dimensions-heading">Perbezaan mengikut kriteria</h2>
            <p>
              Kami tidak memberi skor atau memilih pemenang: pilihan bergantung pada kontrak, keperluan dan
              sebut harga yang tersedia kepada anda.
            </p>
          </div>
          {/* Side by side at every width, phones included; the head naming the two companies sticks while the
              rows scroll. One tbody per criterion: its name, the two sides, then the note across both. */}
          <table class="cg">
            <caption class="sr-only">{nameA} dan {nameB} mengikut kriteria</caption>
            <thead>
              <tr>
                <th scope="col"><span class="cg-co"><LogoTile company={comp.company1} size="s" />{nameA}</span></th>
                <th scope="col"><span class="cg-co"><LogoTile company={comp.company2} size="s" />{nameB}</span></th>
              </tr>
            </thead>
            {dims.map((dimension) => (
              <tbody>
                <tr><th scope="rowgroup" colspan="2" class="cg-k">{dimension.label}</th></tr>
                <tr class="cg-v">
                  <td data-empty={dimension.a ? undefined : ''}>{dimension.a ? buyerCopy(dimension.a) : 'Tiada data'}</td>
                  <td data-empty={dimension.b ? undefined : ''}>{dimension.b ? buyerCopy(dimension.b) : 'Tiada data'}</td>
                </tr>
                {dimension.note && <tr><td colspan="2" class="cg-note">{buyerCopy(dimension.note)}</td></tr>}
              </tbody>
            ))}
          </table>
        </section>

        <section class="prose-editorial prose-bars mb-8">
          <h2 class="h2-quiet">Skop perbandingan</h2>
          <p>
            Untuk produk yang anda pertimbangkan, minta jadual manfaat dan dokumen polisi terkini supaya
            anda membandingkan perlindungan yang sama.
          </p>
        </section>

        <section aria-labelledby="choose-heading" class="mb-12">
          <div class="prose-editorial prose-bars mb-5">
            <h2 id="choose-heading">Tiada skor atau pemenang tunggal</h2>
            <p>
              Senarai ini bukan pengesyoran keseluruhan atau penarafan syarikat. Ia memadankan ciri yang
              disebut dalam sumber dengan keutamaan tertentu, supaya anda boleh menyemak sama ada polisi yang
              ditawarkan memenuhi keperluan itu.
            </p>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <section class="note-plain">
              <h3 class="font-semibold text-stone-900 mb-3">Pilih {nameA} jika:</h3>
              <ul class="list-disc pl-5 space-y-3 text-base text-stone-700 leading-relaxed">
                {comp.chooseA.map((item: string) => <li>{item}</li>)}
              </ul>
            </section>
            <section class="note-plain">
              <h3 class="font-semibold text-stone-900 mb-3">Pilih {nameB} jika:</h3>
              <ul class="list-disc pl-5 space-y-3 text-base text-stone-700 leading-relaxed">
                {comp.chooseB.map((item: string) => <li>{item}</li>)}
              </ul>
            </section>
          </div>
        </section>

        <section aria-labelledby="both-heading" class="info-box mb-12">
          <h2 id="both-heading" class="font-serif text-xl text-stone-900 mb-3">Sama untuk kedua-dua</h2>
          <ul class="list-disc pl-5 space-y-3 text-base text-stone-700 leading-relaxed">
            {comp.sameForBoth.map((item: string) => <li>{item}</li>)}
          </ul>
        </section>

        <section aria-labelledby="faq-heading" class="mb-12">
          <div class="prose-editorial prose-bars mb-5">
            <h2 class="h2-quiet" id="faq-heading">Soalan lazim tentang {nameA} vs {nameB}</h2>
          </div>
          <div>
            {comp.faqs.map((faq: { q: string; a: string }, index: number) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{buyerCopy(faq.a)}</p>
              </details>
            ))}
          </div>
        </section>

        <section aria-labelledby="sources-heading" class="mb-10">
          <div class="prose-editorial prose-bars mb-4">
            <h2 class="h2-quiet" id="sources-heading">Sumber</h2>
            <p>Tarikh semakan: {formatDate(comp.asAt)}.</p>
          </div>
          <ul class="tap-links list-disc pl-5 space-y-2 text-sm">
            {comp.sources.map((source: { label: string; url: string }) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-hijau-700 underline">
                  {source.label}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <aside class="info-box mb-8">
          <p class="text-base text-stone-700 leading-relaxed">
            <strong>Nota editorial:</strong> Perbandingan ini menyusun fakta daripada sumber yang disenaraikan
            dan bukan sokongan atau pengesyoran kepada mana-mana syarikat. Semak dokumen polisi dan kelayakan
            semasa sebelum membeli. Untuk harga, banding sebut harga melalui platform perbandingan yang diluluskan BNM atau terus daripada penyedia; platform ialah saluran perbandingan, bukan
            pengesyoran terhadap produk tertentu.
          </p>
        </aside>

        {related.length > 0 && (
          <section aria-labelledby="related-heading">
            <div class="prose-editorial prose-bars mb-4">
              <h2 class="h2-quiet" id="related-heading">Perbandingan lain</h2>
            </div>
            <div class="space-y-3">
              {related.map((r: { slug: string; company1: string; company2: string }) => (
                <a href={`/perbandingan/${r.slug}/`} class="card-editorial group block">
                  <span class="font-medium text-stone-900 group-hover:text-hijau-700 transition-colors">
                    {companyName(r.company1)} vs {companyName(r.company2)}
                  </span>
                  <Ikon name="i-kanan" size={16} class="ml-2 inline text-hijau-700" />
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-20 space-y-6">
          <section class="card-editorial">
            <h2 class="font-semibold text-sm text-stone-900 mb-3">Halaman syarikat</h2>
            <div class="space-y-2">
              <a href={`/companies/${comp.company1}/`} class="block btn-outline text-sm text-center">
                Info lengkap {nameA}
              </a>
              <a href={`/companies/${comp.company2}/`} class="block btn-outline text-sm text-center">
                Info lengkap {nameB}
              </a>
            </div>
          </section>

          <section class="card-editorial">
            <h2 class="font-semibold text-sm text-stone-900 mb-3">Baca juga</h2>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/perbandingan/" class="text-hijau-700 underline">Semua perbandingan</a></li>
              <li><a href="/companies/" class="text-hijau-700 underline">Semua syarikat insurans</a></li>
              <li><a href="/car-insurance/" class="text-hijau-700 underline">Panduan insurans kereta</a></li>
              <li><a href="/guides/ncd-explained/" class="text-hijau-700 underline">NCD: panduan lengkap</a></li>
            </ul>
          </section>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .cg { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; font-size: 0.875rem; line-height: 1.5; color: var(--ink); }
  .cg thead th {
    position: sticky; top: 0; z-index: 3; background: var(--paper); text-align: left; vertical-align: bottom;
    padding: 0.5rem 0.5rem 0.5rem 0; border-bottom: 2px solid var(--ink);
    font: 800 1rem/1.2 var(--fd, inherit);
  }
  .cg thead th + th, .cg-v > td + td { padding-left: 0.75rem; border-left: 1px solid var(--line); }
  .cg-co { display: flex; align-items: center; gap: 0.5rem; min-width: 0; overflow-wrap: anywhere; }
  .cg-co > :global(*) { flex: none; }
  .cg-k { text-align: left; padding: 1rem 0 0.375rem; font: 800 1rem/1.25 var(--fd, inherit); }
  .cg tbody + tbody .cg-k { border-top: 1px solid var(--line); }
  .cg-v > td { vertical-align: top; padding: 0 0.75rem 0.75rem 0; overflow-wrap: break-word; hyphens: auto; }
  .cg-v > td[data-empty] { color: var(--ink-2); }
  .cg-note { padding: 0 0 1rem; color: var(--ink-2); }
  @media (min-width: 48rem) {
    .cg { font-size: 1rem; line-height: 1.55; }
    .cg thead th { font-size: 1.125rem; padding-block: 0.75rem; }
    .cg thead th + th, .cg-v > td + td { padding-left: 1.5rem; }
    .cg-v > td { padding-right: 1.5rem; }
    .cg-k { font-size: 1.125rem; padding-top: 1.25rem; }
  }
  /* From 70rem the section tabs stick at the top (69px band, SiteHeader.astro): the head sits under them. */
  @media (min-width: 70rem) { .cg thead th { top: 4.375rem; } }
</style>
