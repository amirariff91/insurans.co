---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import EditorialStamp from '../components/EditorialStamp.astro';
import Ikon from '../components/Ikon.astro';
import HomeAnswer from '../components/edisi/HomeAnswer.astro';
import ModelRail from '../components/edisi/ModelRail.astro';
import ToolsRail from '../components/edisi/ToolsRail.astro';
import '../styles/edisi-answer.css';
import companies from '../data/companies.json';
import carModels from '../data/car-models.json';
import comparisons from '../data/comparisons.json';

const topMotorInsurers = companies.filter(c => c.products.includes('car')).slice(0, 6);
const popularCars = carModels.filter(car => ['perodua-axia', 'perodua-myvi', 'proton-saga', 'toyota-vios', 'honda-city', 'honda-civic'].includes(car.slug));
const exampleModel = carModels.find((car) => car.slug === 'perodua-axia') ?? carModels[0];
const companyCount = companies.length;
// Hero lead figures read from the same data as the Axia and Myvi model pages.
const leadNum = (value: number) => value.toLocaleString('en-MY');
const leadAxia = carModels.find((car) => car.slug === 'perodua-axia')!;
const leadMyvi = carModels.find((car) => car.slug === 'perodua-myvi')!;
const leadSmall55 = `RM${leadNum(leadAxia.premiumNCD55Min)}–RM${leadNum(leadMyvi.premiumNCD55Max)}`;
const leadSmall0 = `RM${leadNum(leadAxia.premiumNCD0Min)}–RM${leadNum(leadMyvi.premiumNCD0Max)}`;
const carModelCount = carModels.length;
// Front-page picker: the most-searched models, in the concept's order. Figures come from car-models.json via carSteps.
const pickSlugs = ['perodua-myvi', 'perodua-axia', 'perodua-bezza', 'proton-saga', 'honda-city', 'toyota-vios', 'proton-x50', 'perodua-alza'];
const pickModels = pickSlugs.map((slug) => carModels.find((car) => car.slug === slug)).filter(Boolean);
const calculators = [
  { href: '/tools/ncd-calculator/', label: 'Kalkulator NCD', icon: 'i-peratus' },
  { href: '/tools/kalkulator-roadtax/', label: 'Kalkulator roadtax kereta', icon: 'i-roadtax' },
  { href: '/tools/kalkulator-roadtax-motosikal/', label: 'Kalkulator roadtax motosikal', icon: 'i-roadtax' },
  { href: '/tools/kalkulator-insurans-rumah/', label: 'Kalkulator insurans rumah', icon: 'i-utama' },
  { href: '/tools/kalkulator-coverage-nyawa/', label: 'Kalkulator coverage nyawa', icon: 'i-orang' },
];
const comparisonCount = comparisons.length;


const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Insurans.co",
  "url": "https://insurans.co",
  "description": "Panduan insurans Malaysia — ditulis untuk rakyat Malaysia yang nak faham insurans tanpa jargon.",
  "inLanguage": ["ms", "en"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Third-party je cukup ke, atau kena ambil comprehensive?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Third-party cuma cover kerosakan kereta orang lain. Kereta sendiri langsung tak dilindungi. Kalau kereta anda masih bernilai dan anda tak mampu bayar cash kalau accident, ambil comprehensive. Third-party sesuai untuk kereta lama yang nilai dah sangat rendah — contohnya kereta bawah RM10,000."
      }
    },
    {
      "@type": "Question",
      "name": "Boleh ke renew insurans kereta online?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Boleh, dan lagi senang dari pergi pejabat. Semak NCD dulu dengan Kalkulator NCD, lepas tu minta sebut harga terus daripada syarikat insurans, contohnya di etiqa.com.my (lihat senarai beli online di insurans.co/insurans-online/). Bayar online, dapat e-cover note terus, lepas tu renew roadtax di MyEG atau Pos Malaysia. Langkah penuh: cara renew insurans kereta online."
      }
    },
    {
      "@type": "Question",
      "name": "Apa jadi kalau NCD reset sebab claim?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Claim own damage biasa boleh menyebabkan NCD kembali kepada 0% pada renew seterusnya. Claim OD-KfK yang layak apabila pihak lain bersalah, dan claim windscreen di bawah add-on windscreen, tidak menjejaskan NCD. Kalau NCD anda 55%, premium tahun depan boleh naik RM1,000+. Sebab tu untuk calar kecil bawah RM1,000–RM2,000, sesetengah pemilik pilih bayar sendiri. Jangan agak-agak — kira dulu dengan Kalkulator NCD: masukkan premium asal, NCD semasa, dan kos repair, tool akan tunjuk sama ada berbaloi claim atau tidak."
      }
    },
    {
      "@type": "Question",
      "name": "Insurans dan takaful — sama ke beza?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Beza dari segi konsep. Takaful guna prinsip saling bantu-membantu (ta'awun) dan patuh Syariah. Lebihan dana dikongsi balik kepada peserta. Insurans konvensional — premium masuk syarikat, untung pun milik syarikat. Dari segi coverage dan proses claim, lebih kurang sama je. Kalau anda nak yang patuh Syariah, pilih takaful. Kalau tak kisah, pilih mana yang harga dan servis paling sesuai."
      }
    },
    {
      "@type": "Question",
      "name": "Apa tu \"agreed value\" dan \"market value\"?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Market value — syarikat bayar berdasarkan nilai kereta masa claim (kereta depreciate setiap tahun, so payout mungkin kurang dari yang dijangka). Agreed value — anda dan syarikat setuju satu jumlah tetap masa beli polisi. Premium agreed value lebih mahal, tapi anda tahu exactly berapa dapat kalau total loss. Untuk kereta baru atau kereta mahal, agreed value lagi selamat."
      }
    }
  ]
};
---

<Base
  title="Anggaran Harga Insurans Kereta Malaysia 2026"
  description={`Panduan insurans bebas, bukan ejen atau broker: anggaran harga insurans ${carModelCount} model kereta, kalkulator NCD & roadtax, perbandingan dan profil syarikat.`}
  schema={schema}
  pageType="home"
>
  <div class="ep hp">
    <div class="ep-main">
      <HomeAnswer h1="Harga Insurans Kereta Malaysia 2026" models={pickModels} initial={exampleModel.slug} allCount={carModelCount} />

      <!-- Who writes this, and how it is checked -->
      <section class="mod" aria-labelledby="tentang">
        <h2 class="mod-bar" id="tentang"><Ikon name="i-tanda" size={22} /> Bukan ejen. Bukan broker.</h2>
        <div class="mod-in">
          <p class="ix-s">
            Berapa patut anda bayar untuk insurans kereta? Harga insurans kereta di Malaysia untuk Axia/Myvi sekitar <strong class="numeric">{leadSmall55}</strong> setahun dengan NCD 55%, dan <span class="numeric">{leadSmall0}</span> tanpa NCD. Insurans.co bantu anda semak anggaran ikut 39 model, kira NCD, bandingkan 12 syarikat, dan renew online — tanpa jargon.
          </p>
          <div class="hp-by">
            <a href="/penulis/amir-ariff/" class="hp-by-img"><img src="/images/penulis/amir-ariff-colour-192.webp" alt="Amir Ariff" width="56" height="56" loading="lazy" decoding="async" /></a>
            <p>Oleh <a href="/penulis/amir-ariff/">Amir Ariff</a> · Pengasas &amp; Editor</p>
          </div>
          <p class="hp-trust" data-section="trust-strip">
            Disunting oleh Amir Ariff <span aria-hidden="true">·</span> Tiada affiliate atau tajaan <span aria-hidden="true">·</span>
            <a href="/kaedah-editorial/">Cara kami menyemak</a>
          </p>
          <EditorialStamp
            premiumReviewed={exampleModel.premiumReviewed}
            sources={exampleModel.sources}
          />
          <p class="ix-src">{carModelCount} model · {companyCount} syarikat · {comparisonCount} perbandingan · bebas daripada ejen dan broker.</p>
        </div>
      </section>

      <!-- Main actions -->
      <div class="hp-grid">
        <section class="mod" aria-labelledby="popular">
          <h2 class="mod-bar" id="popular"><Ikon name="i-kereta" size={22} /> Range premium ikut model: NCD 0% vs 55%</h2>
          <div class="mod-in">
            <p class="ix-s">Terus tengok range premium untuk Axia, Myvi, Saga, Vios, City dan model lain — termasuk NCD 0% vs 55%.</p>
            <a href="#harga-sebenar" class="hp-more">Lihat harga {popularCars.length} model popular di bawah <Ikon name="i-bawah" size={18} /></a>
            <a href="/car-insurance/" data-cta="card_car" class="hp-more">Bandingkan ikut model <Ikon name="i-kanan" size={18} /></a>
          </div>
        </section>

        <section class="mod" data-tint="pink" aria-labelledby="kalk-ncd">
          <h2 class="mod-bar" id="kalk-ncd"><Ikon name="i-kalkulator" size={22} /> Kira dulu “patut ke claim?” sebelum NCD reset</h2>
          <div class="mod-in">
            <p class="ix-s">Masukkan premium asal, pilih NCD level. Termasuk kira-kira “patut ke claim?” sebelum NCD reset.</p>
            <a href="/tools/ncd-calculator/" data-cta="card_ncd" class="ea-btn ea-btn-o">Kira NCD sekarang <Ikon name="i-kanan" size={20} /></a>
          </div>
        </section>

        <section class="mod" aria-labelledby="banding">
          <h2 class="mod-bar" id="banding"><Ikon name="i-neraca" size={22} /> {comparisonCount} perbandingan: harga dan claim line, head-to-head</h2>
          <div class="mod-in">
            <p class="ix-s">{comparisonCount} perbandingan head-to-head — Etiqa vs Allianz, Takaful vs konvensional, harga dan claim line.</p>
            <ul class="hp-links">
              <li><a href="/perbandingan/prudential-vs-aia/">Prudential vs AIA — mana medical card lagi power?</a></li>
              <li><a href="/perbandingan/etiqa-vs-zurich/">Etiqa vs Zurich — insurans kereta mana lagi murah?</a></li>
              <li><a href="/perbandingan/allianz-vs-zurich/">Allianz vs Zurich — coverage premium, mana berbaloi?</a></li>
            </ul>
            <a href="/perbandingan/" data-cta="card_compare" class="hp-more">Semua perbandingan <Ikon name="i-kanan" size={18} /></a>
          </div>
        </section>

        <section class="mod" aria-labelledby="takaful-q">
          <h2 class="mod-bar" id="takaful-q"><Ikon name="i-lindung" size={22} /> Takaful atau konvensional: coverage lebih kurang sama</h2>
          <div class="mod-in">
            <p class="ix-s">Coverage lebih kurang sama. Beza utama: takaful patuh Syariah, lebihan dana boleh dikongsi.</p>
            <a href="/takaful/" data-cta="card_takaful" class="hp-more">Baca tentang takaful <Ikon name="i-kanan" size={18} /></a>
          </div>
        </section>
      </div>

      <!-- Cara renew -->
      <section class="mod" data-section="renew" data-tint="sky" aria-labelledby="renew-h">
        <details class="hp-fold">
        <summary class="mod-bar"><h2 id="renew-h"><Ikon name="i-renew" size={22} /> Renew online dalam 4 langkah, tak perlu ke pejabat</h2><Ikon name="i-bawah" size={22} class="hp-fold-i" /></summary>
        <div class="mod-in">
          <p class="ix-s">Tak perlu pergi pejabat insurans. Semak NCD, bandingkan harga, bayar online, kemudian renew roadtax.</p>
          <ol class="hp-steps">
            <li>
              <h3>Semak NCD anda</h3>
              <p>Pergi <a href="https://www.myeg.com.my" target="_blank" rel="noopener">MyEG</a> atau check dengan ejen. Penting sebab NCD affect harga premium.</p>
            </li>
            <li>
              <h3>Dapatkan quotation</h3>
              <p>Minta sebut harga terus daripada dua atau tiga syarikat insurans untuk perlindungan yang sama (<a href="/insurans-online/#beli-terus">lihat senarai beli online</a>).</p>
            </li>
            <li>
              <h3>Bayar &amp; dapat e-cover note</h3>
              <p>Bayar online (FPX, kad kredit). E-cover note terus masuk email. Simpan PDF tu.</p>
            </li>
            <li>
              <h3>Renew roadtax</h3>
              <p>Boleh renew di JPJ, MyEG, Pos Malaysia, atau kaunter di shopping mall.</p>
            </li>
          </ol>
        </div>
        </details>
      </section>

      <CtaBand
        trackingSection="renew"
        heading="Minta sebut harga terus daripada syarikat insurans"
        body="Kira NCD dahulu, kemudian semak senarai syarikat yang menjual insurans kereta secara online di laman rasmi mereka."
        primary={{ label: 'Lihat senarai beli online →', href: '/insurans-online/#beli-terus' }}
        disclosure="Tiada hubungan berbayar atau affiliate dengan mana-mana syarikat. Pembelian polisi dibuat di laman syarikat, bukan di Insurans.co."
      />

      <!-- Company directory -->
      <section class="mod" aria-labelledby="syarikat">
        <details class="hp-fold">
        <summary class="mod-bar"><h2 id="syarikat"><Ikon name="i-dokumen" size={22} /> Senarai syarikat insurans motor, bukan ranking</h2><Ikon name="i-bawah" size={22} class="hp-fold-i" /></summary>
        <div class="mod-in">
          <p class="ix-s">Senarai syarikat, bukan ranking — baca profil setiap syarikat.</p>
          <ul class="hp-co">
            {topMotorInsurers.map((company) => (
              <li>
                <h3>
                  <a href={`/companies/${company.slug}/`}>{company.name}</a>
                  {company.takaful && <span class="hp-tag">Takaful</span>}
                </h3>
                <p>{company.verdictBM}</p>
                {company.claimLine && <p class="hp-co-c">Claim: {company.claimLine}</p>}
              </li>
            ))}
          </ul>
          <a href="/companies/" class="hp-more">Semua syarikat <Ikon name="i-kanan" size={18} /></a>
        </div>
        </details>
      </section>

      <!-- Harga sebenar -->
      <section class="mod" aria-labelledby="harga-sebenar">
        <h2 class="mod-bar" id="harga-sebenar"><Ikon name="i-harga" size={22} /> Anggaran comprehensive setahun: {popularCars.length} model popular</h2>
        <div class="mod-in">
          <p class="ix-s">
            Kami compile anggaran harga untuk kereta-kereta popular di Malaysia.
            Harga di bawah adalah untuk polisi comprehensive setahun.
          </p>
          <ul class="hp-cars numeric">
            {popularCars.map(car => (
              <li>
                <a href={`/car-insurance/${car.slug}/`}>
                  <span class="hp-car-n">{car.fullName}</span>
                  <span class="hp-car-m">Harga pasaran: {car.marketValueRange}</span>
                  <span class="hp-car-l">NCD 55%</span>
                  <span class="hp-car-p">{car.premiumNCD55}</span>
                  <span class="hp-car-z">NCD 0%: {car.premiumNCD0}</span>
                  <span class="hp-car-go">Bandingkan syarikat <Ikon name="i-kanan" size={18} /></span>
                </a>
              </li>
            ))}
          </ul>
          <p class="ix-src">
            Nota: Harga di atas adalah anggaran untuk tahun 2026. Harga sebenar bergantung pada
            umur kereta, lokasi, rekod pemanduan, dan syarikat insurans yang dipilih.
            Selepas liberalisasi tarif motor 2017, setiap syarikat boleh set harga sendiri.
          </p>
        </div>
      </section>

      <!-- FAQ -->
      <section class="mod" aria-labelledby="soalan">
        <h2 class="mod-bar" id="soalan"><Ikon name="i-info" size={22} /> Insurans kereta wajib: minimum third-party</h2>
        <div class="mod-in hp-faq">
      <details class="faq-item" open>
        <summary>Wajib ke beli insurans kereta?</summary>
        <p>
          Ya, memang wajib. Minimum kena ada <strong>third-party insurance</strong>. Tanpa insurans yang sah,
          anda tak boleh renew roadtax. Kalau kena tangkap polis memandu tanpa insurans,
          boleh kena denda sehingga <strong>RM1,000</strong> atau penjara sehingga 3 bulan.
          Ini bukan optional — memang dalam Road Transport Act 1987.
        </p>
      </details>

      <details class="faq-item">
        <summary>Third-party je cukup ke, atau kena ambil comprehensive?</summary>
        <p>
          Third-party cuma cover kerosakan kereta <em>orang lain</em>. Kereta sendiri langsung tak dilindungi.
          Kalau kereta anda masih bernilai dan anda tak mampu bayar cash kalau accident, ambil <strong>comprehensive</strong>.
          Third-party sesuai untuk kereta lama yang nilai dah sangat rendah — contohnya kereta bawah RM10,000.
        </p>
      </details>

      <details class="faq-item">
        <summary>Boleh ke renew insurans kereta online?</summary>
        <p>
          Boleh, dan lagi senang dari pergi pejabat. Semak NCD dulu dengan <a href="/tools/ncd-calculator/">Kalkulator NCD</a>, lepas tu minta sebut harga terus daripada syarikat insurans, contohnya di etiqa.com.my
          (<a href="/insurans-online/#beli-terus">lihat senarai beli online</a>).
          Bayar online, dapat e-cover note terus, lepas tu renew roadtax di MyEG atau Pos Malaysia. Langkah penuh:
          <a href="/guides/renew-car-insurance/">cara renew insurans kereta online</a>.
        </p>
      </details>

      <details class="faq-item">
        <summary>Apa jadi kalau NCD reset sebab claim?</summary>
        <p>
          Claim own damage biasa boleh menyebabkan NCD kembali kepada <strong>0%</strong> pada renew seterusnya. Claim OD-KfK yang layak apabila pihak lain bersalah, dan claim windscreen di bawah add-on windscreen, tidak menjejaskan NCD. Kalau NCD anda 55%, premium tahun depan boleh naik RM1,000+.
          Sebab tu untuk calar kecil bawah RM1,000–RM2,000, sesetengah pemilik pilih bayar sendiri. Jangan agak-agak — kira dulu dengan
          <a href="/tools/ncd-calculator/">Kalkulator NCD</a>: masukkan premium asal, NCD semasa, dan kos repair, tool akan tunjuk sama ada berbaloi claim atau tidak.
        </p>
      </details>

      <details class="faq-item">
        <summary>Insurans dan takaful — sama ke beza?</summary>
        <p>
          Beza dari segi konsep. <strong>Takaful</strong> guna prinsip saling bantu-membantu (ta'awun) dan patuh Syariah.
          Lebihan dana dikongsi balik kepada peserta. <strong>Insurans konvensional</strong> — premium masuk syarikat,
          untung pun milik syarikat. Dari segi coverage dan proses claim, lebih kurang sama je.
          Kalau anda nak yang patuh Syariah, pilih takaful. Kalau tak kisah, pilih mana yang harga dan servis paling sesuai.
        </p>
      </details>

      <details class="faq-item">
        <summary>Apa tu "agreed value" dan "market value"?</summary>
        <p>
          <strong>Market value</strong> — syarikat bayar berdasarkan nilai kereta masa claim (kereta depreciate setiap tahun,
          so payout mungkin kurang dari yang dijangka). <strong>Agreed value</strong> — anda dan syarikat setuju satu jumlah
          tetap masa beli polisi. Premium agreed value lebih mahal, tapi anda tahu exactly berapa dapat kalau total loss.
          Untuk kereta baru atau kereta mahal, agreed value lagi selamat.
        </p>
      </details>
        </div>
      </section>

      <!-- Other verticals -->
      <section class="mod" aria-labelledby="jenis">
        <h2 class="mod-bar" id="jenis"><Ikon name="i-lindung" size={22} /> Selain kereta: kesihatan, nyawa, rumah dan lain-lain</h2>
        <div class="mod-in">
          <ul class="hp-vert">
            <li><a href="/car-insurance/"><Ikon name="i-kereta" size={24} /><b>Insurans Kereta</b><span>Motor & motosikal</span></a></li>
            <li><a href="/health-insurance/"><Ikon name="i-tambah" size={24} /><b>Insurans Kesihatan</b><span>Medical card</span></a></li>
            <li><a href="/medical-cards/"><Ikon name="i-resit" size={24} /><b>Medical Card</b><span>Pelan hospital</span></a></li>
            <li><a href="/life-insurance/"><Ikon name="i-orang" size={24} /><b>Insurans Nyawa</b><span>Life & investment-linked</span></a></li>
            <li><a href="/personal-accident/"><Ikon name="i-kemalangan" size={24} /><b>Insurans Kemalangan Diri</b><span>Perlindungan kemalangan</span></a></li>
            <li><a href="/takaful/"><Ikon name="i-lindung" size={24} /><b>Takaful</b><span>Patuh Syariah</span></a></li>
            <li><a href="/critical-illness/"><Ikon name="i-amaran" size={24} /><b>Penyakit Kritikal</b><span>Critical illness</span></a></li>
            <li><a href="/bantuan-insurans/"><Ikon name="i-dompet" size={24} /><b>Bantuan &amp; EPF</b><span>mySalam, i-Lindung, Tenang</span></a></li>
            <li><a href="/travel-insurance/"><Ikon name="i-luar" size={24} /><b>Insurans Perjalanan</b><span>Travel insurance</span></a></li>
            <li><a href="/insurans-online/"><Ikon name="i-cari" size={24} /><b>Insurans Online</b><span>Banding & beli online</span></a></li>
            <li><a href="/home-insurance/"><Ikon name="i-utama" size={24} /><b>Insurans Rumah</b><span>Fire, houseowner & householder</span></a></li>
            <li><a href="/motorcycle-insurance/"><Ikon name="i-tayar" size={24} /><b>Insurans Motosikal</b><span>Roadtax & coverage</span></a></li>
          </ul>
        </div>
      </section>
    </div>

    <aside class="ep-tools" aria-label="Alat">
      <ToolsRail model={exampleModel} related={[]} calculatorUrl={`/tools/ncd-calculator/?model=${exampleModel.slug}`} hooks />
      <nav class="mod" aria-labelledby="kalkulator">
        <h2 class="mod-bar" id="kalkulator"><Ikon name="i-kalkulator" size={22} /> {calculators.length} kalkulator: NCD, roadtax, rumah, nyawa</h2>
        <ul class="hp-calc">
          {calculators.map((c) => (
            <li><a href={c.href}><Ikon name={c.icon} size={22} /><span>{c.label}</span></a></li>
          ))}
          <li><a href="/tools/"><Ikon name="i-kanan" size={22} /><span>Semua alat</span></a></li>
        </ul>
      </nav>
    </aside>

    <div class="ep-models">
      <ModelRail current="" />
    </div>
  </div>

  {/* Inject FAQ schema separately */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>

<style>
  .hp-grid { display: grid; gap: 1.25rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 64rem) { .hp-grid { grid-template-columns: 1fr 1fr; } }
  .hp-by { display: flex; align-items: center; gap: 0.75rem; }
  .hp-by-img { flex: none; display: block; border-radius: 50%; }
