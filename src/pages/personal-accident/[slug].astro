---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import personalAccident from '../../data/personal-accident.json';
import { buildDescription, buildTitle } from '../../lib/seo';

type PersonalAccidentRecord = (typeof personalAccident.records)[number];

const records = personalAccident.records;
const typeLabels: Record<string, string> = {
  'personal-accident': 'PA konvensional',
  'personal-accident-takaful': 'PA takaful',
};

export function getStaticPaths() {
  return personalAccident.records.map((record) => ({
    params: { slug: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props as { record: PersonalAccidentRecord };
const canonicalUrl = `https://insurans.co/personal-accident/${record.slug}/`;
const typeLabel = typeLabels[record.type] ?? record.type;
const relatedRecords = records.filter((candidate) => candidate.slug !== record.slug).slice(0, 4);
const sourceLabel = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const sourceLinks = record.sources.map((url) => ({
  label: sourceLabel(url),
  url,
}));
const displayValue = (value: string | null, emptyLabel = 'Tidak dinyatakan dalam sumber yang dibaca') => value ?? emptyLabel;
const specItems = [
  { label: 'Jenis pelan', value: typeLabel },
  { label: 'Cover utama', value: displayValue(record.coversWhat) },
  { label: 'Pelan & manfaat', value: displayValue(record.plansAndBenefits) },
  { label: 'Umur masuk', value: displayValue(record.entryAge) },
  { label: 'Premium diterbitkan', value: displayValue(record.premiumPublished, 'Tidak diterbitkan dalam sumber yang dibaca') },
].filter((item) => item.value);
const isPdsExample = record.premiumPublished?.startsWith('Contoh PDS') ?? false;
const pageTitle = `${record.planName} — PA`;
const description = buildDescription(
  `Data ${record.planName} oleh ${record.insurer}: cover AD dan PPD, manfaat, umur masuk, harga yang diterbitkan jika ada, serta sumber rasmi.`,
);
const figureNote = record.figureVerified
  ? 'Angka yang dipaparkan datang daripada sumber rasmi yang disenaraikan dan dikekalkan bersama qualifier asal.'
  : 'Nota ketelusan: sumber yang dibaca tidak dapat mengesahkan butiran angka atau manfaat. Perlindungan, pelan/manfaat, umur masuk dan premium tidak dinyatakan; tiada angka direka untuk halaman ini.';

const typeFaqAnswer =
  record.type === 'personal-accident-takaful'
    ? 'Rekod ini dikategorikan sebagai PA takaful, iaitu perlindungan melalui sijil takaful. Semak manfaat, pengecualian dan caruman dalam sijil serta PDS terkini.'
    : 'Rekod ini dikategorikan sebagai PA konvensional, iaitu perlindungan melalui polisi insurans. Semak manfaat, pengecualian dan premium dalam polisi serta PDS terkini.';
const coverFaqAnswer = record.coversWhat
  ? `Sumber yang dibaca menyenaraikan: ${record.coversWhat}. Senarai ringkas ini tidak menggantikan definisi, jadual PPD atau pengecualian dalam PDS.`
  : 'Sumber yang dibaca tidak dapat mengesahkan cover utama untuk rekod ini. Jangan anggap nama produk sahaja membuktikan manfaat; minta PDS atau wording rasmi yang boleh dibaca.';
const priceFaqAnswer = record.premiumPublished
  ? isPdsExample
    ? `Sumber menerbitkan contoh berikut, bukan harga jualan umum: ${record.premiumPublished}. Premium sebenar bergantung pada terma quotation dan maklumat insured.`
    : `Harga yang diterbitkan dalam sumber ialah: ${record.premiumPublished}. Ini bukan anggaran atau quotation individu; qualifier seperti kelas pekerjaan, SST dan setem perlu dikekalkan.`
  : 'Sumber yang dibaca tidak menerbitkan harga premium untuk rekod ini. Tiada harga dianggar; semak quotation rasmi dan PDS jika saluran pembelian tersedia.';
const ageFaqAnswer = record.entryAge
  ? `Rekod ini menyatakan: ${record.entryAge}. Sahkan umur, status penduduk atau permit kerja dan syarat pembaharuan dalam dokumen semasa.`
  : 'Umur masuk tidak dinyatakan dalam sumber yang dibaca. Jangan pinjam had umur daripada pelan lain; semak PDS atau quotation rasmi produk ini.';
const faqs = [
  {
    q: `${record.planName} ini PA konvensional atau takaful?`,
    a: typeFaqAnswer,
  },
  {
    q: `Apa yang dilindungi oleh ${record.planName}?`,
    a: coverFaqAnswer,
  },
  {
    q: `Berapa harga ${record.planName}?`,
    a: priceFaqAnswer,
  },
  {
    q: `Siapa boleh masuk ${record.planName}?`,
    a: ageFaqAnswer,
  },
  {
    q: `Adakah ${record.planName} ada waiting period?`,
    a: 'Sumber yang dibaca untuk rekod ini tidak menyatakan satu waiting period yang boleh disahkan. Jangan anggap ia automatik tiada; semak tarikh kuat kuasa, tempoh menunggu jika ada dan pengecualian dalam PDS atau wording polisi.',
  },
  {
    q: `Adakah angka ${record.planName} telah disahkan?`,
    a: record.figureVerified
      ? 'Ya. Angka yang dipaparkan datang daripada sumber rasmi yang disenaraikan pada halaman ini dan tidak dipuratakan atau dikira semula.'
      : 'Tidak. Sumber rasmi yang dibaca tidak dapat memberikan butiran yang boleh disahkan, jadi medan angka dan manfaat dikekalkan null dan tidak dipaparkan sebagai fakta.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: record.asAt,
  dateModified: record.asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Kemalangan Diri', item: 'https://insurans.co/personal-accident/' },
      { '@type': 'ListItem', position: 3, name: record.planName, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={buildTitle(pageTitle)}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={record.asAt}
  modifiedTime={record.asAt}
>
  <Hero title={`Insurans kemalangan diri: ${record.planName}`}>
    <Byline slot="byline" dateModified={record.asAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Insurans Kemalangan Diri', href: '/personal-accident/' },
        { label: record.planName },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      Data ringkas {record.planName} oleh {record.insurer}, berdasarkan sumber rasmi yang dibaca pada {record.asAt}. Harga hanya dipaparkan apabila diterbitkan oleh sumber.
    </p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="label">Personal accident</p>
          <h2 class="mt-2 font-serif text-headline-sm text-stone-900">{record.planName}</h2>
          <p class="mt-1 text-sm leading-5 text-stone-600">{record.insurer}</p>
        </div>
        <span class="inline-flex w-fit border border-hijau-700 bg-hijau-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-hijau-800">
          {typeLabel}
        </span>
      </div>

      <h2 class="mt-7 font-serif text-headline-sm text-stone-900">Ringkasan rekod</h2>
      <dl class="mt-4 space-y-3 text-sm">
        {specItems.map((spec) => (
          <div class="border-t border-stone-200 pt-3 first:border-t-0 first:pt-0">
            <dt class="text-stone-500">{spec.label}</dt>
            <dd class="mt-1 font-semibold leading-5 text-stone-900">{spec.value}</dd>
          </div>
        ))}
      </dl>
      <p class={`mt-5 border-t pt-4 text-sm leading-5 ${record.figureVerified ? 'border-stone-200 text-stone-600' : 'border-emas-200 text-emas-800'}`}>
        {figureNote}
      </p>
    </div>

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={record.asAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial">
        <p class="text-lg text-stone-700">
          Halaman ini merumuskan maklumat {record.planName} yang dapat dibaca dalam sumber rasmi. PA merujuk perlindungan kemalangan diri seperti AD dan PPD mengikut definisi polisi; ia bukan pengganti medical card dan bukan perlindungan automatik untuk sakit biasa.
        </p>

        <h2 id="butiran">Apa yang dinyatakan dalam sumber?</h2>
        {record.coversWhat ? (
          <p>{record.coversWhat}. Semak definisi setiap manfaat, jadual hilang upaya, had, pengecualian dan dokumen tuntutan dalam PDS atau wording sebenar.</p>
        ) : (
          <p>Sumber yang dibaca tidak dapat mengesahkan manfaat untuk rekod ini. Nama produk dan URL sumber sahaja tidak cukup untuk mengisi butiran cover atau had.</p>
        )}
        {record.plansAndBenefits && <p><strong>Pelan &amp; manfaat yang direkodkan:</strong> {record.plansAndBenefits}.</p>}

        {record.premiumPublished ? (
          <>
            <h2 id="harga">{isPdsExample ? 'Contoh premium dalam PDS — bukan harga jualan umum' : 'Harga yang diterbitkan'}</h2>
            <p>
              {isPdsExample ? 'Sumber rasmi memberi contoh pengiraan berikut. Ia bukan harga jualan umum dan tidak boleh dianggap quotation individu.' : 'Harga ini disalin daripada sumber rasmi bersama qualifier asal. Jangan tukar senarai atau harga rata ini menjadi purata, julat baharu atau quotation.'}
            </p>
            <div class="border-2 border-stone-900 bg-krim-100 p-5 sm:p-6">
              <p class="text-lg leading-7 font-semibold text-stone-900">{record.premiumPublished}</p>
              <p class="mt-3 text-sm leading-5 text-stone-600">Sumber dan tarikh rujukan: {record.sources.map((url, index) => (
                <span>
                  {index > 0 && <span aria-hidden="true"> · </span>}
                  <a href={url} class="text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">{sourceLabel(url)}</a>
                </span>
              ))} · {record.asAt}</p>
            </div>
          </>
        ) : (
          <>
            <h2 id="harga">Harga premium</h2>
            <p class="border border-stone-200 bg-stone-50 p-4 text-stone-700">
              Harga premium tidak diterbitkan atau tidak dapat disahkan dalam sumber yang dibaca untuk rekod ini. Tiada angka diisi sebagai ganti.
            </p>
          </>
        )}

        <h2 id="baca-pds">Cara membaca rekod PA ini</h2>
        <p>
          Gunakan ringkasan sebagai indeks, bukan pengganti PDS atau polisi. Semak siapa yang diinsuranskan, umur dan pekerjaan yang layak, tarikh kuat kuasa, jadual PPD, had manfaat, pengecualian, pembaharuan, SST atau setem serta langkah tuntutan. Angka yang tidak dinyatakan kekal tidak dinyatakan.
        </p>
      </article>

      <section id="faq">
        <div class="prose-editorial">
          <h2>Soalan lazim — {record.planName}</h2>
        </div>
        <div class="mt-5">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      {relatedRecords.length > 0 && (
        <section id="related">
          <div class="prose-editorial">
            <h2>Pelan PA dalam set data</h2>
            <p>Rekod lain di hub ini dipaparkan untuk rujukan silang. Setiap harga mengekalkan sumber dan qualifier sendiri.</p>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {relatedRecords.map((related) => (
              <a href={`/personal-accident/${related.slug}/`} class="card-editorial group block">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <h3 class="font-semibold text-stone-900 group-hover:text-hijau-700">{related.planName}</h3>
                    <p class="mt-1 text-sm text-stone-600">{related.insurer}</p>
                  </div>
                  <span class="shrink-0 border border-stone-300 px-2 py-1 text-xs font-semibold text-stone-600">
                    {typeLabels[related.type] ?? related.type}
                  </span>
                </div>
                {related.premiumPublished ? (
                  <p class="mt-4 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-700">{related.premiumPublished}</p>
                ) : (
                  <p class="mt-4 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">Harga dan manfaat tidak diterbitkan dalam sumber yang dibaca.</p>
                )}
                <span class="mt-4 inline-block text-sm font-semibold text-hijau-700">Lihat butiran →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <CtaBand
        heading={`Semak sumber rasmi ${record.planName}`}
        body="Gunakan sumber rasmi untuk membaca PDS, semak quotation dan sahkan syarat sebelum membeli. Insurans.co tidak menjual polisi."
        primary={{ label: 'Kembali ke hub PA →', href: '/personal-accident/' }}
        outbound={record.sources.map((url) => ({
          label: `Sumber ${sourceLabel(url)}`,
          href: url,
          relationship: 'unpaid' as const,
        }))}
        disclosure="Pautan luar di bawah ialah rujukan rasmi tanpa hubungan berbayar atau affiliate. Harga dan kelayakan boleh berubah; semak dokumen penyedia sebelum bertindak."
        trackingSection="personal-accident-source-cta"
      />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
