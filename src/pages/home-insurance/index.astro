---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import homeInsurance from '../../data/home-insurance.json';
import { buildDescription, buildTitle } from '../../lib/seo';

const records = homeInsurance.records;
const tariff = homeInsurance.tariff;
const typeOrder = [
  'houseowner-householder',
  'houseowner-householder-takaful',
  'houseowner-comprehensive',
  'modular-houseowner-householder',
];
const typeLabels: Record<string, string> = {
  'houseowner-householder': 'Houseowner / Householder',
  'houseowner-householder-takaful': 'Houseowner / Householder takaful',
  'houseowner-comprehensive': 'Houseowner komprehensif',
  'modular-houseowner-householder': 'Modular house cover',
};
const typeDescriptions: Record<string, string> = {
  'houseowner-householder': 'Perlindungan bangunan dan/atau isi rumah dengan kadar yang direkodkan daripada sumber rasmi.',
  'houseowner-householder-takaful': 'Perlindungan bangunan dan isi rumah berasaskan takaful.',
  'houseowner-comprehensive': 'Pakej houseowner dengan struktur dan tempoh produk tersendiri.',
  'modular-houseowner-householder': 'Produk modular; butiran kadar dan manfaat perlu disahkan dalam PDS.',
};
const recordGroups = typeOrder
  .map((type) => ({
    type,
    label: typeLabels[type],
    description: typeDescriptions[type],
    records: records.filter((record) => record.type === type),
  }))
  .filter((group) => group.records.length > 0);

const formatRate = (rate: number) => `${rate.toFixed(3)}%`;
const premiumFor = (sumInsured: number, rate: number) => sumInsured * (rate / 100);
const workedSumInsured = 100000;
const workedExample = {
  landed: premiumFor(workedSumInsured, tariff.ho_landed_1A),
  flat: premiumFor(workedSumInsured, tariff.ho_flat_1A),
  contents: premiumFor(workedSumInsured, tariff.hh_1A),
};
const sourceLinks = records.flatMap((record) =>
  record.sources.map((url) => ({
    label: new URL(url).hostname.replace(/^www\./, ''),
    url,
  })),
);

const faqs = [
  {
    q: 'LPPSA perlu insurans rumah atau takaful?',
    a: 'Untuk pembiayaan LPPSA, semak surat tawaran dan syarat pembiayaan kerana perlindungan yang diperlukan boleh berupa insurans atau takaful yang ditetapkan. Perlindungan pembiayaan tidak semestinya melindungi semua isi rumah; semak skop polisi atau sijil serta keperluan LPPSA yang semasa.',
  },
  {
    q: 'Apa beza MRTT dan MLTT dengan insurans rumah?',
    a: 'MRTT dan MLTT ialah perlindungan berkaitan pinjaman yang membantu menyelesaikan baki pembiayaan apabila peristiwa yang dilindungi berlaku. Insurans rumah pula melindungi bangunan, isi rumah atau risiko harta mengikut polisi. Satu tidak menggantikan yang lain; semak manfaat dan pemilik perlindungan dalam dokumen anda.',
  },
  {
    q: 'Lepas habis bayar loan, insurans rumah masih perlu ke?',
    a: 'Selepas pinjaman selesai, keperluan bank terhadap fire insurance mungkin berakhir, tetapi risiko kepada bangunan dan isi rumah masih ada. Teruskan hanya selepas menyemak skop yang diperlukan, jumlah diinsuranskan, pengecualian dan kos pembaharuan; bank bukan lagi pihak yang menetapkan perlindungan anda.',
  },
  {
    q: 'Banjir covered dalam insurans rumah?',
    a: 'Jangan anggap banjir dilindungi oleh fire-only asas. Dalam rekod houseowner atau householder yang kadar atau manfaatnya disahkan, banjir dinyatakan untuk sesetengah produk, tetapi wording, pengecualian dan syarat tuntutan tetap berbeza. Semak PDS atau polisi sebelum menganggap banjir covered.',
  },
  {
    q: 'Berapa harga insurans rumah untuk jumlah diinsuranskan RM100,000?',
    a: `Sebagai ilustrasi kadar tariff 1A: RM100,000 × ${formatRate(tariff.ho_landed_1A)} untuk houseowner landed = RM${workedExample.landed.toFixed(0)} setahun; rumah flat pada ${formatRate(tariff.ho_flat_1A)} = RM${workedExample.flat.toFixed(0)}; householder pada ${formatRate(tariff.hh_1A)} = RM${workedExample.contents.toFixed(0)}. Premium sebenar masih tertakluk pada skop, minimum premium RM${tariff.minPremium} dan setem RM${tariff.stamp}.`,
  },
  {
    q: 'Bagaimana pengiraan premium insurans rumah dibuat?',
    a: `Asasnya ialah kadar × jumlah diinsuranskan untuk skop yang dipilih, kemudian semak minimum premium RM${tariff.minPremium} dan setem RM${tariff.stamp}. Jumlah diinsuranskan houseowner patut berpandukan kos pembinaan semula, bukan harga tanah; gunakan PIAM Building Cost Calculator di bcc.piam.org.my sebagai rujukan dan sahkan nilai serta wording dengan penyedia.`,
  },
];

const pageTitle = 'Insurans Rumah Malaysia 2026';
const description = buildDescription(
  'Panduan insurans rumah Malaysia: houseowner, householder, fire-only, kadar tariff, contoh RM100,000, LPPSA, banjir dan rekod sumber rasmi.',
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: 'https://insurans.co/home-insurance/',
  datePublished: homeInsurance.asAt,
  dateModified: homeInsurance.asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Rumah', item: 'https://insurans.co/home-insurance/' },
    ],
  },
};
---

<Base
  title={buildTitle(pageTitle)}
  description={description}
  canonical="https://insurans.co/home-insurance/"
  schema={schema}
  ogType="article"
  publishedTime={homeInsurance.asAt}
  modifiedTime={homeInsurance.asAt}
>
  <section class="border-b border-stone-200 bg-white">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { label: 'Utama', href: '/' },
          { label: 'Insurans Rumah' },
        ]}
      />
      <p class="label mb-3">Panduan Data</p>
      <h1 class="mb-4 font-serif text-headline-lg text-stone-900 sm:text-headline-xl">Insurans Rumah Malaysia 2026</h1>
      <Byline dateModified={homeInsurance.asAt} />
      <p class="mt-4 max-w-2xl text-lg leading-7 text-stone-600">
        Fahami beza houseowner, householder dan fire-only; semak kadar tariff yang dapat disahkan, asas jumlah diinsuranskan
        dan rekod produk sebelum mendapatkan quotation.
      </p>
      <div class="mt-6 max-w-3xl">
        <EditorialStamp
          articleDate={homeInsurance.asAt}
          sources={sourceLinks}
          sourcesLabel="Sumber kadar dan produk"
          showReviewed={false}
        />
      </div>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div class="lg:col-span-2">
        <article class="prose-editorial">
          <p class="text-lg leading-7 text-stone-700">
            Rumah memerlukan dua soalan berasingan: apa yang hendak dilindungi, dan berapa jumlah yang patut diinsuranskan.
            Fire-only biasanya menjawab keperluan asas bangunan untuk pembiayaan; houseowner merujuk bangunan, manakala
            householder merujuk isi rumah. Skop sebenar tetap bergantung pada polisi atau sijil dan PDS terkini.
          </p>
          <p>
            {homeInsurance.methodologyNote}
          </p>

          <h2 id="apa-itu">Apa itu insurans rumah? Houseowner, householder dan fire-only</h2>
          <p>
            <strong>Houseowner</strong> ialah perlindungan bangunan dan komponen tetap yang dinyatakan dalam polisi. Ia boleh
            merangkumi risiko seperti kebakaran, paip pecah, ribut atau banjir jika skop produk dan wording memasukkannya.
            <strong>Householder</strong> pula merujuk isi rumah seperti perabot, peralatan dan barang peribadi, dengan had khas
            bagi sesetengah kategori.
          </p>
          <p>
            <strong>Fire-only</strong> ialah perlindungan asas yang lazimnya tertumpu pada kebakaran, kilat dan letupan
            domestik. Jangan anggap ia melindungi isi rumah, banjir atau pecah masuk tanpa wording yang jelas. Untuk flat atau
            condo, semak juga skop strata dan bahagian yang menjadi tanggungjawab pemilik unit.
          </p>

          <h2 id="kadar-tariff">Kadar premium tariff</h2>
          <p>
            Kadar asas yang direkodkan di bawah ialah peratus setahun daripada jumlah diinsuranskan. Kelas pembinaan 1A
            menggunakan kadar berasingan untuk rumah landed dan flat; 1B ialah kelas pembinaan partly brick. Ini bukan quotation
            individu.
          </p>
        </article>

        <div class="mt-6 overflow-x-auto">
          <table class="table-editorial">
            <caption class="caption-top pb-3 text-left text-sm leading-5 text-stone-600">
              Kadar houseowner dan householder yang direkodkan daripada sumber rasmi
            </caption>
            <thead>
              <tr>
                <th scope="col">Perlindungan</th>
                <th scope="col">1A landed</th>
                <th scope="col">1A flat</th>
                <th scope="col">1B landed</th>
                <th scope="col">1B flat</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row" class="font-medium text-stone-900">Houseowner</th>
                <td class="font-semibold text-hijau-700">{formatRate(tariff.ho_landed_1A)}</td>
                <td class="font-semibold text-hijau-700">{formatRate(tariff.ho_flat_1A)}</td>
                <td class="font-semibold text-hijau-700">{formatRate(tariff.ho_landed_1B)}</td>
                <td class="font-semibold text-hijau-700">{formatRate(tariff.ho_flat_1B)}</td>
              </tr>
              <tr>
                <th scope="row" class="font-medium text-stone-900">Householder</th>
                <td class="font-semibold text-hijau-700">{formatRate(tariff.hh_1A)}</td>
                <td class="font-semibold text-hijau-700">{formatRate(tariff.hh_1A)}</td>
                <td class="font-semibold text-hijau-700">{formatRate(tariff.hh_1B)}</td>
                <td class="font-semibold text-hijau-700">{formatRate(tariff.hh_1B)}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="info-box mt-6">
          <p class="text-sm leading-5 text-stone-700">
            <strong>Contoh RM100,000, kadar 1A:</strong> houseowner landed pada {formatRate(tariff.ho_landed_1A)} =
            <strong>RM{workedExample.landed.toFixed(0)}</strong> setahun; houseowner flat pada {formatRate(tariff.ho_flat_1A)} =
            <strong>RM{workedExample.flat.toFixed(0)}</strong>; householder pada {formatRate(tariff.hh_1A)} =
            <strong>RM{workedExample.contents.toFixed(0)}</strong>. Semak juga minimum premium RM{tariff.minPremium} dan setem
            RM{tariff.stamp}.
          </p>
        </div>

        <div class="mt-8">
          <CtaBand
            heading="Kalkulator insurans rumah"
            body="Gunakan kalkulator dalaman untuk memasukkan jumlah diinsuranskan dan melihat asas pengiraan. Ia bukan quotation daripada insurer. Untuk anggaran kos pembinaan semula, PIAM Building Cost Calculator ialah rujukan berasingan."
            primary={{ label: 'Buka kalkulator insurans rumah →', href: '/tools/kalkulator-insurans-rumah/' }}
            outbound={[
              {
                label: 'PIAM Building Cost Calculator (rujukan)',
                href: 'https://bcc.piam.org.my/',
                relationship: 'unpaid',
              },
            ]}
            disclosure="Semak jumlah diinsuranskan, skop dan wording dengan penyedia sebelum membeli. Pautan PIAM di atas ialah rujukan kos pembinaan semula, bukan pengesyoran atau quotation."
          />
        </div>

        <article class="prose-editorial mt-10 sm:mt-14">
          <h2 id="lppsa">LPPSA dan MRTT/MLTT</h2>
          <p>
            Jika pembiayaan anda melalui LPPSA, rujuk surat tawaran dan syarat pembiayaan untuk jenis perlindungan yang
            diperlukan. Keperluan pembiayaan dan perlindungan harta bukan perkara yang sama: dokumen pembiayaan mungkin
            menetapkan saluran insurans atau takaful, tetapi skop polisi tetap perlu dibaca.
          </p>
          <p>
            MRTT ialah perlindungan berkaitan pinjaman dengan jumlah perlindungan yang biasanya mengikuti baki pembiayaan,
            manakala MLTT biasanya mengekalkan jumlah perlindungan yang ditetapkan mengikut struktur pelan. Kedua-duanya
            berkaitan kematian atau hilang upaya seperti yang ditakrifkan dalam dokumen masing-masing; ia bukan pengganti
            perlindungan bangunan atau isi rumah.
          </p>
          <p>
            Selepas loan selesai, semak semula siapa yang memerlukan perlindungan, jumlah diinsuranskan dan risiko lokasi.
            Fire-only, houseowner dan householder mempunyai skop yang berbeza walaupun semuanya disebut sebagai insurans rumah.
          </p>

          <h2 id="senarai-produk">Senarai produk insurans rumah</h2>
          <p>
            Rekod di bawah disusun mengikut jenis produk. Kad yang bertanda angka disahkan memaparkan maklumat yang dapat
            dikesan kepada sumber rasmi pada tarikh semakan; rekod nama sahaja tidak memaparkan kadar atau had yang belum
            disahkan.
          </p>
        </article>

        <div class="mt-8 space-y-10 sm:mt-10">
          {recordGroups.map((group) => (
            <section id={group.type}>
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div>
                  <h3 class="font-serif text-headline-md text-stone-900">{group.label}</h3>
                  <p class="mt-1 text-sm text-stone-600">{group.description}</p>
                </div>
                <span class="text-sm text-stone-500">{group.records.length} rekod</span>
              </div>

              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {group.records.map((record) => (
                  <a href={`/home-insurance/${record.slug}/`} class="card-editorial group block">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <h4 class="font-semibold text-stone-900 group-hover:text-hijau-700">{record.planName}</h4>
                        <p class="mt-1 text-xs leading-5 text-stone-500">{record.insurer}</p>
                      </div>
                      <span class="shrink-0 border border-stone-300 px-2 py-1 text-xs font-semibold text-stone-600">{group.label}</span>
                    </div>
                    {record.figureVerified ? (
                      <>
                        <dl class="mt-5 space-y-2 text-sm">
                          <div class="flex flex-wrap justify-between gap-x-3 gap-y-1 border-t border-stone-200 pt-2">
                            <dt class="text-stone-600">Kadar direkodkan</dt>
                            <dd class="font-semibold text-hijau-800">{record.tariffRates}</dd>
                          </div>
                          {record.minPremium && (
                            <div class="flex flex-wrap justify-between gap-x-3 gap-y-1">
                              <dt class="text-stone-600">Premium minimum</dt>
                              <dd class="font-semibold text-stone-900">{record.minPremium}</dd>
                            </div>
                          )}
                        </dl>
                        <p class="mt-4 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">{record.coversWhat}</p>
                      </>
                    ) : (
                      <p class="mt-5 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">
                        Nama produk direkodkan, tetapi kadar dan manfaat belum disahkan daripada sumber rasmi semasa penyelidikan.
                      </p>
                    )}
                    <span class="mt-4 inline-block text-sm font-semibold text-hijau-700">Lihat butiran →</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>

        <article class="prose-editorial mt-10 sm:mt-14">
          <h2 id="banjir">Banjir: apa yang perlu disemak?</h2>
          <p>
            Fire-only asas tidak patut dianggap melindungi banjir. Untuk houseowner atau householder, cari perkataan banjir
            atau special perils dalam PDS dan wording, kemudian semak had, excess, pengecualian, syarat rumah kosong dan proses
            tuntutan. Dalam data ini, beberapa sumber rasmi menyatakan banjir, tetapi kenyataan itu tidak menjadikan semua produk
            atau semua keadaan tuntutan sama.
          </p>
          <p>
            Jika rumah berada di kawasan berisiko, bandingkan skop bangunan dan isi rumah secara berasingan. Banjir yang merosakkan
            struktur, perabot atau kedua-duanya mungkin tertakluk pada bahagian perlindungan dan had yang berlainan. Simpan PDS,
            polisi atau sijil yang tepat untuk semakan sebelum pembaharuan.
          </p>
        </article>

        <section id="faq" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Soalan lazim insurans rumah</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:col-span-1">
        <div class="space-y-6 lg:sticky lg:top-20">
          <div class="border-2 border-stone-900 bg-white p-5">
            <h3 class="font-serif text-headline-sm text-stone-900">Ringkasan</h3>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-stone-500">Bilangan rekod</dt>
                <dd class="font-semibold text-stone-900">{records.length} produk</dd>
              </div>
              <div>
                <dt class="text-stone-500">Angka disahkan</dt>
                <dd class="font-semibold text-stone-900">{records.filter((record) => record.figureVerified).length} rekod</dd>
              </div>
              <div>
                <dt class="text-stone-500">Kadar asas 1A landed</dt>
                <dd class="font-semibold text-hijau-700">{formatRate(tariff.ho_landed_1A)} houseowner</dd>
              </div>
              <div>
                <dt class="text-stone-500">Minimum / setem</dt>
                <dd class="font-semibold text-stone-900">RM{tariff.minPremium} / RM{tariff.stamp}</dd>
              </div>
              <div>
                <dt class="text-stone-500">Data dikemas kini</dt>
                <dd class="font-semibold text-hijau-700">{homeInsurance.asAt}</dd>
              </div>
            </dl>
          </div>
          <div class="card-editorial">
            <h3 class="text-sm font-semibold text-stone-900">Baca juga</h3>
            <ul class="mt-3 space-y-2.5 text-sm">
              <li><a href="/tools/kalkulator-insurans-rumah/" class="text-hijau-700 hover:text-hijau-600">Kalkulator insurans rumah</a></li>
              <li><a href="/health-insurance/" class="text-hijau-700 hover:text-hijau-600">Panduan insurans kesihatan</a></li>
              <li><a href="/takaful/" class="text-hijau-700 hover:text-hijau-600">Insurans vs takaful</a></li>
              <li><a href="/companies/" class="text-hijau-700 hover:text-hijau-600">Direktori syarikat insurans</a></li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
