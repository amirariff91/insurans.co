---
import Base from '../../layouts/Base.astro';
import AnswerCard from '../../components/AnswerCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import NcdLadder from '../../components/NcdLadder.astro';
import carModels from '../../data/car-models.json';
import companies from '../../data/companies.json';
import { monthly, rm } from '../../lib/ncd';

export function getStaticPaths() {
  return carModels.map((car) => ({
    params: { model: car.slug },
    props: { car },
  }));
}

const { car } = Astro.props;
const model = car as any;
const isEnriched = model.enriched === true;
const carInsurers = companies.filter((company) => company.products.includes('car')).slice(0, 5);
const relatedCars = model.relatedModels
  .map((slug: string) => carModels.find((candidate) => candidate.slug === slug))
  .filter(Boolean)
  .slice(0, 4);
const articleDate = '2026-02-14';
const initialMonthly = monthly(model.premiumNCD55Min, model.premiumNCD55Max);
const zeroMonthly = monthly(model.premiumNCD0Min, model.premiumNCD0Max);
const repairHeadline = model.riskProfile.repairCost.split('—')[0].trim();
const modelYearNotes = isEnriched && Array.isArray(model.modelYearNotes) ? model.modelYearNotes : [];
const addOnsDetail = isEnriched && Array.isArray(model.addOnsDetail) ? model.addOnsDetail : [];
const modelFaqs = isEnriched && Array.isArray(model.modelFAQs) ? model.modelFAQs : [];
const faqSchemaItems = modelFaqs.length > 0
  ? modelFaqs.map((faq: any) => ({ question: faq.q, answer: faq.a }))
  : (model.faqSchemaItems ?? []);

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `Harga Insurans ${model.fullName} 2026 | Semak & Bandingkan`,
  "description": `Panduan lengkap insurans ${model.fullName} di Malaysia. Harga premium ${rm(model.premiumNCD55Min)} – ${rm(model.premiumNCD55Max)} (NCD 55%). Tips jimat, add-ons dan perbandingan syarikat.`,
  "url": `https://insurans.co/car-insurance/${model.slug}/`,
  "datePublished": "2026-02-01",
  "dateModified": articleDate,
  "inLanguage": "ms",
  "publisher": {
    "@type": "Organization",
    "name": "Insurans.co",
    "url": "https://insurans.co"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
      { "@type": "ListItem", "position": 2, "name": "Insurans Kereta", "item": "https://insurans.co/car-insurance/" },
      { "@type": "ListItem", "position": 3, "name": model.fullName, "item": `https://insurans.co/car-insurance/${model.slug}/` }
    ]
  }
};

const primaryCalculatorUrl = `/tools/ncd-calculator/?model=${model.slug}&ncd=55`;
---

<Base
  title={model.titleOverride || `Harga Insurans ${model.fullName} 2026 | Semak & Bandingkan — Insurans.co`}
  description={model.descriptionOverride || `Harga insurans ${model.fullName} 2026: ${rm(model.premiumNCD55Min)}–${rm(model.premiumNCD55Max)} (NCD 55%) hingga ${rm(model.premiumNCD0Min)}–${rm(model.premiumNCD0Max)} (tanpa NCD). Bandingkan coverage komprehensif, NCD dan add-ons.`}
  schema={schema}
  ogType="article"
  publishedTime="2026-02-01"
  modifiedTime={articleDate}
  ogImage={`/og/car-insurance/${model.slug}.png`}
  ogImageAlt={`Insurans ${model.fullName}: NCD 55% ${rm(model.premiumNCD55Min)}–${rm(model.premiumNCD55Max)} setahun; tanpa NCD ${rm(model.premiumNCD0Min)}–${rm(model.premiumNCD0Max)}.`}
>
  <Hero title={`Harga insurans ${model.fullName}`}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Insurans Kereta', href: '/car-insurance/' },
        { label: model.fullName },
      ]}
    />
    <AnswerCard
      slug={model.slug}
      model={model.fullName}
      year="2026"
      premium0={{ min: model.premiumNCD0Min, max: model.premiumNCD0Max }}
      premium55={{ min: model.premiumNCD55Min, max: model.premiumNCD55Max }}
    />
    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={schema.dateModified}
        premiumReviewed={model.premiumReviewed}
        sources={model.sources}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <!-- Apa yang termasuk? -->
      <article class="prose-editorial">
        <p class="text-lg text-stone-700">{model.description}</p>
        <h2 id="harga">Apa yang termasuk?</h2>
        <p>
          Anggaran di atas ialah untuk polisi <strong>komprehensif</strong> {model.fullName}.
          Perlindungan ini biasanya merangkumi kerosakan kereta sendiri, liabiliti pihak ketiga,
          kecurian dan kebakaran, tetapi butiran sebenar bergantung pada polisi dan syarikat.
        </p>
        <p>
          Nilai pasaran {model.fullName} dianggarkan {model.marketValueRange}.
          Roadtax dan perlindungan tambahan ditunjukkan berasingan supaya julat premium kekal jelas.
        </p>
      </article>

      <!-- Kos Tahunan Anggaran -->
      {model.roadtaxMin !== undefined && (
        <section id="kos-tahunan" class="border border-stone-200 bg-krim-100 p-5 sm:p-6">
          <h2 class="font-serif text-headline-sm text-stone-900">Kos tahunan anggaran</h2>
          <div class="mt-4 space-y-3 text-base">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-stone-200 py-2">
              <span class="text-stone-600">Insurans · NCD 55%</span>
              <span class="numeric font-semibold text-stone-900">{rm(model.premiumNCD55Min)} – {rm(model.premiumNCD55Max)}</span>
            </div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-stone-200 py-2">
              <span class="text-stone-600">Roadtax</span>
              <span class="numeric font-semibold text-stone-900">
                {model.roadtaxMin === model.roadtaxMax
                  ? rm(model.roadtaxMin)
                  : `${rm(model.roadtaxMin)} – ${rm(model.roadtaxMax)}`}
              </span>
            </div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 bg-hijau-50 px-3 py-3">
              <span class="font-semibold text-stone-900">Jumlah anggaran</span>
              <span class="numeric font-bold text-hijau-700">{rm(model.premiumNCD55Min + model.roadtaxMin)} – {rm(model.premiumNCD55Max + model.roadtaxMax)}</span>
            </div>
          </div>
          <p class="mt-3 text-sm leading-5 text-stone-600">{model.roadtaxNote} · Anggaran polisi komprehensif + roadtax sahaja. Tidak termasuk add-ons.</p>
        </section>
      )}

      <!-- Butiran model -->
      <details class="border-y border-stone-300 py-2">
        <summary class="flex min-h-12 cursor-pointer items-center font-semibold text-stone-900 hover:text-hijau-700">Butiran model &amp; andaian harga</summary>
        <div class="pb-4 pt-3">
          <dl class="grid gap-3 text-base sm:grid-cols-2">
            <div>
              <dt class="text-stone-600">Enjin / kapasiti</dt>
              <dd class="font-semibold text-stone-900">{model.engineCC}</dd>
            </div>
            <div>
              <dt class="text-stone-600">Varian</dt>
              <dd class="font-semibold text-stone-900">{model.variants.join(', ')}</dd>
            </div>
            <div>
              <dt class="text-stone-600">Tahun model</dt>
              <dd class="font-semibold text-stone-900">{model.yearRange}</dd>
            </div>
            <div>
              <dt class="text-stone-600">Segmen</dt>
              <dd class="font-semibold text-stone-900">{model.segment}</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="text-stone-600">Nilai pasaran</dt>
              <dd class="font-semibold text-stone-900">{model.marketValueRange}</dd>
            </div>
          </dl>
          <p class="mt-5 text-sm leading-5 text-stone-600">
            {model.premiumMethodology || 'Harga ialah anggaran premium polisi komprehensif; umur kereta, lokasi, varian, rekod pemanduan dan syarikat boleh mengubah quotation.'}
          </p>

          {modelYearNotes.length > 0 && (
            <div class="mt-6 border-t border-stone-200 pt-5">
              <h3 class="font-serif text-headline-sm text-stone-900">Nota mengikut tahun</h3>
              <ul class="mt-3 space-y-3">
                {modelYearNotes.map((item: any) => (
                  <li class="text-base leading-6 text-stone-700">
                    <strong class="text-stone-900">{item.range}:</strong> {item.note}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </details>

      <!-- NCD Section -->
      <section id="ncd">
        <div class="prose-editorial">
          <h2>NCD: dari 0% hingga 55%</h2>
          <p>
            NCD (diskaun tanpa tuntutan) mengurangkan premium asas selepas tahun-tahun tanpa tuntutan.
            Jadual di bawah membezakan kadar diskaun daripada baki premium asas.
          </p>
        </div>
        <NcdLadder mode="diagram" selectedTier={55} />
        <div class="info-box mt-6">
          <p class="text-base leading-6 text-stone-700">
            <strong>Nota NCD:</strong> Sesetengah tuntutan boleh menjejaskan NCD. Semak jenis tuntutan dan syarat polisi sebelum membuat keputusan.
          </p>
        </div>
        <a href="/guides/ncd-explained/" class="mt-4 inline-flex min-h-11 items-center text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">Panduan NCD →</a>
      </section>

      <!-- Add-ons Section -->
      <section id="addons">
        <div class="prose-editorial">
          <h2>Add-ons untuk {model.fullName}</h2>
          <p>
            Perlindungan tambahan bukan automatik untuk semua polisi. Pilih berdasarkan penggunaan kereta,
            lokasi dan kos yang anda sanggup tanggung sendiri.
          </p>
        </div>

        {addOnsDetail.length > 0 ? (
          <div class="mt-6 space-y-3">
            {addOnsDetail.map((addon: any) => (
              <article class="border border-stone-200 bg-white p-4 sm:p-5">
                <h3 class="font-semibold text-stone-900">{addon.name} · {addon.verdict}</h3>
                <p class="mt-1 text-base leading-6 text-stone-700">{addon.whyBM}</p>
                <p class="mt-2 text-sm leading-5 text-stone-600">Anggaran: {addon.priceBM}. Perlindungan tertakluk pada had, pengecualian dan syarat tuntutan dalam polisi.</p>
              </article>
            ))}
          </div>
        ) : (
          <div class="mt-6 space-y-3">
            {model.popularAddOns.map((addon: any) => (
              <article class={`flex items-start gap-3 border p-4 ${addon.recommended ? 'border-hijau-200 bg-hijau-50' : 'border-stone-200 bg-stone-50'}`}>
                <span class={`mt-0.5 shrink-0 text-sm font-bold ${addon.recommended ? 'text-hijau-700' : 'text-stone-600'}`} aria-hidden="true">{addon.recommended ? '✓' : '~'}</span>
                <div>
                  <h3 class="font-semibold text-stone-900">{addon.name} — {addon.recommended ? 'RECOMMENDED' : 'BERGANTUNG'}</h3>
                  <p class="mt-1 text-base leading-6 text-stone-700">{addon.price} setahun untuk {model.model}.</p>
                </div>
              </article>
            ))}
          </div>
        )}

        {model.windscreenPrice && (
          <p class="mt-5 text-base leading-6 text-stone-700">
            Anggaran gantian cermin depan: <strong>{model.windscreenPrice}</strong>. Sahkan harga dan keperluan calibration dengan panel bengkel sebelum memilih windscreen cover.
          </p>
        )}
      </section>

      <!-- Risk Profile -->
      <section id="risiko">
        <div class="prose-editorial">
          <h2>Profil risiko {model.fullName}</h2>
          <p>
            Setiap model mempunyai faktor risiko yang berbeza. Lokasi, cara penggunaan, umur kereta dan syarat syarikat juga mempengaruhi premium.
          </p>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <article class="card-editorial">
            <h3 class="font-semibold text-stone-900">Risiko kecurian</h3>
            <p class="mt-2 font-serif text-lg text-stone-900">{model.theftRiskDetail || model.riskProfile.theftRate}</p>
          </article>
          <article class="card-editorial">
            <h3 class="font-semibold text-stone-900">Kos repair</h3>
            <p class="mt-2 font-serif text-lg text-stone-900">{repairHeadline}</p>
            <p class="mt-1 text-sm leading-5 text-stone-600">{model.riskProfile.repairCost}</p>
          </article>
          <article class="card-editorial">
            <h3 class="font-semibold text-stone-900">Kekerapan tuntutan</h3>
            <p class="mt-2 font-serif text-lg text-stone-900">{model.claimFrequencyNote || model.riskProfile.claimFrequency}</p>
          </article>
          <article class="card-editorial sm:col-span-2">
            <h3 class="font-semibold text-stone-900">Nota banjir dan had data</h3>
            <p class="mt-2 text-base leading-6 text-stone-700">{model.floodRiskNote || model.riskProfile.notes}</p>
          </article>
        </div>
      </section>

      <!-- Tips Section -->
      <section id="tips">
        <div class="prose-editorial">
          <h2>Tips jimat insurans {model.fullName}</h2>
          <p>Beberapa perkara praktikal untuk pemilik {model.model}:</p>
        </div>
        <ol class="mt-6 space-y-3">
          {model.tips.map((tip: string, index: number) => (
            <li class="flex items-start gap-3 border border-stone-200 bg-white p-4">
              <span class="shrink-0 font-serif text-lg text-stone-600">{index + 1}.</span>
              <p class="text-base leading-6 text-stone-700">{tip}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Neutral company directory -->
      <section>
        <div class="prose-editorial">
          <h2>Syarikat insurans</h2>
          <p>
            Harga dan ciri polisi boleh berbeza antara syarikat untuk {model.model}.
            Gunakan direktori ini sebagai titik mula, kemudian semak syarat dan quotation sebenar.
          </p>
        </div>
        <ul class="mt-5 grid gap-x-8 gap-y-2 sm:grid-cols-2">
          {carInsurers.map((company) => (
            <li>
              <a href={`/companies/${company.slug}/`} class="inline-flex min-h-11 items-center text-base font-semibold text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">{company.name}</a>
            </li>
          ))}
        </ul>
        <a href="/perbandingan/" class="mt-4 inline-flex min-h-11 items-center text-base text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">Lihat perbandingan syarikat →</a>

            </section>

<nav aria-label="Panduan berkaitan" class="text-base">
        <p class="font-semibold text-stone-900">Panduan berkaitan</p>
        <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1">
          <li><a href="/guides/renew-car-insurance/" class="inline-flex min-h-11 items-center text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">Cara renew insurans kereta online →</a></li>
          <li><a href="/guides/how-to-claim/" class="inline-flex min-h-11 items-center text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">Cara buat claim →</a></li>
          <li><a href="/car-insurance/" class="inline-flex min-h-11 items-center text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">Semua model →</a></li>
        </ul>
      </nav>

      <!-- FAQ -->
      <section id="faq">
        <div class="prose-editorial">
          <h2>Soalan lazim — Insurans {model.fullName}</h2>
        </div>

        <div class="mt-5">
          {modelFaqs.length > 0 ? (
            modelFaqs.map((faq: any, index: number) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))
          ) : (
            <>
              <details class="faq-item" open>
                <summary>Berapa harga insurans {model.model} sebulan?</summary>
                <p>
                  Jika dibahagi secara bulanan, insurans {model.model} sekitar
                  <strong>{rm(initialMonthly.min)} – {rm(initialMonthly.max)}</strong> sebulan dengan NCD 55%.
                  Tanpa NCD, sekitar <strong>{rm(zeroMonthly.min)} – {rm(zeroMonthly.max)}</strong> sebulan.
                  Ini setara tahunan ÷ 12, bukan pelan ansuran.
                </p>
              </details>

              <details class="faq-item">
                <summary>{model.model} patut ambil comprehensive atau third-party?</summary>
                <p>
                  Kalau {model.model} anda masih bernilai (lebih RM15,000), <strong>comprehensive</strong> biasanya memberi perlindungan lebih luas.
                  Ia boleh melindungi kerosakan kereta sendiri, kereta orang lain, kecurian dan bencana alam mengikut polisi.
                  Third-party hanya melindungi liabiliti kepada pihak ketiga.
                  <a href="/car-insurance/" class="text-hijau-700 underline">Baca perbandingan jenis coverage →</a>
                </p>
              </details>

              <details class="faq-item">
                <summary>Boleh ke saya tukar syarikat insurans untuk {model.model} saya?</summary>
                <p>
                  Ya. NCD ikut pemilik dan kereta, bukan syarikat. Masa renew, anda boleh membandingkan syarikat insurans berlesen dan memilih polisi yang sesuai.
                </p>
              </details>

              <details class="faq-item">
                <summary>Kenapa harga insurans {model.model} saya berbeza dari kawan?</summary>
                <p>
                  Premium bergantung pada <strong>umur kereta</strong>, <strong>NCD</strong>,
                  <strong>lokasi</strong>, <strong>add-ons</strong> dan <strong>syarikat</strong> yang dipilih.
                  Dua orang dengan {model.model} yang sama boleh menerima quotation yang berbeza.
                </p>
              </details>

              <details class="faq-item">
                <summary>Apa add-on yang sesuai untuk {model.model}?</summary>
                <p>
                  Windscreen cover dan special perils boleh dipertimbangkan berdasarkan penggunaan dan lokasi anda.
                  Semak had, pengecualian dan syarat claim sebelum memilih.
                  <a href="/car-insurance/#addons" class="text-hijau-700 underline">Baca panduan add-ons lengkap →</a>
                </p>
              </details>
            </>
          )}
        </div>
      </section>

      <!-- Related Cars -->
      {relatedCars.length > 0 && (
        <section>
          <div class="prose-editorial">
            <h2>Model berkaitan</h2>
            <p>Bandingkan model lain yang mungkin sesuai dengan keperluan anda:</p>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {relatedCars.map((related: any) => (
              <article class="card-editorial">
                <h3 class="font-semibold text-stone-900">
                  <a href={`/car-insurance/${related.slug}/`} class="text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">{related.fullName}</a>
                </h3>
                <p class="mt-1 text-sm text-stone-600">{related.segment} · {related.engineCC}</p>
                <dl class="mt-4 space-y-2 text-sm">
                  <div class="flex flex-wrap justify-between gap-x-3 gap-y-1">
                    <dt class="text-stone-600">NCD 55%</dt>
                    <dd class="numeric font-semibold text-hijau-800">{rm(related.premiumNCD55Min)} – {rm(related.premiumNCD55Max)}</dd>
                  </div>
                  <div class="flex flex-wrap justify-between gap-x-3 gap-y-1">
                    <dt class="text-stone-600">NCD 0%</dt>
                    <dd class="numeric font-semibold text-stone-900">{rm(related.premiumNCD0Min)} – {rm(related.premiumNCD0Max)}</dd>
                  </div>
                </dl>
              </article>
            ))}
          </div>
        </section>
      )}

      <CtaBand
        heading={`Kira NCD dan semak quotation ${model.fullName}`}
        body="Masukkan premium asal daripada polisi anda. Kalkulator ini tidak menganggap julat editorial sebagai quotation sebenar."
        primary={{ label: 'Kira NCD saya →', href: primaryCalculatorUrl }}
        outbound={[
          { label: 'Bjak.my', href: 'https://bjak.my', relationship: 'unknown' },
          { label: 'PolicyStreet', href: 'https://policystreet.com', relationship: 'unknown' },
          { label: 'Fincrew.my', href: 'https://fincrew.my', relationship: 'unknown' },
        ]}
        disclosure="Quotation/pembelian dibuat di laman mereka, bukan di sini."
      />
    </div>
  </div>

  {faqSchemaItems.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqSchemaItems.map((item: { question: string; answer: string }) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer,
        },
      })),
    })} />
  )}
</Base>
