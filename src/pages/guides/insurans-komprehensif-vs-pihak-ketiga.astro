---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import PageAnswer from '../../components/edisi/PageAnswer.astro';
import carModels from '../../data/car-models.json';

// Comprehensive-premium figures on this page read from car-models.json, the same data the model
// pages and the car-insurance hub use, so the guide cannot drift from them.
const bySlug = Object.fromEntries(carModels.map((car) => [car.slug, car])) as Record<string, (typeof carModels)[number]>;
const num = (value: number) => value.toLocaleString('en-MY');
const range = (min: number, max: number) => `RM${num(min)}–RM${num(max)}`;
const tightRange = (min: number, max: number) => `RM${num(min)}–RM${num(max)}`;
const myvi = bySlug['perodua-myvi'];
const city = bySlug['honda-city'];
const corollaCross = bySlug['toyota-corolla-cross'];
// Span of the NCD 55% estimates across every model in the data, for the comparison table.
const lowest55 = carModels.reduce((a, b) => (b.premiumNCD55Min < a.premiumNCD55Min ? b : a));
const highest55 = carModels.reduce((a, b) => (b.premiumNCD55Max > a.premiumNCD55Max ? b : a));

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Insurans Komprehensif vs Pihak Ketiga: Mana Lebih Baik untuk Anda?",
      "description": "Perbezaan antara insurans komprehensif dan pihak ketiga. Mana yang lebih sesuai untuk kereta anda? Panduan lengkap dalam Bahasa Malaysia.",
      "url": "https://insurans.co/guides/insurans-komprehensif-vs-pihak-ketiga/",
      "datePublished": "2026-01-15",
      "dateModified": "2026-11-15",
      "inLanguage": "ms",
      "publisher": { "@type": "Organization", "name": "Insurans.co", "url": "https://insurans.co" },
      "author": { "@type": "Organization", "name": "Insurans.co" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
        { "@type": "ListItem", "position": 2, "name": "Panduan", "item": "https://insurans.co/guides/" },
        { "@type": "ListItem", "position": 3, "name": "Komprehensif vs Pihak Ketiga", "item": "https://insurans.co/guides/insurans-komprehensif-vs-pihak-ketiga/" }
      ]
    }
  ]
};
---

<Base
  title="Insurans Komprehensif vs Pihak Ketiga: Mana Lebih Baik untuk Anda? — Insurans.co"
  description="Perbezaan insurans komprehensif dan pihak ketiga — apa yang dilindungi, berapa harga, dan yang mana sesuai untuk umur kereta anda. Panduan lengkap BM."
  schema={schema}
  ogType="article"
  publishedTime="2026-01-15"
  modifiedTime="2026-11-15"
  ads={true}
>
  <!-- Breadcrumb + Header -->
  <section class="bg-white">
    <div class="container-wide pt-6 pb-4 sm:pt-8 sm:pb-6">
      <Breadcrumbs items={[{ label: 'Utama', href: '/' }, { label: 'Panduan', href: '/guides/' }, { label: 'Komprehensif vs Pihak Ketiga' }]} />
      <h1 class="ea-h1 mb-1">
        Insurans Komprehensif vs Pihak Ketiga: Mana Lebih Baik untuk Anda?
      </h1>
      <PageAnswer
        finding="Insurans komprehensif memberi perlindungan paling luas antara tiga jenis polisi."
        facts={[
          { label: 'Komprehensif', value: 'lindungi kereta sendiri dan pihak ketiga; banjir perlukan add-on special perils' },
          { label: 'TPFT', value: 'lindungi kecurian + kebakaran + pihak ketiga' },
          { label: 'Pihak Ketiga', value: 'lindungi orang lain sahaja' },
        ]}
      />
      <Byline dateModified="2026-11-15" />
      <p class="text-lg text-stone-900 max-w-2xl leading-relaxed">
        Komprehensif dan pihak ketiga ialah dua jenis insurans kereta yang paling asas. Bezanya ialah siapa yang dilindungi: komprehensif melindungi kereta anda dan orang lain, manakala pihak ketiga hanya melindungi orang lain.
      </p>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <article class="prose-editorial prose-bars">

          <h2>Insurans komprehensif melindungi kereta anda dan orang lain</h2>
          <p>
            Insurans komprehensif (atau "all risks") ialah perlindungan paling lengkap yang boleh anda beli
            untuk kereta. Ia melindungi dua pihak: anda <em>dan</em> orang lain. Jika berlaku kemalangan, sama ada
            kesalahan anda atau bukan, kereta anda tetap dilindungi.
          </p>
          <p>
            Insurans komprehensif melindungi kerosakan pada kereta anda sendiri akibat kemalangan, kecurian penuh,
            kerosakan akibat kebakaran, dan (dengan add-on) banjir serta bencana alam. Ini juga melindungi
            pihak ketiga: orang lain yang terlibat dalam kemalangan dengan anda.
          </p>

          <h2>Insurans pihak ketiga (third party) hanya melindungi orang lain</h2>
          <p>
            Insurans pihak ketiga (TP) ialah insurans minimum yang diwajibkan oleh undang-undang Malaysia.
            Ia <strong>hanya melindungi pihak ketiga</strong>: orang lain yang terlibat dalam kemalangan dengan anda.
            Kereta anda sendiri <em>tidak</em> dilindungi sama sekali.
          </p>
          <p>
            Ada juga varian tengah yang dipanggil <strong>Third Party Fire and Theft (TPFT)</strong>.
            Ia melindungi pihak ketiga, dan kereta anda sendiri jika dicuri atau terbakar,
            tetapi tidak melindungi kerosakan akibat kemalangan biasa.
          </p>

          <h2>Perbandingan: apa yang dilindungi</h2>
        </article>

        <!-- Comparison Table -->
        <div class="overflow-x-auto my-8" role="region" tabindex="0" aria-label="Perbandingan: apa yang dilindungi">
          <table class="table-editorial">
            <thead>
              <tr>
                <th scope="col">Jenis Perlindungan</th>
                <th scope="col">Komprehensif</th>
                <th scope="col">TPFT</th>
                <th scope="col">Pihak Ketiga</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row" class="font-medium">Kerosakan kereta sendiri (kemalangan)</th>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
                <td class="mark-no">✗ Tidak</td>
                <td class="mark-no">✗ Tidak</td>
              </tr>
              <tr>
                <th scope="row" class="font-medium">Kecurian kereta sendiri</th>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
                <td class="mark-no">✗ Tidak</td>
              </tr>
              <tr>
                <th scope="row" class="font-medium">Kebakaran kereta sendiri</th>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
                <td class="mark-no">✗ Tidak</td>
              </tr>
              <tr>
                <th scope="row" class="font-medium">Kerosakan kereta orang lain</th>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
              </tr>
              <tr>
                <th scope="row" class="font-medium">Kecederaan orang lain</th>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
                <td class="text-hijau-700 font-bold">✓ Ya</td>
              </tr>
              <tr>
                <th scope="row" class="font-medium">Banjir &amp; bencana alam (special perils)</th>
                <td class="text-stone-500">Add-on</td>
                <td class="mark-no">✗</td>
                <td class="mark-no">✗</td>
              </tr>
              <tr>
                <th scope="row" class="font-medium">Harga premium (anggaran, NCD 55%, setahun)</th>
                <td class="font-semibold text-stone-900">{range(lowest55.premiumNCD55Min, highest55.premiumNCD55Max)}</td>
                <td class="font-semibold text-stone-900">Minta sebut harga</td>
                <td class="font-semibold text-stone-900">Minta sebut harga</td>
              </tr>
            </tbody>
          </table>
        </div>

        <article class="prose-editorial prose-bars">
          <h2>Pilihan berdasarkan umur kereta</h2>
          <p>
            Cara paling mudah untuk membuat keputusan: lihat umur dan nilai kereta anda.
          </p>

          <h3>Kereta baru atau bernilai tinggi (lebih RM30,000)</h3>
          <p>
            Komprehensif wajar diutamakan. Kereta baru bernilai tinggi; jika kemalangan teruk atau kereta dicuri, insurans pihak ketiga tidak melindungi kereta anda, dan kos membaiki atau mengganti kereta boleh mencecah puluhan ribu ringgit.
          </p>

          <h3>Kereta sederhana (RM10,000–RM30,000)</h3>
          <p>
            Komprehensif masih patut dipertimbangkan, tetapi kira dahulu. Jika premium komprehensif lebih daripada 10% nilai kereta, TPFT mungkin wajar dipertimbangkan. Ingat, dengan TPFT anda menanggung sendiri kos jika kereta rosak teruk dalam kemalangan.
          </p>

          <h3>Kereta lama atau bernilai rendah (bawah RM10,000)</h3>
          <p>
            Jika nilai kereta sudah rendah dan kos membaiki mungkin melebihi nilai kereta, TPFT atau pihak ketiga boleh dipertimbangkan. Pastikan anda bersedia menanggung kos jika berlaku kemalangan.
          </p>

          <div class="info-box my-6">
            <p class="text-sm">
              <strong>Cara membandingkan:</strong> Bandingkan premium komprehensif, TPFT dan pihak ketiga bersama nilai kereta, syarat pinjaman dan kos kerosakan yang anda mampu tanggung.
            </p>
          </div>

          <h2>Perbezaan harga: komprehensif vs pihak ketiga</h2>
          <p>
            Untuk kereta seperti Perodua Myvi:
          </p>
          <ul>
            <li><strong>Komprehensif (NCD 55%):</strong> ~{range(myvi.premiumNCD55Min, myvi.premiumNCD55Max)} setahun</li>
            <li><strong>TPFT dan pihak ketiga:</strong> lebih murah, tetapi kami belum mengesahkan angkanya. Minta sebut harga untuk kereta anda.</li>
          </ul>

          <div class="not-prose note-price my-6">
            <p class="note-t mb-2">Contoh kos: {myvi.fullName}</p>
            <ul class="text-sm space-y-1">
              <li>• <strong>Komprehensif (NCD 55%):</strong> ~{tightRange(myvi.premiumNCD55Min, myvi.premiumNCD55Max)}/tahun (belum termasuk special perils)</li>
              <li>• <strong>Komprehensif (tanpa NCD):</strong> ~{tightRange(myvi.premiumNCD0Min, myvi.premiumNCD0Max)}/tahun</li>
              <li>• <strong>Pihak ketiga:</strong> minta sebut harga; kami belum mengesahkan angkanya</li>
              <li>• Nilai pasaran {myvi.fullName}: {myvi.marketValueRange}</li>
            </ul>
          </div>
          <p>
            Beza antara komprehensif dan pihak ketiga untuk Myvi biasanya beberapa ratus ringgit setahun; minta sebut harga untuk angka tepat.
            Tetapi jika kereta dicuri atau terlibat dalam kemalangan teruk, anda boleh rugi RM20,000–RM50,000.
            Untuk kereta yang masih bernilai, komprehensif biasanya lebih wajar dipertimbangkan.
          </p>

          <h2>Komprehensif vs pihak ketiga: timbang beza premium dengan kos sendiri</h2>
          <p>
            Insurans komprehensif <strong>memberi perlindungan paling luas</strong> antara tiga jenis polisi. Untuk kereta yang masih bernilai tinggi, bandingkan beza premium dengan kos yang perlu anda tanggung sendiri jika kereta rosak atau dicuri. Jika anda tinggal di kawasan banjir, semak kos add-on special perils, lazimnya sekitar 0.2%–0.5% daripada sum insured setahun.
          </p>
        </article>

        <p class="text-xs text-stone-500 mt-8 pt-4 border-t border-stone-200">Artikel ini ditulis dan disunting oleh Amir Ariff, pengasas dan editor Insurans.co. Beliau bukan penasihat kewangan atau ejen insurans berlesen. Untuk maklumat rasmi, sila rujuk <a href="https://www.piam.org.my" class="underline" target="_blank" rel="noopener noreferrer">PIAM</a> atau <a href="https://www.bnm.gov.my" class="underline" target="_blank" rel="noopener noreferrer">Bank Negara Malaysia</a>.</p>

        <!-- CTA -->
        <div class="border-2 border-stone-900 p-5 my-8">
          <h3 class="font-serif text-lg text-stone-900 mb-2">Bandingkan harga insurans komprehensif</h3>
          <p class="text-sm text-stone-600 mb-4">
            Dapatkan sebut harga komprehensif daripada beberapa syarikat dan bandingkan sebelum membuat keputusan.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/insurans-online/" class="btn-hijau text-sm">
              Semakan platform insurans online
            </a>
            <a href="/car-insurance/" class="btn-outline text-sm">
              Panduan insurans kereta
            </a>
          </div>
        </div>

        <!-- Lihat Juga -->
        <div class="not-prose bg-stone-50 border border-stone-200 rounded-xl p-6 my-8">
          <h3 class="font-semibold text-stone-800 mb-4">Lihat juga: harga insurans kereta popular</h3>
          <p class="text-sm text-stone-600 mb-4">Anggaran harga insurans komprehensif untuk model popular:</p>
          <ul class="space-y-3">
            <li class="flex items-center justify-between p-3 bg-white border border-stone-200 rounded-lg">
              <a href="/car-insurance/perodua-myvi/" class="text-hijau-700 font-semibold hover:underline">{myvi.fullName}</a>
              <span class="text-sm text-stone-500">NCD 55%: {tightRange(myvi.premiumNCD55Min, myvi.premiumNCD55Max)}</span>
            </li>
            <li class="flex items-center justify-between p-3 bg-white border border-stone-200 rounded-lg">
              <a href="/car-insurance/honda-city/" class="text-hijau-700 font-semibold hover:underline">{city.fullName}</a>
              <span class="text-sm text-stone-500">NCD 55%: {tightRange(city.premiumNCD55Min, city.premiumNCD55Max)}</span>
            </li>
            <li class="flex items-center justify-between p-3 bg-white border border-stone-200 rounded-lg">
              <a href="/car-insurance/toyota-corolla-cross/" class="text-hijau-700 font-semibold hover:underline">Toyota Corolla Cross</a>
              <span class="text-sm text-stone-500">NCD 55%: {tightRange(corollaCross.premiumNCD55Min, corollaCross.premiumNCD55Max)}</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-20 space-y-6">
          <div class="card-editorial">
            <h3 class="font-semibold text-sm text-stone-900 mb-3">Panduan berkaitan</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/guides/ncd-explained/" class="text-hijau-700 hover:text-hijau-600">NCD: jimat sehingga 55%</a></li>
              <li><a href="/guides/cara-turun-premium-insurans-kereta/" class="text-hijau-700 hover:text-hijau-600">10 cara turunkan premium</a></li>
              <li><a href="/guides/insurans-kereta-banjir/" class="text-hijau-700 hover:text-hijau-600">Insurans kereta banjir</a></li>
              <li><a href="/guides/how-to-claim/" class="text-hijau-700 hover:text-hijau-600">Cara buat claim</a></li>
              <li><a href="/companies/" class="text-hijau-700 hover:text-hijau-600">Semua syarikat insurans</a></li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>
