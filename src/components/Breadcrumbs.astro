---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const lastIndex = items.length - 1;
---

<nav aria-label="Jejak navigasi" class="mb-5 text-sm text-stone-400">
  <ol class="flex flex-wrap items-center gap-x-1">
    {items.map((item, index) => (
      <li class="flex min-w-0 items-center">
        {index > 0 && <span aria-hidden="true" class="mx-1 shrink-0">›</span>}
        {index === lastIndex ? (
          <span aria-current="page" class="flex min-h-11 min-w-0 items-center break-words py-2 text-stone-700">
            {item.label}
          </span>
        ) : item.href ? (
          <a href={item.href} class="inline-flex min-h-11 items-center py-2 text-stone-500 transition-colors hover:text-hijau-700">
            {item.label}
          </a>
        ) : (
          <span class="flex min-h-11 items-center py-2 text-stone-500">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
