---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import platforms from '../../data/platforms.json';

const productLabels: Record<string, string> = {
  life: 'Insurans hayat / term',
  'critical-illness': 'Penyakit kritikal',
  health: 'Kesihatan / medical card',
  travel: 'Travel insurance / takaful',
  car: 'Insurans kereta',
  motorcycle: 'Insurans motosikal',
  'personal-accident': 'Kemalangan diri',
  home: 'Perlindungan kandungan rumah',
  roadtax: 'Renew roadtax',
};

const modelGroups = [
  {
    key: 'insurer-langsung',
    label: 'Insurer-langsung — beli terus tanpa ejen',
    description: 'Beli terus daripada penginsurans atau takaful melalui saluran digital mereka.',
    records: platforms.records.filter((platform) => platform.model.startsWith('insurer-langsung')),
  },
  {
    key: 'aggregator',
    label: 'Aggregator — banding beberapa penginsurans',
    description: 'Lihat pilihan daripada beberapa penginsurans dalam satu platform.',
    records: platforms.records.filter((platform) => platform.model.startsWith('aggregator')),
  },
  {
    key: 'platform-jpj',
    label: 'Penyedia kontrak JPJ — bukan eksklusif',
    description: 'Penyedia berkontrak JPJ yang turut menawarkan urusan digital lain.',
    records: platforms.records.filter((platform) => platform.model.startsWith('platform berkontrak JPJ')),
  },
  {
    key: 'marketplace',
    label: 'Marketplace — beli dalam platform besar',
    description: 'Akses produk penyedia melalui platform pihak ketiga yang turut menawarkan urusan lain.',
    records: platforms.records.filter((platform) => platform.model === 'marketplace'),
  },
].filter((group) => group.records.length > 0);

const faqs = [
  {
    q: 'Macam mana cara banding dan beli insurans online?',
    a: 'Bandingkan sebut harga untuk jumlah perlindungan dan manfaat yang sama. Semak nama insurer, PDS, add-on serta jumlah bayaran akhir sebelum memilih. Untuk pembaharuan roadtax melalui PolicyStreet, polisi insurans dikeluarkan dahulu sebelum roadtax diproses.',
    source: 'https://policystreet.com.my/en/renew-road-tax',
  },
  {
    q: 'Apa beza Bjak dan PolicyStreet?',
    a: 'Bjak dan Polisea, entiti PolicyStreet, diluluskan sebagai Financial Adviser dan Islamic Financial Adviser. Bjak menyenaraikan 16 insurer/takaful untuk perbandingan motor. PolicyStreet menawarkan Drive+, keahlian pilihan berbayar dengan tiga tahap: Lite, Standard dan Premium.',
    source: 'https://policystreet.com.my/en/blog/get-cheapest-road-tax-with-policystreet-membership',
  },
  {
    q: 'Apa yang perlu disemak sebelum membeli travel insurance di Shopee?',
    a: 'Shopee menawarkan Allianz Travel Insurance dan Zurich Travel Takaful. Semak penyedia yang dipilih, manfaat dan pengecualian dalam dokumen polisi atau sijil. Perlindungan COVID pada pelan Allianz tertakluk kepada syarat vaksinasi penuh serta bukti diagnosis.',
    source: 'https://help.shopee.com.my/portal/4/article/145752',
  },
  {
    q: 'Apa yang diperlukan untuk renew roadtax melalui MyEG atau Bjak?',
    a: 'Insurans kenderaan perlu aktif sebelum roadtax diperbaharui. Dalam aliran Bjak, roadtax dihantar untuk pemprosesan JPJ selepas insurans diproses dan pelanggan boleh menyemak status digital dalam MyJPJ. Perkhidmatan roadtax Bjak tidak tersedia untuk kenderaan e-hailing.',
    source: 'https://bjak.my/en/roadtax/how-roadtax-renewal-works',
  },
  {
    q: 'Apakah pelan FWD yang boleh dipertimbangkan?',
    a: 'FWD menawarkan i-Care untuk hayat bertempoh, i-Protect dan i-Protect Plus untuk penyakit kritikal serta i-Med untuk perubatan. FWD i-Lindung Critical Illness Plan pula melindungi penyakit kritikal dan kematian sehingga RM200,000 untuk diri, pasangan dan anak.',
    source: 'https://www.fwd.com.my/files/v3/assets/bltca8cd6b067df6d1c/bltcdda9742a1440734/68d363633653b77049b4928e/FWD_i-Lindung_Critical_Illness_Plan_P2_EN_V0.1.pdf?branch=capricorn',
  },
  {
    q: 'Kaotim ini platform siapa?',
    a: 'Kaotim ialah platform takaful digital milik Takaful Malaysia. Untuk MediKad, semak jumlah perlindungan, tempoh menunggu, pengecualian serta jadual sumbangan sebelum memilih pelan.',
    source: 'https://www.takaful-malaysia.com.my/en/news/takaful-malaysia-unveils-kaotim-a-new-digital-platform-offering-an-affordable-medical-card-for-malaysians/',
  },
];
const schemaDescription = 'Compare insurance Malaysia & buy insurance online Malaysia — semak insurer-langsung, aggregator FA/IFA, marketplace dan penyedia kontrak JPJ.';
const canonicalUrl = 'https://insurans.co/insurans-online/';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Compare Insurance Malaysia — Beli Insurance Online',
  description: schemaDescription,
  url: canonicalUrl,
  datePublished: platforms.asAt,
  dateModified: platforms.asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Online', item: canonicalUrl },
    ],
  },
};
---

<Base
  title="Compare Insurance Malaysia — Beli Online | Insurans.co"
  description={schemaDescription}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={platforms.asAt}
  modifiedTime={platforms.asAt}
>
  <section class="border-b border-stone-200 bg-white">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { label: 'Utama', href: '/' },
          { label: 'Insurans Online' },
        ]}
      />
      <p class="label mb-3">Panduan platform</p>
      <h1 class="mb-4 font-serif text-headline-lg text-stone-900 sm:text-headline-xl">
        Compare Insurance Malaysia &amp; Beli Insurance Online
      </h1>
      <Byline dateModified={platforms.asAt} />
      <p class="mt-4 max-w-2xl text-lg leading-7 text-stone-600">
        Kenali saluran insurance online Malaysia, pilihan produk dan syarat pembelian.
        Bandingkan quotation serta manfaat sebelum membeli atau memperbaharui perlindungan.
      </p>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div class="lg:col-span-2">
        <article class="prose-editorial">
          <p class="text-lg leading-7 text-stone-700">
            Nak banding dan beli insurans online di Malaysia — start dengan faham siapa penjualnya. Salurannya berbeza.
            <strong>Insurer-langsung:</strong> beli terus dari penginsurans/takaful tanpa ejen — contoh FWD (term/CI/medical +
            i-Lindung melalui KWSP) dan Kaotim, jenama takaful digital milik Takaful Malaysia (MediKad, Car/Motor dan Legasi).
            <strong>Aggregator:</strong> banding beberapa insurer. Bjak menyenaraikan 16 insurer/takaful dan diluluskan BNM
            sebagai FA/IFA sejak Oktober 2025. Polisea, entiti PolicyStreet, juga diluluskan sebagai FA/IFA.
            PolicyStreet menawarkan Drive+, keahlian pilihan berbayar yang dipilih semasa checkout. Rujuk <a href="https://bjak.my/en/approved-financial-adviser" target="_blank" rel="noopener">Bjak</a> dan
            <a href="https://policystreet.com.my/en/terms-business" target="_blank" rel="noopener">PolicyStreet</a>. <strong>Marketplace:</strong> beli dalam platform besar — Shopee Insurance (Allianz
            Travel + Zurich Travel Takaful, motor takaful, PA; ansur SPayLater 3–12 bulan; Shopee hanya ejen SeaMoney, bukan
            insurer). <strong>Urusan JPJ:</strong> MyEG disenaraikan sebagai rakan niaga JPJ dalam
            <a href="https://www.jpj.gov.my/wp-content/uploads/2024/08/LATEST-PR-PENJELASAN-BJAK.pdf" target="_blank" rel="noopener">kenyataan JPJ pada 6 Mei 2024</a>.
            Kenyataan yang sama menyebut Bjak tidak mendapat kelulusan pembaharuan roadtax dan tiada integrasi MySikap.
            Untuk Bjak, aliran pembaharuan bermula dengan insurans aktif sebelum roadtax dihantar untuk pemprosesan JPJ;
            pelanggan menyemak statusnya dalam MyJPJ. Rujuk <a href="https://bjak.my/en/roadtax/how-roadtax-renewal-works" target="_blank" rel="noopener">langkah rasmi Bjak</a>.
            Bandingkan PDS, quotation dan jumlah bayaran akhir di saluran penyedia sebelum membayar.
          </p>
        </article>

        <div class="info-box mt-8 sm:mt-10">
          <p>
            <strong>Flow:</strong> banding → bayar FPX/kad → e-policy → renew roadtax. Insurans.co bukan ejen, broker atau
            affiliate; pautan platform ialah rujukan untuk semakan sendiri, bukan ranking.
          </p>
        </div>

        <div class="mt-10 space-y-10 sm:mt-14">
          {modelGroups.map((group) => (
            <section id={group.key}>
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div>
                  <h2 class="font-serif text-headline-md text-stone-900">{group.label}</h2>
                  <p class="mt-1 text-sm text-stone-600">{group.description}</p>
                </div>
                <span class="text-sm text-stone-500">{group.records.length} platform</span>
              </div>

              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {group.records.map((platform) => (
                  <a href={`/insurans-online/${platform.slug}/`} class="card-editorial group block">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <h3 class="font-semibold text-stone-900 group-hover:text-hijau-700">{platform.name}</h3>
                        <p class="mt-1 text-xs leading-5 text-stone-500">{platform.digitalPlatform}</p>
                      </div>
                      <span class="shrink-0 border border-stone-300 px-2 py-1 text-xs font-semibold text-stone-600">
                        {platform.model.startsWith('insurer-langsung') ? 'Insurer-langsung' : platform.model}
                      </span>
                    </div>
                    <p class="mt-4 text-sm leading-5 text-stone-700">{platform.keyFact}</p>
                    <div class="mt-4 border-t border-stone-200 pt-3">
                      <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">Produk / urusan</p>
                      <p class="mt-1 text-sm leading-5 text-stone-600">
                        {platform.products.map((product) => productLabels[product] ?? product).join(' · ')}
                      </p>
                    </div>
                    <p class="mt-4 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">
                      <span class="font-semibold text-stone-900">Perhatian:</span> {platform.caveat}
                    </p>
                    <span class="mt-4 inline-block text-sm font-semibold text-hijau-700">
                      {['kaotim', 'fwd', 'shopee'].includes(platform.slug) ? 'Baca semakan' : 'Butiran platform'} {platform.name} →
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>

        <section id="faq" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Soalan lazim insurans online Malaysia</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>
                  {faq.a}{' '}
                  <a href={faq.source} target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Rujukan rasmi</a>
                </p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:col-span-1">
        <div class="space-y-6 lg:sticky lg:top-20">
          <div class="border-2 border-stone-900 bg-white p-5">
            <h2 class="font-serif text-headline-sm text-stone-900">Ringkasan</h2>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-stone-500">Bilangan platform</dt>
                <dd class="font-semibold text-stone-900">{platforms.records.length} platform</dd>
              </div>
              <div>
                <dt class="text-stone-500">Model</dt>
                <dd class="font-semibold text-stone-900">Insurer-langsung, aggregator + FA/IFA, marketplace, penyedia kontrak JPJ</dd>
              </div>
              <div>
                <dt class="text-stone-500">Data dikemas kini</dt>
                <dd class="font-semibold text-hijau-700">{platforms.asAt}</dd>
              </div>
              <div>
                <dt class="text-stone-500">Harga quotation</dt>
                <dd class="font-semibold text-stone-900">Tiada anggaran</dd>
              </div>
            </dl>
          </div>
          <div class="card-editorial">
            <h2 class="font-semibold text-sm text-stone-900">Nota kebebasan editorial</h2>
            <p class="mt-3 text-sm leading-5 text-stone-600">
              Kami bukan ejen, bukan broker dan tiada affiliate. Setiap platform diliputi sebagai saluran untuk disemak,
              bukan ranking atau pengesyoran.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
