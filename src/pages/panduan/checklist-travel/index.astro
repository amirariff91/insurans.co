---
import Base from '../../../layouts/Base.astro';
import Byline from '../../../components/Byline.astro';
import PageAnswer from '../../../components/edisi/PageAnswer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { buildDescription, buildTitle } from '../../../lib/seo';

const asAt = '2026-09-12';
const pageTitle = 'Travel Insurance: Checklist 8 Perkara Sebelum Fly';
const title = buildTitle(pageTitle);
const description = buildDescription(
  'Checklist 8 perkara sebelum fly: single vs annual, had perubatan, evakuasi, delay, COVID, tier kawasan, sukan lasak dan dokumen claim.',
);
const canonicalUrl = 'https://insurans.co/panduan/checklist-travel/';

const checklistItems = [
  {
    title: 'Single trip atau annual trip?',
    question: '"Saya terbang berapa kali setahun? Plan ini single, annual, atau kedua-duanya?"',
    why: 'Jika anda terbang sekali setahun, single trip memadai; yang kerap terbang (kerja + percutian) biasanya lebih jimat dengan annual. Dalam data kami, Etiqa TripCare 360 dan Allianz ialah single; Zurich Z-Travel (International dan Takaful), Tune Protect AirAsia dan Generali SmartTraveller Enhanced ada single dan annual. Kira: jika 3+ trip setahun, bandingkan harga annual dengan 3× single sebelum membuat keputusan.',
  },
  {
    title: 'Had perubatan luar negara — berapa?',
    question: '"Had perubatan di luar negara berapa? Satu harga untuk siapa?"',
    why: 'Bil hospital luar negara (terutama USA/Eropah/Jepun) boleh mencecah ratusan ribu — had kecil boleh habis dalam sehari. Contoh sebenar: Zurich Z-Travel Lite Basic RM100,000, VIP/Silver RM300,000, Gold RM500,000, Diamond unlimited; Generali SmartTraveller Enhanced sehingga RM350,000 seorang (Plan 2 bawah 65 tahun; RM250,000 Plan 1; RM125,000–RM175,000 warga emas); Tune Protect Plus melindungi perubatan & hospitalisasi COVID sehingga RM100,000. Etiqa pula menjual satu harga untuk 2 dewasa + 10 kanak-kanak. Padankan had dengan destinasi — USA tanpa had yang besar ialah risiko.',
  },
  {
    title: 'Evakuasi perubatan & repatriasi — hotline 24 jam apa?',
    question: '"Nombor hotline 24-jam apa? Evakuasi mesti diatur melalui siapa? Dari mana ke mana dilindungi?"',
    why: 'Claim evakuasi tanpa susunan yang betul boleh ditolak. Contoh yang tegas: MSIG Travel SafeGuard mewajibkan evakuasi & repatriasi diselaraskan melalui hotline 24-jam (+603-2166 3080) — dan polisi tidak membayar evakuasi dari Malaysia ke destinasi asing. Sebaliknya Generali memberi emergency medical evacuation & repatriation unlimited setiap kejadian, dan Etiqa menyediakan kemasukan hospital cashless di luar negara melalui Guarantee Letter. Simpan nombor hotline dalam telefon sebelum terbang — bukan dalam beg yang hilang.',
  },
  {
    title: 'Trip cancellation & travel delay — ambang bermula jam ke berapa?',
    question: '"Delay dari jam ke berapa baru dibayar? Cancellation ada dalam plan ini?"',
    why: 'Setiap plan mula bayar pada jam berbeza. Contoh sebenar: Etiqa membayar secara automatik apabila penerbangan lewat 2 jam atau lebih; Zurich Z-Travel membayar delay mulai 6 jam. Nota penting: trip cancellation ada dalam kebanyakan plan, tetapi TIADA dalam Zurich Z-Travel Lite — jika pembatalan penting untuk anda (tiket mahal, hotel non-refundable), jangan ambil Lite. Baca ambang jam dalam PDS, bukan dalam iklan.',
  },
  {
    title: 'Liputan COVID — standard, add-on, atau tiada?',
    question: '"COVID termasuk standard, perlu tambah add-on, atau langsung tiada?"',
    why: 'Status COVID berbeza setiap plan dalam data kami — Zurich Travel Takaful: ya; Allianz: ya (pelancong divaksin penuh sahaja); Tune Protect Plus: ya, Lite: tiada; Zurich Z-Travel International: add-on; Generali: add-on Pandemic Cover (perjalanan luar negara sahaja); Etiqa TripCare 360: add-on. Syarat claim pun berbeza: Allianz memerlukan diagnosis doktor + laporan makmal untuk tuntutan COVID. Jika destinasi masih memerlukan bukti liputan COVID, pastikan ia tertulis dalam sijil anda.',
  },
  {
    title: 'Tier kawasan — destinasi saya jatuh dalam tier mana?',
    question: '"Negara saya pergi termasuk dalam tier/area mana? Domestik dilindungi?"',
    why: 'Salah pilih tier = tiada perlindungan langsung. Contoh sebenar: Zurich Z-Travel International ada Area 1 (Asia & Oceania terpilih), Area 2 (Worldwide kecuali Kanada/Mongolia/Nepal/Tibet/USA), Area 3 (Worldwide); Zurich Travel Takaful ada tier domestik (≥50km dari rumah), Southeast Asia, Asia, Asia/Eropah/Afrika/Amerika Selatan/Oceania, Worldwide; Allianz ada Domestik, Asia, Worldwide (kecuali negara disekat/zon perang). Untuk dalam Malaysia: Zurich Takaful domestik bermula ≥50km dari rumah — balik kampung 30km tidak dikira. Pilih tier yang benar-benar meliputi setiap negara transit, bukan negara akhir sahaja.',
  },
  {
    title: 'Sukan lasak — aktiviti saya dilindungi?',
    question: '"Scuba, winter sports, hiking, bungee — yang mana termasuk, yang mana perlu add-on atau dikecualikan?"',
    why: 'Jangan anggap semua aktiviti dilindungi — selalunya tidak. Contoh: Zurich Z-Travel menyatakan perlindungan sukan amatur termasuk scuba, winter sports dan bungee jump. Jika plan anda tidak menyebut aktiviti itu, anggap ia dikecualikan dan tanya secara bertulis. Generali ada varian domestik (SmartTraveller Easy) yang berasingan daripada Enhanced — pastikan varian yang anda beli sepadan dengan trip anda.',
  },
  {
    title: 'Dokumen claim — apa nak simpan dari hari pertama?',
    question: '"Senarai dokumen claim plan ini apa? Had masa hantar?"',
    why: 'Claim gagal selalunya kerana dokumen, bukan kerana plan. Simpan dari hari pertama: resit asal perubatan/hotel/penerbangan, laporan polis (kecurian/kehilangan), diagnosis doktor + laporan makmal (untuk claim COVID seperti yang Allianz perlukan), boarding pass dan notis delay bertulis dari syarikat penerbangan (untuk claim delay/cancellation). Nota liputan: Allianz coverage bermula dari rumah/tempat kerja dan tamat 24 jam selepas ketibaan balik Malaysia — kejadian di luar tetingkap itu tidak dilindungi. Ambil gambar semua dokumen dan simpan salinannya dalam storan awan (cloud).',
  },
];

const faqs = [
  {
    q: 'Perlu ke travel insurance untuk trip domestik?',
    a: 'Bergantung pada jarak dan plan. Contoh: Zurich Travel Takaful ada tier domestik bermula ≥50km dari rumah — trip dekat bawah jarak itu tidak dilindungi. Untuk trip domestik jauh (penerbangan + hotel prabayar), perlindungan pembatalan/kelewatan masih berbaloi; untuk balik kampung dengan kereta sejam, biasanya membazir.',
  },
  {
    q: 'Annual trip jimat ke berbanding single?',
    a: 'Kira ikut kekerapan: jika anda terbang 3 kali atau lebih setahun, bandingkan harga satu annual (contoh varian annual Zurich, Tune Protect, Generali) dengan jumlah 3× single. Jika terbang sekali setahun, single sudah memadai.',
  },
  {
    q: 'Flight delay 2–3 jam boleh claim?',
    a: 'Ikut plan: Etiqa membayar secara automatik mulai lewat 2 jam; Zurich mulai 6 jam. Simpan boarding pass dan notis delay bertulis daripada syarikat penerbangan — tanpa bukti bertulis, claim delay sukar diluluskan walaupun melepasi ambang.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: asAt,
  dateModified: asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Panduan', item: 'https://insurans.co/panduan/' },
      { '@type': 'ListItem', position: 3, name: 'Checklist Travel Insurance', item: canonicalUrl },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={asAt}
  modifiedTime={asAt}
>
  <section class="bg-white">
    <div class="container-wide pt-6 pb-6 sm:pt-8 sm:pb-8">
      <Breadcrumbs
        items={[
          { label: 'Utama', href: '/' },
          { label: 'Panduan', href: '/panduan/' },
          { label: 'Checklist Travel Insurance' },
        ]}
      />
      <h1 class="ea-h1 mb-1">Checklist Travel Insurance Sebelum Fly — 8 Perkara Wajib Semak</h1>
      <PageAnswer
        finding="Semak 8 perkara ini sehari sebelum bayar"
        facts={[
          { label: 'Jangan beli', value: 'Travel insurance di kaunter airport sambil beratur' },
          { label: 'Perkara pertama', value: 'Single trip atau annual trip?', href: '#perkara-1' },
          { label: 'Sumber', value: 'Ciri sebenar plan yang kami rekodkan', href: '/travel-insurance/' },
        ]}
      />
      <Byline dateModified={asAt} />
      <p class="max-w-3xl text-lg leading-7 text-stone-600">
        Jangan beli travel insurance di kaunter airport sambil beratur. Semak 8 perkara ini sehari sebelum bayar — semuanya daripada ciri sebenar plan yang kami rekodkan di <a href="/travel-insurance/">/travel-insurance/</a>. Kami bukan ejen, bukan broker; kami tak jual plan dan tak ambil komisen.
      </p>
    </div>
  </section>

  <div class="container-article print-content py-10 sm:py-14">
    <article class="prose-editorial">
      <ol class="list-none space-y-8 pl-0">
        {checklistItems.map((item, index) => (
          <li id={`perkara-${index + 1}`} class="checklist-item border-b border-stone-200 pb-8">
            <h2 class="mt-0 flex gap-2 text-headline-sm">
              <span class="shrink-0 font-sans text-base text-stone-500">{index + 1}.</span>
              <span aria-hidden="true" class="shrink-0 font-sans text-stone-700">☐</span>
              <span>{item.title}</span>
            </h2>
            <p><strong>Apa nak tanya:</strong> {item.question}</p>
            <p><strong>Kenapa:</strong> {item.why}</p>
          </li>
        ))}
      </ol>

      <p class="info-box mt-8 text-sm leading-6 text-stone-700">
        <strong>Cara guna checklist ini (mesra cetak)</strong>
        Cetak satu salinan untuk setiap pengembara. Tanda ☐ apabila jawapan sudah disahkan dalam PDS/sijil — bukan dalam brosur.
      </p>
    </article>

    <section id="faq" class="mt-10 sm:mt-14">
      <div class="prose-editorial prose-bars">
        <h2>Soalan lazim travel insurance</h2>
      </div>
      <div class="mt-5">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10 border-t border-stone-200 pt-8 sm:mt-14">
      <div class="prose-editorial prose-bars">
        <h2>Baca juga</h2>
      </div>
      <ul class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
        <li><a href="/travel-insurance/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Bandingan travel insurance</a></li>
        <li><a href="/health-insurance/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Panduan insurans kesihatan</a></li>
        <li><a href="/insurans-online/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Insurans online</a></li>
        <li><a href="/guides/how-to-claim/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Cara buat claim</a></li>
        <li><a href="/guides/insurance-vs-takaful/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Beza insurans dan takaful</a></li>
      </ul>
    </section>

    <section class="mt-10 border-2 border-stone-900 bg-white p-5 sm:mt-14 sm:p-6">
      <p class="text-lg leading-7 text-stone-700">
        Dah tanda 8? Bandingkan plan sebenar ikut had perubatan, tier kawasan dan status COVID dalam <a href="/travel-insurance/" class="font-semibold text-hijau-700 underline decoration-hijau-300 underline-offset-2">bandingan travel insurance kami</a>
      </p>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>

<style>
  @media print {
    :global(body) {
      background: #fff;
    }

    :global(header),
    :global(footer),
    :global(nav) {
      display: none;
    }

    .print-content {
      max-width: none;
      padding-top: 0;
      padding-bottom: 0;
    }

    .checklist-item,
    .faq-item {
      break-inside: avoid;
    }
  }
</style>
