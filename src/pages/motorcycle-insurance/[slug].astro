---
import Base from '../../layouts/Base.astro';
import TrustStrip from '../../components/edisi/TrustStrip.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import PageAnswer from '../../components/edisi/PageAnswer.astro';
import ProductCss from '../../components/edisi/ProductCss.astro';
import { tarikh } from '../../components/edisi/ProductFormat';
import motorcycleInsurance from '../../data/motorcycle-insurance.json';
import { buildDescription, buildTitle } from '../../lib/seo';
import { freshFaqs } from '../../lib/plan-faq';

type MotorcycleRecord = (typeof motorcycleInsurance.records)[number];

// Ads opt-in (Base defaults to ads off). From the programmatic audit on 2026-11-15: at least
// 700 words in <main> and a 5-gram Jaccard below 0.35 against every sibling.
const adsEnabledSlugs = new Set([
  'zurich-z-rider',
]);
const records = motorcycleInsurance.records;
const typeLabels: Record<string, string> = {
  'third-party': 'Third party',
  comprehensive: 'Comprehensive',
  'comprehensive-takaful': 'Comprehensive / takaful',
  'motorcycle-add-on': 'Add-on motosikal',
};

export function getStaticPaths() {
  return motorcycleInsurance.records.map((record) => ({
    params: { slug: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props as { record: MotorcycleRecord };
const canonicalUrl = `https://insurans.co/motorcycle-insurance/${record.slug}/`;
const typeLabel = typeLabels[record.type] ?? record.type;
const sourceLinks = record.sources.map((url) => ({
  label: new URL(url).hostname.replace(/^www\./, ''),
  url,
}));
const specItems = [
  { label: 'Apa yang dilindungi', value: record.coversWhat },
  { label: 'Asas premium', value: record.premiumBasis },
  { label: 'Contoh premium PDS', value: record.workedExample },
].filter((item) => item.value);
const honestyLine = 'Manfaat, premium dan syarat portal produk ini belum disahkan daripada sumber primer yang dibaca. Halaman ini tidak membuat tuntutan tentang perlindungan atau harga.';
const relatedRecords = records.filter((candidate) => candidate.slug !== record.slug).slice(0, 4);
const title = buildTitle(`${record.planName} — Insurans Motosikal`, { max: 59 });
const description = buildDescription(
  record.figureVerified
    ? `${record.planName} oleh ${record.insurer}: ringkasan jenis perlindungan, asas premium, contoh PDS jika ada dan sumber rasmi. Tiada jadual premium motosikal mengikut cc direka.`
    : `${record.planName} oleh ${record.insurer}: nama dan jenis produk direkodkan, tetapi manfaat serta premium belum disahkan daripada sumber primer yang dibaca.`,
);
const barTypes: Record<string, string> = {
  'third-party': 'Insurans motosikal third party',
  comprehensive: 'Insurans motosikal comprehensive',
  'comprehensive-takaful': 'Motosikal comprehensive / takaful',
  'motorcycle-add-on': 'Add-on motosikal',
};
const barType = barTypes[record.type] ?? typeLabel;
const faqCandidates = record.figureVerified
  ? [
      {
        q: `${record.planName} ini jenis perlindungan apa?`,
        a: record.type === 'motorcycle-add-on'
          ? `${record.planName} ialah add-on pilihan yang perlu dibeli bersama polisi motosikal Comprehensive yang berkenaan; ia bukan polisi comprehensive atau takaful yang berdiri sendiri. Semak PDS untuk syarat dan pengecualian.`
          : `${barType}. Jenis perlindungan sebenar dan pengecualian masih tertakluk pada polisi, sijil dan PDS terkini ${record.planName}.`,
      },
      {
        q: 'Macam mana premium ditentukan?',
        a: `${record.premiumBasis} Halaman ini tidak memaparkan jadual premium mengikut cc; dapatkan quotation sebenar daripada penyedia.`,
      },
      {
        q: 'Contoh premium ini harga untuk semua motosikal ke?',
        a: record.workedExample
          ? `${record.workedExample}. Itu hanya contoh PDS dengan pemboleh ubah yang dinyatakan, bukan kadar umum atau janji quotation.`
          : 'Tiada contoh premium yang disahkan untuk produk ini. Jangan anggap angka daripada produk lain terpakai pada motosikal atau keadaan anda.',
      },
      {
        q: 'Apa yang perlu disemak sebelum membeli?',
        a: 'Semak jenis cover, jumlah diinsuranskan, NCD, excess, add-on pembonceng, pengecualian, SST, setem dan tarikh kuat kuasa dalam quotation atau PDS. Syarat sebenar mengatasi ringkasan halaman ini.',
      },
    ]
  : [
      {
        q: `Butiran ${record.planName} sudah disahkan ke?`,
        a: honestyLine,
      },
      {
        q: 'Di mana boleh semak?',
        a: `Gunakan sumber rasmi ${record.insurer} yang dipautkan pada halaman ini untuk menyemak manfaat, premium, syarat dan status produk terkini. Jangan gunakan halaman ini sebagai pengganti PDS atau quotation.`,
      },
    ];
// The coverage and premium basis are printed above; an answer made only of those sentences is dropped.
const faqs = freshFaqs(faqCandidates, [
  record.coversWhat,
  record.premiumBasis,
  record.workedExample,
  record.figureVerified ? undefined : honestyLine,
]);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${record.planName} — Insurans Motosikal`,
  description,
  url: canonicalUrl,
  datePublished: record.asAt,
  dateModified: record.asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Motosikal', item: 'https://insurans.co/motorcycle-insurance/' },
      { '@type': 'ListItem', position: 3, name: record.planName, item: canonicalUrl },
    ],
  },
};
// Page answer (Edisi). Verified records: type plus the recorded facts (at most four rows). Unverified records:
// only the type, with the existing honesty line as the note, so no unverified figure is promoted.
// Rows whose value is a paragraph (over 160 characters) move to a details list under the box.
const answerSpecs = record.figureVerified ? specItems.slice(0, 4) : [];
const answerTop = answerSpecs.filter((spec) => String(spec.value ?? '').length <= 160);
const answerRest = answerSpecs.filter((spec) => !answerTop.includes(spec));
// The type sits in the bar with the insurer, so it is not repeated as a row. No lead: no single headline figure.
const answerFacts = [
  ...answerTop.map((spec) => ({ label: spec.label, value: spec.value ?? "", role: spec.label === 'Contoh premium PDS' ? ('price' as const) : ('term' as const) })),
];

---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={record.asAt}
  modifiedTime={record.asAt}
  ads={adsEnabledSlugs.has(record.slug)}
>
  <Hero title={`Insurans motosikal: ${record.planName}`}>
    <TrustStrip slot="trust" date={record.asAt} sources={sourceLinks} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Insurans Motosikal', href: '/motorcycle-insurance/' },
        { label: record.planName },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-900">
      {record.figureVerified
        ? `Data ringkas berdasarkan sumber rasmi yang dibaca pada ${tarikh(record.asAt)}.`
        : `Rekod nama berdasarkan sumber yang dikenal pasti pada ${tarikh(record.asAt)}; butiran produk belum disahkan.`}
    </p>

    <PageAnswer
      slot="answer"
      finding={`${barType} oleh ${record.insurer.replace(/\.$/, '')}`}
      facts={answerFacts}
      note={record.figureVerified ? undefined : honestyLine}
    />
    <ProductCss />

    {answerRest.length > 0 && (
      <div class="mod">
        <dl class="pa-rows">
          {answerRest.map((spec) => (
            <div class="pa-r">
              <dt>{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    <div class="mt-4 mr-2">
      <EditorialStamp articleDate={record.asAt} sources={sourceLinks} sourcesLabel="Sumber" showReviewed={false} />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial prose-bars">
        {record.figureVerified ? (
          <>
            <p class="text-lg text-stone-700">
              Ringkasan ini bukan quotation; semak PDS, wording polisi atau sijil terkini {record.planName} sebelum
              membeli.
            </p>
            <h2 id="bandingkan">Sebelum membandingkan quotation</h2>
            <p>
              Bandingkan jenis cover, skop liabiliti, perlindungan motosikal sendiri, jumlah diinsuranskan, had manfaat, NCD, excess,
              add-on pembonceng dan pengecualian. Premium motosikal tidak boleh disimpulkan daripada jadual roadtax atau
              angka pasaran yang tidak mempunyai sumber primer.
            </p>
            <h2 id="premium">Premium dan quotation</h2>
            <p>
              {record.premiumBasis} {record.workedExample ? `Contoh yang dinyatakan dalam PDS ialah ${record.workedExample}; ia tidak mewakili semua motosikal.` : 'Sebab itu quotation sebenar diperlukan untuk keadaan dan motosikal anda.'}
            </p>
          </>
        ) : (
          <p class="text-lg text-stone-700">{honestyLine}</p>
        )}
      </article>

      {faqs.length > 0 && (
        <section id="faq">
          <div class="prose-editorial prose-bars">
            <h2>Soalan lazim</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {record.figureVerified && relatedRecords.length > 0 && (
        <section id="related">
          <div class="prose-editorial prose-bars">
            <h2>Produk motosikal berkaitan</h2>
            <p>Setiap halaman menyatakan sama ada manfaat dan premiumnya sudah disahkan daripada sumber primer.</p>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {relatedRecords.map((related) => (
              <div class="card-editorial">
                <h3 class="font-semibold text-stone-900">
                  <a href={`/motorcycle-insurance/${related.slug}/`} class="text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-ink">
                    {related.planName}
                  </a>
                </h3>
                <p class="mt-1 text-sm text-stone-600">{related.insurer}</p>
                <p class="mt-3 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">Jenis: {typeLabels[related.type] ?? related.type}</p>
                <p class="mt-3 text-sm leading-5 text-stone-600">
                  {related.figureVerified ? 'Ringkasan bersumber tersedia.' : 'Manfaat dan premium belum disahkan daripada sumber primer yang dibaca.'}
                </p>
              </div>
            ))}
          </div>
        </section>
      )}

      <CtaBand
        heading={`Semak ${record.planName} dengan penyedia`}
        body="Pautan rasmi di bawah ialah rujukan tanpa hubungan berbayar. Sahkan quotation, PDS dan syarat terkini terus dengan penyedia."
        primary={{ label: 'Kembali ke insurans motosikal', href: '/motorcycle-insurance/' }}
        outbound={[{ label: `Semak sumber rasmi ${record.insurer}`, href: record.sources[0], relationship: 'unpaid' }]}
        disclosure="Insurans.co bukan ejen atau broker. Pautan luar tidak bermakna pengesyoran; pembelian dan quotation dibuat di laman penyedia."
      />
    </div>
  </div>

  {faqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />}
</Base>
