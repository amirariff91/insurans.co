---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import travel from '../../data/travel-insurance.json';
import { buildDescription, buildTitle } from '../../lib/seo';

type TravelPlan = (typeof travel.records)[number];

const plans = travel.records;

export function getStaticPaths() {
  return travel.records.map((plan) => ({
    params: { slug: plan.slug },
    props: { plan },
  }));
}

const { plan } = Astro.props as { plan: TravelPlan };
const planName = ({
  'etiqa-tripcare-360': 'TripCare 360 Insurance',
  'msig-travel-safeguard': 'Travel SafeGuard',
} as Record<string, string>)[plan.slug] ?? plan.planName;
const { analysis } = plan;
// Built <main> text measured on 2026-10-10: >= 700 words and max sibling Jaccard < 0.35.
// Ads stay off where official sources could not be independently fetched for verification (Allianz 403, Generali renamed PDS).
const adsEnabledSlugs = new Set([
  'etiqa-tripcare-360',
  'zurich-z-travel-international',
  'zurich-travel-takaful',
  'tune-protect-travel-airasia',
  'msig-travel-safeguard',
]);
const passesUniqueness = adsEnabledSlugs.has(plan.slug);
const canonicalUrl = `https://insurans.co/travel-insurance/${plan.slug}/`;
const sibling = plans.find((candidate) => candidate.slug === analysis.siblingSlug)!;
const siblingName = sibling.slug === 'msig-travel-safeguard' ? 'Travel SafeGuard' : sibling.planName;
const sourceUrls = [...new Set(analysis.facts.map((fact) => fact.source))];
const sourceLinks = sourceUrls.map((url, index) => ({
  label: `[${index + 1}] ${new URL(url).hostname.replace(/^www\./, '')}`,
  url,
}));
const specItems = analysis.facts.filter((fact) => [
  'Had perubatan',
  'Evakuasi dan repatriasi perubatan',
  'Pembatalan perjalanan',
].includes(fact.label));
const title = buildTitle(`${planName} — Travel Insurance`);
const description = buildDescription(
  `${planName} (${plan.insurer}): kelayakan umur, had manfaat, syarat pembatalan dan perbandingan dengan ${siblingName}. Analisis bertarikh ${plan.analysisAsAt}.`,
);
const faqTopics = [
  { label: 'Tempoh maksimum perjalanan', question: `Berapa lama perjalanan boleh dilindungi oleh ${planName}?` },
  { label: 'Umur penyertaan', question: `Siapa yang layak menyertai ${planName}?` },
  { label: 'Pembatalan perjalanan', question: `Berapa had pembatalan perjalanan ${planName}?` },
  { label: 'Perlindungan COVID-19', question: `Apakah skop COVID-19 dalam ${planName}?` },
  { label: 'Tarikh akhir notis tuntutan', question: `Bila perlu menghantar tuntutan ${planName}?` },
];
const faqs = faqTopics.flatMap((topic) => {
  const fact = analysis.facts.find((candidate) => candidate.label === topic.label);
  return fact ? [{ q: topic.question, a: fact.value }] : [];
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${planName} — Travel Insurance`,
  description,
  url: canonicalUrl,
  datePublished: plan.asAt,
  dateModified: plan.analysisAsAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Travel Insurance', item: 'https://insurans.co/travel-insurance/' },
      { '@type': 'ListItem', position: 3, name: planName, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ads={passesUniqueness}
  ogType="article"
  publishedTime={plan.asAt}
  modifiedTime={plan.analysisAsAt}
>
  <Hero title={`Travel insurance ${planName}`}>
    <Byline slot="byline" dateModified={plan.analysisAsAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Travel Insurance', href: '/travel-insurance/' },
        { label: planName },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      Analisis {planName} oleh {plan.insurer}, dikemas kini pada {plan.analysisAsAt}.
      Had dan kelayakan dipisahkan mengikut varian dalam dokumen rasmi yang dipautkan pada setiap fakta.
    </p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="label">Travel insurance</p>
          <h2 class="mt-2 font-serif text-headline-sm text-stone-900">{planName}</h2>
          <p class="mt-1 text-sm leading-5 text-stone-600">{plan.insurer}</p>
        </div>
      </div>

      <h2 class="mt-7 font-serif text-headline-sm text-stone-900">Apa yang anda dapat</h2>
      <dl class="mt-4 space-y-3 text-sm">
        {specItems.map((spec) => (
          <div class="border-t border-stone-200 pt-3 first:border-t-0 first:pt-0">
            <dt class="text-stone-500">{spec.label}</dt>
            <dd class="mt-1 font-semibold leading-5 text-stone-900">{spec.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={plan.analysisAsAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial">
        <h2 id="sesuai">Siapa yang sesuai dengan {planName}</h2>
        <p>{analysis.bestFor}</p>

        <h2 id="fakta">Fakta utama {planName}</h2>
        <dl class="space-y-5">
          {analysis.facts.map((fact) => (
            <div class="border-t border-stone-200 pt-4">
              <dt class="font-semibold text-stone-900">{fact.label}</dt>
              <dd class="mt-1 leading-7">
                {fact.value}{' '}
                <sup><a href={fact.source} aria-label={`Sumber untuk ${fact.label}`}>[{sourceUrls.indexOf(fact.source) + 1}]</a></sup>
              </dd>
            </div>
          ))}
        </dl>

        <h2 id="had">Had dan perkara yang perlu ditimbang</h2>
        <p>{analysis.tradeoffs}</p>

        <h2 id="perbandingan">{planName} berbanding {siblingName}</h2>
        <ul>
          {analysis.siblingDifferences.map((difference) => <li>{difference}</li>)}
        </ul>
        <p><a href={`/travel-insurance/${sibling.slug}/`}>Lihat manfaat dan syarat {siblingName}</a>.</p>
        <p>
          Untuk membandingkan pilihan perjalanan lain, gunakan <a href="/travel-insurance/">jadual travel insurance Malaysia</a>
          dan padankan had manfaat dengan destinasi serta tempoh perjalanan anda.
        </p>
      </article>

      <section id="faq">
        <div class="prose-editorial">
          <h2>Soalan lazim — {planName}</h2>
        </div>
        <div class="mt-5">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <CtaBand
        heading="Semak semua pilihan travel insurance"
        body="Gunakan halaman hub untuk membandingkan pelan berdasarkan manfaat, syarat dan sumber rasmi."
        primary={{ label: 'Lihat semua travel insurance →', href: '/travel-insurance/' }}
        disclosure="Tiada hubungan berbayar atau affiliate. Pautan luar, jika ada, hanya rujukan; pembelian polisi dibuat di laman penyedia, bukan di Insurans.co."
      />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
