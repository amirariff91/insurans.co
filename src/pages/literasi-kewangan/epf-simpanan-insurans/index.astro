---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Byline from '../../../components/Byline.astro';
import EditorialStamp from '../../../components/EditorialStamp.astro';
import Hero from '../../../components/Hero.astro';
import { buildDescription, buildTitle } from '../../../lib/seo';

const asAt = '2026-09-12';
const pageTitle = 'EPF, Simpanan & Insurans: Mana Dulu?';
const title = buildTitle(pageTitle);
const description = buildDescription(
  'Dana kecemasan, EPF/i-Lindung atau insurans swasta — mana patut dulu? Panduan literasi kewangan ini bagi susunan asas supaya anda tak beli ikut turutan salah.',
);
const h1 = 'EPF, Simpanan & Insurans: Mana Dulu?';
const canonicalUrl = 'https://insurans.co/literasi-kewangan/epf-simpanan-insurans/';
const sources = [
  { label: 'mySalam', url: 'https://www.mysalam.com.my/mys/info/?url=ci' },
  { label: 'KWSP', url: 'https://www.kwsp.gov.my/' },
];

const faqs = [
  {
    q: 'Boleh guna duit EPF untuk beli insurans ke?',
    a: 'Boleh untuk produk tersenarai di i-Lindung dalam app KWSP — contoh disahkan: Etiqa Critical Care Plus dan Critical Care Takaful. Terma dan had ikut produk masing-masing, dan pengeluaran mengurangkan baki persaraan. Semak produk aktif masa apply.',
  },
  {
    q: 'Ada cover majikan — masih perlu medical card sendiri?',
    a: 'Bergantung angka: bandingkan had tahunan majikan dengan kos hospital swasta di bandar anda dan risiko pertukaran kerja (cover majikan berhenti bila anda berhenti). Ramai guna majikan sebagai asas + top-up swasta deductible-tinggi sebagai jaring kedua.',
  },
  {
    q: 'mySalam dengan CI swasta — bertindih ke?',
    a: 'Fungsi berbeza: mySalam skim percuma untuk penerima STR (RM8,000 one-off + RM50/hari hospital, maksimum 14 hari setahun; mesti bermalam di hospital kerajaan/universiti/tentera panel); CI swasta bayar lump sum ikut sum assured untuk ganti pendapatan dan hutang. Penerima mySalam yang ada tanggungan besar mungkin masih ada jurang — kira, jangan assume cukup atau assume perlu.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: asAt,
  dateModified: asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Literasi Kewangan', item: 'https://insurans.co/literasi-kewangan/' },
      { '@type': 'ListItem', position: 3, name: h1, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={asAt}
  modifiedTime={asAt}
>
  <Hero title={h1}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Literasi Kewangan', href: '/literasi-kewangan/' },
        { label: h1 },
      ]}
    />
    <Byline slot="byline" dateModified={asAt} />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      Susunan asas ialah penampan tunai dahulu, audit skim sedia ada kemudian, barulah pertimbang i-Lindung dan top-up
      swasta untuk jurang yang masih tinggal.
    </p>
    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <p class="label">Jawapan ringkas</p>
      <h2 class="mt-2 font-serif text-headline-sm text-stone-900">Penampan tunai → audit → top-up</h2>
      <p class="mt-3 text-sm leading-6 text-stone-700">
        Sasarkan dana kecemasan 3–6 bulan, kenal pasti cover EPF, PERKESO, majikan dan mySalam, kemudian tutup jurang saja.
      </p>
    </div>
    <div class="mt-4 mr-2">
      <EditorialStamp articleDate={asAt} sources={sources} sourcesLabel="Rujukan" showReviewed={false} />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <article class="prose-editorial">
      <p class="text-lg leading-7 text-stone-700">
        Turutan asas yang selamat ialah <strong>penampan tunai → audit percuma atau sedia ada → i-Lindung → top-up swasta
        untuk jurang</strong>. Tujuannya bukan cari produk paling banyak, tetapi tahu apa yang runtuh dulu kalau musibah datang
        bulan ini.
      </p>
      <p class="border-l-4 border-hijau-700 bg-hijau-50 px-4 py-3 text-sm leading-6 text-stone-700">
        <strong>Kami bukan ejen, bukan broker — maklumat am sahaja.</strong> Susunan ini ialah rangka literasi kewangan, bukan
        cadangan produk individu.
      </p>

      <h2 id="turutan">Kenapa turutan penting</h2>
      <p>
        Perlindungan yang dibeli sebelum asas kukuh selalu jadi beban: caruman bulanan makan dana kecemasan, lepas tu polisi
        lapse bila kereta rosak atau kena buang kerja. Turutan betul bukan soal produk terbaik — soal <strong>apa runtuh dulu
        kalau musibah datang bulan ini.</strong>
      </p>

      <h2 id="dana-kecemasan">Langkah 1: Dana kecemasan (3–6 bulan perbelanjaan asas)</h2>
      <p>
        Ini duit tunai, asing dari akaun belanja. Bukan pelaburan, bukan EPF — sebab EPF tak boleh keluar suka hati. Sasaran:
        3 bulan perbelanjaan keperluan minimum (makan, rumah, transport). Kalau RM1,500 sebulan, sasaran awal RM4,500.
      </p>
      <p>
        Belum cukup? Tak apa — mula dengan RM1,000 sebagai penampan, sambil tutup pembelian komitmen baru. Dana ini yang elak
        anda surrender polisi atau swipe kad kredit bila tayar pecah serentak dengan bil perubatan.
      </p>

      <h2 id="skim-sedia-ada">Langkah 2: EPF + skim sedia ada (yang dah tolak gaji)</h2>
      <p>Sebelum tambah apa-apa, audit apa anda DAH ada — ramai tak sedar:</p>
      <ul>
        <li>
          <strong>EPF</strong> — caruman wajib + dividen; ini asas persaraan, bukan dana perubatan. Tapi simpanan EPF boleh
          ditolak dalam kiraan jurang coverage (keperluan kasar tolak simpanan sedia ada).
        </li>
        <li>
          <strong>PERKESO</strong> — Skim Keilatan beri pencen atau elaun bulanan untuk hilang upaya kekal (bukan bayaran
          sekaligus macam CI swasta). Pekerja berdaftar dah dilindungi — semak, bukan beli ganti.
        </li>
        <li>
          <strong>Cover majikan</strong> — panel klinik, had hospital tahunan. Tahu angkanya: kalau majikan cover RM50,000
          setahun, top-up swasta anda cuma perlu tampung lebihan, bukan bermula dari sifar.
        </li>
        <li>
          <strong>mySalam</strong> — skim percuma untuk penerima STR (kerajaan + Great Eastern Holdings): RM8,000 tunai one-off
          untuk 50 penyakit kritikal + RM50/hari pendapatan hospital (mesti bermalam; hospital kerajaan/universiti/tentera
          panel), maksimum 14 hari setahun (RM700). Penerima layak tak perlu beli ganti benda yang sama.
        </li>
      </ul>

      <h2 id="i-lindung">Langkah 3: i-Lindung (guna duit EPF, tapi ingat itu duit anda)</h2>
      <p>
        i-Lindung ialah <strong>saluran</strong>, bukan produk — beli perlindungan guna dana Akaun EPF melalui app KWSP.
        Produk yang disahkan dalam data kami: Etiqa Critical Care Plus (42 kondisi) dan Etiqa Critical Care Takaful (39
        kondisi), plus barisan FWD i-Lindung (term, CI, medical). Kelebihannya: tak usik aliran tunai bulanan. Amaran
        jujurnya: ia tetap mengurangkan baki persaraan — semak had umur dan jumlah cover setiap produk dalam app sebelum apply,
        dan jangan anggap “duit EPF” maksudnya percuma.
      </p>

      <h2 id="top-up">Langkah 4: Top-up swasta (tutup jurang saja)</h2>
      <p>
        Baru di sini beli dari poket sendiri — dan hanya sebesar jurang: keperluan kasar tolak simpanan tolak coverage sedia
        ada. Ada cover majikan RM50,000 + bajet hospital swasta bandar besar? Mungkin top-up deductible-tinggi (<a href="/literasi-kewangan/deductible-co-insurance/">baca artikel deductible dan co-insurance</a>) memadai. Tiada tanggungan? Mungkin CI kecil dahulu, bukan medical besar. Prinsipnya:
        <strong>setiap ringgit caruman mesti tutup jurang yang dah dikenal pasti, bukan risiko yang ejen kenal pasti.</strong>
      </p>
      <p>
        Susunan ringkas: penampan tunai → audit percuma atau sedia ada → i-Lindung untuk asas murah → top-up swasta untuk
        baki jurang. Ikut turutan ini, anda takkan bayar dua kali untuk perlindungan yang sama.
      </p>
    </article>

    <nav class="mt-8 border-t border-stone-200 pt-6" aria-label="Bacaan berkaitan">
      <p class="text-sm text-stone-500">Baca juga:</p>
      <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
        <li><a href="/life-insurance/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Kaedah jurang coverage</a></li>
        <li><a href="/medical-cards/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Bila top-up medical swasta diperlukan</a></li>
        <li><a href="/critical-illness/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Produk CI dalam i-Lindung</a></li>
        <li><a href="/insurans-online/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Saluran beli terus online</a></li>
        <li><a href="/guides/insurance-vs-takaful/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Pilih takaful atau konvensional</a></li>
      </ul>
    </nav>

    <section id="faq" class="mt-10 sm:mt-14">
      <div class="prose-editorial">
        <h2>Soalan lazim EPF, simpanan dan insurans</h2>
      </div>
      <div class="mt-5">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
