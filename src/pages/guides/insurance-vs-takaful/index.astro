// One source for the visible FAQ and its FAQPage JSON-LD: the JSON-LD repeats the visible text exactly.
const faqs = [
  { q: 'Apa beza takaful dan insurans?', a: 'Perbezaan utama takaful dan insurans terletak pada konsep dan pemilikan dana. Dalam insurans konvensional, premium yang anda bayar menjadi milik syarikat. Dalam takaful, wang anda masuk ke dana bersama peserta, yang diurus oleh syarikat takaful sebagai operator. Lebihan dana dikongsi semula kepada peserta, bukan menjadi keuntungan syarikat. Dari segi perlindungan dan proses claim, kedua-duanya hampir sama.' },
  { q: 'Mana lebih baik takaful atau insurans?', a: 'Bergantung pada keutamaan anda. Jika patuh Syariah penting bagi anda, pilih takaful. Jika anda mahu pilihan yang paling jimat, bandingkan quotation daripada kedua-dua jenis untuk kereta anda; ada masanya takaful lebih murah, ada masanya insurans konvensional lebih murah. Dari segi perlindungan, kedua-duanya hampir sama.' },
  { q: 'Beza takaful dan insurans dari segi harga — mana lebih murah?', a: 'Tiada jawapan mutlak. Selepas liberalisasi tarif motor 2017, setiap syarikat boleh menetapkan harga sendiri. Untuk kereta yang sama, takaful daripada Syarikat A mungkin lebih murah daripada insurans konvensional Syarikat B, tetapi lebih mahal daripada Syarikat C. Sentiasa bandingkan quotation untuk kereta anda daripada pelbagai syarikat.' },
  { q: 'Perbezaan takaful dan insurans dari segi claim — susah ke senang?', a: 'Proses claim hampir sama: hubungi syarikat, buat laporan polis dan hantar kereta ke bengkel panel. Pengalaman sebenar bergantung pada syarikat dan jenis kerosakan, bukan pada sama ada ia takaful atau insurans. Semak ulasan pengguna untuk syarikat yang anda pertimbangkan.' },
  { q: 'Non-Muslim boleh beli takaful?', a: 'Ya, 100% boleh. Takaful terbuka untuk semua warganegara Malaysia tanpa mengira agama atau latar belakang. Sesetengah peserta bukan Islam memilih takaful kerana konsep perkongsian lebihan (surplus sharing): ada potensi mendapat semula sebahagian wang jika dana ada lebihan. Tiada syarat agama untuk mendaftar.' },
  { q: 'Boleh pindah NCD dari insurans konvensional ke takaful?', a: 'Ya, NCD anda boleh dibawa ke mana-mana syarikat, sama ada takaful atau insurans konvensional. Jika anda ada NCD 55% dengan syarikat konvensional dan mahu bertukar ke takaful tahun depan, NCD anda kekal 55%.' },
  { q: 'Apa itu surplus sharing dalam takaful?', a: 'Surplus sharing ialah pengagihan lebihan dana takaful kepada peserta pada akhir tempoh polisi. Jika tuntutan yang dibayar lebih rendah daripada sumbangan yang dikutip, lebihan ini dibahagikan mengikut nisbah yang ditetapkan, contohnya 70% kepada peserta dan 30% kepada syarikat. Namun, ia tidak dijamin. Ada tahun yang tiada lebihan langsung.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a },
  })),
};
