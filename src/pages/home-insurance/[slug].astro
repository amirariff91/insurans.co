---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import homeInsurance from '../../data/home-insurance.json';
import { buildDescription, buildTitle } from '../../lib/seo';

type HomeInsuranceRecord = (typeof homeInsurance.records)[number];

const records = homeInsurance.records;
const typeLabels: Record<string, string> = {
  'houseowner-householder': 'Houseowner / Householder',
  'houseowner-householder-takaful': 'Houseowner / Householder takaful',
  'houseowner-comprehensive': 'Houseowner komprehensif',
  'modular-houseowner-householder': 'Modular house cover',
};
const honestyLine = 'Butiran kadar/manfaat tidak disahkan daripada sumber rasmi semasa penyelidikan; semak PDS.';

export function getStaticPaths() {
  return homeInsurance.records.map((record) => ({
    params: { slug: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props as { record: HomeInsuranceRecord };
const canonicalUrl = `https://insurans.co/home-insurance/${record.slug}/`;
const typeLabel = typeLabels[record.type] ?? record.type;
const relatedRecords = record.figureVerified
  ? records.filter((candidate) => candidate.slug !== record.slug).slice(0, 4)
  : [];
const sourceLinks = record.sources.map((url) => ({
  label: new URL(url).hostname.replace(/^www\./, ''),
  url,
}));
const specItems = record.figureVerified
  ? [
      { label: 'Jenis pelan', value: typeLabel },
      { label: 'Perlindungan direkodkan', value: record.coversWhat },
      { label: 'Kadar tariff', value: record.tariffRates },
      { label: 'Premium minimum', value: record.minPremium },
      { label: 'Asas jumlah diinsuranskan', value: record.sumInsuredBasis },
      { label: 'Status quotation', value: record.quoteGated },
    ].filter((item) => item.value !== null && item.value !== undefined && item.value !== '')
  : [];

const typeFaqAnswer = record.figureVerified
  ? record.type.includes('takaful')
    ? 'Rekod ini ialah perlindungan rumah berasaskan takaful. Semak sijil dan PDS untuk skop bangunan, isi rumah, sumbangan, pengecualian dan proses tuntutan.'
    : record.type === 'houseowner-comprehensive'
      ? 'Rekod ini ialah pakej houseowner komprehensif dengan struktur produk tersendiri. Semak PDS untuk tempoh, skop bangunan, had dan pengecualian.'
      : record.type === 'modular-houseowner-householder'
        ? 'Rekod ini ialah produk modular yang membezakan modul houseowner dan householder. Butiran modul perlu disahkan dalam PDS.'
        : 'Rekod ini menggabungkan skop houseowner untuk bangunan dan householder untuk isi rumah. Semak sama ada kedua-dua bahagian diperlukan dan bagaimana hadnya berfungsi.'
  : honestyLine;
const coverageFaqAnswer = record.figureVerified && record.coversWhat
  ? `Sumber rasmi yang dibaca menyatakan: ${record.coversWhat}. Senarai itu ialah ringkasan sumber, bukan pengganti wording polisi atau sijil.`
  : honestyLine;
const tariffFaqAnswer = record.figureVerified && record.tariffRates
  ? `Kadar atau struktur yang direkodkan ialah: ${record.tariffRates}. Angka ini datang daripada sumber yang disenaraikan pada halaman; quotation sebenar boleh bergantung pada skop dan syarat produk.`
  : honestyLine;
const sumInsuredFaqAnswer = record.figureVerified && record.sumInsuredBasis
  ? `Asas jumlah diinsuranskan yang direkodkan ialah: ${record.sumInsuredBasis}. Semak average clause, nilai pembinaan semula dan takrif dalam PDS atau wording.`
  : honestyLine;
const floodFaqAnswer = record.figureVerified
  ? 'Banjir hanya boleh dianggap dilindungi jika dinyatakan dalam skop dan wording produk. Semak had, excess, pengecualian serta syarat tuntutan; jangan samakan semua polisi houseowner atau householder.'
  : honestyLine;
const faqs = [
  {
    q: `Plan ${record.planName} ini jenis insurans rumah apa?`,
    a: typeFaqAnswer,
  },
  {
    q: `Apa yang dilindungi oleh ${record.planName}?`,
    a: coverageFaqAnswer,
  },
  {
    q: `Bagaimana kadar premium untuk ${record.planName}?`,
    a: tariffFaqAnswer,
  },
  {
    q: `Bagaimana menentukan jumlah diinsuranskan untuk ${record.planName}?`,
    a: sumInsuredFaqAnswer,
  },
  {
    q: `${record.planName} cover banjir ke?`,
    a: floodFaqAnswer,
  },
];

const title = buildTitle(`${record.planName} — Insurans Rumah`);
const description = buildDescription(
  record.figureVerified
    ? `Data ${record.planName} oleh ${record.insurer}: skop perlindungan, kadar tariff, asas jumlah diinsuranskan dan sumber rasmi.`
    : `${record.planName} oleh ${record.insurer}: nama produk direkodkan, tetapi kadar dan manfaat belum disahkan daripada sumber rasmi.`,
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${record.planName} — Insurans Rumah`,
  description,
  url: canonicalUrl,
  datePublished: record.asAt,
  dateModified: record.asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Rumah', item: 'https://insurans.co/home-insurance/' },
      { '@type': 'ListItem', position: 3, name: record.planName, item: canonicalUrl },
    ],
  },
};
const outboundSources = sourceLinks.map((source) => ({
  label: `Sumber rasmi · ${source.label}`,
  href: source.url,
  relationship: 'unpaid' as const,
}));
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={record.asAt}
  modifiedTime={record.asAt}
>
  <Hero title={`Insurans rumah: ${record.planName}`}>
    <Byline slot="byline" dateModified={record.asAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Insurans Rumah', href: '/home-insurance/' },
        { label: record.planName },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      {record.figureVerified
        ? `Data ringkas ${record.planName} oleh ${record.insurer}, berdasarkan sumber rasmi yang dibaca pada ${record.asAt}. Tiada anggaran quotation dalam halaman ini.`
        : `${record.planName} oleh ${record.insurer}. ${honestyLine}`}
    </p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="label">Insurans rumah</p>
          <h2 class="mt-2 font-serif text-headline-sm text-stone-900">{record.planName}</h2>
          <p class="mt-1 text-sm leading-5 text-stone-600">{record.insurer}</p>
        </div>
        <span class="inline-flex w-fit border border-hijau-700 bg-hijau-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-hijau-800">
          {typeLabel}
        </span>
      </div>

      {record.figureVerified ? (
        <>
          <h2 class="mt-7 font-serif text-headline-sm text-stone-900">Apa yang direkodkan</h2>
          <dl class="mt-4 space-y-3 text-sm">
            {specItems.map((spec) => (
              <div class="border-t border-stone-200 pt-3 first:border-t-0 first:pt-0">
                <dt class="text-stone-500">{spec.label}</dt>
                <dd class="mt-1 font-semibold leading-5 text-stone-900">{spec.value}</dd>
              </div>
            ))}
          </dl>
        </>
      ) : (
        <p class="mt-7 border-t border-stone-200 pt-4 text-sm leading-5 text-stone-700">{honestyLine}</p>
      )}
    </div>

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={record.asAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial">
        {record.figureVerified ? (
          <>
            <p class="text-lg text-stone-700">
              Halaman ini merumuskan skop yang dinyatakan dalam sumber rasmi {record.planName}. Perlindungan rumah boleh
              memisahkan bangunan dan isi rumah; semak had, pengecualian, average clause serta proses tuntutan dalam polisi
              atau sijil sebenar.
            </p>
            <h2 id="skop">Skop perlindungan yang direkodkan</h2>
            <p>{record.coversWhat}</p>
            <h2 id="kadar">Kadar dan jumlah diinsuranskan</h2>
            <p>
              {record.tariffRates && <>Kadar atau struktur premium yang direkodkan: <strong>{record.tariffRates}</strong>. </>}
              {record.minPremium && <>Minimum premium yang direkodkan: <strong>{record.minPremium}</strong>. </>}
              {record.sumInsuredBasis && <>Asas jumlah diinsuranskan: {record.sumInsuredBasis}. </>}
              {record.quoteGated && <>Nota quotation: {record.quoteGated}.</>}
              Semak angka dan terma semasa dengan penyedia sebelum membuat keputusan.
            </p>
          </>
        ) : (
          <p class="text-lg text-stone-700">{honestyLine}</p>
        )}
      </article>

      <section id="faq">
        <div class="prose-editorial">
          <h2>Soalan lazim — {record.planName}</h2>
        </div>
        <div class="mt-5">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      {relatedRecords.length > 0 && (
        <section id="related">
          <div class="prose-editorial">
            <h2>Produk insurans rumah berkaitan</h2>
            <p>Semak rekod lain daripada set data yang sama; status angka dan manfaat kekal berasingan bagi setiap sumber.</p>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {relatedRecords.map((related) => (
              <article class="card-editorial">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <h3 class="font-semibold text-stone-900">
                      <a href={`/home-insurance/${related.slug}/`} class="text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">
                        {related.planName}
                      </a>
                    </h3>
                    <p class="mt-1 text-sm text-stone-600">{related.insurer}</p>
                  </div>
                  <span class="shrink-0 border border-stone-300 px-2 py-1 text-xs font-semibold text-stone-600">
                    {typeLabels[related.type] ?? related.type}
                  </span>
                </div>
                {related.figureVerified ? (
                  <>
                    <p class="mt-4 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">{related.tariffRates}</p>
                    {related.sumInsuredBasis && (
                      <p class="mt-3 text-sm leading-5 text-stone-600">Asas jumlah: {related.sumInsuredBasis}</p>
                    )}
                  </>
                ) : (
                  <p class="mt-4 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">{honestyLine}</p>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      <CtaBand
        heading="Semak semua insurans rumah"
        body="Kembali ke hub untuk membaca asas houseowner, householder, kadar tariff dan status sumber setiap rekod."
        primary={{ label: 'Lihat semua insurans rumah →', href: '/home-insurance/' }}
        outbound={outboundSources}
        disclosure="Pautan luar membuka sumber rasmi penyedia untuk semakan lanjut. Insurans.co tidak menjual polisi; semak PDS, quotation dan terma semasa dengan penyedia."
      />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
