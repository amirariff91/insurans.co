---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Base from '../../layouts/Base.astro';
import companies from '../../data/companies.json';
import Ikon from '../../components/Ikon.astro';

const conventional = companies.filter(c => c.type === 'conventional');
const takafulOnly = companies.filter(c => c.type === 'takaful');
const withTakaful = companies.filter(c => c.takaful);
const sortedCompanies = [...companies].sort((a, b) => a.name.localeCompare(b.name, 'ms'));

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Senarai Syarikat Insurans Malaysia",
  "description": "Senarai 12 syarikat insurans dan takaful Malaysia — profil, produk, status takaful dan nombor claim Etiqa, Allianz, AIA, Prudential, Zurich.",
  "url": "https://insurans.co/companies/",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
      { "@type": "ListItem", "position": 2, "name": "Syarikat", "item": "https://insurans.co/companies/" }
    ]
  }
};
---

<Base
  title="Senarai Syarikat Insurans Malaysia 2026 — Profil & Nombor Claim"
  description="Senarai 12 syarikat insurans dan takaful Malaysia — profil, produk, status takaful dan nombor claim Etiqa, Allianz, AIA, Prudential, Zurich."
  schema={schema}
>
  <section class="bg-white">
    <div class="container-wide pt-6 pb-4 sm:pt-8">
      <Breadcrumbs items={[{ label: 'Utama', href: '/' }, { label: 'Syarikat' }]} />
      <h1 class="ea-h1 mb-1">
        Syarikat Insurans & Takaful di Malaysia: Senarai, Profil & Nombor Claim
      </h1>
      <section class="mod co-list" aria-labelledby="senarai-syarikat">
        <h2 id="senarai-syarikat" class="mod-bar">{companies.length} syarikat insurans dan takaful berlesen di Malaysia</h2>
        <ul class="co-rows">
          {sortedCompanies.map((company) => (
            <li class="co-r">
              <a href={`/companies/${company.slug}/`} class="co-a">{company.name}<Ikon name="i-kanan" size={18} /></a>
              <span class="co-t">{company.type === 'takaful' ? 'Takaful' : company.takaful ? 'Ada takaful' : 'Insurans'}</span>
              <span class="co-f">{company.verdictBM}</span>
            </li>
          ))}
        </ul>
      </section>
      <p class="text-lg text-stone-700 max-w-2xl leading-relaxed">
        Senarai syarikat insurans dan takaful berlesen di Malaysia — 12 syarikat termasuk Etiqa, Allianz, Zurich, AIA dan Prudential. Semak produk, status takaful dan nombor claim hotline setiap syarikat sebelum renew.
      </p>

      <ul class="flex flex-wrap gap-x-6 gap-y-2 mt-6 text-base text-stone-700">
        <li><strong class="text-stone-900">{companies.length}</strong> syarikat</li>
        <li><strong class="text-stone-900">{withTakaful.length}</strong> ada takaful</li>
        <li><strong class="text-stone-900">{takafulOnly.length}</strong> takaful sahaja</li>
      </ul>
    </div>
  </section>

  <section class="container-wide py-10 sm:py-14">
    <h2 id="claim-hotline" class="h2-bar">Nombor claim hotline syarikat insurans</h2>
    <p class="text-stone-600 max-w-3xl mb-6">
      Mahu membuat claim? Hubungi terus hotline rasmi di bawah — bukan ejen. Semua nombor disalin daripada laman rasmi syarikat. Klik nombor untuk menelefon terus dari telefon bimbit.
    </p>
    <div class="overflow-x-auto mb-3">
      <table class="table-editorial">
        <caption class="sr-only">Nombor claim hotline syarikat insurans</caption>
        <thead>
          <tr>
            <th scope="col">Syarikat</th>
            <th scope="col">Nombor claim (klik untuk call)</th>
            <th scope="col">Ada takaful?</th>
            <th scope="col">Nota</th>
          </tr>
        </thead>
        <tbody>
          {sortedCompanies.map((company) => (
            <tr>
              <td>
                <a href={`/companies/${company.slug}/`}>{company.name}</a>
              </td>
              <td>
                <a href={`tel:${company.claimLine.replace(/\s+/g, '')}`}>{company.claimLine}</a>
              </td>
              <td>{company.takaful ? 'Ya' : 'Tidak'}</td>
              <td>{company.claimLineNote}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-sm text-stone-700 mb-3">Disahkan 10 Sep 2026 daripada laman rasmi</p>
    <p class="text-sm text-stone-600 mb-10">Mahu banding dua syarikat secara terus? <a href="/perbandingan/etiqa-vs-zurich/" class="text-hijau-700 hover:text-hijau-600 hover:underline">Etiqa vs Zurich</a>, <a href="/perbandingan/allianz-vs-zurich/" class="text-hijau-700 hover:text-hijau-600 hover:underline">Allianz vs Zurich</a> atau <a href="/perbandingan/prudential-vs-aia/" class="text-hijau-700 hover:text-hijau-600 hover:underline">Prudential vs AIA</a></p>

  </section>

  <!-- Quick note -->
  <section class="bg-white border-t border-stone-200 py-10">
    <div class="container-article">
      <div class="info-box">
        <p class="text-sm text-stone-700">
          <strong>Cara kami menyusun profil:</strong> Profil disenaraikan mengikut abjad nama syarikat.
          Maklumat fakta dalam setiap profil dirujuk daripada laman rasmi syarikat berkenaan.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .co-list { max-width: 48rem; margin-block: 1rem 1.25rem; }
  .co-rows { list-style: none; margin: 0; padding: 0 0.9rem; display: grid; }
  @media (min-width: 48rem) { .co-rows { grid-template-columns: 1fr 1fr; column-gap: 1.5rem; } }
  .co-r { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 0.75rem; padding: 0.35rem 0 0.5rem; border-bottom: 1px solid rgb(0 0 0 / 0.2); }
  .co-a { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 2.75rem; font-weight: 700; color: var(--ink); text-decoration: underline; text-underline-offset: 0.18em; }
  .co-a:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .co-t { font-size: 0.875rem; font-weight: 600; color: var(--ink); }
  .co-f { grid-column: 1 / -1; font-size: 0.9375rem; color: var(--ink); }
</style>
