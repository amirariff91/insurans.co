---
interface Source {
  label: string;
  url?: string;
  href?: string;
}

interface Props {
  articleDate?: string;
  premiumReviewed?: string;
  sources?: Source[];
  sourcesLabel?: string;
  reviewedLabel?: string;
  showReviewed?: boolean;
}

const {
  articleDate,
  premiumReviewed,
  sources = [],
  sourcesLabel = 'Sumber harga',
  reviewedLabel = 'Anggaran premium dikira',
  showReviewed = true,
} = Astro.props;

function formatDate(value?: string): string {
  if (!value) return 'belum direkodkan';

  const date = new Date(`${value}T00:00:00Z`);
  if (Number.isNaN(date.getTime())) return value;

  return new Intl.DateTimeFormat('ms-MY', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
}

// A bare root domain (PIAM/BNM homepage) is a general reference, never a price source.
const isRootUrl = (u?: string) => !!u && /^https?:\/\/[^/]+\/?$/.test(u);
const priceSources = sources.filter((source) => source.label && (source.url || source.href) && !isRootUrl(source.url || source.href));
const generalRefs = sources.filter((source) => source.label && isRootUrl(source.url || source.href));
const linkClass = 'inline-flex min-h-11 items-center text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600';
---

<div data-editorial-stamp class="border-t border-stone-200 pt-4 text-sm leading-5 text-stone-600">
  <p data-editorial-article-date>Oleh Amir Ariff (Editor) · Tarikh artikel: {formatDate(articleDate)}</p>
  {showReviewed && (
    <p data-editorial-price-reviewed>{reviewedLabel}: {formatDate(premiumReviewed)} · Semakan harga oleh editor: belum direkodkan</p>
  )}
  <p data-editorial-sources>
    <span>{sourcesLabel}:</span>{' '}
    <span data-editorial-source-links>
      {priceSources.length > 0 ? (
        priceSources.map((source, index) => (
          <span>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a href={source.url || source.href} class={linkClass}>{source.label}</a>
          </span>
        ))
      ) : (
        'belum direkodkan'
      )}
    </span>
  </p>
  {generalRefs.length > 0 && (
    <p data-editorial-general-refs>
      Rujukan umum:
      {generalRefs.map((source, index) => (
        <span>
          {index > 0 && <span aria-hidden="true"> · </span>}
          <a href={source.url || source.href} class={linkClass}>{source.label}</a>
        </span>
      ))}
    </p>
  )}
</div>
