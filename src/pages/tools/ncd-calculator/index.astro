---
import Base from '../../../layouts/Base.astro';
import carModels from '../../../data/car-models.json';
import { NCD_TIERS } from '../../../lib/ncd';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kalkulator NCD Insurans Kereta Malaysia",
  "description": "Kira NCD insurans kereta anda secara percuma. Semak berapa anda jimat dengan NCD 25%, 30%, 38.33%, 45% atau 55%. Termasuk kalkulator 'patut ke claim?'",
  "url": "https://insurans.co/tools/ncd-calculator/",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "MYR" },
  "inLanguage": "ms",
  "publisher": {
    "@type": "Organization",
    "name": "Insurans.co",
    "url": "https://insurans.co"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://insurans.co/tools/" },
      { "@type": "ListItem", "position": 3, "name": "Kalkulator NCD", "item": "https://insurans.co/tools/ncd-calculator/" }
    ]
  }
};

const modelReferences = Object.fromEntries(
  carModels.map((car) => [
    car.slug,
    {
      fullName: car.fullName,
      premiumNCD0Min: car.premiumNCD0Min,
      premiumNCD0Max: car.premiumNCD0Max,
    },
  ]),
);
---

<Base
  title="Kalkulator NCD Insurans Kereta — Kira Diskaun & Jimat Premium"
  description="Kira NCD insurans kereta anda dalam beberapa saat. Masukkan premium anda, pilih NCD, dan tengok berapa anda boleh jimat. Termasuk kalkulator 'patut ke claim?'"
  schema={schema}
  pageType="tool"
>
  <!-- Header -->
  <section class="bg-white border-b border-stone-200">
    <div class="container-wide py-10 sm:py-14">
      <nav class="text-sm text-stone-400 mb-5">
        <a href="/" class="hover:text-hijau-700 text-stone-500">Utama</a>
        <span class="mx-2">›</span>
        <a href="/tools/" class="hover:text-hijau-700 text-stone-500">Tools</a>
        <span class="mx-2">›</span>
        <span class="text-stone-700">Kalkulator NCD</span>
      </nav>
      <p class="label mb-3">Free Tool</p>
      <h1 class="font-serif text-headline-lg sm:text-headline-xl text-stone-900 mb-4">
        Kalkulator NCD Insurans Kereta
      </h1>
      <p class="text-lg text-stone-600 max-w-2xl leading-relaxed">
        Masukkan premium asal anda, pilih NCD semasa — dan tengok berapa sebenarnya anda jimat.
        Termasuk kalkulator <strong>"patut ke claim?"</strong> supaya anda tak rugi lepas accident kecil.
      </p>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">

      <!-- Main: Calculators -->
      <div class="lg:col-span-2 space-y-10">

        <!-- ── CALCULATOR 1: NCD Savings ── -->
        <div class="bg-white border-2 border-stone-900 p-6 sm:p-8">
          <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 mb-1">Kira Premium Selepas NCD</h2>
          <p class="text-stone-500 text-sm mb-6">Anggaran premium asas selepas potongan NCD.</p>

          <div class="space-y-5">
            <!-- Premium input -->
            <div>
              <label for="base-premium" class="block text-sm font-semibold text-stone-700 mb-1.5">
                Premium Asas (sebelum NCD) — RM
              </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 font-medium text-sm">RM</span>
                <input
                  type="number"
                  id="base-premium"
                  placeholder="cth: 2000"
                  min="100"
                  max="50000"
                  class="w-full pl-10 pr-4 py-3 border border-stone-300 focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100 outline-none text-stone-900 font-medium text-lg transition-colors"
                />
              </div>
              <p class="text-xs text-stone-400 mt-1.5">Gunakan premium asas sebelum NCD, tanpa perlindungan tambahan, cukai, duti atau roadtax.</p>
            </div>

            <!-- NCD selector -->
            <div>
              <label class="block text-sm font-semibold text-stone-700 mb-2">NCD Semasa Anda</label>
              <div class="grid grid-cols-3 sm:grid-cols-6 gap-2" id="ncd-selector">
                {NCD_TIERS.map((tier) => (
                  <button
                    type="button"
                    data-ncd={tier.value}
                    class="ncd-btn py-3 px-1 border-2 border-stone-200 text-center text-sm font-bold text-stone-500 hover:border-hijau-500 hover:text-hijau-700 transition-colors"
                  >
                    {tier.label}
                  </button>
                ))}
              </div>
              <p class="text-xs text-stone-400 mt-1.5">
                Tak tahu NCD anda? Semak di <a href="https://www.mycarinfo.com.my/ncdcheck/online" target="_blank" rel="noopener noreferrer" class="text-hijau-700 underline">MyCarInfo</a> atau hubungi syarikat insurans anda. <a href="https://www.zurich.com.my/knowledge-hub/articles/2023/getting-to-know-ncd-no-claim-discount" target="_blank" rel="noopener noreferrer" class="text-hijau-700 underline">Rujukan Zurich</a>.
              </p>
            </div>
          </div>

          <!-- Result -->
          <div id="ncd-result" class="hidden mt-6 p-5 bg-hijau-50 border border-hijau-200">
            <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
              <div>
                <p class="text-sm text-stone-500">Anggaran premium asas selepas NCD</p>
                <p id="result-premium" class="font-serif text-4xl font-bold text-hijau-700 mt-0.5"></p>
              </div>
              <div class="text-right">
                <p class="text-sm text-stone-500">Jimat berbanding 0% NCD</p>
                <p id="result-saving" class="font-serif text-2xl font-bold text-stone-900 mt-0.5"></p>
              </div>
            </div>
            <div id="result-breakdown" class="border-t border-hijau-200 pt-4 space-y-2"></div>
          </div>
          <p id="model-reference" hidden class="mt-5 border-t border-stone-200 pt-4 text-sm leading-5 text-stone-700">
            <span class="font-semibold text-stone-900">Julat rujukan</span>
            <span id="model-reference-name"></span>:
            <span id="model-reference-range" class="numeric"></span> (NCD 0%)
          </p>
          <p id="handoff-note" hidden class="mt-3 border border-emas-800 bg-emas-50 p-3 text-sm leading-5 text-stone-800"></p>
        </div>
        <script id="model-reference-data" type="application/json" set:html={JSON.stringify(modelReferences)}></script>


        <!-- ── CALCULATOR 2: Should I Claim? ── -->
        <div class="bg-white border-2 border-stone-200 p-6 sm:p-8">
          <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 mb-1">Patut Ke Claim?</h2>
          <p class="text-stone-500 text-sm mb-6">Accident kecil? Kira sama ada worth it untuk claim atau bayar sendiri.</p>

          <div class="space-y-5">
            <!-- Current premium (after NCD) -->
            <div>
              <label for="current-premium" class="block text-sm font-semibold text-stone-700 mb-1.5">
                Premium Asas Semasa (selepas NCD) — RM
              </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 font-medium text-sm">RM</span>
                <input
                  type="number"
                  id="current-premium"
                  placeholder="cth: 900"
                  min="100"
                  max="50000"
                  class="w-full pl-10 pr-4 py-3 border border-stone-300 focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100 outline-none text-stone-900 font-medium text-lg transition-colors"
                />
              </div>
              <p class="text-xs text-stone-400 mt-1.5">Asingkan perlindungan tambahan dan bayaran lain daripada jumlah bil sebelum mengisi angka ini.</p>
            </div>

            <!-- Current NCD % for claim calc -->
            <div>
              <label for="current-ncd-pct" class="block text-sm font-semibold text-stone-700 mb-1.5">
                NCD Semasa (%)
              </label>
              <select
                id="current-ncd-pct"
                class="w-full px-4 py-3 border border-stone-300 focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100 outline-none text-stone-900 font-medium text-base transition-colors bg-white"
              >
                {[...NCD_TIERS].reverse().map((tier) => (
                  <option value={tier.value}>{tier.label} ({tier.value === 0 ? 'Tiada NCD yang layak' : tier.years})</option>
                ))}
              </select>
            </div>

            <!-- Repair cost -->
            <div>
              <label for="repair-cost" class="block text-sm font-semibold text-stone-700 mb-1.5">
                Anggaran Kos Repair — RM
              </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 font-medium text-sm">RM</span>
                <input
                  type="number"
                  id="repair-cost"
                  placeholder="cth: 800"
                  min="0"
                  max="100000"
                  class="w-full pl-10 pr-4 py-3 border border-stone-300 focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100 outline-none text-stone-900 font-medium text-lg transition-colors"
                />
              </div>
            </div>

            <!-- Excess -->
            <div>
              <label for="excess" class="block text-sm font-semibold text-stone-700 mb-1.5">
                Excess Polisi Anda — RM
              </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 font-medium text-sm">RM</span>
                <input
                  type="number"
                  id="excess"
                  value="400"
                  min="0"
                  max="5000"
                  class="w-full pl-10 pr-4 py-3 border border-stone-300 focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100 outline-none text-stone-900 font-medium text-lg transition-colors"
                />
              </div>
            </div>

            <button
              id="claim-calc-btn"
              class="w-full py-3.5 bg-stone-900 text-white font-semibold text-sm hover:bg-stone-800 transition-colors"
            >
              Kira — Patut Claim Tak?
            </button>
          </div>

          <!-- Claim Result -->
          <div id="claim-result" class="hidden mt-6"></div>
        </div>

        <section class="prose-editorial" aria-labelledby="cara-kiraan">
          <h2 id="cara-kiraan">Cara kiraan ini dibuat</h2>
          <p>
            Kalkulator ini menggunakan premium asas sebelum NCD dan kadar yang anda pilih. Masukkan angka premium asas daripada pecahan sebut harga, kemudian pilih NCD yang layak digunakan. Potongan dikira dengan formula <strong>premium asas × NCD ÷ 100</strong>. Baki premium asas ialah <strong>premium asas × (1 − NCD ÷ 100)</strong>. <a href="https://www.etiqa.com.my/pdfs/en/insurance/Product+Disclosure+Sheet+Private+Car+Insurance.pdf" target="_blank" rel="noopener noreferrer">PDS Etiqa</a> menunjukkan premium asas ditolak NCD sebelum perlindungan tambahan dan bayaran lain.
          </p>
          <p>
            Sebagai contoh matematik, premium asas RM2,000 dengan NCD 55% memberi potongan RM1,100 dan baki RM900. Angka itu belum termasuk perlindungan tambahan, cukai, duti atau roadtax. Paparan ringgit dibundarkan kepada ringgit terdekat. Pilihan 38.33% menggunakan nilai perpuluhan itu; ikut pembundaran syarikat pada sebut harga akhir, terutama jika kontrak menggunakan kadar 38⅓%.
          </p>
          <p>
            Jadual di sini untuk kereta persendirian. <a href="https://www.zurich.com.my/knowledge-hub/articles/2023/getting-to-know-ncd-no-claim-discount" target="_blank" rel="noopener noreferrer">Zurich Malaysia</a> menerbitkan skala berasingan untuk motosikal dan menyediakan pautan semakan MyCarInfo. Kalkulator ini tidak menyemak rekod polisi atau menentukan kelayakan NCD anda. Sahkan kadar dengan syarikat sebelum renew. Premium asas juga boleh berubah mengikut nilai diinsuranskan, model, umur pemohon, pengalaman tuntutan dan pengunderaitan, seperti diterangkan dalam PDS Etiqa.
          </p>
          <p>
            Bahagian “Patut Ke Claim?” menganggarkan premium sebelum NCD melalui <strong>premium asas selepas NCD ÷ (1 − NCD ÷ 100)</strong>. Bayaran bersih anggaran ialah kos repair ditolak excess, dengan minimum RM0. Kiraan mengandaikan tuntutan own damage biasa menjadikan NCD 0% pada pembaharuan seterusnya dan premium asas kekal sama. Petunjuknya membandingkan bayaran bersih dengan dua kali tambahan premium asas tahun pertama. Ambang dua tahun ini ialah kaedah perbandingan alat, bukan syarat tuntutan syarikat.
          </p>
          <p>
            Kiraan tidak meramal kenaikan semula NCD selepas tahun pertama, perubahan harga atau keputusan tuntutan. OD-KfK yang layak dan tuntutan cermin di bawah perlindungan tambahan berkenaan boleh mengekalkan NCD. Semak pengecualian dalam <a href="https://www.etiqa.com.my/pdfs/en/insurance/Private+Car+Insurance+Policy+Contract.pdf" target="_blank" rel="noopener noreferrer">kontrak Etiqa</a> dan baca <a href="/guides/ncd-explained/">panduan NCD lengkap</a> sebelum menggunakan hasil untuk membuat keputusan.
          </p>
        </section>

        <!-- ── NCD Table ── -->
        <div class="prose-editorial">
          <h2>Jadual NCD Kereta Persendirian Malaysia 2026</h2>
          <p>NCD meningkat mengikut tempoh insurans tanpa tuntutan, sehingga maksimum 55% untuk kereta persendirian. Rujuk <a href="https://www.zurich.com.my/knowledge-hub/articles/2023/getting-to-know-ncd-no-claim-discount" target="_blank" rel="noopener noreferrer">jadual Zurich Malaysia</a>.</p>
        </div>

        <div class="overflow-x-auto my-6">
          <table class="table-editorial">
            <thead>
              <tr>
                <th>Tahun Tanpa Claim</th>
                <th>NCD</th>
                <th>Contoh: Premium Asas RM2,000</th>
                <th>Baki premium asas</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Tiada NCD yang layak</td>
                <td class="font-semibold">0%</td>
                <td>Tiada diskaun</td>
                <td class="font-bold text-stone-900">RM2,000</td>
              </tr>
              <tr>
                <td>1 tahun tanpa claim</td>
                <td class="font-semibold">25%</td>
                <td>Diskaun RM500</td>
                <td class="font-bold text-hijau-700">RM1,500</td>
              </tr>
              <tr>
                <td>2 tahun tanpa claim</td>
                <td class="font-semibold">30%</td>
                <td>Diskaun RM600</td>
                <td class="font-bold text-hijau-700">RM1,400</td>
              </tr>
              <tr>
                <td>3 tahun tanpa claim</td>
                <td class="font-semibold">38.33%</td>
                <td>Diskaun RM767</td>
                <td class="font-bold text-hijau-700">RM1,233</td>
              </tr>
              <tr>
                <td>4 tahun tanpa claim</td>
                <td class="font-semibold">45%</td>
                <td>Diskaun RM900</td>
                <td class="font-bold text-hijau-700">RM1,100</td>
              </tr>
              <tr class="bg-hijau-50">
                <td class="font-semibold">5+ tahun tanpa claim</td>
                <td class="font-semibold text-hijau-700">55% (Max)</td>
                <td>Diskaun RM1,100</td>
                <td class="font-bold text-hijau-700 text-lg">RM900</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Content -->
        <article class="prose-editorial">
          <h2>Apa yang berlaku kepada NCD kalau saya claim?</h2>
          <p>
            Tuntutan <strong>own damage biasa</strong> boleh menjadikan NCD <strong>0% pada pembaharuan seterusnya</strong>.
            OD-KfK yang memenuhi syarat dan tuntutan cermin di bawah perlindungan tambahan berkenaan boleh mengekalkan NCD. Rujuk <a href="https://www.etiqa.com.my/pdfs/en/insurance/Private+Car+Insurance+Policy+Contract.pdf" target="_blank" rel="noopener noreferrer">Seksyen C dan Endorsement 89 kontrak Etiqa</a>.
          </p>
          <p>
            Bandingkan kos repair, excess dan kesan NCD sebelum memilih cara tuntutan. Tuntutan pihak ketiga terhadap polisi anda juga boleh menjejaskan NCD walaupun anda membayar repair sendiri, mengikut <a href="https://www.etiqa.com.my/pdfs/en/insurance/Private+Car+Insurance+Policy+Contract.pdf" target="_blank" rel="noopener noreferrer">Seksyen C kontrak Etiqa</a>.
          </p>

          <h3>Contoh kiraan own damage biasa:</h3>
          <p>
            Andaikan kos repair <strong>RM600</strong>, excess RM0, NCD <strong>55%</strong> dan premium asas <strong>RM2,000</strong> yang kekal sama pada pembaharuan seterusnya.
          </p>
          <ul>
            <li>Kalau <strong>claim dan NCD menjadi 0%</strong>: Bayaran repair RM600, tetapi premium asas tahun depan menjadi RM2,000 berbanding RM900 jika NCD kekal. Tambahan premium asas: <strong>RM1,100</strong>.</li>
            <li>Kalau <strong>bayar sendiri dan NCD kekal 55%</strong>: Keluar RM600 untuk repair. Dalam perbandingan tahun pertama ini, kosnya <strong>RM500 lebih rendah</strong> daripada tambahan premium asas RM1,100.</li>
          </ul>
          <p>
            Contoh ini mengasingkan kesan NCD sahaja. Gunakan kos repair dan excess sebenar, kemudian sahkan kategori tuntutan dengan syarikat.
          </p>

          <h2>Soalan lazim tentang NCD</h2>
        </article>

        <div class="my-6 space-y-0">
          <details class="faq-item" open>
            <summary>Boleh ke pindah NCD ke kereta lain?</summary>
            <p>
              NCD hanya boleh dipindahkan antara kenderaan atas nama pemegang polisi yang sama, bukan kepada pasangan, anak atau orang lain.
              Maklumkan syarikat insurans untuk menguruskan penarikan NCD daripada polisi lama. Rujuk <a href="https://piam.org.my/news-media/stay-ahead/articles/page/how-to-transfer-your-ncd-when-buying-a-new-car-in-malaysia/" target="_blank" rel="noopener noreferrer">panduan pemindahan PIAM</a> dan <a href="/guides/ncd-explained/">panduan NCD lengkap</a>.
            </p>
          </details>
          <details class="faq-item">
            <summary>Kalau kereta kena langgar dan bukan salah saya, NCD kena reset juga?</summary>
            <p>
              Tuntutan OD-KfK yang memenuhi syarat boleh mengekalkan NCD apabila pihak ketiga bersalah dan polis mengesahkan anda tidak bersalah.
              <a href="https://piam.org.my/insurance-101/individual/motor/" target="_blank" rel="noopener noreferrer">PIAM menerangkan syarat OD-KfK</a>. Tuntutan pihak ketiga terhadap polisi anda pula boleh menjejaskan NCD, mengikut <a href="https://www.etiqa.com.my/pdfs/en/insurance/Private+Car+Insurance+Policy+Contract.pdf" target="_blank" rel="noopener noreferrer">Seksyen C kontrak Etiqa</a>. Sahkan kategori tuntutan dan syarat polisi dengan syarikat; baca <a href="/guides/ncd-explained/">panduan NCD lengkap</a>.
            </p>
          </details>
          <details class="faq-item">
            <summary>Berapa lama NCD kekal kalau saya tak renew insurans?</summary>
            <p>
              Kontrak kereta Etiqa menyatakan NCD berundur mengikut jadual bagi setiap tahun NCD tidak digunakan.
              Semak tempoh tidak digunakan dan kadar sebenar dengan syarikat. Perlindungan insurans tetap mengikut tarikh dalam jadual polisi. Rujuk <a href="https://www.etiqa.com.my/pdfs/en/insurance/Private+Car+Insurance+Policy+Contract.pdf" target="_blank" rel="noopener noreferrer">Seksyen C kontrak Etiqa</a> dan <a href="/guides/ncd-explained/">panduan NCD lengkap</a>.
            </p>
          </details>
          <details class="faq-item">
            <summary>Boleh ke ada NCD untuk insurans kereta lagi dari satu?</summary>
            <p>
              Setiap kenderaan mempunyai rekod NCD sendiri. NCD boleh dipindahkan antara kenderaan milik anda selepas penarikan daripada polisi asal; satu rekod NCD tidak digunakan serentak untuk dua kereta. Rujuk <a href="https://piam.org.my/news-media/stay-ahead/articles/page/how-to-transfer-your-ncd-when-buying-a-new-car-in-malaysia/" target="_blank" rel="noopener noreferrer">penerangan PIAM</a>.
            </p>
          </details>
        </div>

        <!-- Related tools CTA -->
        <div class="bg-stone-50 border border-stone-200 p-6">
          <p class="text-sm font-semibold text-stone-700 mb-3">Langkah seterusnya</p>
          <div class="grid sm:grid-cols-2 gap-3">
            <a href="/car-insurance/" class="block p-4 bg-white border border-stone-200 hover:border-hijau-500 transition-colors group">
              <p class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700">Panduan Insurans Kereta →</p>
              <p class="text-xs text-stone-500 mt-0.5">Harga, jenis coverage, cara renew</p>
            </a>
            <a href="/guides/ncd-explained/" class="block p-4 bg-white border border-stone-200 hover:border-hijau-500 transition-colors group">
              <p class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700">Panduan NCD Lengkap →</p>
              <p class="text-xs text-stone-500 mt-0.5">Semua yang anda perlu tahu tentang NCD</p>
            </a>
            <a href="/companies/" class="block p-4 bg-white border border-stone-200 hover:border-hijau-500 transition-colors group">
              <p class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700">Bandingkan Syarikat →</p>
              <p class="text-xs text-stone-500 mt-0.5">Pilih syarikat insurans terbaik</p>
            </a>
            <a href="/guides/how-to-claim/" class="block p-4 bg-white border border-stone-200 hover:border-hijau-500 transition-colors group">
              <p class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700">Cara Buat Claim →</p>
              <p class="text-xs text-stone-500 mt-0.5">Langkah-langkah buat tuntutan insurans</p>
            </a>
          </div>
        </div>

        <!-- Car model quick links -->
        <div class="bg-white border border-stone-200 p-6">
          <p class="text-sm font-semibold text-stone-700 mb-3">Semak harga premium untuk kereta anda</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            <a href="/car-insurance/perodua-myvi/" class="text-sm text-hijau-700 hover:text-hijau-600 font-medium p-2 border border-stone-100 hover:border-hijau-300 transition-colors">Perodua Myvi</a>
