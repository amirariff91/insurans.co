  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "NCD (No Claim Discount) — Panduan Lengkap",
      "description": "Jadual NCD kereta dan motosikal Malaysia, cara semak, aturan pemindahan, penarikan NCD dan kesan tuntutan.",
      "url": "https://insurans.co/guides/ncd-explained/",
