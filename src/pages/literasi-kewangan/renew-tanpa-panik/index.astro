---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TrustStrip from '../../../components/edisi/TrustStrip.astro';
import EditorialStamp from '../../../components/EditorialStamp.astro';
import Hero from '../../../components/Hero.astro';
import PageAnswer from '../../../components/edisi/PageAnswer.astro';
import { buildDescription, buildTitle } from '../../../lib/seo';

const asAt = '2026-09-12';
const pageTitle = 'Renew Roadtax & Insurans Tanpa Panik Setiap Tahun';
const title = buildTitle(pageTitle);
const description = buildDescription(
  'Renew insurans dan roadtax setiap tahun tanpa kelam-kabut: turutan NCD, sum insured, roadtax dan fail PDF. Ritual tahunan perancangan kewangan keluarga.',
);
const h1 = 'Renew Roadtax & Insurans Tanpa Panik Setiap Tahun';
const canonicalUrl = 'https://insurans.co/literasi-kewangan/renew-tanpa-panik/';
const sources = [
  { label: 'JPJ: panduan LKM', url: 'https://www.jpj.gov.my/wp-content/uploads/2026/07/Lampiran-A-Garis_Panduan_Pengiraan_LKM_Bajet_20092-2.pdf' },
  { label: 'MyEG', url: 'https://www.myeg.com.my/' },
];

const faqs = [
  {
    q: 'Bila patut mula renew?',
    a: '2–4 minggu sebelum tamat. Jangan tunggu saat akhir. Jika polisi luput (lapse), anda tidak sah memandu di jalan raya dan NCD boleh terjejas. Peringatan kalendar dan folder PDF tahunan menjadikan proses ini automatik.',
  },
  {
    q: 'Renew guna MyEG atau Bjak?',
    a: 'Dua urusan berbeza. Untuk insurans, minta sebut harga terus daripada syarikat insurans (lihat senarai beli online di /insurans-online/). MyEG ialah rakan niaga JPJ untuk roadtax (tambah saman dan insurans dalam satu platform, dengan yuran servis). Untuk roadtax, guna saluran rasmi (MyJPJ atau MyEG). JPJ menyatakan (2024) Bjak tiada kebenaran rasmi untuk roadtax.',
  },
  {
    q: 'Sum insured ikut apa sebenarnya?',
    a: 'Semak sama ada polisi menggunakan nilai pasaran atau nilai dipersetujui. Bagi polisi nilai pasaran, gunakan penilaian semasa, bukan harga beli atau baki pinjaman. Kurang insurans boleh mengurangkan bayaran mengikut syarat polisi. Semak angka yang dikesan secara automatik oleh aggregator dengan harga pasaran semasa sebelum bayar.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: asAt,
  dateModified: asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Literasi Kewangan', item: 'https://insurans.co/literasi-kewangan/' },
      { '@type': 'ListItem', position: 3, name: h1, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={asAt}
  modifiedTime={asAt}
>
  <Hero title={h1}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Literasi Kewangan', href: '/literasi-kewangan/' },
        { label: h1 },
      ]}
    />
    <TrustStrip slot="trust" date={asAt} sources={sources} />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-900">
      Mula 2–4 minggu sebelum tamat dan ikut satu turutan: semak NCD, nilai pasaran, quotation dan add-on, kemudian bayar,
      simpan e-cover note dan renew roadtax.
    </p>
    <PageAnswer
      slot="answer"
      finding="NCD, nilai, quote, PDF"
      facts={[
        { label: 'Mula', value: '2–4 minggu sebelum tamat', role: 'term' },
        { label: 'Turutan', value: 'semak NCD, nilai pasaran, quotation dan add-on' },
        { label: 'Kemudian', value: 'bayar, simpan e-cover note dan renew roadtax' },
      ]}
    />
    <div class="mt-4 mr-2">
      <EditorialStamp articleDate={asAt} sources={sources} sourcesLabel="Rujukan" showReviewed={false} />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <article class="prose-editorial prose-bars">
      <p class="text-lg leading-7 text-stone-700">
        Panik renew biasanya berlaku apabila semuanya dibuat serentak pada minggu terakhir. Jika anda mula
        <strong>2–4 minggu sebelum tarikh tamat</strong>, ada masa untuk membandingkan 2–3 quotation dan menyemak dokumen sebelum bayar.
      </p>
      <p class="note-plain text-sm leading-6">
        <strong>Kami bukan ejen, bukan broker. Maklumat am sahaja.</strong> Aggregator hanya rujukan pasaran; semak saluran
        rasmi dan dokumen polisi sebelum bayar.
      </p>

      <h2 id="panik">NCD dan sum insured disemak dahulu</h2>
      <p>
        Ikut langkah di bawah mengikut urutan. Quotation yang anda terima bergantung pada NCD dan sum insured, jadi dua semakan itu
        dibuat sebelum anda meminta sebut harga.
      </p>

      <h2 id="ncd">Langkah 1: Semak NCD anda dahulu</h2>
      <p>
        NCD (diskaun tanpa tuntutan) menentukan harga premium: 0% hingga 55% ikut rekod tanpa claim. Semak di MyEG atau tanya
        syarikat insurans semasa, dan simpan tangkapan skrin angkanya. Jika NCD salah, quotation juga salah: anda mungkin bayar lebih atau polisinya bermasalah. Jika
        baru mengalami kemalangan, kira dulu “patut ke claim?” dengan kalkulator sebelum NCD yang anda kumpul bertahun-tahun ditetapkan semula.
      </p>

      <h2 id="sum-insured">Langkah 2: Semak sum insured (nilai pasaran, bukan harga beli)</h2>
      <p>
        Semak sama ada polisi menggunakan nilai pasaran atau nilai dipersetujui. Bagi polisi nilai pasaran, gunakan <strong>penilaian semasa</strong>.
        Kurang insurans boleh mengurangkan bayaran mengikut syarat polisi. Sistem aggregator biasanya mengesan nilai secara automatik, tetapi semak sendiri.
        Bagi kereta berusia 5 tahun yang menggunakan polisi nilai pasaran, gunakan nilai pasaran semasa, bukan harga belinya dahulu.
      </p>

      <h2 id="quotation">Langkah 3: Banding 2–3 quotation + add-on yang perlu sahaja</h2>
      <p>
        Minta sebut harga terus daripada dua atau tiga syarikat insurans untuk perlindungan yang sama
        (<a href="/insurans-online/#beli-terus">lihat senarai beli online</a>). Senarai itu bukan kedudukan editorial sesiapa. Selepas itu, pilih add-on yang perlu sahaja: cermin (jika kereta selalu di lebuh raya), banjir atau special perils (kawasan rendah: baca
        panduan banjir kami), dan tolak yang tidak perlu. Untuk roadtax pula, JPJ menyatakan (Mei 2024) Bjak tiada kebenaran rasmi untuk
        renew roadtax dan tiada integrasi MySikap. Guna saluran rasmi (MyJPJ atau MyEG).
      </p>

      <h2 id="bayar">Langkah 4: Bayar, simpan e-cover note, renew roadtax dan failkan PDF</h2>
      <ol>
        <li>Bayar dalam talian (FPX atau kad; sesetengah insurer terima ansuran).</li>
        <li>E-cover note dihantar melalui e-mel. <strong>Simpan PDF itu terus</strong> kerana ini bukti insurans sah.</li>
        <li>Renew roadtax: MyEG (ada yuran servis RM2.50 + SST 8% + pos kurier), Pos Malaysia, JPJ atau MyJPJ untuk kes khas.</li>
        <li>Buat folder “Renew 2027”: PDF polisi + e-cover note + resit roadtax + tangkapan skrin NCD. Set peringatan kalendar 3 minggu sebelum tamat tahun depan. Jumlah belanja tahun ini = premium (selepas NCD) + roadtax.</li>
      </ol>
    </article>

    <nav class="mt-8 border-t border-stone-200 pt-6" aria-label="Bacaan berkaitan">
      <p class="text-sm text-stone-500">Baca juga:</p>
      <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
        <li><a href="/tools/ncd-calculator/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Semak NCD + kira claim-vs-bayar</a></li>
        <li><a href="/guides/renew-car-insurance/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Panduan renew langkah demi langkah</a></li>
        <li><a href="/guides/ncd-explained/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Jadual NCD 25%–55%</a></li>
        <li><a href="/guides/cara-turun-premium-insurans-kereta/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">10 cara turunkan premium</a></li>
        <li><a href="/insurans-online/#beli-terus" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Senarai beli insurans online terus dari syarikat</a></li>
      </ul>
    </nav>

    <section id="faq" class="mt-10 sm:mt-14">
      <div class="prose-editorial prose-bars">
        <h2>Soalan lazim renew roadtax dan insurans</h2>
      </div>
      <div class="mt-5">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
