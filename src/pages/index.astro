---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import EditorialStamp from '../components/EditorialStamp.astro';
import Ikon from '../components/Ikon.astro';
import CarThumb from '../components/CarThumb.astro';
import HomeAnswer from '../components/edisi/HomeAnswer.astro';
import Dock from '../components/edisi/Dock.astro';
import ModelRail from '../components/edisi/ModelRail.astro';
import ToolsRail from '../components/edisi/ToolsRail.astro';
import TerkiniRail from '../components/edisi/TerkiniRail.astro';
import HomeTypes from '../components/edisi/HomeTypes.astro';
import '../styles/edisi-answer.css';
import companies from '../data/companies.json';
import carModels from '../data/car-models.json';
import comparisons from '../data/comparisons.json';

const topMotorInsurers = companies.filter(c => c.products.includes('car')).slice(0, 6);
const popularCars = carModels.filter(car => ['perodua-axia', 'perodua-myvi', 'proton-saga', 'toyota-vios', 'honda-city', 'honda-civic'].includes(car.slug));
const exampleModel = carModels.find((car) => car.slug === 'perodua-axia') ?? carModels[0];
const companyCount = companies.length;
// Hero lead figures read from the same data as the Axia and Myvi model pages.
const leadNum = (value: number) => value.toLocaleString('en-MY');
const leadAxia = carModels.find((car) => car.slug === 'perodua-axia')!;
const leadMyvi = carModels.find((car) => car.slug === 'perodua-myvi')!;
const leadSmall55 = `RM${leadNum(leadAxia.premiumNCD55Min)}–RM${leadNum(leadMyvi.premiumNCD55Max)}`;
const leadSmall0 = `RM${leadNum(leadAxia.premiumNCD0Min)}–RM${leadNum(leadMyvi.premiumNCD0Max)}`;
const carModelCount = carModels.length;
// Front-page picker: the most-searched models, in the concept's order. Figures come from car-models.json via carSteps.
const pickSlugs = ['perodua-myvi', 'perodua-axia', 'perodua-bezza', 'proton-saga', 'honda-city', 'toyota-vios', 'proton-x50', 'perodua-alza'];
const pickModels = pickSlugs.map((slug) => carModels.find((car) => car.slug === slug)).filter(Boolean);
const calculators = [
  { href: '/tools/ncd-calculator/', label: 'Kalkulator NCD', icon: 'i-peratus' },
  { href: '/tools/kalkulator-roadtax/', label: 'Kalkulator roadtax kereta', icon: 'i-roadtax' },
  { href: '/tools/kalkulator-roadtax-motosikal/', label: 'Kalkulator roadtax motosikal', icon: 'i-roadtax' },
  { href: '/tools/kalkulator-roadtax-ev/', label: 'Kalkulator roadtax kereta elektrik', icon: 'i-roadtax' },
  { href: '/tools/kalkulator-insurans-rumah/', label: 'Kalkulator insurans rumah', icon: 'i-utama' },
  { href: '/tools/kalkulator-coverage-nyawa/', label: 'Kalkulator coverage nyawa', icon: 'i-orang' },
];
const comparisonCount = comparisons.length;


const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Insurans.co",
  "url": "https://insurans.co",
  "description": "Panduan insurans Malaysia — ditulis untuk rakyat Malaysia yang nak faham insurans tanpa jargon.",
  "inLanguage": ["ms", "en"]
};

// One source for the visible FAQ and its FAQPage JSON-LD. `ld: false` keeps the first question out of the
// JSON-LD, as before; the JSON-LD answer is the visible answer as plain text (tags removed, whitespace collapsed).
const homeFaqs = [
  {
    q: 'Wajib ke beli insurans kereta?',
    a: `Ya, memang wajib. Minimum mesti ada <strong>insurans pihak ketiga (third-party)</strong>. Tanpa insurans yang sah,
          anda tidak boleh renew roadtax. Jika ditangkap polis memandu tanpa insurans,
          anda boleh didenda sehingga <strong>RM1,000</strong> atau dipenjara sehingga 3 bulan.
          Ini bukan pilihan; ia ditetapkan dalam Road Transport Act 1987 (Akta Pengangkutan Jalan).`,
    ld: false,
  },
  {
    q: 'Third-party je cukup ke, atau kena ambil comprehensive?',
    a: `Polisi pihak ketiga hanya melindungi kerosakan kereta <em>orang lain</em>. Kereta anda sendiri langsung tidak dilindungi.
          Bandingkan polisi pihak ketiga dan <strong>komprehensif</strong> bersama nilai kereta, syarat pinjaman dan kemampuan anda menanggung kerugian.`,
    ld: true,
  },
  {
    q: 'Boleh ke renew insurans kereta online?',
    a: `Boleh, dan lebih mudah daripada pergi ke pejabat. Semak NCD sebenar di MyCarInfo atau dengan syarikat insurans. Gunakan <a href="/tools/ncd-calculator/">Kalkulator NCD</a> untuk mengira potongan premium, kemudian minta sebut harga terus daripada syarikat insurans, contohnya di etiqa.com.my
          (<a href="/insurans-online/#beli-terus">lihat senarai beli online di insurans.co/insurans-online/</a>).
          Bayar online dan anda terus dapat e-cover note, kemudian renew roadtax di MyEG atau Pos Malaysia. Langkah penuh:
          <a href="/guides/renew-car-insurance/">cara renew insurans kereta online</a>.`,
    ld: true,
  },
  {
    q: 'Apa jadi kalau NCD reset sebab claim?',
    a: `Claim own damage biasa boleh menyebabkan NCD kembali kepada <strong>0%</strong> pada renew seterusnya. Claim OD-KfK yang layak apabila pihak lain bersalah, dan claim windscreen di bawah add-on windscreen, tidak menjejaskan NCD. Jika NCD anda 55%, premium tahun depan boleh naik RM1,000+.
          Sebab itu, untuk calar kecil bawah RM1,000–RM2,000, sesetengah pemilik memilih untuk bayar sendiri. Jangan meneka; kira dahulu dengan
          <a href="/tools/ncd-calculator/">Kalkulator NCD</a>: masukkan premium asal, NCD semasa dan kos baiki, untuk membandingkan kos baiki, excess dan kesan terhadap NCD.`,
    ld: true,
  },
  {
    q: 'Insurans dan takaful — sama ke beza?',
    a: `Bezanya dari segi konsep. <strong>Takaful</strong> menggunakan prinsip saling bantu-membantu (ta'awun) dan patuh Syariah.
          Lebihan dana boleh dikongsi mengikut syarat sijil dan nisbah yang ditetapkan. Agihan kepada peserta tidak dijamin. Bagi <strong>insurans konvensional</strong>, premium masuk ke syarikat
          dan keuntungannya milik syarikat. Takaful dan insurans konvensional boleh menyediakan jenis perlindungan yang serupa, tetapi manfaat serta syarat bergantung pada produk.
          Jika anda mahu pilihan yang patuh Syariah, pilih takaful. Jika tidak kisah, pilih yang harga dan servisnya paling sesuai.`,
    ld: true,
  },
  {
    q: 'Apa tu "agreed value" dan "market value"?',
    a: `<strong>Market value</strong> (nilai pasaran): syarikat membayar berdasarkan nilai kereta semasa claim. Nilai kereta susut setiap tahun,
          jadi bayaran mungkin kurang daripada yang dijangka. <strong>Agreed value</strong> (nilai dipersetujui): anda dan syarikat bersetuju dengan satu jumlah
          tetap semasa membeli polisi. Bandingkan premium dan syarat kedua-duanya tanpa menganggap satu kaedah sentiasa lebih mahal.
          Dengan agreed value, jumlah yang dipersetujui menjadi asas penyelesaian total loss, tertakluk pada terma polisi.`,
    ld: true,
  },
];
const plainText = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homeFaqs.filter((faq) => faq.ld).map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": plainText(faq.a),
    },
  })),
};
---

<Base
  title="Anggaran Harga Insurans Kereta Malaysia 2026"
  description={`Panduan insurans bebas, bukan ejen atau broker: anggaran harga insurans ${carModelCount} model kereta, kalkulator NCD & roadtax, perbandingan dan profil syarikat.`}
  schema={schema}
  pageType="home"
>
  <div class="ep hp">
    <div class="ep-main">
      <HomeAnswer h1="Harga Insurans Kereta Malaysia 2026" models={pickModels} initial={exampleModel.slug} allCount={carModelCount} />

      <HomeTypes />

      <!-- Who writes this, and how it is checked -->
      <section class="mod" aria-labelledby="tentang">
        <h2 class="mod-bar" id="tentang"><Ikon name="i-tanda" size={22} /> Bukan ejen. Bukan broker.</h2>
        <div class="mod-in">
          <p class="ix-s">
            Berapa patut anda bayar untuk insurans kereta? Harga insurans kereta di Malaysia untuk Axia/Myvi sekitar <strong class="numeric">{leadSmall55}</strong> setahun dengan NCD 55%, dan <span class="numeric">{leadSmall0}</span> tanpa NCD. Insurans.co membantu anda menyemak anggaran ikut 39 model, kira NCD, bandingkan 12 syarikat, dan renew online — tanpa jargon.
          </p>
          <div class="hp-by">
            <a href="/penulis/amir-ariff/" class="hp-by-img"><img src="/images/penulis/amir-ariff-colour-192.webp" alt="Amir Ariff" width="56" height="56" loading="lazy" decoding="async" /></a>
            <p>Oleh <a href="/penulis/amir-ariff/">Amir Ariff</a> · Pengasas &amp; Editor</p>
          </div>
          <p class="hp-trust" data-section="trust-strip">
            Disunting oleh Amir Ariff <span aria-hidden="true">·</span> Tiada affiliate atau tajaan <span aria-hidden="true">·</span>
            <a href="/kaedah-editorial/">Cara kami menyemak</a>
          </p>
          <EditorialStamp
            premiumReviewed={exampleModel.premiumReviewed}
            sources={exampleModel.sources}
          />
          <p class="ix-src">{carModelCount} model · {companyCount} syarikat · {comparisonCount} perbandingan · bebas daripada ejen dan broker.</p>
        </div>
      </section>

      <!-- Car: the site's strongest section -->
      <section class="hp-sec" aria-labelledby="kereta-h">
        <h2 class="hp-sec-h" id="kereta-h"><Ikon name="i-kereta" size={24} /> Insurans kereta</h2>
        <div class="hp-grid">
        <section class="mod" aria-labelledby="popular">
          <h3 class="mod-bar mod-lab" id="popular"><Ikon name="i-kereta" size={22} /> Julat premium ikut model: NCD 0% vs 55%</h3>
          <div class="mod-in">
            <p class="ix-s">Terus lihat julat premium untuk Axia, Myvi, Saga, Vios, City dan model lain, termasuk NCD 0% dan 55%.</p>
            <a href="#harga-sebenar" class="hp-more">Lihat harga {popularCars.length} model dalam panduan ini <Ikon name="i-bawah" size={18} /></a>
            <a href="/car-insurance/" data-cta="card_car" class="hp-more">Bandingkan ikut model <Ikon name="i-kanan" size={18} /></a>
          </div>
        </section>
        <section class="mod" data-tint="pink" aria-labelledby="kalk-ncd">
          <h3 class="mod-bar" id="kalk-ncd"><Ikon name="i-kalkulator" size={22} /> Kira dulu “patut ke claim?” sebelum NCD reset</h3>
          <div class="mod-in">
            <p class="ix-s">Masukkan premium asal dan pilih tahap NCD. Termasuk kiraan “patut ke claim?” sebelum NCD hilang.</p>
            <a href="/tools/ncd-calculator/" data-cta="card_ncd" class="ea-btn ea-btn-o">Kira NCD sekarang <Ikon name="i-kanan" size={20} /></a>
          </div>
        </section>
        </div>
      <!-- Harga sebenar -->
      <section class="mod" aria-labelledby="harga-sebenar">
        <h3 class="mod-bar" id="harga-sebenar"><Ikon name="i-harga" size={22} /> Anggaran polisi komprehensif setahun</h3>
        <div class="mod-in">
          <p class="ix-s">
            Kami kumpulkan anggaran harga untuk model kereta yang disenaraikan.
            Harga di bawah ialah untuk polisi komprehensif setahun.
          </p>
          <ul class="hp-cars numeric">
            {popularCars.map(car => (
              <li>
                <a href={`/car-insurance/${car.slug}/`}>
                  <CarThumb slug={car.slug} />
                  <span class="hp-car-n">{car.fullName}</span>
                  <span class="hp-car-m">Harga pasaran: {car.marketValueRange}</span>
                  <span class="hp-car-l">NCD 55%</span>
                  <span class="hp-car-p">{car.premiumNCD55}</span>
                  <span class="hp-car-z">NCD 0%: {car.premiumNCD0}</span>
                  <span class="hp-car-go">Bandingkan syarikat <Ikon name="i-kanan" size={18} /></span>
                </a>
              </li>
            ))}
          </ul>
          <p class="ix-src">
            Nota: Harga di atas ialah anggaran untuk tahun 2026. Harga sebenar bergantung pada
            umur kereta, lokasi, rekod pemanduan, dan syarikat insurans yang dipilih.
            Selepas liberalisasi tarif motor 2017, setiap syarikat boleh menetapkan harga sendiri.
          </p>
        </div>
      </section>

      <!-- Cara renew -->
      <section class="mod" data-section="renew" data-tint="sky" aria-labelledby="renew-h">
        <details class="hp-fold">
        <summary class="mod-bar"><h3 id="renew-h"><Ikon name="i-renew" size={22} /> Renew online dalam 4 langkah, tak perlu ke pejabat</h3><Ikon name="i-bawah" size={22} class="hp-fold-i" /></summary>
        <div class="mod-in">
          <p class="ix-s">Anda tidak perlu pergi ke pejabat insurans. Semak NCD, bandingkan harga, bayar online, kemudian renew roadtax.</p>
          <ol class="hp-steps">
            <li>
              <h4>Semak NCD anda</h4>
              <p>Semak di <a href="https://www.myeg.com.my" target="_blank" rel="noopener">MyEG</a> atau tanya ejen. Ini penting kerana NCD mempengaruhi harga premium.</p>
            </li>
            <li>
              <h4>Dapatkan quotation</h4>
              <p>Minta sebut harga terus daripada dua atau tiga syarikat insurans untuk perlindungan yang sama (<a href="/insurans-online/#beli-terus">lihat senarai beli online</a>).</p>
            </li>
            <li>
              <h4>Bayar &amp; dapat e-cover note</h4>
              <p>Bayar online (FPX, kad kredit). E-cover note dihantar terus ke e-mel. Simpan PDF itu.</p>
            </li>
            <li>
              <h4>Renew roadtax</h4>
              <p>Boleh renew di JPJ, MyEG, Pos Malaysia, atau kaunter di pusat beli-belah.</p>
            </li>
          </ol>
        </div>
        </details>
      </section>

      <CtaBand
        trackingSection="renew"
        level={3}
        heading="Minta sebut harga terus daripada syarikat insurans"
        body="Kira NCD dahulu, kemudian semak senarai syarikat yang menjual insurans kereta secara online di laman rasmi mereka."
        primary={{ label: 'Lihat senarai beli online →', href: '/insurans-online/#beli-terus' }}
        disclosure="Tiada hubungan berbayar atau affiliate dengan mana-mana syarikat. Pembelian polisi dibuat di laman syarikat, bukan di Insurans.co."
      />

      <!-- Company directory -->
      <section class="mod" aria-labelledby="syarikat">
        <details class="hp-fold">
        <summary class="mod-bar"><h3 id="syarikat"><Ikon name="i-dokumen" size={22} /> Senarai syarikat insurans motor, bukan ranking</h3><Ikon name="i-bawah" size={22} class="hp-fold-i" /></summary>
        <div class="mod-in">
          <p class="ix-s">Senarai syarikat, bukan ranking — baca profil setiap syarikat.</p>
          <ul class="hp-co">
            {topMotorInsurers.map((company) => (
              <li>
                <h4>
                  <a href={`/companies/${company.slug}/`}>{company.name}</a>
                  {company.takaful && <span class="hp-tag">Takaful</span>}
                </h4>
                <p>{company.verdictBM}</p>
                {company.claimLine && <p class="hp-co-c">Claim: {company.claimLine}</p>}
              </li>
            ))}
          </ul>
          <a href="/companies/" class="hp-more">Semua syarikat <Ikon name="i-kanan" size={18} /></a>
        </div>
        </details>
      </section>

      <!-- FAQ -->
      <section class="mod" aria-labelledby="soalan">
        <h3 class="mod-bar" id="soalan"><Ikon name="i-info" size={22} /> Insurans kereta wajib: sekurang-kurangnya perlindungan pihak ketiga</h3>
        <div class="mod-in hp-faq">
      {homeFaqs.map((faq, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>{faq.q}</summary>
          <p set:html={faq.a} />
        </details>
      ))}
        </div>
      </section>
      </section>

      <!-- Beyond car: one tool and the comparisons -->
      <section class="hp-sec" aria-labelledby="lain-h">
        <h2 class="hp-sec-h" id="lain-h"><Ikon name="i-lindung" size={24} /> Rumah, kesihatan dan takaful</h2>
        <div class="hp-grid">
          <section class="mod" aria-labelledby="kalk-rumah">
            <h3 class="mod-bar mod-lab" id="kalk-rumah"><Ikon name="i-utama" size={22} /> Kalkulator insurans rumah</h3>
            <div class="mod-in">
              <p class="ix-s">Fahami beza houseowner, householder dan fire-only.</p>
              <a href="/tools/kalkulator-insurans-rumah/" data-cta="card_home_calc" class="ea-btn ea-btn-o">Kira insurans rumah <Ikon name="i-kanan" size={20} /></a>
            </div>
          </section>

        <section class="mod" aria-labelledby="takaful-q">
          <h3 class="mod-bar" id="takaful-q"><Ikon name="i-lindung" size={22} /> Takaful patuh Syariah, dan lebihan dana boleh dikongsi</h3>
          <div class="mod-in">
            <p class="ix-s">Jenis perlindungan boleh serupa, tetapi manfaat dan syarat bergantung pada produk. Beza utama: takaful patuh Syariah, dan lebihan dana boleh dikongsi.</p>
            <a href="/takaful/" data-cta="card_takaful" class="hp-more">Baca tentang takaful <Ikon name="i-kanan" size={18} /></a>
          </div>
        </section>
        </div>
        <section class="mod" aria-labelledby="banding">
          <h3 class="mod-bar mod-lab" id="banding"><Ikon name="i-neraca" size={22} /> {comparisonCount} perbandingan satu lawan satu</h3>
          <div class="mod-in">
            <p class="ix-s">{comparisonCount} perbandingan satu lawan satu: Etiqa vs Allianz, takaful vs konvensional, produk, talian claim dan saluran digital.</p>
            <ul class="hp-links">
              <li><a href="/perbandingan/prudential-vs-aia/">Prudential vs AIA — perbandingan medical card</a></li>
              <li><a href="/perbandingan/etiqa-vs-zurich/">Etiqa vs Zurich — perbandingan harga insurans kereta</a></li>
              <li><a href="/perbandingan/allianz-vs-zurich/">Allianz vs Zurich — perbandingan perlindungan dan premium</a></li>
            </ul>
            <a href="/perbandingan/" data-cta="card_compare" class="hp-more">Semua perbandingan <Ikon name="i-kanan" size={18} /></a>
          </div>
        </section>
      </section>






    </div>

    <aside class="ep-tools" aria-label="Alat">
      <ToolsRail model={exampleModel} related={[]} calculatorUrl={`/tools/ncd-calculator/?model=${exampleModel.slug}`} hooks />
      <nav class="mod" aria-labelledby="kalkulator">
        <h2 class="mod-bar mod-lab" id="kalkulator"><Ikon name="i-kalkulator" size={22} /> {calculators.length} kalkulator: NCD, roadtax, rumah, nyawa</h2>
        <ul class="hp-calc">
          {calculators.map((c) => (
            <li><a href={c.href}><Ikon name={c.icon} size={22} /><span>{c.label}</span></a></li>
          ))}
          <li><a href="/tools/"><Ikon name="i-kanan" size={22} /><span>Semua alat</span></a></li>
        </ul>
      </nav>
      <TerkiniRail />
    </aside>

    <div class="ep-models">
      <ModelRail current="" />
    </div>
  </div>

  {/* Inject FAQ schema separately */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Dock answer="[data-ea]" control=".ea-ncd" name={'[data-ha] [data-f="short"]'} />
</Base>

<style>
  .hp-grid { display: grid; gap: 1.25rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 64rem) { .hp-grid { grid-template-columns: 1fr 1fr; } }
  .hp-by { display: flex; align-items: center; gap: 0.75rem; }
  .hp-by-img { flex: none; display: block; border-radius: 50%; }
  .hp-by-img img { display: block; width: 3.5rem; height: 3.5rem; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 1.5px var(--ink); }
  .hp-by p { font-size: 1rem; }
  .hp-by p a { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 600; }
  .hp-trust { font-size: 0.9375rem; font-weight: 500; line-height: 1.6; }
  .hp-trust a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .hp-more { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 2.75rem; font-weight: 700; justify-self: start; }
  .hp-mini { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); }
  .hp-mini li { display: grid; gap: 0.1rem; padding: 0.6rem 0.75rem; background: var(--tray); border-radius: var(--r-1); }
  .hp-mini-n { font-weight: 700; }
  .hp-mini-l, .hp-car-l { font-size: 0.875rem; color: var(--ink-2); }
  .hp-mini-p { font: 800 1.25rem/1.15 var(--fd); }
  .hp-links { list-style: none; margin: 0; padding: 0; display: grid; }
  .hp-links li + li { border-top: 1px solid rgb(0 0 0 / 0.15); }
  .hp-links a { display: flex; align-items: center; min-height: 2.75rem; padding: 0.3rem 0; }
  .hp-steps { list-style: none; margin: 0; padding: 0; counter-reset: s; display: grid; gap: 0.9rem; }
  @media (min-width: 40rem) { .hp-steps { grid-template-columns: 1fr 1fr; } }
  .hp-steps li { counter-increment: s; display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); column-gap: 0.6rem; }
  .hp-steps li::before { content: counter(s); grid-row: span 2; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: #000; color: #fff; font: 800 1.125rem/1 var(--fd); }
  .hp-steps h4 { font: 800 1.0625rem/1.25 var(--fd); align-self: center; }
  .hp-steps p { font-size: 1rem; line-height: 1.5; margin-top: 0.15rem; }
  .hp-co { list-style: none; margin: 0; padding: 0; display: grid; }
  .hp-co li { padding: 0.75rem 0; border-top: 1px solid rgb(0 0 0 / 0.15); }
