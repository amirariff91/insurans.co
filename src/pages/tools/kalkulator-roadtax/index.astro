---
import Base from '../../../layouts/Base.astro';
import Byline from '../../../components/Byline.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Hero from '../../../components/Hero.astro';
import rates from '../../../data/roadtax-rates.json';

const canonicalUrl = 'https://insurans.co/tools/kalkulator-roadtax/';
const description = 'Kira kadar roadtax JPJ untuk kereta persendirian mengikut cc, wilayah dan jenis badan. Kadar awam, bukan premium insurans.';
const intro = 'Masukkan cc kereta dan wilayah — tengok roadtax JPJ setahun dalam beberapa saat. Ini roadtax sahaja, belum termasuk premium insurans. Bukan ejen, bukan broker — nombor ini ikut jadual JPJ awam.';
const faqs = [
  {
    q: 'Roadtax ini untuk kereta apa?',
    a: 'Kalkulator ini untuk kereta persendirian sahaja: saloon seperti sedan dan hatchback, atau non-saloon seperti MPV, SUV dan pikap. Kenderaan syarikat, EV dan motosikal menggunakan jadual berasingan.',
  },
  {
    q: 'Macam mana kadar roadtax dikira?',
    a: 'Kami pilih band cc mengikut wilayah dan jenis badan, kemudian gunakan formula kadar asas + kadar per-cc × (cc − (min cc − 1)). Nilai sen dikekalkan dan tidak dibundarkan ke RM penuh.',
  },
  {
    q: 'Kenapa kadar Semenanjung berbeza daripada Sabah & Sarawak?',
    a: 'Jadual kadar JPJ berbeza mengikut wilayah. Pilih wilayah pendaftaran kereta anda untuk menggunakan jadual yang sepadan.',
  },
  {
    q: 'Adakah Langkawi, Pangkor dan Labuan dikira di sini?',
    a: 'Tidak. Wilayah duty-free bukan cabang kiraan dalam alat ini. Langkawi, Pangkor dan Labuan mempunyai aturan kadar khas; semak portal JPJ untuk pengesahan sebelum renew.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Kalkulator Roadtax Kereta',
  description,
  url: canonicalUrl,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'MYR' },
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://insurans.co/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Kalkulator Roadtax Kereta', item: canonicalUrl },
    ],
  },
};
---

<Base
  title="Kalkulator Roadtax Kereta"
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  pageType="tool"
>
  <Hero title="Kalkulator Roadtax Kereta 2026">
    <Byline slot="byline" dateModified={rates.asAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Tools', href: '/tools/' },
        { label: 'Kalkulator Roadtax Kereta' },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">{intro}</p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <p class="label">Alat percuma</p>
      <p class="mt-2 font-serif text-headline-sm text-stone-900">Kadar JPJ, bukan teka-teki</p>
      <p class="mt-2 text-sm leading-5 text-stone-600">Kiraan untuk kereta persendirian menggunakan jadual kadar awam JPJ.</p>
    </div>
  </Hero>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div class="lg:col-span-2">
        <section id="calculator" aria-labelledby="calculator-heading" class="border-2 border-stone-900 bg-white p-6 sm:p-8">
          <p class="label">Kalkulator percuma</p>
          <h2 id="calculator-heading" class="mt-2 font-serif text-headline-md text-stone-900">Kira roadtax kereta anda</h2>
          <p class="mt-2 text-sm leading-5 text-stone-600">Masukkan maklumat dalam geran atau VOC kereta. Pilih kategori yang paling tepat.</p>

          <form id="roadtax-form" class="mt-6 space-y-5">
            <div>
              <label for="engine-cc" class="mb-1.5 block text-sm font-semibold text-stone-700">
                Kapasiti enjin (cc)
              </label>
              <input
                type="number"
                id="engine-cc"
                name="cc"
                inputmode="numeric"
                min="1"
                step="1"
                required
                placeholder="cth: 1498"
                aria-describedby="engine-cc-help"
                class="w-full border border-stone-300 px-4 py-3 text-lg font-medium text-stone-900 outline-none transition-colors focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100"
              />
              <p id="engine-cc-help" class="mt-1.5 text-xs text-stone-400">Tengok dalam geran/VOC kereta anda.</p>
            </div>

            <fieldset>
              <legend class="mb-2 block text-sm font-semibold text-stone-700">Wilayah</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                <label class="flex min-h-11 items-center gap-2 border border-stone-300 px-3 py-3 text-sm text-stone-700 transition-colors hover:border-hijau-500">
                  <input type="radio" name="region" value="semenanjung" checked required class="h-4 w-4 accent-hijau-700" />
                  <span>Semenanjung</span>
                </label>
                <label class="flex min-h-11 items-center gap-2 border border-stone-300 px-3 py-3 text-sm text-stone-700 transition-colors hover:border-hijau-500">
                  <input type="radio" name="region" value="sabahSarawak" class="h-4 w-4 accent-hijau-700" />
                  <span>Sabah &amp; Sarawak</span>
                </label>
              </div>
              <p class="mt-2 border-l-2 border-emas-800 bg-emas-50 px-3 py-2 text-xs leading-5 text-stone-600">
                <strong>Nota:</strong> {rates.displayNotes.dutyFree}
              </p>
            </fieldset>

            <fieldset>
              <legend class="mb-2 block text-sm font-semibold text-stone-700">Jenis badan</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                <label class="flex min-h-11 items-center gap-2 border border-stone-300 px-3 py-3 text-sm text-stone-700 transition-colors hover:border-hijau-500">
                  <input type="radio" name="body" value="saloon" checked required class="h-4 w-4 accent-hijau-700" />
                  <span>Saloon (sedan/hatchback)</span>
                </label>
                <label class="flex min-h-11 items-center gap-2 border border-stone-300 px-3 py-3 text-sm text-stone-700 transition-colors hover:border-hijau-500">
                  <input type="radio" name="body" value="nonSaloon" class="h-4 w-4 accent-hijau-700" />
                  <span>Non-saloon (MPV/SUV/pikap)</span>
                </label>
              </div>
            </fieldset>

            <button type="submit" class="w-full bg-stone-900 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-stone-800">
              Kira Roadtax Saya
            </button>
          </form>

          <div
            id="roadtax-result"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            class="mt-6 hidden border border-hijau-200 bg-hijau-50 p-5"
          >
            <p id="roadtax-error" hidden role="alert" class="border border-red-200 bg-red-50 p-4 text-sm text-red-700"></p>
            <p id="roadtax-value" class="font-serif text-4xl font-bold text-hijau-700"></p>
            <p id="roadtax-breakdown" class="mt-4 border-t border-hijau-200 pt-4 text-sm leading-5 text-stone-600"></p>
          </div>

          <p class="mt-5 border-t border-stone-200 pt-4 text-sm leading-5 text-stone-700">
            Roadtax + premium insurans (selepas NCD) = belanja renew tahun ni.
            <a href="/tools/ncd-calculator/" class="font-semibold text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">Semak NCD →</a>
          </p>
          <p id="roadtax-handoff-note" hidden role="alert" class="mt-4 border border-emas-800 bg-emas-50 p-3 text-sm leading-5 text-stone-800"></p>
        </section>

        <article class="prose-editorial mt-10">
          <h2>Macam mana kami kira?</h2>
          <p>Kami pilih jadual kadar berdasarkan wilayah dan jenis badan, kemudian cari band yang mengandungi kapasiti enjin anda.</p>
          <ul>
            <li>Formula: <code>{rates.formula}</code>.</li>
            <li>Kadar rata kekal sebagai kadar asas; band progresif menambah kadar per-cc mengikut cc tambahan dalam band.</li>
            <li>Nilai sen dikekalkan. Alat ini tidak membundarkan kadar ke RM penuh.</li>
          </ul>

          <h3>Caveat penting</h3>
          <ul>
            <li>{rates.displayNotes.company}</li>
            <li>{rates.displayNotes.ev}</li>
            <li>{rates.displayNotes.motorcycle}</li>
            <li>{rates.displayNotes['>3000cc']}</li>
          </ul>

          <div class="info-box mt-8">
            <p class="mb-0 text-sm leading-5 text-stone-700">
              <strong>Disclaimer:</strong> Anggaran ikut jadual kadar JPJ awam (disemak {rates.asAt}). Roadtax sahaja — bukan premium insurans. Kadar muktamad ikut JPJ/MyEG. Kami bukan ejen, bukan broker.
            </p>
            <div class="mt-3 text-sm leading-5 text-stone-700">
              <strong>Sumber:</strong>
              <ul class="mt-1 list-disc pl-5">
                {rates.sources.map((source) => (
                  <li><a href={source} target="_blank" rel="noopener" class="break-all text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">{source}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </article>

        <section id="faq" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Soalan lazim kalkulator roadtax</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:col-span-1">
        <div class="space-y-6 lg:sticky lg:top-20">
          <div class="border-2 border-stone-900 bg-white p-5">
            <h2 class="font-serif text-headline-sm text-stone-900">Cara guna</h2>
            <ol class="mt-4 space-y-3 text-sm text-stone-600">
              <li class="flex gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center bg-stone-900 text-xs font-bold text-white">1</span>
                <span>Semak kapasiti enjin dalam <strong>geran/VOC</strong>.</span>
              </li>
              <li class="flex gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center bg-stone-900 text-xs font-bold text-white">2</span>
                <span>Pilih <strong>wilayah</strong> pendaftaran kereta.</span>
              </li>
              <li class="flex gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center bg-stone-900 text-xs font-bold text-white">3</span>
                <span>Pilih badan kereta dan tekan <strong>Kira Roadtax Saya</strong>.</span>
              </li>
            </ol>
          </div>

          <div class="card-editorial">
            <h2 class="text-sm font-semibold text-stone-900">Nota penting</h2>
            <p class="mt-2 text-sm leading-5 text-stone-600">Angka ini semakan awal berdasarkan jadual kadar awam. Untuk bayaran dan pengesahan, rujuk JPJ atau MyEG.</p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>

<script>
  import { calcRoadtax, type RoadtaxBody, type RoadtaxRegion } from '../../../lib/roadtax';
  import { track } from '../../../lib/track';

  const regionLabels: Record<RoadtaxRegion, string> = {
    semenanjung: 'Semenanjung',
    sabahSarawak: 'Sabah & Sarawak',
  };

  function getElement(id: string): HTMLElement | null {
    const element = document.getElementById(id);
    return element instanceof HTMLElement ? element : null;
  }

  function getInput(id: string): HTMLInputElement | null {
    const element = document.getElementById(id);
    return element instanceof HTMLInputElement ? element : null;
  }

  function getCheckedRadio(name: string): HTMLInputElement | null {
    const element = document.querySelector(`input[name="${name}"]:checked`);
    return element instanceof HTMLInputElement ? element : null;
  }

  function isRegion(value: string): value is RoadtaxRegion {
    return value === 'semenanjung' || value === 'sabahSarawak';
  }

  function isBody(value: string): value is RoadtaxBody {
    return value === 'saloon' || value === 'nonSaloon';
  }

  function formatCc(value: number): string {
    return value.toLocaleString('ms-MY');
  }

  function formatRate(value: number): string {
    return `RM\u00a0${value.toLocaleString('ms-MY', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  function showMessage(message: string): void {
    const resultEl = getElement('roadtax-result');
    const errorEl = getElement('roadtax-error');
    const valueEl = getElement('roadtax-value');
    const breakdownEl = getElement('roadtax-breakdown');
    if (!resultEl || !errorEl || !valueEl || !breakdownEl) return;

    resultEl.classList.remove('hidden');
    errorEl.hidden = false;
    errorEl.textContent = message;
    valueEl.hidden = true;
    breakdownEl.hidden = true;
    valueEl.textContent = '';
    breakdownEl.textContent = '';
  }

  function calculateFromForm(): void {
    const engineInput = getInput('engine-cc');
    const regionInput = getCheckedRadio('region');
    const bodyInput = getCheckedRadio('body');
    const resultEl = getElement('roadtax-result');
    const errorEl = getElement('roadtax-error');
    const valueEl = getElement('roadtax-value');
    const breakdownEl = getElement('roadtax-breakdown');
    if (!resultEl || !errorEl || !valueEl || !breakdownEl) return;

    const cc = engineInput ? Number(engineInput.value) : Number.NaN;
    if (!Number.isFinite(cc) || cc <= 0 || !regionInput || !bodyInput || !isRegion(regionInput.value) || !isBody(bodyInput.value)) {
      showMessage('Sila isi kapasiti enjin yang sah dan pilih wilayah serta jenis badan.');
      return;
    }

    const region = regionInput.value;
    const body = bodyInput.value;
    try {
      const result = calcRoadtax(region, body, cc);
      const maxCc = result.band.maxCc === 99999 ? '∞' : formatCc(result.band.maxCc);
      const additionalCc = cc - (result.band.minCc - 1);

      resultEl.classList.remove('hidden');
      errorEl.hidden = true;
      valueEl.hidden = false;
      breakdownEl.hidden = false;
      valueEl.textContent = `Roadtax setahun: ${formatRate(result.rate)}`;
      breakdownEl.textContent = `Enjin ${formatCc(cc)}cc · ${regionLabels[region]} · band ${formatCc(result.band.minCc)}–${maxCc}cc · kadar ${formatRate(result.band.base)} asas + ${formatRate(result.band.perCc)} × ${formatCc(additionalCc)}cc`;

      track('roadtax_calculate', {
        region,
        body,
        cc,
        rate: result.rate,
        band_min_cc: result.band.minCc,
        band_max_cc: result.band.maxCc,
      });
    } catch {
      showMessage('Kapasiti enjin ini tidak sepadan dengan band kadar JPJ yang tersedia. Semak angka dalam geran/VOC.');
    }
  }

  function setRadioValue(name: string, value: string): boolean {
    const radios = Array.from(document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`));
    const radio = radios.find((candidate) => candidate.value === value);
    if (!radio) return false;
    radio.checked = true;
    return true;
  }

  function applyUrlParams(): void {
    const params = new URLSearchParams(window.location.search);
    const invalidParams: string[] = [];
    const engineInput = getInput('engine-cc');
    const engineParamName = ['cc', 'engineCC', 'engineCc'].find((name) => params.has(name));

    if (engineParamName) {
      const raw = params.get(engineParamName);
      const value = raw && raw.trim() !== '' ? Number(raw) : Number.NaN;
      if (!Number.isFinite(value) || value <= 0) {
        invalidParams.push(engineParamName);
      } else if (engineInput) {
        engineInput.value = String(value);
      }
    }

    const regionParam = params.get('region');
    if (regionParam !== null && !setRadioValue('region', regionParam)) invalidParams.push('region');

    const bodyParam = params.get('body');
    if (bodyParam !== null && !setRadioValue('body', bodyParam)) invalidParams.push('body');

    const handoffNote = getElement('roadtax-handoff-note');
    if (invalidParams.length > 0 && handoffNote) {
      handoffNote.textContent = `Parameter ${invalidParams.join(' dan ')} tidak sah dan diabaikan.`;
      handoffNote.hidden = false;
    }
  }

  const form = document.getElementById('roadtax-form');
  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      calculateFromForm();
    });
  }

  applyUrlParams();
</script>
