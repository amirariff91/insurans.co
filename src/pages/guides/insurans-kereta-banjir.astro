---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';

const faqItems = [
  {
    q: "Adakah insurans kereta standard melindungi kerosakan akibat banjir?",
    a: "Tidak. Insurans komprehensif standard TIDAK melindungi kerosakan banjir. Anda perlu tambah add-on 'Special Perils' atau 'Bencana Khas' secara berasingan untuk mendapat perlindungan banjir."
  },
  {
    q: "Berapa kos add-on special perils untuk banjir?",
    a: "Kos add-on special perils dikira sebagai peratusan daripada sum insured, lazimnya 0.2% hingga 0.5% setahun, bergantung kepada syarikat insurans dan tahap perlindungan. Contohnya, untuk kereta dengan sum insured RM50,000, premium tambahan adalah sekitar RM100 hingga RM250 setahun. Minta sebut harga untuk angka tepat."
  },
  {
    q: "Apa yang perlu dilakukan jika kereta dilanda banjir?",
    a: "Jangan hidupkan enjin selepas kereta ditenggelami air — ini boleh menambah kerosakan dan menjejaskan claim. Ambil gambar/video kerosakan segera. Maklumkan syarikat insurans anda secepat mungkin dan semak tempoh pemberitahuan dalam polisi anda. Bawa kereta ke panel bengkel yang dilantik oleh syarikat insurans anda."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Insurans Kereta Banjir di Malaysia: Apa Yang Dilindungi?",
      "description": "Panduan lengkap insurans kereta banjir — special perils, apa yang dilindungi, cara tambah coverage, kos, negeri berisiko tinggi, dan langkah tuntutan.",
      "url": "https://insurans.co/guides/insurans-kereta-banjir/",
      "datePublished": "2026-01-15",
      "dateModified": "2026-11-15",
      "inLanguage": "ms",
      "publisher": { "@type": "Organization", "name": "Insurans.co", "url": "https://insurans.co" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
        { "@type": "ListItem", "position": 2, "name": "Panduan", "item": "https://insurans.co/guides/" },
        { "@type": "ListItem", "position": 3, "name": "Insurans Kereta Banjir", "item": "https://insurans.co/guides/insurans-kereta-banjir/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    }
  ]
};
---

<Base
  title="Insurans Kereta Banjir di Malaysia: Apa Yang Dilindungi? — Insurans.co"
  description="Adakah insurans kereta anda melindungi banjir? Panduan special perils: apa yang dilindungi, kos 0.2%–0.5% daripada sum insured, dan cara buat tuntutan."
  schema={schema}
  ogType="article"
  publishedTime="2026-01-15"
  modifiedTime="2026-11-15"
  ads={true}
>
  <section class="bg-white border-b border-stone-200">
    <div class="container-wide py-10 sm:py-14">
      <nav class="text-sm text-stone-400 mb-5">
        <a href="/" class="text-stone-500 underline decoration-stone-300 underline-offset-2 hover:text-hijau-700">Utama</a>
        <span class="mx-2">›</span>
        <a href="/guides/" class="text-stone-500 underline decoration-stone-300 underline-offset-2 hover:text-hijau-700">Panduan</a>
        <span class="mx-2">›</span>
        <span class="text-stone-700">Insurans Kereta Banjir</span>
      </nav>
      <p class="label mb-3">Panduan Perlindungan</p>
      <h1 class="font-serif text-headline-lg sm:text-headline-xl text-stone-900 mb-4">
        Insurans Kereta Banjir di Malaysia: Apa Yang Dilindungi?
      </h1>
      <Byline dateModified="2026-11-15" />
      <p class="text-lg text-stone-600 max-w-2xl leading-relaxed">
        Insurans komprehensif standard <strong>tidak</strong>
        melindungi kerosakan akibat banjir. Hanya 13% kenderaan bermotor di Malaysia mempunyai perlindungan banjir (PIAM, Oktober 2026, dilaporkan oleh <a href="https://ringgitplus.com/ms/blog/utama/piam-monsun-hampir-tiba-87-kenderaan-masih-tiada-perlindungan-banjir.html" class="underline" target="_blank" rel="noopener noreferrer">RinggitPlus</a>). Ketahui cara menambah perlindungan banjir pada polisi anda.
      </p>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
      <article class="lg:col-span-2 prose-editorial">

        <!-- Warning box -->
        <div class="not-prose note-warn mb-8">
          <p class="note-t text-sm">Peringatan Penting</p>
          <p class="text-sm leading-relaxed">
            Insurans komprehensif standard TIDAK melindungi kerosakan banjir. Anda perlu tambah
            add-on <strong>Special Perils</strong> secara berasingan. Jika anda tinggal di kawasan
            banjir dan tidak ada add-on ini, anda menanggung sepenuhnya kos kerosakan banjir.
          </p>
        </div>

        <h2>Apa Itu Special Perils (Bencana Khas)?</h2>
        <p>
          <em>Special Perils</em> atau <em>Bencana Khas</em> adalah add-on tambahan kepada polisi
          insurans kereta anda yang melindungi kerosakan akibat bencana alam dan kejadian luar biasa.
          Ini termasuk:
        </p>
        <ul>
          <li><strong>Banjir dan banjir kilat</strong> — termasuk air masuk ke dalam kereta</li>
          <li><strong>Ribut dan angin kencang</strong> — pokok tumbang ke atas kereta</li>
          <li><strong>Tanah runtuh dan runtuhan</strong></li>
          <li><strong>Letupan gunung berapi</strong> (jarang berlaku di Malaysia)</li>
          <li><strong>Gempa bumi</strong></li>
        </ul>
        <p>
          Tanpa add-on ini, insurans kereta anda — walaupun polisi komprehensif penuh — tidak akan
          membayar sebarang tuntutan berkaitan banjir.
        </p>

        <h2>Berapa Kos Special Perils?</h2>
        <p>Kos special perils dikira sebagai peratusan daripada sum insured kereta anda:</p>
        <ul>
          <li>Kadar lazim: <strong>sekitar 0.2% – 0.5% daripada sum insured setahun</strong></li>
          <li>Contoh: sum insured RM50,000 → sekitar RM100 – RM250 setahun</li>
          <li>Kadar dan tahap perlindungan (penuh atau separa) berbeza mengikut syarikat insurans</li>
        </ul>
        <p class="text-sm text-stone-500">
          Sumber: <a href="https://www.kurnia.com/blog/special-perils-coverage" target="_blank" rel="noopener noreferrer">Kurnia, Special Perils Coverage</a>.
        </p>
        <p>
          Kos membaiki kereta yang rosak akibat banjir boleh mencecah ribuan ringgit, bergantung pada tahap kerosakan. Bandingkan kos itu dengan premium tambahan special perils untuk kereta anda.
        </p>

        <div class="note-warn my-6">
          <p class="note-t mb-2">Contoh Nyata: Banjir Klang 2021</p>
          <p class="text-sm">Banjir besar di Lembah Klang pada Disember 2021 merosakkan banyak kenderaan. Tanpa perlindungan <em>special perils</em>, kos membaiki kereta yang rosak akibat banjir perlu ditanggung sendiri dan boleh mencecah ribuan ringgit, bergantung pada tahap kerosakan.</p>
        </div>

        <h2>Negeri Berisiko Tinggi Banjir</h2>
        <p>
          Jika anda tinggal atau selalu memandu di negeri-negeri berikut, special perils <strong>wajar dipertimbangkan dengan serius</strong>. Ia add-on pilihan, bukan kewajipan undang-undang:
        </p>
        <ul>
          <li><a href="/negeri/kelantan/" class="text-hijau-700 underline"><strong>Kelantan</strong></a> — antara negeri paling kerap dilanda banjir di Malaysia</li>
          <li><a href="/negeri/terengganu/" class="text-hijau-700 underline"><strong>Terengganu</strong></a> — pesisiran Laut China Selatan, monsun timur laut</li>
          <li><a href="/negeri/pahang/" class="text-hijau-700 underline"><strong>Pahang</strong></a> — banjir sungai dan kawasan pedalaman</li>
          <li><a href="/negeri/kedah/" class="text-hijau-700 underline"><strong>Kedah</strong></a> — banjir musim tengkujuh</li>
          <li><a href="/negeri/selangor/" class="text-hijau-700 underline"><strong>Selangor</strong></a> — kawasan Klang, Shah Alam, Subang kerap banjir kilat</li>
          <li><strong>Johor</strong> — banjir besar pernah berlaku di Johor Bahru</li>
        </ul>
        <p>
          Lihat <a href="/negeri/" class="text-hijau-700 underline">panduan insurans mengikut negeri</a>
          untuk maklumat risiko banjir bagi setiap negeri di Malaysia.
        </p>

        <div class="not-prose grid sm:grid-cols-3 gap-3 my-6">
          <a href="/negeri/kelantan/" class="tile-link group">
            <span class="block font-semibold group-hover:underline">Kelantan</span>
            <span class="text-sm font-semibold text-edisi-red">Risiko Banjir: Tinggi</span>
          </a>
          <a href="/negeri/terengganu/" class="tile-link group">
            <span class="block font-semibold group-hover:underline">Terengganu</span>
            <span class="text-sm font-semibold text-edisi-red">Risiko Banjir: Tinggi</span>
          </a>
          <a href="/negeri/pahang/" class="tile-link group">
            <span class="block font-semibold group-hover:underline">Pahang</span>
            <span class="text-sm font-semibold text-edisi-red">Risiko Banjir: Tinggi</span>
          </a>
          <a href="/negeri/kedah/" class="tile-link group">
            <span class="block font-semibold group-hover:underline">Kedah</span>
            <span class="text-sm font-semibold text-edisi-red">Risiko Banjir: Tinggi</span>
          </a>
          <a href="/negeri/selangor/" class="tile-link group">
            <span class="block font-semibold group-hover:underline">Selangor</span>
            <span class="text-sm font-semibold text-edisi-red">Risiko Banjir: Tinggi</span>
          </a>
          <a href="/negeri/" class="tile-link group">
            <span class="block font-semibold group-hover:underline">Semua Negeri →</span>
            <span class="text-xs text-stone-500">16 negeri di Malaysia</span>
          </a>
        </div>

        <h2>Cara Tambah Special Perils ke Polisi Anda</h2>
        <p>
          Tambah special perils adalah mudah:
        </p>
        <ol>
          <li>
            <strong>Semasa renew insurans:</strong> Ini masa paling mudah. Semasa renew, tandakan
            pilihan "Special Perils" atau "Bencana Khas" dalam senarai add-on.
          </li>
          <li>
            <strong>Endorsement kepada polisi sedia ada:</strong> Jika polisi anda masih aktif,
            tanya syarikat insurans anda sama ada special perils boleh ditambah di pertengahan tempoh
            polisi. Kelulusan tertakluk kepada syarikat; dapatkan pengesahan bertulis tentang premium,
            tarikh kuat kuasa dan syarat perlindungan sebelum menganggapnya aktif.
          </li>
          <li>
            <strong>Melalui platform perbandingan:</strong> Platform perbandingan yang diluluskan BNM biasanya membolehkan anda memilih add-on ini semasa membandingkan harga (lihat <a href="/insurans-online/">semakan platform insurans online</a>).
          </li>
        </ol>

        <h2>Apa Yang TIDAK Dilindungi</h2>
        <p>
          Walaupun ada special perils, ada had tertentu yang perlu anda tahu:
        </p>
        <ul>
          <li>Kerosakan akibat anda sengaja meredah air yang dalam (boleh menjejaskan claim; semak terma polisi)</li>
          <li>Kehilangan barang peribadi di dalam kereta semasa banjir (perlukan add-on berbeza)</li>
          <li>Kerosakan elektrikal jika anda cuba hidupkan enjin kereta yang dilanda banjir — jangan sekali-kali cuba start enjin kereta yang terendam air</li>
        </ul>

        <h2>Langkah Tuntutan Insurans Selepas Banjir</h2>
        <ol>
          <li>
            <strong>JANGAN hidupkan enjin</strong> selepas kereta ditenggelami air. Menghidupkan enjin
            atau meredah air boleh menambah kerosakan dan menjejaskan claim; penilaian tertakluk kepada
            punca kerosakan dan terma polisi.
          </li>
          <li>
            <strong>Ambil gambar dan video</strong> kerosakan secara menyeluruh sebelum mana-mana
            kerja pembersihan dilakukan.
          </li>
          <li>
            <strong>Maklumkan syarikat insurans secepat mungkin</strong> dan semak tempoh pemberitahuan
            dalam polisi anda. Ikut arahan claim yang diberikan oleh syarikat.
          </li>
          <li>
            <strong>Buat laporan polis</strong> jika diperlukan oleh syarikat insurans anda.
          </li>
          <li>
            <strong>Hantar ke panel bengkel</strong> yang dilantik oleh syarikat insurans anda.
            Bengkel panel akan hubungi adjuster insurans untuk penilaian kerosakan.
          </li>
          <li>
            <strong>Simpan semua resit</strong> berkaitan kos towing, penginapan sementara, dan
            perbelanjaan lain yang mungkin boleh dituntut.
          </li>
        </ol>

        <!-- Attribution -->
        <p class="text-xs text-stone-500 mt-8 pt-4 border-t border-stone-200">Artikel ini ditulis dan disunting oleh Amir Ariff, pengasas dan editor Insurans.co. Beliau bukan penasihat kewangan atau ejen insurans berlesen. Untuk maklumat rasmi, sila rujuk <a href="https://www.piam.org.my" class="underline" target="_blank" rel="noopener noreferrer">PIAM</a> atau <a href="https://www.bnm.gov.my" class="underline" target="_blank" rel="noopener noreferrer">Bank Negara Malaysia</a>.</p>

        <!-- FAQ Section -->
        <h2>Soalan Lazim</h2>
        {faqItems.map(item => (
          <details class="not-prose border border-stone-200 rounded-lg mb-3 overflow-hidden">
            <summary class="flex items-center justify-between p-4 cursor-pointer hover:bg-stone-50 font-medium text-stone-800 text-sm">
              {item.q}
              <span class="text-stone-400 ml-3 flex-shrink-0 text-lg leading-none">+</span>
            </summary>
            <div class="px-4 pb-4 text-sm text-stone-600 leading-relaxed border-t border-stone-100 pt-3">
              {item.a}
            </div>
          </details>
        ))}

      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-20 space-y-6">

          <div class="note-warn">
            <h3 class="note-t mb-2 text-base">Perlu Special Perils?</h3>
            <p class="text-sm mb-3 leading-relaxed">
              Jika anda tinggal di kawasan yang kerap banjir, semak kos add-on special perils semasa renew. Lazimnya 0.2%–0.5% daripada sum insured setahun.
            </p>
            <a href="/insurans-online/#beli-terus"
               class="btn-outline w-full justify-center text-center text-sm">
              Beli terus daripada syarikat insurans →
            </a>
          </div>

          <div class="card-editorial">
            <h3 class="font-semibold text-sm text-stone-900 mb-3">Panduan Berkaitan</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/negeri/" class="text-hijau-700 hover:underline">Risiko banjir mengikut negeri →</a></li>
              <li><a href="/guides/insurans-komprehensif-vs-pihak-ketiga/" class="text-hijau-700 hover:underline">Komprehensif vs Pihak Ketiga</a></li>
              <li><a href="/guides/cara-turun-premium-insurans-kereta/" class="text-hijau-700 hover:underline">10 cara jimat premium</a></li>
              <li><a href="/guides/how-to-claim/" class="text-hijau-700 hover:underline">Cara buat claim insurans</a></li>
            </ul>
          </div>

          <div class="card-editorial">
            <h3 class="font-semibold text-sm text-stone-900 mb-3">Contoh Syarikat dengan Special Perils</h3>
            <p class="text-xs text-stone-500 mb-3">Antara syarikat yang menawarkan add-on special perils:</p>
            <ul class="space-y-2 text-sm">
              <li><a href="/companies/etiqa/" class="text-hijau-700 hover:underline">Etiqa →</a></li>
              <li><a href="/companies/allianz/" class="text-hijau-700 hover:underline">Allianz →</a></li>
              <li><a href="/companies/tokio-marine/" class="text-hijau-700 hover:underline">Tokio Marine →</a></li>
            </ul>
          </div>

        </div>
      </aside>
    </div>
  </div>
</Base>
