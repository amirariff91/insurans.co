---
import Base from '../../../layouts/Base.astro';
import Byline from '../../../components/Byline.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Hero from '../../../components/Hero.astro';

const canonicalUrl = 'https://insurans.co/tools/kalkulator-coverage-nyawa/';
const description = 'Kira jurang coverage nyawa berdasarkan gaji, tahun sokongan, hutang, belanja khas, simpanan dan coverage sedia ada — tanpa anggaran produk.';
const intro = 'Jawab 6 soalan tentang nombor anda sendiri. Kami tak tanya nama, tak jual apa-apa — cuma kira jurang kasar supaya anda ada angka sebelum bercakap dengan sesiapa.';
const faqs = [
  {
    q: 'Apa maksud jurang coverage kasar?',
    a: 'Jurang coverage kasar ialah keperluan pendapatan, hutang dan belanja khas yang masih berbaki selepas simpanan serta coverage sedia ada ditolak. Ia dikira daripada nombor yang anda masukkan sendiri.',
  },
  {
    q: 'Perlu ke saya masukkan coverage polisi atau majikan yang sedia ada?',
    a: 'Ya. Masukkan jumlah manfaat kematian yang benar-benar tersedia kepada keluarga anda, berdasarkan dokumen polisi, sijil atau faedah majikan. Jika tidak pasti, semak dokumen sebenar sebelum menggunakan angka itu.',
  },
  {
    q: 'Kenapa simpanan dan EPF ditolak dalam kiraan?',
    a: 'Alat ini menganggap simpanan dan EPF sebagai sumber kewangan yang anda pilih untuk masukkan dalam kiraan. Sama ada jumlah itu mudah digunakan oleh keluarga bergantung pada akaun, penama dan keadaan sebenar anda.',
  },
  {
    q: 'Adakah keputusan ini menentukan polisi yang saya patut ambil?',
    a: 'Tidak. Ini cuma titik mula pendidikan berdasarkan nombor anda sendiri, bukan cadangan produk. Tempoh perlindungan, manfaat, pengecualian, penama dan keadaan kewangan perlu dinilai secara berasingan dengan perancang kewangan berlesen.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Kalkulator Coverage Nyawa',
  description,
  url: canonicalUrl,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'MYR' },
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://insurans.co/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Kalkulator Coverage Nyawa', item: canonicalUrl },
    ],
  },
};
---

<Base
  title="Kalkulator Coverage Nyawa"
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  pageType="tool"
>
  <Hero title="Kalkulator Coverage Nyawa — Berapa Cukup Untuk Keluarga?">
    <Byline slot="byline" />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Tools', href: '/tools/' },
        { label: 'Kalkulator Coverage Nyawa' },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">{intro}</p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <p class="label">Alat pendidikan</p>
      <p class="mt-2 font-serif text-headline-sm text-stone-900">Nombor anda, kiraan yang jelas</p>
      <p class="mt-2 text-sm leading-5 text-stone-600">Tiada nama, tiada andaian pasaran. Hanya pendapatan, tanggungan dan sumber yang anda masukkan.</p>
    </div>
  </Hero>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div class="lg:col-span-2">
        <section id="calculator" aria-labelledby="calculator-heading" class="border-2 border-stone-900 bg-white p-6 sm:p-8">
          <p class="label">Kalkulator percuma</p>
          <h2 id="calculator-heading" class="mt-2 font-serif text-headline-md text-stone-900">Kira jurang coverage keluarga</h2>
          <p class="mt-2 text-sm leading-5 text-stone-600">Masukkan nombor anda sendiri. Untuk jumlah yang tiada, masukkan 0.</p>

          <form id="coverage-form" class="mt-6 space-y-5">
            <div>
              <label for="monthly-income" class="mb-1.5 block text-sm font-semibold text-stone-700">
                Gaji bersih sebulan (RM) — cth: 4,000
              </label>
              <div class="relative">
                <span aria-hidden="true" class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-medium text-stone-400">RM</span>
                <input
                  type="number"
                  id="monthly-income"
                  name="monthlyIncome"
                  inputmode="numeric"
                  min="0"
                  step="1"
                  required
                  placeholder="4,000"
                  class="w-full border border-stone-300 py-3 pl-10 pr-4 text-lg font-medium text-stone-900 outline-none transition-colors focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100"
                />
              </div>
            </div>

            <div>
              <label for="years-support" class="mb-1.5 block text-sm font-semibold text-stone-700">
                Berapa tahun keluarga perlu disokong?
              </label>
              <select
                id="years-support"
                name="yearsSupport"
                inputmode="numeric"
                required
                class="w-full border border-stone-300 bg-white px-4 py-3 text-base font-medium text-stone-900 outline-none transition-colors focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100"
              >
                <option value="5">5 tahun</option>
                <option value="10" selected>10 tahun</option>
                <option value="15">15 tahun</option>
                <option value="20">20 tahun</option>
              </select>
            </div>

            <div>
              <label for="debts" class="mb-1.5 block text-sm font-semibold text-stone-700">
                Jumlah hutang (rumah + kereta + lain-lain) (RM)
              </label>
              <input
                type="number"
                id="debts"
                name="debts"
                inputmode="numeric"
                min="0"
                step="1"
                required
                placeholder="Masukkan jumlah"
                class="w-full border border-stone-300 px-4 py-3 text-lg font-medium text-stone-900 outline-none transition-colors focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100"
              />
            </div>

            <div>
              <label for="special-expenses" class="mb-1.5 block text-sm font-semibold text-stone-700">
                Belanja khas sekali (pendidikan anak dsb.) (RM) — boleh 0
              </label>
              <input
                type="number"
                id="special-expenses"
                name="specialExpenses"
                inputmode="numeric"
                min="0"
                step="1"
                required
                placeholder="Masukkan jumlah"
                class="w-full border border-stone-300 px-4 py-3 text-lg font-medium text-stone-900 outline-none transition-colors focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100"
              />
            </div>

            <div>
              <label for="savings" class="mb-1.5 block text-sm font-semibold text-stone-700">
                Simpanan sedia ada + EPF (RM) — boleh 0
              </label>
              <input
                type="number"
                id="savings"
                name="savings"
                inputmode="numeric"
                min="0"
                step="1"
                required
                placeholder="Masukkan jumlah"
                class="w-full border border-stone-300 px-4 py-3 text-lg font-medium text-stone-900 outline-none transition-colors focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100"
              />
            </div>

            <div>
              <label for="existing-cover" class="mb-1.5 block text-sm font-semibold text-stone-700">
                Coverage sedia ada (polisi/majikan) (RM) — boleh 0
              </label>
              <input
                type="number"
                id="existing-cover"
                name="existingCover"
                inputmode="numeric"
                min="0"
                step="1"
                required
                placeholder="Masukkan jumlah"
                class="w-full border border-stone-300 px-4 py-3 text-lg font-medium text-stone-900 outline-none transition-colors focus:border-hijau-500 focus:ring-2 focus:ring-hijau-100"
              />
            </div>

            <button type="submit" class="w-full bg-stone-900 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-stone-800">
              Kira Jurang Saya
            </button>
          </form>

          <div
            id="coverage-result"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            class="hidden mt-6 border border-hijau-200 bg-hijau-50 p-5"
          >
            <p class="text-sm text-stone-500">Jurang coverage kasar anda:</p>
            <p id="result-gap" class="mt-0.5 font-serif text-4xl font-bold text-hijau-700"></p>
            <div id="result-breakdown" class="mt-5 space-y-2 border-t border-hijau-200 pt-4"></div>
            <p id="result-interpretation" class="mt-5 border-t border-hijau-200 pt-4 text-sm leading-5 text-stone-700"></p>
          </div>
          <p id="handoff-note" hidden role="alert" class="mt-5 border border-emas-800 bg-emas-50 p-3 text-sm leading-5 text-stone-800"></p>
        </section>

        <article class="prose-editorial mt-10">
          <h2>Macam mana kami kira?</h2>
          <p>Kiraan ini hanya menggunakan nombor yang anda masukkan sendiri — tiada andaian tentang pasaran atau produk.</p>
          <ul>
            <li>Gantian pendapatan = gaji bersih sebulan × 12 × tahun sokongan.</li>
            <li>Keperluan kasar = gantian pendapatan + hutang + belanja khas.</li>
            <li>Jurang = keperluan kasar − simpanan − coverage sedia ada. Jika hasilnya negatif, jurang dipaparkan sebagai RM 0.</li>
          </ul>
          <div class="info-box mt-8">
            <p class="mb-0 text-sm leading-5 text-stone-700">
              <strong>Disclaimer:</strong> Alat pendidikan dari nombor anda sendiri. Bukan cadangan produk, bukan quote premium, bukan nasihat kewangan. Kami tak jual polisi. Untuk nasihat peribadi, jumpa perancang kewangan berlesen.
            </p>
          </div>
        </article>

        <section id="faq" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Soalan lazim kalkulator coverage nyawa</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>

        <CtaBand
          heading="Fahami asas insurans nyawa"
          body="Baca panduan insurans nyawa sebelum anda berbincang dengan mana-mana penyedia."
          primary={{ label: 'Baca panduan insurans nyawa →', href: '/life-insurance/' }}
          disclosure="Kiraan ini bukan cadangan produk, bukan quote premium dan bukan nasihat kewangan."
        />

        <section class="mt-6 border border-stone-200 bg-stone-50 p-6" aria-labelledby="related-heading">
          <p id="related-heading" class="mb-3 text-sm font-semibold text-stone-700">Related tools</p>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href="/life-insurance/" class="block border border-stone-200 bg-white p-4 transition-colors hover:border-hijau-500 group">
              <p class="text-sm font-semibold text-stone-900 group-hover:text-hijau-700">Panduan Insurans Nyawa →</p>
              <p class="mt-0.5 text-xs text-stone-500">Asas jenis perlindungan dan tanggungan</p>
            </a>
            <a href="/tools/ncd-calculator/" class="block border border-stone-200 bg-white p-4 transition-colors hover:border-hijau-500 group">
              <p class="text-sm font-semibold text-stone-900 group-hover:text-hijau-700">Kalkulator NCD →</p>
              <p class="mt-0.5 text-xs text-stone-500">Semak NCD dan kesan tuntutan</p>
            </a>
          </div>
        </section>
      </div>

      <aside class="lg:col-span-1">
        <div class="space-y-6 lg:sticky lg:top-20">
          <div class="border-2 border-stone-900 bg-white p-5">
            <h2 class="font-serif text-headline-sm text-stone-900">Cara guna</h2>
            <ol class="mt-4 space-y-3 text-sm text-stone-600">
              <li class="flex gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center bg-stone-900 text-xs font-bold text-white">1</span>
                <span>Masukkan <strong>gaji bersih sebulan</strong> anda.</span>
              </li>
              <li class="flex gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center bg-stone-900 text-xs font-bold text-white">2</span>
                <span>Pilih berapa tahun keluarga perlu disokong.</span>
              </li>
              <li class="flex gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center bg-stone-900 text-xs font-bold text-white">3</span>
                <span>Masukkan hutang, belanja khas, simpanan dan coverage sedia ada.</span>
              </li>
            </ol>
          </div>

          <div class="card-editorial">
            <h2 class="text-sm font-semibold text-stone-900">Nota penting</h2>
            <p class="mt-2 text-sm leading-5 text-stone-600">Semak nombor dengan dokumen kewangan dan polisi sebenar anda. Alat ini tidak menyimpan nama atau meminta maklumat peribadi.</p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>

<script>
  import { calculateCoverage, rm, type CoverageInputs } from '../../../lib/coverage';
  import { track } from '../../../lib/track';

  type CoverageField = HTMLInputElement | HTMLSelectElement;
  const supportedYears = [5, 10, 15, 20] as const;

  function getField(id: string): CoverageField | null {
    const element = document.getElementById(id);
    return element instanceof HTMLInputElement || element instanceof HTMLSelectElement ? element : null;
  }

  const fields: Record<keyof CoverageInputs, CoverageField | null> = {
    monthlyIncome: getField('monthly-income'),
    yearsSupport: getField('years-support'),
    debts: getField('debts'),
    specialExpenses: getField('special-expenses'),
    savings: getField('savings'),
    existingCover: getField('existing-cover'),
  };

  const form = document.getElementById('coverage-form');
  const resultEl = document.getElementById('coverage-result');
  const gapEl = document.getElementById('result-gap');
  const breakdownEl = document.getElementById('result-breakdown');
  const interpretationEl = document.getElementById('result-interpretation');
  const errorEl = document.getElementById('handoff-note');

  function readNumber(field: CoverageField | null): number {
    if (!field || field.value.trim() === '') return Number.NaN;
    return Number(field.value);
  }

  function isValidValue(key: keyof CoverageInputs, value: number): boolean {
    if (!Number.isFinite(value) || value < 0) return false;
    return key !== 'yearsSupport' || supportedYears.includes(value as (typeof supportedYears)[number]);
  }

  function showMessage(message: string): void {
    // Use the dedicated alert element; never replace the result container's
    // innerHTML (that would detach #result-gap/#result-breakdown refs).
    if (resultEl instanceof HTMLElement) resultEl.classList.add('hidden');
    if (errorEl instanceof HTMLElement) {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }
  }

  function calculateFromForm(): void {
    if (
      !(resultEl instanceof HTMLElement) ||
      !(gapEl instanceof HTMLElement) ||
      !(breakdownEl instanceof HTMLElement) ||
      !(interpretationEl instanceof HTMLElement)
    ) return;

    const values: CoverageInputs = {
      monthlyIncome: readNumber(fields.monthlyIncome),
      yearsSupport: readNumber(fields.yearsSupport),
      debts: readNumber(fields.debts),
      specialExpenses: readNumber(fields.specialExpenses),
      savings: readNumber(fields.savings),
      existingCover: readNumber(fields.existingCover),
    };

    const invalidValue = (Object.keys(values) as Array<keyof CoverageInputs>).some((key) => !isValidValue(key, values[key]));
    if (invalidValue) {
      showMessage('Sila isi semua jumlah dengan nombor 0 atau lebih. Pilih 5, 10, 15 atau 20 tahun.');
      return;
    }

    const result = calculateCoverage(values);
    if (errorEl instanceof HTMLElement) errorEl.hidden = true;
    resultEl.classList.remove('hidden');
    gapEl.textContent = rm(result.gap);
    breakdownEl.innerHTML = `
      <div class="flex items-start justify-between gap-4 text-sm">
        <span class="text-stone-600">Gantian pendapatan</span>
        <span class="text-right font-semibold text-stone-900">${rm(result.incomeReplacement)} <span class="block text-xs font-normal text-stone-500">(${rm(values.monthlyIncome)} × 12 × ${values.yearsSupport} tahun)</span></span>
      </div>
      <div class="flex items-start justify-between gap-4 border-t border-hijau-100 pt-2 text-sm">
        <span class="text-stone-600">(+) Hutang &amp; belanja khas</span>
        <span class="font-semibold text-stone-900">${rm(values.debts + values.specialExpenses)}</span>
      </div>
      <div class="flex items-start justify-between gap-4 border-t border-hijau-100 pt-2 text-sm">
        <span class="text-stone-600">(−) Simpanan &amp; coverage sedia ada</span>
        <span class="font-semibold text-stone-900">${rm(result.deductions)}</span>
      </div>
      <div class="flex items-start justify-between gap-4 border-t border-hijau-200 pt-2 text-sm font-bold">
        <span class="text-stone-900">(=) Jurang</span>
        <span class="text-hijau-700">${rm(result.gap)}</span>
      </div>`;
    interpretationEl.innerHTML = 'Ini keperluan kasar, bukan cadangan produk dan bukan quote. Kalau jurang besar, baca <a href="/life-insurance/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">panduan insurans nyawa</a> dulu sebelum jumpa sesiapa.';

    track('coverage_calculate', {
      monthly_income: values.monthlyIncome,
      years_support: values.yearsSupport,
      debts: values.debts,
      special_expenses: values.specialExpenses,
      savings: values.savings,
      existing_cover: values.existingCover,
    });
  }

  const paramNames: Record<keyof CoverageInputs, string[]> = {
    monthlyIncome: ['monthlyIncome', 'income'],
    yearsSupport: ['yearsSupport', 'years'],
    debts: ['debts'],
    specialExpenses: ['specialExpenses', 'special'],
    savings: ['savings'],
    existingCover: ['existingCover', 'cover'],
  };

  function applyUrlParams(): void {
    const params = new URLSearchParams(window.location.search);
    const invalidParams: string[] = [];

    (Object.keys(paramNames) as Array<keyof CoverageInputs>).forEach((key) => {
      const paramName = paramNames[key].find((name) => params.has(name));
      if (!paramName) return;

      const raw = params.get(paramName);
      const value = raw && raw.trim() !== '' ? Number(raw) : Number.NaN;
      if (!isValidValue(key, value)) {
        invalidParams.push(paramName);
        return;
      }

      const field = fields[key];
      if (field) field.value = String(value);
    });

    const handoffNote = document.getElementById('handoff-note');
    if (invalidParams.length > 0 && handoffNote instanceof HTMLElement) {
      handoffNote.textContent = `Parameter ${invalidParams.join(' dan ')} tidak sah dan diabaikan.`;
      handoffNote.hidden = false;
    }
  }

  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      calculateFromForm();
    });
  }

  applyUrlParams();
</script>
