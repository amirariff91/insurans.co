---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import companies from '../../data/companies.json';
import platforms from '../../data/platforms.json';

type Platform = (typeof platforms.records)[number];

const platformRoots: Record<string, string> = {
  fwd: 'https://www.fwd.com.my/',
  shopee: 'https://shopee.com.my/',
  bjak: 'https://bjak.my/',
  policystreet: 'https://policystreet.com.my/',
  myeg: 'https://www.myeg.com.my/',
  kaotim: 'https://kaotim.my/',
};

const modelLabels: Record<string, string> = {
  'insurer-langsung': 'Insurer-langsung',
  aggregator: 'Aggregator',
  'aggregator + FA/IFA berlesen': 'Aggregator · FA/IFA diluluskan BNM',
  marketplace: 'Marketplace',
  'platform berkontrak JPJ (bukan eksklusif)': 'Penyedia kontrak JPJ · bukan eksklusif',
  'insurer-langsung (takaful digital)': 'Takaful digital',
};

const modelDescriptions: Record<string, string> = {
  'insurer-langsung': 'beli terus daripada penginsurans atau takaful tanpa ejen.',
  aggregator: 'bandingkan beberapa penginsurans dalam satu laman.',
  'aggregator + FA/IFA berlesen': 'membandingkan produk beberapa insurer dan diluluskan BNM sebagai Financial Adviser serta Islamic Financial Adviser.',
  marketplace: 'beli produk daripada penyedia melalui platform pihak ketiga.',
  'platform berkontrak JPJ (bukan eksklusif)': 'menyediakan urusan JPJ sebagai salah satu penyedia kontrak, bukan saluran eksklusif.',
  'insurer-langsung (takaful digital)': 'saluran takaful digital terus milik pengendali takaful tanpa aggregator.',
};

const productLabels: Record<string, string> = {
  life: 'Insurans hayat / term',
  'critical-illness': 'Penyakit kritikal',
  health: 'Kesihatan / medical card',
  travel: 'Travel insurance / takaful',
  car: 'Insurans kereta',
  motorcycle: 'Insurans motosikal',
  'personal-accident': 'Kemalangan diri',
  home: 'Perlindungan kandungan rumah',
  roadtax: 'Renew roadtax',
};


const pageMeta: Record<string, { title: string; description: string; h1: string }> = {
  kaotim: {
    title: 'Kaotim Medical Card Review — Insurans.co',
    description: 'Kaotim medical card review BM: manfaat MediKad, had perlindungan, takaful digital dan perkara penting dalam PDS sebelum beli online.',
    h1: 'Kaotim Medical Card Review: MediKad',
  },
  fwd: {
    title: 'FWD Takaful & FWD Insurance — Insurans.co',
    description: 'FWD takaful dan FWD insurance online: bandingkan pelan hayat, penyakit kritikal, perubatan serta perlindungan i-Lindung untuk ahli KWSP dan keluarga.',
    h1: 'FWD: Beli Insurans & Takaful Online Tanpa Ejen',
  },
  shopee: {
    title: 'Shopee Insurance Review — Insurans.co',
    description: 'Shopee Insurance review BM: faham model marketplace SeaMoney, Allianz dan Zurich, produk travel, ansuran SPayLater serta caveat COVID sebelum beli.',
    h1: 'Shopee Insurance: Apa Deal Sebenarnya?',
  },
  bjak: {
    title: 'Bjak Insurance Online — Insurans.co',
    description: 'Bjak insurance online: status FA/IFA BNM, panel motor, ansuran, aliran roadtax melalui MyJPJ dan kenyataan JPJ bertarikh 6 Mei 2024.',
    h1: 'Bjak: Insurance Online & Renew Roadtax',
  },
  policystreet: {
    title: 'PolicyStreet Insurance Online — Insurans.co',
    description: 'PolicyStreet insurance online: semak status FA/IFA BNM, panel motor, aliran roadtax, keahlian Drive+ berbayar dan bantuan tuntutan.',
    h1: 'PolicyStreet: Insurance Online & Roadtax',
  },
  myeg: {
    title: 'MyEG Insurance & Roadtax Online — Insurans.co',
    description: 'MyEG insurance online: semak peranan kontrak JPJ bukan eksklusif, insurans auto, aliran e-LKM, yuran dan had bantuan tuntutan.',
    h1: 'MyEG: Insurance & Roadtax Online',
  },
};

export function getStaticPaths() {
  return platforms.records.map((platform) => ({
    params: { slug: platform.slug },
    props: { platform },
  }));
}

const { platform } = Astro.props as { platform: Platform };
const seo = pageMeta[platform.slug] ?? {
  title: `${platform.name} — banding & beli insurans online | Insurans.co`,
  description: `${platform.name}: ${platform.keyFact}`.slice(0, 155),
  h1: platform.name,
};
const canonicalUrl = `https://insurans.co/insurans-online/${platform.slug}/`;
const modelLabel = modelLabels[platform.model] ?? platform.model;
const modelDescription = modelDescriptions[platform.model] ?? 'saluran untuk mendapatkan produk insurans atau takaful.';
const platformRoot = platformRoots[platform.slug] ?? 'https://insurans.co/insurans-online/';
const parentCompanySlug = platform.parentCompany;
const parentCompany = parentCompanySlug
  ? companies.find((company) => company.slug === parentCompanySlug)
  : undefined;
const productList = platform.products.map((product) => productLabels[product] ?? product).join(', ');
const sourceLinks = platform.sources.map((url) => ({
  label: new URL(url).hostname.replace(/^www\./, ''),
  url,
}));

const baseFaqs = [
  {
    q: `${platform.name} ini penginsurans atau platform?`,
    a: `${platform.name} menggunakan model ${modelLabel.toLowerCase()}: ${modelDescription} Saluran digitalnya ialah ${platform.digitalPlatform}.`,
  },
  {
    q: `Apa boleh dibuat di ${platform.name}?`,
    a: `Anda boleh mendapatkan ${productList} melalui saluran ini. Bandingkan quotation serta PDS atau dokumen sijil di saluran rasmi sebelum membayar.`,
  },
  {
    q: `Apa caveat penting untuk ${platform.name}?`,
    a: platform.caveat,
  },
];
const faqs = parentCompany
  ? [
      ...baseFaqs,
      {
        q: `Siapa syarikat induk ${platform.name}?`,
        a: `${platform.name} ialah platform milik ${parentCompany.name}. Pautan ke rekod syarikat itu disediakan untuk rujukan, bukan pengesyoran.`,
      },
    ]
  : baseFaqs;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: seo.h1,
  description: seo.description,
  url: canonicalUrl,
  datePublished: platform.asAt,
  dateModified: platform.asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Online', item: 'https://insurans.co/insurans-online/' },
      { '@type': 'ListItem', position: 3, name: platform.name, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={seo.title}
  description={seo.description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={platform.asAt}
  modifiedTime={platform.asAt}
>
  <Hero title={seo.h1}>
    <Byline slot="byline" dateModified={platform.asAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Insurans Online', href: '/insurans-online/' },
        { label: platform.name },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      Kenali produk {platform.name}, cara pembelian online, bayaran dan perkara penting sebelum memilih perlindungan.
    </p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="label">Platform online</p>
          <h2 class="mt-2 font-serif text-headline-sm text-stone-900">{platform.name}</h2>
          <p class="mt-1 text-sm leading-5 text-stone-600">{platform.digitalPlatform}</p>
        </div>
        <span class="inline-flex w-fit border border-hijau-700 bg-hijau-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-hijau-800">
          {modelLabel}
        </span>
      </div>
      <p class="mt-5 border-t border-stone-200 pt-4 text-sm leading-5 text-stone-700">{platform.keyFact}</p>
      {parentCompany && parentCompanySlug && (
        <p class="mt-3 text-sm leading-5 text-stone-600">
          Syarikat induk:{' '}
          <a href={`/companies/${parentCompanySlug}/`} class="text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">
            {parentCompany.name}
          </a>
        </p>
      )}
    </div>

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={platform.asAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial">
        <p class="text-lg text-stone-700">{platform.keyFact}</p>

        <h2 id="produk">Apa boleh buat di sini?</h2>
        <p>Produk dan urusan yang tersedia melalui saluran ini:</p>
        <ul>
          {platform.products.map((product) => <li>{productLabels[product] ?? product}</li>)}
        </ul>

        <h2 id="caveat">Perhatian / caveat</h2>
        <div class="info-box">
          <p><strong>Semak sebelum bayar:</strong>{' '}{platform.caveat}</p>
        </div>

        {platform.slug === 'kaotim' && (
          <>
            <h2 id="kaotim-review">Kaotim MediKad: ulasan ringkas</h2>
            <p>
              <strong>Ringkasan:</strong> Kaotim ialah platform takaful digital milik Takaful Malaysia — direct channel,
              bukan aggregator, bukan ejen. MediKad ialah kad perubatan takaful standalone dalam platform tu: quote, apply,
              e-certificate dan e-medical card semua online tanpa ejen. Model ini berasaskan urusan takaful bajet secara kendiri;
              terma perlu disemak dalam dokumen produk.
            </p>
            <h3>Manfaat dan had MediKad</h3>
            <p>
              Model direct-to-consumer, perlindungan takaful penuh bawah Takaful Malaysia, dan pemasaran rasmi
              "dari RM38 sebulan" (laman rasmi medikad.kaotim.my). Tier (laman rasmi + PDS MediKad 19/07/2024):
              Standard RM50,000, Pro RM75,000, Max RM100,000 annual limit, naik ke RM550,000 / RM825,000 / RM1.1 juta dengan rider
              MediBooster; room &amp; board RM100/RM150/RM200 sehari, tiada lifetime limit. Untuk terma penuh dan pengecualian,
              buka PDS dalam browser sebelum beli.
            </p>
            <h3>Pertimbangan utama</h3>
            <p>
              Model tanpa ejen; bajet takaful asas. Pertimbangkan: premium naik ikut umur, pre-existing kena declare, GP rutin
              tak dilindungi. Semak PDS MediKad semasa.
            </p>
            <h3>Caveat kena hadam</h3>
            <p>
              Premium naik ikut age band; pre-existing tetap kena declare; rawatan GP rutin tidak dilindungi — medical card bayar
              inpatient/day surgery dan outpatient tersenarai saja. Semak PDS MediKad semasa untuk terma dan pengecualian.
            </p>
          </>
        )}

        {platform.slug === 'fwd' && (
          <>
            <h2 id="fwd-review">FWD: beli insurans &amp; takaful online tanpa ejen</h2>
            <p>
              <strong>Ringkasan:</strong> FWD Malaysia ialah insurer-langsung — FWD Insurance Berhad (konvensional) dan FWD
              Takaful Berhad (takaful keluarga). Saluran "Buy Online" di fwd.com.my membolehkan pembelian terus tanpa ejen.
              Semak manfaat, kelayakan dan dokumen produk sebelum memohon.
            </p>
            <h3>Apa boleh beli online?</h3>
            <p>
              FWD menawarkan i-Care untuk insurans hayat bertempoh, i-Protect dan i-Protect Plus untuk penyakit kritikal,
              serta i-Med untuk perlindungan perubatan. Rujuk halaman rasmi
              <a href="https://www.fwd.com.my/life-insurance-takaful/i-care/" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">i-Care</a>,
              <a href="https://www.fwd.com.my/critical-illness-insurance-takaful/i-protect-plus/" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">i-Protect</a>
              dan <a href="https://www.fwd.com.my/medical-insurance-takaful/i-med/" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">i-Med</a>
              untuk manfaat serta syarat setiap pelan.
            </p>
            <h3 id="fwd-ilindung">Perlindungan FWD untuk ahli KWSP</h3>
            <p>
              FWD i-Lindung Critical Illness Plan melindungi penyakit kritikal dari peringkat awal hingga lanjut serta
              kematian, dengan jumlah perlindungan sehingga RM200,000. Pelan ini boleh melindungi diri, pasangan dan anak.
              Rujuk <a href="https://www.fwd.com.my/files/v3/assets/bltca8cd6b067df6d1c/bltcdda9742a1440734/68d363633653b77049b4928e/FWD_i-Lindung_Critical_Illness_Plan_P2_EN_V0.1.pdf?branch=capricorn" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">brosur rasmi FWD i-Lindung</a>
              untuk kelayakan umur, tempoh menunggu dan pengecualian.
            </p>
            <h3>Caveat utama</h3>
            <p>
              Jawab soalan kesihatan dengan tepat dan semak tempoh menunggu serta pengecualian dalam dokumen produk.
              Untuk FWD i-Lindung Critical Illness Plan, sumbangan bergantung pada jumlah perlindungan, umur dan jantina
              orang yang dilindungi, seperti dinyatakan dalam brosur rasmi di atas.
            </p>
            <p>
              Kami tiada hubungan berbayar dengan FWD. Semak PDS FWD (had, waiting, exclusion, COI tidak dijamin) dan quotation
              semasa sebelum bayar — terma menentukan perlindungan sebenar.
            </p>
          </>
        )}

        {platform.slug === 'shopee' && (
          <>
            <h2 id="shopee-review">Shopee Insurance: apa deal sebenarnya?</h2>
            <p>
              <strong>Ringkasan:</strong> Shopee Insurance bukan penginsurans — ia marketplace dalam app Shopee/ShopeePay yang
              dikendalikan entiti agensi SeaMoney. Shopee jadi ejen digital; risiko ditanggung Allianz, Zurich dan rakan lain.
              Model ini bermaksud platform menjadi saluran pembelian, manakala risiko ditanggung oleh penyedia.
            </p>
            <h3>Pilihan produk dalam Shopee</h3>
            <p>
              Pusat Bantuan Shopee artikel 145752 + ShopeePay menyenaraikan Allianz Travel Insurance (konvensional) dan Zurich
              Travel Takaful (single dan annual antarabangsa), takaful motor (contoh Takaful IKHLAS), personal accident dan wallet
              protection. SPayLater 3–12 bulan (berstruktur patuh Syariah untuk takaful) ialah pilihan bayaran yang dipaparkan
              dalam marketplace. Semak syarat ansuran dan terma penyedia dalam app.
            </p>
            <h3>Perkara penting sebelum beli</h3>
            <p>
              Perlindungan COVID pada pelan Allianz tertakluk kepada syarat vaksinasi penuh dan bukti diagnosis.
              Zurich Travel Takaful domestik meliputi perjalanan sekurang-kurangnya 50 km dari rumah; bayaran balik
              pembatalan sijil tahunan bergantung pada tempoh berkuat kuasa. Rujuk
              <a href="https://help.shopee.com.my/portal/4/article/145752" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">maklumat rasmi travel insurance/takaful Shopee</a>
              dan dokumen penyedia sebelum membayar.
            </p>
            <h3>Pertimbangan</h3>
            <p>
              Model ini menggunakan self-service dan pilihan ansuran. Marketplace tidak menggantikan ejen atau penasihat untuk
              struktur cover atau kes claim kompleks. Kami bukan ejen dan tiada affiliate dengan Shopee — semak had perubatan,
              status COVID (add-on vs standard) dan threshold delay dalam PDS atau laman insurer sebelum bayar.
            </p>
          </>
        )}
        {platform.slug === 'policystreet' && (
          <>
            <h2 id="policystreet-review">PolicyStreet: platform insurans dan roadtax</h2>
            <p>
              <strong>Ringkasan:</strong> PolicyStreet ialah saluran digital untuk produk insurer; entiti yang dinyatakan dalam
              terma ialah Polisea Sdn. Bhd. (201601041144 (1212085-T)), bukan penginsurans. Polisea menyatakan ia diluluskan
              Bank Negara Malaysia sebagai Financial Adviser (FA) dan Islamic Financial Adviser (IFA) di bawah Akta
              Perkhidmatan Kewangan 2013; nama syarikat turut tersenarai dalam <a href="https://www.bnm.gov.my/-/approved-financial-advisers" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">senarai FA BNM</a>.
              Terma perniagaan menyatakan polisi dan tuntutan kekal tertakluk kepada insurer atau pengendali takaful yang
              mengeluarkan perlindungan.
            </p>
            <h3>Perbandingan insurans dan roadtax</h3>
            <p>
              PolicyStreet menyediakan perbandingan insurans kereta dan pembaharuan roadtax dalam satu checkout.
              Pilih pelan serta add-on yang diperlukan, kemudian semak nama insurer dalam quotation.
              Roadtax diproses selepas polisi insurans dikeluarkan. Rujuk
              <a href="https://policystreet.com.my/en/renew-road-tax" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">langkah pembaharuan rasmi PolicyStreet</a>.
            </p>
            <h3>Produk, aliran roadtax dan e-LKM</h3>
            <p>
              Sediakan VOC atau salinan geran, insurans aktif dan dokumen pengenalan. Halaman pembaharuan PolicyStreet
              turut meminta pelanggan menyelesaikan saman JPJ atau PDRM sebelum memperbaharui roadtax.
              Untuk menyemak e-LKM, buka MyJPJ, pilih Profil, tab Kenderaan dan nombor pendaftaran kereta.
              Rujuk <a href="https://policystreet.com.my/en/renew-road-tax" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">syarat dan langkah semakan e-LKM</a>.
            </p>
            <h3>Bayaran, yuran dan bantuan tuntutan</h3>
            <p>
              Drive+ ialah keahlian pilihan berbayar:
              Lite RM49.90, Standard RM79.90 dan Premium RM109.90; manfaat yang diiklankan termasuk diskaun roadtax, baucar,
              sokongan keutamaan dan panduan tuntutan. Sumber: <a href="https://policystreet.com.my/en/blog/get-cheapest-road-tax-with-policystreet-membership" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">penerangan rasmi Drive+</a>.
              Kaedah bayaran yang disenaraikan termasuk FPX, Visa/Mastercard, TNG eWallet, Boost, ShopBack, GrabPay, SPayLater,
              Atome, AHA Pay Later dan ansuran kad 3/6/12 bulan melalui 11 bank. Dalam terma, pelanggan perlu memaklumkan
              PolicyStreet secara bertulis tentang tuntutan; jika PolicyStreet mengendalikannya bagi pihak pelanggan, ia
              menyatakan tuntutan akan diurus secara adil dan dengan segera yang munasabah. Terma juga menyebut tempoh
              cooling-off tujuh hari untuk refund motor. Rujuk <a href="https://policystreet.com.my/en/terms-business" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">terma perniagaan dan senarai pembayaran</a>.
            </p>
            <h3>Caveat</h3>
            <p>
              Drive+ dipilih semasa checkout. Bayaran keahlian dan manfaatnya berasingan daripada premium polisi;
              semak yuran, kelayakan baucar serta terma pembayaran sebelum membeli.
              <a href="https://policystreet.com.my/en/blog/get-cheapest-road-tax-with-policystreet-membership" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Panduan rasmi Drive+</a>
              menerangkan tiga tahap keahlian dan cara menerima baucar melalui emel.
            </p>
            <h3>Pertimbangan</h3>
            <p>
              Bezakan status FA/IFA daripada status insurer: Polisea memberi khidmat nasihat/pengantaraan kewangan, manakala
              insurer atau pengendali takaful menerbitkan perlindungan. Sebelum membayar, sahkan panel dan quotation untuk
              kenderaan anda, jumlah kos Drive+ jika dipilih, syarat roadtax serta PDS polisi yang mengeluarkan cover. Insurans.co
              tiada hubungan berbayar atau affiliate dengan PolicyStreet; pautan ini sumber untuk semakan, bukan pengesyoran.
            </p>
          </>
        )}

        {platform.slug === 'bjak' && (
          <>
            <h2 id="bjak-review">Bjak: semakan insurer, produk dan roadtax</h2>
            <p>
              <strong>Ringkasan:</strong> Bjak Sdn. Bhd. ialah platform perbandingan dan bukannya syarikat insurans. Bjak
              menyatakan ia mendapat kelulusan BNM sebagai Financial Adviser (FA) dan Islamic Financial Adviser (IFA) pada
              Oktober 2025; namanya terdapat pada <a href="https://www.bnm.gov.my/-/approved-financial-advisers" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">senarai rasmi BNM</a>.
              Status FA/IFA itu berasingan daripada kebenaran JPJ untuk urusan roadtax.
            </p>
            <h3>Panel insurans dan pilihan bayaran</h3>
            <p>
              Halaman rasmi menyenaraikan 16 insurer/takaful untuk panel motor setakat 13 Mei 2026: AIG Malaysia, Allianz
              General, Chubb Malaysia, Generali, Great Eastern General, Liberty General, Lonpac, MSIG, Pacific &amp; Orient,
              RHB Insurance, Berjaya Sompo, Takaful Ikhlas General, Syarikat Takaful Malaysia Am, Tokio Marine Insurans, Tune
              Insurance dan Zurich General Takaful. Menu rasmi turut memaparkan car, motorcycle, travel termasuk Umrah, life
              dan medical, personal accident, kandungan rumah, roadtax, BJAK VIP serta tempahan bengkel. Sumber: <a href="https://bjak.my/en/approved-financial-adviser" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">status FA dan panel Bjak</a> dan
              <a href="https://bjak.my/en" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">menu produk rasmi</a>.
            </p>
            <h3>Aliran roadtax dan e-LKM</h3>
            <p>
              Insurans diproses dahulu. Jika roadtax dipilih semasa checkout, pembaharuannya dihantar untuk pemprosesan
              JPJ selepas insurans aktif. Bjak menghantar resit dan kemas kini status; pelanggan boleh melihat roadtax digital
              dalam MyJPJ. Perkhidmatan roadtax Bjak tidak tersedia untuk kenderaan e-hailing.
              Rujuk <a href="https://bjak.my/en/roadtax/how-roadtax-renewal-works" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">aliran pembaharuan dan had perkhidmatan Bjak</a>.
            </p>
            <h3>Bayaran dan sokongan tuntutan</h3>
            <p>
              Bjak menyediakan sokongan selepas pembelian untuk isu bayaran, polisi belum diterima, bayaran balik dan
              tuntutan. Polisi atau cover note dikeluarkan oleh insurer atau pengendali takaful yang dipilih.
              Simpan resit dan nombor polisi supaya pasukan sokongan boleh menyemak urusan anda.
              Rujuk <a href="https://bjak.my/en/trust/is-bjak-legit" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">penerangan rasmi sokongan Bjak</a>.
            </p>
            <h3>Caveat — pertikaian JPJ 2024</h3>
            <p>
              Dalam kenyataan bertarikh 6 Mei 2024, JPJ menyatakan bahawa Bjak tidak mendapat kelulusan untuk
              pembaharuan roadtax dan sistemnya tidak berintegrasi dengan MySikap. Kenyataan itu turut merekodkan aduan
              tempoh sah laku yang tidak dikemas kini serta caj tambahan yang tidak diluluskan.
              Baca <a href="https://www.jpj.gov.my/wp-content/uploads/2024/08/LATEST-PR-PENJELASAN-BJAK.pdf" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">kenyataan asal JPJ pada 6 Mei 2024</a>.
              Untuk urusan pembaharuan, JPJ menyenaraikan kaunter, kios, MyJPJ, portal awam serta rakan niaganya sebagai
              saluran yang boleh digunakan dalam kenyataan tersebut.
            </p>
            <h3>Pertimbangan</h3>
            <p>
              Semak polisi dan insurer yang mengeluarkan perlindungan, jumlah premium serta kos ansuran sebelum membayar.
              Untuk roadtax, periksa status e-LKM dalam MyJPJ. Bjak menyediakan aliran pembaharuan insurans dan roadtax
              serta sokongan selepas pembelian; semak dokumen polisi dan resit untuk butiran urusan anda.
            </p>
          </>
        )}

