---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import personalAccident from '../../data/personal-accident.json';
import { buildDescription, buildTitle } from '../../lib/seo';

type PersonalAccidentRecord = (typeof personalAccident.records)[number];

const records = personalAccident.records;
const typeLabels: Record<string, string> = {
  'personal-accident': 'PA konvensional',
  'personal-accident-takaful': 'PA takaful',
};

export function getStaticPaths() {
  return personalAccident.records.map((record) => ({
    params: { slug: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props as { record: PersonalAccidentRecord };
const canonicalUrl = `https://insurans.co/personal-accident/${record.slug}/`;
const typeLabel = typeLabels[record.type] ?? record.type;
const { analysis } = record;
// Measured on built <main> text, excluding collapsed FAQ answers: >=700 words and Jaccard <0.35.
const adsEnabledSlugs = new Set([
  'etiqa-buddy-pa-weekend-warrior',
  'tune-protect-pa-easy',
  'tune-protect-pa-shield',
  'allianz-personal-accident',
]);
const passesUniqueness = adsEnabledSlugs.has(record.slug);
const siblingRecord = records.find((candidate) => candidate.slug === analysis.siblingSlug)!;
const sourceLabel = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const sourceLinks = Array.from(new Set([
  ...record.sources,
  ...analysis.facts.map((fact) => fact.source),
])).map((url) => ({
  label: sourceLabel(url),
  url,
}));
const specItems = [
  { label: 'Jenis pelan', value: typeLabel },
  ...analysis.facts.filter((fact) => [
    'Kematian akibat kemalangan',
    'Umur kemasukan',
    'Umur dan status pemohon',
    'Umur dan kelayakan kemasukan',
    'Kelayakan dan percanggahan umur',
  ].includes(fact.label)),
];
const pageTitle = `${record.planName} — PA`;
const description = buildDescription(
  `${record.planName}: kelayakan, skala hilang upaya, had manfaat dan pengecualian. Bandingan dengan ${siblingRecord.planName} menggunakan dokumen rasmi.`,
);
const faqs = analysis.faqs;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: record.asAt,
  dateModified: record.analysisAsAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Kemalangan Diri', item: 'https://insurans.co/personal-accident/' },
      { '@type': 'ListItem', position: 3, name: record.planName, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={buildTitle(pageTitle)}
  description={description}
  canonical={canonicalUrl}
  ads={passesUniqueness}
  schema={schema}
  ogType="article"
  publishedTime={record.asAt}
  modifiedTime={record.analysisAsAt}
>
  <Hero title={`Insurans kemalangan diri: ${record.planName}`}>
    <Byline slot="byline" dateModified={record.analysisAsAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Insurans Kemalangan Diri', href: '/personal-accident/' },
        { label: record.planName },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      {analysis.facts.find((fact) => fact.label === 'Kematian akibat kemalangan')?.value}
    </p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="label">Personal accident</p>
          <h2 class="mt-2 font-serif text-headline-sm text-stone-900">{record.planName}</h2>
          <p class="mt-1 text-sm leading-5 text-stone-600">{record.insurer}</p>
        </div>
        <span class="inline-flex w-fit border border-hijau-700 bg-hijau-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-hijau-800">
          {typeLabel}
        </span>
      </div>

      <h2 class="mt-7 font-serif text-headline-sm text-stone-900">Ringkasan rekod</h2>
      <dl class="mt-4 space-y-3 text-sm">
        {specItems.map((spec) => (
          <div class="border-t border-stone-200 pt-3 first:border-t-0 first:pt-0">
            <dt class="text-stone-500">{spec.label}</dt>
            <dd class="mt-1 font-semibold leading-5 text-stone-900">{spec.value}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-5 border-t border-stone-200 pt-4 text-sm leading-5 text-stone-600">
        Analisis dikemas kini pada {record.analysisAsAt}. Tarikh rekod asal: {record.asAt}.
      </p>
    </div>

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={record.analysisAsAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial">
        <h2 id="sesuai">Siapa yang sesuai dengan {record.planName}</h2>
        <p>{analysis.bestFor}</p>

        <h2 id="fakta">Fakta utama {record.planName}</h2>
        <dl class="space-y-5">
          {analysis.facts.map((fact) => (
            <div class="border-t border-stone-200 pt-4">
              <dt class="font-semibold text-stone-900">{fact.label}</dt>
              <dd class="mt-2 leading-7 text-stone-700">
                {fact.value}{' '}
                <sup>
                  <a href={fact.source} aria-label={`Sumber untuk ${fact.label}`}>
                    [{sourceLinks.findIndex((source) => source.url === fact.source) + 1}]
                  </a>
                </sup>
              </dd>
            </div>
          ))}
        </dl>

        <h2 id="had">Had dan perkara yang perlu ditimbang</h2>
        <p>{analysis.tradeoffs}</p>

        <h2 id="bandingan">{record.planName} berbanding {siblingRecord.planName}</h2>
        <ul>
          {analysis.siblingDifferences.map((difference) => <li>{difference}</li>)}
        </ul>
        <p>
          <a href={`/personal-accident/${siblingRecord.slug}/`}>Lihat manfaat dan syarat {siblingRecord.planName} →</a>
        </p>
        <p class="text-sm text-stone-600">
          Untuk penerangan AD, PPD dan cara membandingkan polisi, baca <a href="/personal-accident/">panduan insurans kemalangan diri</a>.
        </p>
      </article>

      <section id="faq">
        <div class="prose-editorial">
          <h2>Soalan lazim — {record.planName}</h2>
        </div>
        <div class="mt-5">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="sumber" class="prose-editorial">
        <h2>Sumber rasmi {record.planName}</h2>
        <ol>
          {sourceLinks.map((source, index) => (
            <li id={`sumber-${index + 1}`}>
              <a href={source.url} class="break-words">
                {source.label} · {new URL(source.url).pathname.split('/').filter(Boolean).pop()}
              </a>
            </li>
          ))}
        </ol>
      </section>

      <CtaBand
        heading={`Semak sumber rasmi ${record.planName}`}
        body="Gunakan sumber rasmi untuk membaca PDS, semak quotation dan sahkan syarat sebelum membeli. Insurans.co tidak menjual polisi."
        primary={{ label: 'Kembali ke hub PA →', href: '/personal-accident/' }}
        outbound={sourceLinks.map((source) => ({
          label: `Sumber ${source.label}`,
          href: source.url,
          relationship: 'unpaid' as const,
        }))}
        disclosure="Pautan luar di bawah ialah rujukan rasmi tanpa hubungan berbayar atau affiliate. Harga dan kelayakan boleh berubah; semak dokumen penyedia sebelum bertindak."
        trackingSection="personal-accident-source-cta"
      />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
