---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import homeInsurance from '../../data/home-insurance.json';
import { buildDescription, buildTitle } from '../../lib/seo';

type HomeInsuranceRecord = (typeof homeInsurance.records)[number];

const records = homeInsurance.records;
const typeLabels: Record<string, string> = {
  'houseowner-householder': 'Houseowner / Householder',
  'houseowner-householder-takaful': 'Houseowner / Householder takaful',
  'houseowner-comprehensive': 'Houseowner komprehensif',
  'modular-houseowner-householder': 'Modular house cover',
};

export function getStaticPaths() {
  return homeInsurance.records.map((record) => ({
    params: { slug: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props as { record: HomeInsuranceRecord };
const canonicalUrl = `https://insurans.co/home-insurance/${record.slug}/`;
const typeLabel = typeLabels[record.type] ?? record.type;
// Measured built-page gate: max sibling 5-word Jaccard < 0.35 and main words >= 700.
const adsEnabledSlugs = new Set([
  'berjaya-sompo-houseowner-householder',
  'takaful-malaysia-myhouseowner-householder',
  'pacific-houseowner-householder',
  'bsn-chubb-houseowner',
  'etiqa-hohh',
  'zurich-z-homeprotect',
  'allianz-smart-home-cover',
]);
const passesUniqueness = adsEnabledSlugs.has(record.slug);
const siblingRecord = records.find((candidate) => candidate.slug === record.analysis.siblingSlug)!;
const sourceLinks = [...new Set(record.facts.map((fact) => fact.source))].map((url) => ({
  label: new URL(url).hostname.replace(/^www\./, ''),
  url,
}));
const specItems = record.facts.filter((fact) =>
  ['Jenis dan tempoh polisi', 'Jenis dan tempoh sijil', 'Komponen dan tempoh polisi', 'Premium minimum', 'Sumbangan minimum'].includes(fact.label),
);
const faqTopics = [
  {
    q: `Pelan ${record.planName} ini jenis insurans rumah apa?`,
    labels: ['Jenis dan tempoh polisi', 'Jenis dan tempoh sijil', 'Komponen dan tempoh polisi'],
  },
  {
    q: `Apa yang dilindungi oleh ${record.planName}?`,
    labels: ['Risiko yang dilindungi', 'Risiko dan bahagian perlindungan', 'Risiko asas bangunan dan isi rumah'],
  },
  {
    q: `Apakah contoh premium atau sumbangan rasmi untuk ${record.planName}?`,
    labels: ['Contoh premium rasmi', 'Contoh sumbangan rasmi', 'Contoh premium rasmi dan percanggahan'],
  },
  {
    q: `Bagaimana menentukan jumlah diinsuranskan untuk ${record.planName}?`,
    labels: ['Asas jumlah diinsuranskan', 'Asas jumlah dilindungi', 'Asas nilai bangunan dan isi rumah', 'Asas nilai dan peningkatan perlindungan'],
  },
  {
    q: `${record.planName} melindungi banjir?`,
    labels: ['Banjir dan ekses', 'Banjir dan kelayakan pilihan'],
  },
];
const faqs = faqTopics.flatMap((topic) => {
  const fact = record.facts.find((candidate) => topic.labels.includes(candidate.label));
  return fact ? [{ q: topic.q, a: fact.value }] : [];
});

const title = buildTitle(`${record.planName} — Insurans Rumah`);
const description = buildDescription(
  `${record.planName} oleh ${record.insurer}: kesesuaian pemilik, fakta perlindungan, had, contoh premium rasmi dan perbandingan pelan.`,
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${record.planName} — Insurans Rumah`,
  description,
  url: canonicalUrl,
  datePublished: record.asAt,
  dateModified: record.analysisAsAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Rumah', item: 'https://insurans.co/home-insurance/' },
      { '@type': 'ListItem', position: 3, name: record.planName, item: canonicalUrl },
    ],
  },
};
const outboundSources = sourceLinks.map((source) => ({
  label: `Sumber rasmi · ${source.label}`,
  href: source.url,
  relationship: 'unpaid' as const,
}));
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  ads={passesUniqueness}
  schema={schema}
  ogType="article"
  publishedTime={record.asAt}
  modifiedTime={record.analysisAsAt}
>
  <Hero title={`Insurans rumah: ${record.planName}`}>
    <Byline slot="byline" dateModified={record.analysisAsAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Insurans Rumah', href: '/home-insurance/' },
        { label: record.planName },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      {record.planName} oleh {record.insurer}. Analisis perlindungan, had dan contoh rasmi dikemas kini pada {record.analysisAsAt}.
    </p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="label">Insurans rumah</p>
          <h2 class="mt-2 font-serif text-headline-sm text-stone-900">{record.planName}</h2>
          <p class="mt-1 text-sm leading-5 text-stone-600">{record.insurer}</p>
        </div>
        <span class="inline-flex w-fit border border-hijau-700 bg-hijau-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-hijau-800">
          {typeLabel}
        </span>
      </div>

      <h2 class="mt-7 font-serif text-headline-sm text-stone-900">Ringkasan polisi</h2>
      <dl class="mt-4 space-y-3 text-sm">
        {specItems.map((spec) => (
          <div class="border-t border-stone-200 pt-3 first:border-t-0 first:pt-0">
            <dt class="text-stone-500">{spec.label}</dt>
            <dd class="mt-1 font-semibold leading-5 text-stone-900">{spec.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={record.analysisAsAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial">
        <h2 id="sesuai">Siapa yang sesuai dengan {record.planName}</h2>
        <p>{record.analysis.bestFor}</p>

        <h2 id="fakta">Fakta utama {record.planName}</h2>
        <dl class="mt-5 space-y-5">
          {record.facts.map((fact) => (
            <div class="border-t border-stone-200 pt-4">
              <dt class="font-semibold text-stone-900">{fact.label}</dt>
              <dd class="mt-2 leading-7">
                {fact.value}{' '}
                <sup>
                  <a href={fact.source} aria-label={`Sumber: ${fact.label}`}>
                    [{sourceLinks.findIndex((source) => source.url === fact.source) + 1}]
                  </a>
                </sup>
              </dd>
            </div>
          ))}
        </dl>

        <h2 id="had">Had dan perkara yang perlu ditimbang</h2>
        <p>{record.analysis.tradeoffs}</p>

        <h2 id="banding">{record.planName} berbanding {siblingRecord.planName} ({siblingRecord.insurer})</h2>
        <ul>
          {record.analysis.siblingDifferences.map((difference) => <li>{difference}</li>)}
        </ul>
        <p>
          Baca <a href={`/home-insurance/${siblingRecord.slug}/`}>{siblingRecord.planName} oleh {siblingRecord.insurer}</a> untuk butiran pelan perbandingan.
          Asas bangunan dan isi rumah diterangkan dalam <a href="/home-insurance/">panduan insurans rumah</a>.
        </p>
      </article>

      <section id="faq">
        <div class="prose-editorial">
          <h2>Soalan lazim — {record.planName}</h2>
        </div>
        <div class="mt-5">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="sumber" class="prose-editorial">
        <h2>Sumber rasmi {record.planName}</h2>
        <ol>
          {sourceLinks.map((source, index) => (
            <li>
              <a href={source.url}>{source.label} — rujukan {index + 1}</a>
            </li>
          ))}
        </ol>
      </section>

      <CtaBand
        heading="Semak semua insurans rumah"
        body={`Lihat kedudukan ${record.planName} dalam perbandingan perlindungan bangunan dan isi rumah.`}
        primary={{ label: 'Lihat semua insurans rumah →', href: '/home-insurance/' }}
        outbound={outboundSources}
        disclosure="Pautan luar membuka sumber rasmi penyedia untuk semakan lanjut. Insurans.co tidak menjual polisi; semak PDS, quotation dan terma semasa dengan penyedia."
      />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
