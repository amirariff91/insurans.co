<style>
  .ncd-btn.active {
    border-color: #16a34a;
    background-color: #f0fdf4;
    color: #15803d;
  }
</style>

<script>
  import { basePremiumFromCurrent, isNcdTier, NCD_TIERS, rm, simulate } from '../../../lib/ncd';
  import { track } from '../../../lib/track';

  let selectedNCD: number | null = null;

  function updateNCDResult(): void {
    const baseInput = document.getElementById('base-premium') as HTMLInputElement | null;
    const base = baseInput ? parseFloat(baseInput.value) : Number.NaN;
    if (!base || base < 100 || selectedNCD === null) return;

    const afterNCD = simulate(base, base, selectedNCD).min;
    const saving = base - afterNCD;

    const resultEl = document.getElementById('ncd-result');
    const resultPremiumEl = document.getElementById('result-premium');
    const resultSavingEl = document.getElementById('result-saving');
    const breakdownEl = document.getElementById('result-breakdown');
    if (!resultEl || !resultPremiumEl || !resultSavingEl || !breakdownEl) return;

    resultEl.classList.remove('hidden');
    resultPremiumEl.textContent = rm(afterNCD);
    resultSavingEl.textContent = rm(saving);

    breakdownEl.innerHTML = '<p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-2">Perbandingan semua peringkat NCD</p>';
    NCD_TIERS.forEach((rate) => {
      const premium = simulate(base, base, rate.value).min;
      const tierSaving = base - premium;
      const isActive = rate.value === selectedNCD;
      breakdownEl.innerHTML += `
        <div class="flex justify-between items-center py-1.5 ${isActive ? 'font-bold text-hijau-700' : 'text-stone-600'} text-sm border-b border-hijau-100 last:border-0">
          <span>${rate.label} NCD <span class="text-xs font-normal text-stone-400">(${rate.value === 0 ? 'Tiada NCD yang layak' : rate.years})</span></span>
          <span>${rm(premium)} ${tierSaving > 0 ? '<span class="text-xs text-stone-400">(jimat ' + rm(tierSaving) + ')</span>' : ''}</span>
        </div>`;
    });
    track('ncd_calculate', {
      base_premium: base,
      ncd_pct: selectedNCD,
      premium_after: afterNCD,
      saving,
    });
  }

  function selectNCD(value: number): void {
    document.querySelectorAll<HTMLElement>('.ncd-btn').forEach((button) => {
      button.classList.toggle('active', Number(button.dataset.ncd) === value);
    });
    selectedNCD = value;
  }

  document.querySelectorAll<HTMLElement>('.ncd-btn').forEach((button) => {
    button.addEventListener('click', () => {
      const value = Number(button.dataset.ncd);
      if (!isNcdTier(value)) return;
      selectNCD(value);
      updateNCDResult();
    });
  });

  let ncdInputDebounce: number | undefined;

  document.getElementById('base-premium')?.addEventListener('input', () => {
    window.clearTimeout(ncdInputDebounce);
    ncdInputDebounce = window.setTimeout(updateNCDResult, 500);
  });

  const modelReferenceData = document.getElementById('model-reference-data');
  const modelReferences = modelReferenceData
    ? JSON.parse(modelReferenceData.textContent || '{}') as Record<string, { fullName: string; premiumNCD0Min: number; premiumNCD0Max: number }>
    : {};
  const params = new URLSearchParams(window.location.search);
  const invalidParams: string[] = [];
  const modelParam = params.get('model');
  const modelReference = modelParam ? modelReferences[modelParam] : undefined;
  if (params.has('model') && !modelReference) invalidParams.push('model');

  if (params.has('ncd')) {
    const ncdParam = params.get('ncd');
    const parsedTier = ncdParam && ncdParam.trim() !== '' ? Number(ncdParam) : Number.NaN;
    if (isNcdTier(parsedTier)) {
      selectNCD(parsedTier);
    } else {
      invalidParams.push('NCD');
    }
  }

  const referenceEl = document.getElementById('model-reference');
  const referenceNameEl = document.getElementById('model-reference-name');
  const referenceRangeEl = document.getElementById('model-reference-range');
  if (modelReference && referenceEl && referenceNameEl && referenceRangeEl) {
    referenceNameEl.textContent = modelReference.fullName;
    referenceRangeEl.textContent = `${rm(modelReference.premiumNCD0Min)} – ${rm(modelReference.premiumNCD0Max)}`;
    referenceEl.hidden = false;
  }

  const handoffNote = document.getElementById('handoff-note');
  if (invalidParams.length > 0 && handoffNote) {
    handoffNote.textContent = `Parameter ${invalidParams.join(' dan ')} tidak sah dan diabaikan.`;
    handoffNote.hidden = false;
  }

  // ── Should I Claim? Calculator ──
  document.getElementById('claim-calc-btn')?.addEventListener('click', () => {
    const currentPremium = parseFloat((document.getElementById('current-premium') as HTMLInputElement).value);
    const ncdPct = parseFloat((document.getElementById('current-ncd-pct') as HTMLSelectElement).value);
    const repairCost = parseFloat((document.getElementById('repair-cost') as HTMLInputElement).value);
    const excess = parseFloat((document.getElementById('excess') as HTMLInputElement).value) || 0;

    const resultEl = document.getElementById('claim-result')!;

    if (!currentPremium || isNaN(ncdPct) || !repairCost) {
      resultEl.classList.remove('hidden');
      resultEl.innerHTML = '<p class="text-sm text-red-600 p-4 bg-red-50 border border-red-200">Sila isi semua maklumat di atas.</p>';
      return;
    }

    // Base premium (before NCD)
    const basePremium = basePremiumFromCurrent(currentPremium, ncdPct);

    // After claim: NCD resets to 0%
    const premiumAfterClaim = basePremium; // 0% NCD = full base
    const premiumExtraPerYear = premiumAfterClaim - currentPremium;

    // Net repair payout (repair cost minus excess)
    const netPayout = Math.max(0, repairCost - excess);

    // How many years to recover? (premium extra vs net payout)
    const yearsToRecover = premiumExtraPerYear > 0 ? netPayout / premiumExtraPerYear : 0;

    // Verdict
    const shouldClaim = netPayout > premiumExtraPerYear * 2; // worth it if savings > 2 years of extra premium
    track('ncd_claim_check', {
      repair_cost: repairCost,
      excess,
      ncd_pct: ncdPct,
      should_claim: shouldClaim,
    });

    const verdictColor = shouldClaim ? 'hijau' : 'stone';
    const verdictBg = shouldClaim ? 'bg-hijau-50 border-hijau-300' : 'bg-amber-50 border-amber-300';
    const verdictText = shouldClaim ? 'text-hijau-800' : 'text-amber-800';
    const verdictTitle = shouldClaim ? '✓ Bayaran bersih melebihi ambang dua tahun' : '⚠ Bayaran bersih tidak melebihi ambang dua tahun';
    const verdictDesc = shouldClaim
      ? `Dalam andaian NCD menjadi 0%, bayaran bersih anggaran (${rm(Math.round(netPayout))}) melebihi dua kali tambahan premium asas tahun pertama (${rm(Math.round(premiumExtraPerYear * 2))}). Sahkan kategori tuntutan dengan syarikat sebelum membuat keputusan.`
      : `Dalam andaian NCD menjadi 0%, bayaran bersih anggaran (${rm(Math.round(netPayout))}) tidak melebihi dua kali tambahan premium asas tahun pertama (${rm(Math.round(premiumExtraPerYear * 2))}). Sahkan kategori tuntutan dengan syarikat sebelum membuat keputusan.`;

    resultEl.classList.remove('hidden');
    resultEl.innerHTML = `
      <div class="p-5 border-2 ${verdictBg}">
        <p class="font-bold text-lg ${verdictText} mb-2">${verdictTitle}</p>
        <p class="text-sm ${verdictText} mb-4">${verdictDesc}</p>
        <div class="space-y-2 text-sm border-t ${shouldClaim ? 'border-hijau-200' : 'border-amber-200'} pt-4">
          <div class="flex justify-between">
            <span class="text-stone-600">Kos repair</span>
            <strong>${rm(Math.round(repairCost))}</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-stone-600">Tolak excess polisi</span>
            <strong class="text-red-600">− ${rm(Math.round(excess))}</strong>
          </div>
          <div class="flex justify-between border-t border-stone-200 pt-2">
            <span class="text-stone-600">Net payout dari insurans</span>
            <strong>${rm(Math.round(netPayout))}</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-stone-600">Tambahan premium asas tahun pertama (NCD 0%)</span>
            <strong class="text-red-600">+ ${rm(Math.round(premiumExtraPerYear))}</strong>
          </div>
          ${!shouldClaim ? `
          <div class="flex justify-between border-t border-stone-200 pt-2">
            <span class="text-stone-600 font-semibold">Tambahan premium asas tolak bayaran bersih</span>
            <strong class="text-red-700">${rm(Math.round(premiumExtraPerYear - netPayout))} (tahun pertama)</strong>
          </div>` : ''}
        </div>
      </div>
    `;
  });
</script>
