---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import medicalCards from '../../data/medical-cards.json';
import { buildDescription, buildTitle } from '../../lib/seo';

const cards = medicalCards.records;
const updatedAt = '2026-10-10';
const typeOrder = ['standalone', 'rider', 'takaful'];
const typeLabels: Record<string, string> = {
  standalone: 'Standalone',
  rider: 'Rider perubatan',
  takaful: 'Takaful',
};
const typeDescriptions: Record<string, string> = {
  standalone: 'Pelan medical card yang berdiri sendiri.',
  rider: 'Perlindungan perubatan yang dilampirkan pada pelan asas.',
  takaful: 'Pelan perlindungan perubatan berasaskan takaful.',
};
const cardGroups = typeOrder
  .map((type) => ({
    type,
    label: typeLabels[type],
    description: typeDescriptions[type],
    cards: cards.filter((card) => card.type === type),
  }))
  .filter((group) => group.cards.length > 0);

const faqs = [
  {
    q: "Medical card murah di Malaysia — apa yang sebenarnya murah tu?",
    a: "Harga perlu dibaca bersama had tahunan dan bayaran sendiri. Medic Plus dalam brosur 07/2023 ialah perlindungan tambahan dengan deductible RM10,000 setiap disability setiap tahun polisi, atau RM5,000 di hospital kerajaan. GREAT MedCare menawarkan deductible pilihan RM2,000–RM20,000 dengan julat diskaun premium 5%–50%. Kaotim MediKad menawarkan deductible RM2,000 atau RM3,000 setiap disability dengan diskaun sumbangan 20% atau 30%. Bandingkan pilihan yang sama dalam sebut harga individu, termasuk perlindungan asas dan rider.",
  },
  {
    q: "Best medical card Malaysia — yang mana patut saya ambil?",
    a: "Keperluan dan bajet menentukan pilihan. SmartMedic Shield menyediakan RM1,000,000–RM2,000,000 setahun, atau sehingga RM4,000,000 bersama Extender. A-Plus Health360 menyediakan RM3,000,000. PRUMillion Med 2.0 menyediakan RM2,000,000. OneMedical menawarkan RM50,000, RM100,000 atau RM150,000. myMedik menawarkan RM150,000–RM500,000, atau RM900,000–RM1,500,000 bersama MedikBooster. Semua pelan ini tiada had keseluruhan seumur hidup, namun manfaat tertentu masih mempunyai had khusus. Nilai deductible, perkongsian kos, kelayakan bilik dan tempoh perlindungan pada halaman setiap pelan.",
  },
  {
    q: "Waiting period medical card — berapa lama kena tunggu sebelum boleh claim?",
    a: "Dokumen AIA, SmartMedic Shield, GREAT MedCare, OneMedical, i-MedicalCard Elite, Prudential, myMedik, MediKad dan brosur Medic Plus menyatakan tempoh penyakit umum 30 hari serta penyakit tertentu 120 hari. Syarat kecederaan kemalangan, pengembalian polisi dan manfaat khusus berbeza mengikut pelan. AIA juga mempunyai ketetapan gejala kanser pesakit luar dalam 60 hari pertama dan dialisis dalam 30 hari pertama. Brosur Medic Plus 07/2023 membenarkan keadaan sedia ada yang diisytiharkan serta diterima tanpa syarat selepas 12 bulan. Untuk IKHLAS Medik, minta PDS dan sijil daripada ejen bagi syarat tempoh menunggu.",
  },
  {
    q: "Kaotim MediKad review — okay ke?",
    a: "Kaotim MediKad ialah sijil takaful perubatan langsung dalam talian tanpa komisen ejen. Kelayakan bilik Standard, Pro dan Max ialah RM100, RM150 dan RM200 sehari. Had bersama MediBooster ialah RM550,000, RM825,000 dan RM1,100,000; rider hanya boleh dipilih ketika permohonan. PDS semasa menggunakan nilai templat untuk had tahunan, jadi dapatkan had asas pada sebut harga individu. Pilihan Full Coverage RM0 atau deductible RM2,000/RM3,000 setiap disability mempunyai struktur bayaran sendiri berbeza. Elaun hospital kerajaan RM100 sehari tersedia bagi semua pelan. Perlindungan sehingga 85 ANB, dengan tempoh menunggu dan pengecualian dalam sijil.",
  },
  {
    q: "Medical card untuk baby dan family — umur berapa boleh masuk?",
    a: "A-Plus Health360 dan SmartMedic Shield menerima anak dari 14 hari serta mempunyai pilihan kemasukan anak dalam kandungan pada 13–35 minggu dan 13–36 minggu kehamilan masing-masing. OneMedical dan i-MedicalCard Elite menerima anak dari 14 hari hingga 16 ANB melalui ibu bapa atau pendaftaran pihak ketiga. OneMedical mempunyai diskaun pakej keluarga 5% dan had tahunan setiap ahli. IKHLAS Medik menerima kemasukan dari 30 hari hingga 70 ANB. myMedik dan MediKad menerima anak 6–18 ANB melalui pemegang sijil induk sekurang-kurangnya 19 ANB. Bandingkan kelayakan anak dan syarat setiap permohonan.",
  },
  {
    q: "Medical card cover outpatient (klinik/GP) tak?",
    a: "Manfaat pesakit luar bergantung pada item yang dinamakan dalam kontrak. A-Plus Health360 menggunakan Health Wallet untuk rawatan primer RM50 setiap lawatan, 3 lawatan setahun rider, serta saringan atau vaksinasi dalam had gabungan RM1,000 setiap 2 tahun rider. IKHLAS Medik menyediakan fisioterapi, akupunktur atau bekam RM1,500, RM2,000 atau RM3,000 setiap disability mengikut pelan. i-MedicalCard Elite menyediakan rawatan denggi pesakit luar sehingga RM2,000 setahun sijil. OneMedical mempunyai bayaran tunai penyakit berjangkit RM2,000 yang memerlukan diagnosis dan kemasukan hospital sekurang-kurangnya 24 jam di Malaysia. Rujuk fakta manfaat dan pengecualian pelan yang dipilih.",
  },
];

const description = buildDescription(
  'Bandingkan medical card di Malaysia berdasarkan jenis pelan, had tahunan, room & board, co-payment, tempoh menunggu dan ciri utama daripada sumber rasmi.',
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Medical Card Malaysia 2026 — Bandingkan Pelan dan Manfaat',
  description,
  url: 'https://insurans.co/medical-cards/',
  datePublished: medicalCards.asAt,
  dateModified: updatedAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Medical Card', item: 'https://insurans.co/medical-cards/' },
    ],
  },
};
---

<Base
  title={buildTitle('Medical Card Malaysia 2026')}
  description={description}
  canonical="https://insurans.co/medical-cards/"
  schema={schema}
  ogType="article"
  publishedTime={medicalCards.asAt}
  modifiedTime={updatedAt}
>
  <section class="border-b border-stone-200 bg-white">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { label: 'Utama', href: '/' },
          { label: 'Medical Card' },
        ]}
      />
      <p class="label mb-3">Panduan Data</p>
      <h1 class="mb-4 font-serif text-headline-lg text-stone-900 sm:text-headline-xl">Medical Card Malaysia 2026</h1>
      <Byline dateModified={updatedAt} />
      <p class="mt-4 max-w-2xl text-lg leading-7 text-stone-600">
        Bandingkan pilihan medical card berdasarkan data manfaat yang dinyatakan dalam PDS atau brosur rasmi.
        Tiada harga premium direka; semak quotation dan syarat terkini dengan penyedia.
      </p>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div class="min-w-0 lg:col-span-2">
        <article class="prose-editorial">
          <p class="text-lg leading-7 text-stone-700">
            Setiap rekod memaparkan had tahunan, room &amp; board, pilihan kos sendiri, tempoh menunggu dan ciri utama
            apabila medan itu dinyatakan dalam sumber. Klik pelan untuk melihat sumber rasmi dan ringkasan penuh.
          </p>
          <h2 id="jadual-perbandingan">Jadual perbandingan medical card</h2>
          <div class="overflow-x-auto my-8">
            <table class="table-editorial min-w-[60rem]">
              <caption class="caption-top pb-3 text-left text-sm leading-5 text-stone-600">
                Dikemaskini <time datetime={updatedAt}>{updatedAt}</time>
              </caption>
              <thead>
                <tr>
                  <th scope="col">Pelan</th>
                  <th scope="col">Penyedia</th>
                  <th scope="col">Jenis pelan</th>
                  <th scope="col">Had tahunan</th>
                  <th scope="col">Room &amp; board</th>
                  <th scope="col">Ciri utama</th>
                  <th scope="col">Sumber</th>
                </tr>
              </thead>
              <tbody>
                {cards.map((card) => (
                  <tr>
                    <th scope="row">
                      <a href={`/medical-cards/${card.slug}/`}>{card.planName || '—'}</a>
                    </th>
                    <td>{card.insurer || '—'}</td>
                    <td>{typeLabels[card.type] ?? '—'}</td>
                    <td>{card.annualLimit || '—'}</td>
                    <td>{card.roomBoard || '—'}</td>
                    <td>{card.standoutFeature || '—'}</td>
                    <td>
                      {card.sources[0] ? <a href={card.sources[0]}>Sumber rasmi</a> : '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h3>Cara membaca jadual ini</h3>
          <p>
            Bandingkan had tahunan dan kadar room &amp; board mengikut pilihan pelan yang sama.
            Tanda — menunjukkan maklumat tidak dinyatakan.
            Semak deductible, co-payment dan syarat pembaharuan melalui pautan sumber rasmi sebelum memilih pelan.
          </p>
          <h2 id="bandingkan">Apa yang patut dibanding?</h2>
          <p>
            Mulakan dengan had tahunan yang sesuai, kemudian semak room &amp; board, had seumur hidup, co-payment atau
            deductible, tempoh menunggu, hospital panel dan kemudahan cashless. Jangan bandingkan premium sahaja;
            baca pengecualian, syarat pembaharuan dan PDS setiap pelan.
          </p>
        </article>

        <div class="mt-8 space-y-10 sm:mt-10">
          {cardGroups.map((group) => (
            <section id={group.type}>
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div>
                  <h2 class="font-serif text-headline-md text-stone-900">{group.label}</h2>
                  <p class="mt-1 text-sm text-stone-600">{group.description}</p>
                </div>
                <span class="text-sm text-stone-500">{group.cards.length} pelan</span>
              </div>

              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {group.cards.map((card) => (
                  <a href={`/medical-cards/${card.slug}/`} class="card-editorial group block">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <h3 class="font-semibold text-stone-900 group-hover:text-hijau-700">{card.planName}</h3>
                        <p class="mt-1 text-xs leading-5 text-stone-500">{card.insurer}</p>
                      </div>
                      <span class="shrink-0 border border-stone-300 px-2 py-1 text-xs font-semibold text-stone-600">{group.label}</span>
                    </div>
                    <dl class="mt-5 space-y-2 text-sm">
                      <div class="flex flex-wrap justify-between gap-x-3 gap-y-1 border-t border-stone-200 pt-2">
                        <dt class="text-stone-600">Had tahunan</dt>
                        <dd class="font-semibold text-hijau-800">{card.annualLimit}</dd>
                      </div>
                      <div class="flex flex-wrap justify-between gap-x-3 gap-y-1">
                        <dt class="text-stone-600">Room &amp; board</dt>
                        <dd class="font-semibold text-stone-900">{card.roomBoard}</dd>
                      </div>
                    </dl>
                    <p class="mt-4 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">{card.standoutFeature}</p>
                    <span class="mt-4 inline-block text-sm font-semibold text-hijau-700">Lihat butiran →</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>

        <section id="faq" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Soalan lazim medical card</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:col-span-1">
        <div class="space-y-6 lg:sticky lg:top-20">
          <div class="border-2 border-stone-900 bg-white p-5">
            <h2 class="font-serif text-headline-sm text-stone-900">Ringkasan</h2>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-stone-500">Bilangan rekod</dt>
                <dd class="font-semibold text-stone-900">{cards.length} pelan</dd>
              </div>
              <div>
                <dt class="text-stone-500">Kategori</dt>
                <dd class="font-semibold text-stone-900">Standalone, rider, takaful</dd>
              </div>
              <div>
                <dt class="text-stone-500">Data dikemas kini</dt>
                <dd class="font-semibold text-hijau-700">{medicalCards.asAt}</dd>
              </div>
              <div>
                <dt class="text-stone-500">Harga premium</dt>
                <dd class="font-semibold text-stone-900">Tiada anggaran</dd>
              </div>
            </dl>
          </div>
          <div class="card-editorial">
            <h2 class="font-semibold text-sm text-stone-900">Baca juga</h2>
            <ul class="mt-3 space-y-2.5 text-sm">
              <li><a href="/health-insurance/" class="text-hijau-700 hover:text-hijau-600">Panduan insurans kesihatan</a></li>
              <li><a href="/takaful/" class="text-hijau-700 hover:text-hijau-600">Insurans vs takaful</a></li>
              <li><a href="/companies/" class="text-hijau-700 hover:text-hijau-600">Direktori syarikat insurans</a></li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
