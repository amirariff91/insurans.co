---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import medicalCards from '../../data/medical-cards.json';
import { buildDescription, buildTitle } from '../../lib/seo';

type MedicalCard = (typeof medicalCards.records)[number];

const cards = medicalCards.records;
// Built <main> audit, 2026-10-10: at least 700 words and pairwise 5-word Jaccard below 0.35.
const adsEnabledSlugs = new Set([
  'aia-a-plus-health-360',
  'great-eastern-smartmedic-shield',
  'great-eastern-great-medcare',
  'etiqa-one-medical',
  'etiqa-i-medicalcard-elite',
  'prudential-prumillion-med-2',
  'takaful-malaysia-mymedik',
  'takaful-ikhlas-ikhlas-medik',
  'tokio-marine-medic-plus',
  'takaful-malaysia-kaotim-medikad',
]);
const typeLabels: Record<string, string> = {
  standalone: 'Standalone',
  rider: 'Rider',
  takaful: 'Takaful',
};

export function getStaticPaths() {
  return medicalCards.records.map((card) => ({
    params: { slug: card.slug },
    props: { card },
  }));
}

const { card } = Astro.props as { card: MedicalCard };
const canonicalUrl = `https://insurans.co/medical-cards/${card.slug}/`;
const typeLabel = typeLabels[card.type] ?? card.type;
const passesUniqueness = adsEnabledSlugs.has(card.slug);
const { analysis } = card;
const sibling = cards.find((candidate) => candidate.slug === analysis.siblingSlug)!;
const sourceUrls = [...new Set([...card.sources, ...analysis.facts.map((fact) => fact.source)])];
const sourceLinks = sourceUrls.map((url, index) => ({
  label: `[${index + 1}] ${decodeURIComponent(new URL(url).pathname.split('/').filter(Boolean).pop()!)} — ${new URL(url).hostname.replace(/^www\./, '')}`,
  url,
}));
const specItems = analysis.facts.filter((fact) =>
  ['Had tahunan', 'Bilik dan penginapan', 'Had seumur hidup', 'Deductible', 'Perkongsian kos'].includes(fact.label),
);

const faqFacts = [
  { label: 'Struktur pelan', q: `Bagaimana ${card.planName} dibeli dan disusun?` },
  { label: 'Umur kemasukan', q: `Siapa boleh memohon ${card.planName}?` },
  { label: 'Had tahunan', q: `Berapakah had tahunan ${card.planName}?` },
  { label: 'Deductible', q: `Bagaimana deductible ${card.planName} dikenakan?` },
  { label: 'Perkongsian kos', q: `Apakah perkongsian kos ${card.planName}?` },
  { label: 'Tempoh menunggu', q: `Bilakah perlindungan penyakit ${card.planName} bermula?` },
  { label: 'Panel dan kemasukan tanpa tunai', q: `Bagaimana kemasukan hospital panel ${card.planName}?` },
  ...analysis.facts.filter((fact) => fact.label.startsWith('Manfaat —')).slice(0, 2).map((fact) => ({
    label: fact.label,
    q: `Apakah ${fact.label.replace('Manfaat — ', '')} dalam ${card.planName}?`,
  })),
];
const faqs = faqFacts.flatMap(({ label, q }) => {
  const fact = analysis.facts.find((candidate) => candidate.label === label);
  return fact ? [{ q, a: fact.value }] : [];
});

const title = buildTitle(`${card.planName} — Medical Card`);
const description = buildDescription(
  `${card.planName} oleh ${card.insurer}: kelayakan, manfaat, kos sendiri, pengecualian dan perbandingan dengan ${sibling.planName}, berserta rujukan dokumen rasmi.`,
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${card.planName} — Medical Card`,
  description,
  url: canonicalUrl,
  datePublished: card.asAt,
  dateModified: card.analysisAsAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Medical Card', item: 'https://insurans.co/medical-cards/' },
      { '@type': 'ListItem', position: 3, name: card.planName, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ads={passesUniqueness}
  ogType="article"
  publishedTime={card.asAt}
  modifiedTime={card.analysisAsAt}
>
  <Hero title={`Medical card ${card.planName}`}>
    <Byline slot="byline" dateModified={card.analysisAsAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Medical Card', href: '/medical-cards/' },
        { label: card.planName },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      {card.planName} oleh {card.insurer}. Analisis manfaat dikemaskini pada {card.analysisAsAt}.
      {analysis.facts.find((fact) => fact.label === 'Struktur pelan')?.value}
    </p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="label">Medical card</p>
          <h2 class="mt-2 font-serif text-headline-sm text-stone-900">{card.planName}</h2>
          <p class="mt-1 text-sm leading-5 text-stone-600">{card.insurer}</p>
        </div>
        <span class="inline-flex w-fit border border-hijau-700 bg-hijau-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-hijau-800">
          {typeLabel}
        </span>
      </div>

      <h2 class="mt-7 font-serif text-headline-sm text-stone-900">Apa yang anda dapat</h2>
      <dl class="mt-4 space-y-3 text-sm">
        {specItems.map((spec) => (
          <div class="border-t border-stone-200 pt-3 first:border-t-0 first:pt-0">
            <dt class="text-stone-500">{spec.label}</dt>
            <dd class="mt-1 font-semibold leading-5 text-stone-900">{spec.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={card.analysisAsAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial">
        <h2 id="sesuai">Siapa yang sesuai dengan {card.planName}</h2>
        <p class="text-lg text-stone-700">{analysis.bestFor}</p>

        <h2 id="fakta">Fakta utama {card.planName}</h2>
        <dl class="space-y-5">
          {analysis.facts.map((fact) => (
            <div class="border-t border-stone-200 pt-4">
              <dt class="font-semibold text-stone-900">{fact.label}</dt>
              <dd class="mt-1 ml-0">
                {fact.value}{' '}
                <sup>
                  <a href={fact.source} aria-label={`Sumber untuk ${fact.label}`}>
                    [{sourceUrls.indexOf(fact.source) + 1}]
                  </a>
                </sup>
              </dd>
            </div>
          ))}
        </dl>

        <h2 id="pertimbangan">Had dan perkara yang perlu ditimbang</h2>
        <p>{analysis.tradeoffs}</p>

        <h2 id="perbandingan">{card.planName} berbanding {sibling.planName}</h2>
        <ul>
          {analysis.siblingDifferences.map((difference) => <li>{difference}</li>)}
        </ul>
        <p>
          <a href={`/medical-cards/${sibling.slug}/`}>Baca manfaat dan syarat {sibling.planName}</a>.
        </p>
        <p>
          Untuk membandingkan jenis pelan, had dan kos sendiri merentas penyedia, gunakan
          <a href="/medical-cards/"> panduan perbandingan medical card</a>.
        </p>
      </article>

      <section id="faq">
        <div class="prose-editorial">
          <h2>Soalan lazim — {card.planName}</h2>
        </div>
        <div class="mt-5">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <CtaBand
        heading={`Semak semua pilihan medical card`}
        body="Gunakan halaman hub untuk membandingkan pelan berdasarkan data manfaat dan sumber rasmi."
        primary={{ label: 'Lihat semua medical card →', href: '/medical-cards/' }}
        disclosure="Tiada hubungan berbayar atau affiliate. Pautan luar, jika ada, hanya rujukan; pembelian polisi dibuat di laman penyedia, bukan di Insurans.co."
      />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
