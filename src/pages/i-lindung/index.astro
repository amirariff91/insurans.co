---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import { buildDescription, buildTitle } from '../../lib/seo';

const asAt = '2026-10-10';
const pageTitle = 'i-Lindung KWSP 2026: Produk, Harga & Cara Beli';
const title = buildTitle(pageTitle);
const description = buildDescription(
  'i-Lindung ialah saluran beli insurans guna KWSP: produk dari RM12 setahun, potongan Akaun Sejahtera, perlindungan keluarga dan cara beli melalui i-Akaun.',
);
const canonicalUrl = 'https://insurans.co/i-lindung/';
const fwdBrochure = 'https://www.fwd.com.my/files/v3/assets/bltca8cd6b067df6d1c/bltcdda9742a1440734/68d363633653b77049b4928e/FWD_i-Lindung_Critical_Illness_Plan_P2_EN_V0.1.pdf?branch=capricorn';
const sourceLinks = [
  'https://www.kwsp.gov.my/ms/ahli/kesihatan/i-lindung',
  'https://www.etiqa.com/newsroom/etiqa-enhances-its-i-lindung-plans-to-include-protection-for-families/',
  'https://www.prudential.com.my/en/products-health-insurance/epf-i-lindung/',
  'https://www.prubsn.com.my/en/campaigns-announcements/epf-i-lindung/',
  fwdBrochure,
  'https://www.perkeso.gov.my/perkhidmatan-kami/perlindungan/pekerjaan-sendiri.html',
].map((url) => ({
  label: new URL(url).hostname.replace(/^www\./, ''),
  url,
}));
const products = [
  {
    operator: 'Etiqa',
    product: 'Term Plus / Term Takaful Plus',
    type: 'Hayat / term',
    details: 'Dari RM12 setahun, RM10,000–RM200,000',
  },
  {
    operator: 'Etiqa',
    product: 'Critical Care Plus / Critical Care Takaful Plus',
    type: '42 penyakit kritikal',
    details: 'Dari RM16 setahun; manfaat kanser +50%',
  },
  {
    operator: 'Prudential',
    product: 'PRUGuard Family',
    type: 'Hayat / term keluarga',
    details: 'Kematian + TPD hingga RM200,000 setiap nyawa; boleh diperbaharui hingga 75',
  },
  {
    operator: 'Prudential',
    product: 'PRUCare Family',
    type: '43 penyakit kritikal',
    details: 'RM10,000–RM200,000',
  },
  {
    operator: 'PruBSN',
    product: 'Lindung Famili + Cegah Famili',
    type: 'Takaful hayat + 43 penyakit kritikal',
    details: 'Ikut umur dan jumlah; semak di portal pengendali',
  },
  {
    operator: 'FWD',
    product: 'FWD i-Lindung Critical Illness Plan',
    type: 'Takaful penyakit kritikal dan kematian',
    details: 'Sehingga RM200,000; diri, pasangan dan anak',
    source: fwdBrochure,
  },
];
const faqs = [
  {
    q: 'Apa itu i-Lindung KWSP?',
    a: 'Saluran dalam aplikasi KWSP i-Akaun untuk membeli insurans hayat dan penyakit kritikal daripada pengendali panel menggunakan simpanan Akaun Sejahtera sendiri. Bukan bantuan percuma.',
  },
  {
    q: 'Apakah pelan i-Lindung yang ada?',
    a: 'Antara pilihan: Etiqa Term Plus dari RM12 setahun, Etiqa Critical Care Plus untuk 42 penyakit kritikal dari RM16 setahun, Prudential PRUGuard dan PRUCare Family, PruBSN takaful, serta FWD i-Lindung Critical Illness Plan sehingga RM200,000. Bandingkan manfaat dan syarat dalam aplikasi KWSP i-Akaun.',
  },
  {
    q: 'Akaun KWSP mana ditolak?',
    a: 'Akaun Sejahtera, dahulunya Akaun 2. Akaun 1 (Persaraan) tidak terjejas.',
  },
  {
    q: 'Boleh lindungi keluarga?',
    a: 'Ya. Fasa keluarga sejak Februari 2024 membenarkan perlindungan pasangan dan anak, tertakluk pada syarat umur dan produk.',
  },
  {
    q: 'i-Lindung PERKESO itu apa?',
    a: 'i-Lindung KWSP membolehkan pembelian insurans atau takaful menggunakan simpanan Akaun Sejahtera melalui i-Akaun. PERKESO mengendalikan Skim Pekerjaan Sendiri (Lindung Kendiri); pendaftaran dan carumannya boleh diurus melalui aplikasi atau Web Prihatin.',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: asAt,
  dateModified: asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'i-Lindung', item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={asAt}
  modifiedTime={asAt}
>
  <Hero title="i-Lindung — Beli Insurans Guna Duit KWSP Sendiri">
    <Byline slot="byline" dateModified={asAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'i-Lindung' },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      i-Lindung ialah saluran layan diri dalam KWSP i-Akaun untuk membeli perlindungan di bawah Pelan Perlindungan Ahli. Pembelian menggunakan simpanan Akaun Sejahtera anda. Bandingkan manfaat untuk diri, pasangan dan anak sebelum memilih pelan.
    </p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <p class="label">Jawapan ringkas</p>
      <h2 class="mt-2 font-serif text-headline-sm text-stone-900">Perlindungan melalui KWSP i-Akaun</h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="text-stone-500">Akaun yang digunakan</dt>
          <dd class="font-semibold text-stone-900">Akaun Sejahtera (dahulu Akaun 2)</dd>
        </div>
        <div>
          <dt class="text-stone-500">Akaun Persaraan</dt>
          <dd class="font-semibold text-hijau-700">Akaun 1 tidak terjejas</dd>
        </div>
        <div>
          <dt class="text-stone-500">Harga permulaan</dt>
          <dd class="font-semibold text-stone-900">Dari RM12 setahun untuk produk tertentu</dd>
        </div>
      </dl>
    </div>

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={asAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial">
        <p class="text-lg leading-7 text-stone-700">
          Melalui i-Lindung, ahli KWSP membeli pelan hayat dan penyakit kritikal daripada pengendali panel menggunakan simpanan Akaun Sejahtera. Perlindungan juga boleh dibeli untuk pasangan dan anak, tertakluk pada kelayakan produk. Rujuk <a href="https://www.kwsp.gov.my/ms/ahli/kesihatan/i-lindung" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">panduan rasmi i-Lindung KWSP</a> dan semak manfaat dalam i-Akaun sebelum memohon.
        </p>

        <h2 id="akaun">Duit dari akaun mana?</h2>
        <p>
          Pembelian i-Lindung menggunakan simpanan Akaun Sejahtera melalui KWSP i-Akaun. Semak baki akaun, jumlah bayaran tahunan dan manfaat untuk setiap orang yang hendak dilindungi sebelum memohon.
        </p>
        <p>
          Ahli berumur 55 tahun ke atas layak jika mempunyai sekurang-kurangnya RM100 dalam Akaun 55 atau Akaun Emas, tertakluk pada syarat produk. Permohonan tidak memerlukan pemeriksaan perubatan; soalan kesihatan ringkas tetap perlu dijawab.
        </p>

        <h2 id="produk">Pilihan produk</h2>
        <p>
          Bandingkan jenis perlindungan, jumlah manfaat dan syarat setiap pelan. Semak harga untuk umur serta jumlah perlindungan anda dalam i-Akaun.
        </p>
      </article>

      <div class="overflow-x-auto">
        <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
          <caption class="mb-3 text-left text-sm text-stone-600">Pilihan produk i-Lindung setakat {asAt}</caption>
          <thead>
            <tr class="border-b-2 border-stone-900">
              <th scope="col" class="px-3 py-3 font-semibold text-stone-900">Pengendali</th>
              <th scope="col" class="px-3 py-3 font-semibold text-stone-900">Produk</th>
              <th scope="col" class="px-3 py-3 font-semibold text-stone-900">Jenis</th>
              <th scope="col" class="px-3 py-3 font-semibold text-stone-900">Harga / jumlah</th>
            </tr>
          </thead>
          <tbody>
            {products.map((product) => (
              <tr class="border-b border-stone-200 align-top">
                <td class="px-3 py-3 font-semibold text-stone-900">{product.operator}</td>
                <td class="px-3 py-3 text-stone-700">
                  {product.source ? (
                    <a href={product.source} target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">{product.product}</a>
                  ) : product.product}
                </td>
                <td class="px-3 py-3 text-stone-700">{product.type}</td>
                <td class="px-3 py-3 text-stone-700">{product.details}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-sm leading-6 text-stone-600">
        Brosur <a href={fwdBrochure} target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">FWD i-Lindung Critical Illness Plan</a> menerangkan perlindungan penyakit kritikal dari peringkat awal hingga lanjut serta kematian. Sumbangan bergantung pada umur, jantina dan jumlah perlindungan; semak tempoh menunggu dan pengecualian dalam dokumen sijil.
      </p>

      <article class="prose-editorial">
        <h2 id="beli">Cara beli</h2>
        <ol>
          <li>Buka aplikasi KWSP i-Akaun dan pilih tab i-Lindung.</li>
          <li>Pilih produk panel yang mahu dipertimbangkan.</li>
          <li>Lengkapkan permohonan di portal pengendali.</li>
          <li>Benarkan potongan daripada Akaun Sejahtera. Dokumen polisi dihantar melalui emel atau portal pengendali.</li>
        </ol>
        <p>
          Jika mahu rujukan saluran, <a href="https://www.kwsp.gov.my/i-lindung" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">semak di portal rasmi KWSP</a>. Pembelian, terma polisi dan soalan kesihatan dibuat di saluran KWSP atau pengendali; Insurans.co tidak mengambil permohonan.
        </p>
        <p>
          Polisi biasanya bertempoh satu tahun dan merupakan perlindungan tulen tanpa nilai tunai; pelepasan cukai tertakluk pada syarat LHDN serta produk.
        </p>


        <h2 id="perkeso">i-Lindung KWSP dan Lindung Kendiri PERKESO</h2>
        <p>
          i-Lindung KWSP membolehkan pembelian insurans atau takaful menggunakan simpanan Akaun Sejahtera melalui i-Akaun. PERKESO pula mengendalikan Skim Pekerjaan Sendiri (Lindung Kendiri). Pendaftaran dan pembayaran caruman skim PERKESO boleh dibuat melalui aplikasi atau Web Prihatin. Rujuk <a href="https://www.perkeso.gov.my/perkhidmatan-kami/perlindungan/pekerjaan-sendiri.html" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">panduan rasmi Lindung Kendiri</a> atau baca <a href="/bantuan-insurans/perkeso/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">panduan PERKESO</a>.
        </p>
      </article>

      <section id="faq">
        <div class="prose-editorial">
          <h2>Soalan lazim — i-Lindung</h2>
        </div>
        <div class="mt-5">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <p class="text-sm leading-5 text-stone-600">Kami bukan ejen atau broker dan tidak mengambil permohonan polisi.</p>
      <p class="border-t border-stone-200 pt-4 text-sm leading-5 text-stone-600">Maklumat dikemas kini {asAt}. Semak harga dan terma semasa di portal pengendali sebelum membeli.</p>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
