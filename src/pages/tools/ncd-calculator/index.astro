---
import Base from '../../../layouts/Base.astro';
import carModels from '../../../data/car-models.json';
import { NCD_TIERS } from '../../../lib/ncd';
import Ikon from '../../../components/Ikon.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import '../../../components/edisi-tools/edisi-tools.css';

// The worked example in the NCD table (premium asas RM2,000). Copy and numbers unchanged from the previous table.
const ncdTableRows = [
  { years: 'Tiada NCD yang layak', pct: 0, label: '0%', discount: 'Tiada diskaun', after: 'RM2,000' },
  { years: '1 tahun tanpa claim', pct: 25, label: '25%', discount: 'Diskaun RM500', after: 'RM1,500' },
  { years: '2 tahun tanpa claim', pct: 30, label: '30%', discount: 'Diskaun RM600', after: 'RM1,400' },
  { years: '3 tahun tanpa claim', pct: 38.33, label: '38.33%', discount: 'Diskaun RM767', after: 'RM1,233' },
  { years: '4 tahun tanpa claim', pct: 45, label: '45%', discount: 'Diskaun RM900', after: 'RM1,100' },
  { years: '5+ tahun tanpa claim', pct: 55, label: '55% (Max)', discount: 'Diskaun RM1,100', after: 'RM900' },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kalkulator NCD Insurans Kereta Malaysia",
  "description": "Kira NCD insurans kereta anda secara percuma. Semak berapa anda jimat dengan NCD 25%, 30%, 38.33%, 45% atau 55%. Termasuk kalkulator 'patut ke claim?'",
  "url": "https://insurans.co/tools/ncd-calculator/",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "MYR" },
  "inLanguage": "ms",
  "publisher": {
    "@type": "Organization",
    "name": "Insurans.co",
    "url": "https://insurans.co"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://insurans.co/tools/" },
      { "@type": "ListItem", "position": 3, "name": "Kalkulator NCD", "item": "https://insurans.co/tools/ncd-calculator/" }
    ]
  }
};

const modelReferences = Object.fromEntries(
  carModels.map((car) => [
    car.slug,
    {
      fullName: car.fullName,
      premiumNCD0Min: car.premiumNCD0Min,
      premiumNCD0Max: car.premiumNCD0Max,
    },
  ]),
);
---

<Base
  title="Jadual NCD Kereta 2026 (0–55%) & Kalkulator Insurans NCD"
  description="Jadual NCD kereta: 0%, 25%, 30%, 38.33%, 45% & 55% selepas 5 tahun tanpa claim. Kira premium selepas NCD, semak di MyCarInfo & kira patut claim atau tidak."
  siteSuffix={false}
  schema={schema}
  pageType="tool"
>
  <div class="et">
  <noscript><style is:inline>.et .et-wait, #ncd-result, #claim-calc-btn { display: none; }</style></noscript>
  <!-- Header -->
  <section class="bg-white border-b border-stone-200">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { label: 'Utama', href: '/' },
          { label: 'Tools', href: '/tools/' },
          { label: 'Kalkulator NCD' },
        ]}
      />
      <p class="label mb-3">Free Tool</p>
      <h1 class="ncd-h1 text-stone-900 mb-4">
        Jadual NCD &amp; Kalkulator NCD Insurans Kereta 2026
      </h1>
      <p class="text-lg text-stone-700 max-w-2xl leading-relaxed">
        Masukkan premium asal anda, pilih NCD semasa — dan tengok berapa sebenarnya anda jimat.
        Termasuk kalkulator <strong>"patut ke claim?"</strong> supaya anda tak rugi lepas accident kecil.
      </p>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">

      <!-- Main: Calculators -->
      <div class="lg:col-span-2 space-y-8 min-w-0">

        <!-- ── NCD Table (first: searchers want the rates by year) ── -->
        <section class="et-panel" data-tint="sky" aria-labelledby="jadual-h">
          <div class="et-bar"><Ikon name="i-tangga" size={24} /><h2 id="jadual-h" class="et-bar-t">Jadual NCD Kereta Persendirian Malaysia 2026</h2></div>
          <p class="text-base leading-6 text-stone-900 max-w-[60ch]">NCD meningkat mengikut tempoh insurans tanpa tuntutan, sehingga maksimum 55% untuk kereta persendirian. Rujuk <a href="https://www.zurich.com.my/knowledge-hub/articles/2023/getting-to-know-ncd-no-claim-discount" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">jadual Zurich Malaysia</a>.</p>
          <div class="overflow-x-auto mt-4">
            <table class="tg-table">
              <caption class="sr-only">Jadual NCD kereta persendirian Malaysia 2026</caption>
              <thead>
                <tr>
                  <th scope="col"><span class="tg-long">Tahun Tanpa Claim</span><span class="tg-short" aria-hidden="true">Tahun</span></th>
                  <th scope="col">NCD</th>
                  <th scope="col" class="num"><span class="tg-long">Contoh: Premium Asas RM2,000</span><span class="tg-short" aria-hidden="true">Premium Asas RM2,000</span></th>
                  <th scope="col" class="num"><span class="tg-long">Baki premium asas</span><span class="tg-short" aria-hidden="true">Baki</span></th>
                </tr>
              </thead>
              <tbody>
                {ncdTableRows.map((row) => (
                  <tr class:list={[{ 'tg-max': row.pct === 55 }]}>
                    <th scope="row">{row.years}</th>
                    <td><span class="tg-mid"><span class="tg-bar" style={`--p:${row.pct === 0 ? 4 : row.pct / 55 * 100}`} aria-hidden="true"></span><span class="tg-pct">{row.label}</span></span></td>
                    <td class="num tg-disc">{row.discount}</td>
                    <td class="num"><strong>{row.after}</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- ── Staircase: choose the NCD level ── -->
        <section class="et-panel" aria-labelledby="tangga-h">
          <div class="et-bar"><Ikon name="i-naik" size={24} /><h2 id="tangga-h" class="et-bar-t">Makin lama tanpa claim, makin murah</h2></div>
          <fieldset class="ncd" id="ncd-selector">
            <legend>NCD Semasa Anda</legend>
            <div class="bars">
              {NCD_TIERS.map((tier) => (
                <label class="bar" style={`--h:${100 - tier.value}`}>
                  <input type="radio" name="ncd" value={tier.value} aria-label={`${tier.value === 0 ? 'Tiada NCD yang layak' : tier.years}, NCD ${tier.label}`} />
                  <span class="bar-col" aria-hidden="true"></span>
                  <span class="bar-y" aria-hidden="true">{tier.yearsShort}</span>
                  <span class="bar-p" aria-hidden="true">{tier.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <p class="et-next" id="ncd-next" aria-live="polite">Pilih berapa tahun anda tak claim. Setiap tahun tanpa claim menaikkan NCD satu anak tangga, sehingga 55%. Tuntutan own damage biasa boleh menjadikan NCD 0% pada pembaharuan seterusnya. OD-KfK yang memenuhi syarat dan tuntutan cermin di bawah perlindungan tambahan berkenaan boleh mengekalkan NCD.</p>
          <p class="text-sm leading-5 text-stone-700">
            Tak tahu NCD anda? Semak di <a href="https://www.mycarinfo.com.my/ncdcheck/online" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">MyCarInfo</a> atau hubungi syarikat insurans anda. <a href="https://www.zurich.com.my/knowledge-hub/articles/2023/getting-to-know-ncd-no-claim-discount" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Rujukan Zurich</a>.
          </p>
        </section>

        <!-- ── CALCULATOR 1: NCD Savings ── -->
        <section class="et-panel" data-tint="pink" id="kalkulator" aria-labelledby="kalk-h">
          <div class="et-bar"><Ikon name="i-kalkulator" size={24} /><h2 id="kalk-h" class="et-bar-t">Kira Premium Selepas NCD</h2></div>
          <p class="text-stone-900 text-base">Anggaran premium asas selepas potongan NCD. NCD ikut pilihan pada tangga di atas.</p>
          <noscript><p class="note-warn et-noscript">Kalkulator ini memerlukan JavaScript. Hidupkan JavaScript dalam pelayar anda, atau rujuk jadual di halaman ini.</p></noscript>

          <div class="mt-4">
            <label for="base-premium" class="block text-base font-semibold text-stone-900 mb-1.5">
              Premium Asas (sebelum NCD) — RM
            </label>
            <p id="base-premium-hint" class="et-hint">cth: 2000</p>
            <div class="rm">
              <span aria-hidden="true">RM</span>
              <input
                type="number"
                id="base-premium"
                inputmode="decimal"
                min="100"
                max="50000"
                aria-describedby="base-premium-hint base-premium-help ncd-msg"
              />
            </div>
            <p id="base-premium-help" class="text-sm text-stone-700 mt-1.5">Gunakan premium asas sebelum NCD, tanpa perlindungan tambahan, cukai, duti atau roadtax.</p>
            <p id="ncd-msg" class="et-msg" aria-live="polite"></p>
          </div>

          <!-- Result: always laid out, so nothing moves when numbers arrive -->
          <div id="ncd-result" class="mt-3 p-5 border-[1.5px] border-stone-900 bg-white" aria-live="polite">
            <div class="flex items-end justify-between flex-wrap gap-3 mb-4">
              <div>
                <p class="text-sm text-stone-700">Anggaran premium asas selepas NCD</p>
                <p id="result-premium" class="big mt-1 text-stone-900">RM —</p>
              </div>
              <div class="text-right">
                <p class="text-sm text-stone-700">Jimat berbanding 0% NCD</p>
                <p id="result-saving" class="mt-1 text-2xl font-bold text-stone-900">RM —</p>
              </div>
            </div>
            <div id="result-breakdown" class="border-t border-stone-300 pt-4 space-y-0">
              <p class="text-xs font-semibold text-stone-700 uppercase tracking-wide mb-2">Perbandingan semua peringkat NCD</p>
              {NCD_TIERS.map((rate) => (
                <div class="flex justify-between items-center py-1.5 text-stone-700 text-sm border-b border-stone-200 last:border-0">
                  <span>{rate.label} NCD <span class="text-xs font-normal text-stone-700">({rate.value === 0 ? 'Tiada NCD yang layak' : rate.years})</span></span>
                  <span>RM —</span>
                </div>
              ))}
            </div>
          </div>
          <p id="model-reference" hidden class="mt-5 border-t border-stone-400 pt-4 text-sm leading-5 text-stone-900">
            <span class="font-semibold text-stone-900">Julat rujukan</span>
            <span id="model-reference-name"></span>:
            <span id="model-reference-range" class="numeric"></span> (NCD 0%)
          </p>
          <p id="handoff-note" hidden class="mt-3 border border-stone-900 bg-emas-50 p-3 text-sm leading-5 text-stone-900"></p>
          <p class="et-src mt-4">Potongan = premium asas × NCD ÷ 100. Paparan dibundar ke ringgit terdekat.</p>
        </section>
        <script id="model-reference-data" type="application/json" set:html={JSON.stringify(modelReferences)}></script>


        <!-- ── CALCULATOR 2: Should I Claim? ── -->
        <section class="et-panel" aria-labelledby="claim-h">
          <div class="et-bar"><Ikon name="i-claim" size={24} /><h2 id="claim-h" class="et-bar-t">Patut Ke Claim?</h2></div>
          <p class="text-stone-900 text-base">Accident kecil? Kira sama ada worth it untuk claim atau bayar sendiri.</p>
          <noscript><p class="note-warn et-noscript">Kalkulator ini memerlukan JavaScript. Hidupkan JavaScript dalam pelayar anda.</p></noscript>

          <div class="space-y-5 mt-5">
            <div>
              <label for="current-premium" class="block text-base font-semibold text-stone-900 mb-1.5">
                Premium Asas Semasa (selepas NCD) — RM
              </label>
              <p id="current-premium-hint" class="et-hint">cth: 900</p>
              <div class="rm">
                <span aria-hidden="true">RM</span>
                <input type="number" id="current-premium" inputmode="decimal" min="100" max="50000" aria-describedby="current-premium-hint current-premium-help" />
              </div>
              <p id="current-premium-help" class="text-sm text-stone-700 mt-1.5">Asingkan perlindungan tambahan dan bayaran lain daripada jumlah bil sebelum mengisi angka ini.</p>
            </div>

            <div>
              <label for="current-ncd-pct" class="block text-base font-semibold text-stone-900 mb-1.5">
                NCD Semasa (%)
              </label>
              <select id="current-ncd-pct" class="w-full max-w-[24rem] px-3 text-base font-medium">
                {[...NCD_TIERS].reverse().map((tier) => (
                  <option value={tier.value}>{tier.label} ({tier.value === 0 ? 'Tiada NCD yang layak' : tier.years})</option>
                ))}
              </select>
            </div>

            <div>
              <label for="repair-cost" class="block text-base font-semibold text-stone-900 mb-1.5">
                Anggaran Kos Repair — RM
              </label>
              <p id="repair-cost-hint" class="et-hint">cth: 800</p>
              <div class="rm">
                <span aria-hidden="true">RM</span>
                <input type="number" id="repair-cost" inputmode="decimal" min="0" max="100000" aria-describedby="repair-cost-hint" />
              </div>
            </div>

            <div>
              <label for="excess" class="block text-base font-semibold text-stone-900 mb-1.5">
                Excess Polisi Anda — RM
              </label>
              <div class="rm">
                <span aria-hidden="true">RM</span>
                <input type="number" id="excess" inputmode="decimal" value="400" min="0" max="5000" />
              </div>
            </div>

            <button id="claim-calc-btn" type="button" class="et-btn sm:max-w-[24rem]">
              Kira — Patut Claim Tak?
            </button>
          </div>

          <div class="et-out" style="min-height:20rem">
            <p class="et-wait" aria-hidden="true">Hasil kiraan akan muncul di sini.</p>
            <div id="claim-result" class="hidden" aria-live="polite"></div>
          </div>
        </section>

        <section class="prose-editorial" aria-labelledby="cara-kiraan">
          <h2 id="cara-kiraan">Cara kiraan ini dibuat</h2>
          <p>
            Kalkulator ini menggunakan premium asas sebelum NCD dan kadar yang anda pilih. Masukkan angka premium asas daripada pecahan sebut harga, kemudian pilih NCD yang layak digunakan. Potongan dikira dengan formula <strong>premium asas × NCD ÷ 100</strong>. Baki premium asas ialah <strong>premium asas × (1 − NCD ÷ 100)</strong>. <a href="https://www.etiqa.com.my/pdfs/en/insurance/Product+Disclosure+Sheet+Private+Car+Insurance.pdf" target="_blank" rel="noopener noreferrer">PDS Etiqa</a> menunjukkan premium asas ditolak NCD sebelum perlindungan tambahan dan bayaran lain.
          </p>
          <p>
            Sebagai contoh matematik, premium asas RM2,000 dengan NCD 55% memberi potongan RM1,100 dan baki RM900. Angka itu belum termasuk perlindungan tambahan, cukai, duti atau roadtax. Paparan ringgit dibundarkan kepada ringgit terdekat. Pilihan 38.33% menggunakan nilai perpuluhan itu; ikut pembundaran syarikat pada sebut harga akhir, terutama jika kontrak menggunakan kadar 38⅓%.
          </p>
          <p>
            Jadual di sini untuk kereta persendirian. <a href="https://www.zurich.com.my/knowledge-hub/articles/2023/getting-to-know-ncd-no-claim-discount" target="_blank" rel="noopener noreferrer">Zurich Malaysia</a> menerbitkan skala berasingan untuk motosikal dan menyediakan pautan semakan MyCarInfo. Kalkulator ini tidak menyemak rekod polisi atau menentukan kelayakan NCD anda. Sahkan kadar dengan syarikat sebelum renew. Premium asas juga boleh berubah mengikut nilai diinsuranskan, model, umur pemohon, pengalaman tuntutan dan pengunderaitan, seperti diterangkan dalam PDS Etiqa.
          </p>
          <p>
            Bahagian “Patut Ke Claim?” menganggarkan premium sebelum NCD melalui <strong>premium asas selepas NCD ÷ (1 − NCD ÷ 100)</strong>. Bayaran bersih anggaran ialah kos repair ditolak excess, dengan minimum RM0. Kiraan mengandaikan tuntutan own damage biasa menjadikan NCD 0% pada pembaharuan seterusnya dan premium asas kekal sama. Petunjuknya membandingkan bayaran bersih dengan dua kali tambahan premium asas tahun pertama. Ambang dua tahun ini ialah kaedah perbandingan alat, bukan syarat tuntutan syarikat.
          </p>
          <p>
            Kiraan tidak meramal kenaikan semula NCD selepas tahun pertama, perubahan harga atau keputusan tuntutan. OD-KfK yang layak dan tuntutan cermin di bawah perlindungan tambahan berkenaan boleh mengekalkan NCD. Semak pengecualian dalam <a href="https://www.etiqa.com.my/pdfs/en/insurance/Private+Car+Insurance+Policy+Contract.pdf" target="_blank" rel="noopener noreferrer">kontrak Etiqa</a> dan baca <a href="/guides/ncd-explained/">panduan NCD lengkap</a> sebelum menggunakan hasil untuk membuat keputusan.
          </p>
        </section>

        <!-- Content -->
        <article class="prose-editorial">
          <h2>Apa yang berlaku kepada NCD kalau saya claim?</h2>
          <p>
            Tuntutan <strong>own damage biasa</strong> boleh menjadikan NCD <strong>0% pada pembaharuan seterusnya</strong>.
            OD-KfK yang memenuhi syarat dan tuntutan cermin di bawah perlindungan tambahan berkenaan boleh mengekalkan NCD. Rujuk <a href="https://www.etiqa.com.my/pdfs/en/insurance/Private+Car+Insurance+Policy+Contract.pdf" target="_blank" rel="noopener noreferrer">Seksyen C dan Endorsement 89 kontrak Etiqa</a>.
          </p>
          <p>
            Bandingkan kos repair, excess dan kesan NCD sebelum memilih cara tuntutan. Tuntutan pihak ketiga terhadap polisi anda juga boleh menjejaskan NCD walaupun anda membayar repair sendiri, mengikut <a href="https://www.etiqa.com.my/pdfs/en/insurance/Private+Car+Insurance+Policy+Contract.pdf" target="_blank" rel="noopener noreferrer">Seksyen C kontrak Etiqa</a>.
          </p>

          <h3>Contoh kiraan own damage biasa:</h3>
          <p>
            Andaikan kos repair <strong>RM600</strong>, excess RM0, NCD <strong>55%</strong> dan premium asas <strong>RM2,000</strong> yang kekal sama pada pembaharuan seterusnya.
          </p>
          <ul>
            <li>Kalau <strong>claim dan NCD menjadi 0%</strong>: Bayaran repair RM600, tetapi premium asas tahun depan menjadi RM2,000 berbanding RM900 jika NCD kekal. Tambahan premium asas: <strong>RM1,100</strong>.</li>
            <li>Kalau <strong>bayar sendiri dan NCD kekal 55%</strong>: Keluar RM600 untuk repair. Dalam perbandingan tahun pertama ini, kosnya <strong>RM500 lebih rendah</strong> daripada tambahan premium asas RM1,100.</li>
          </ul>
          <p>
            Contoh ini mengasingkan kesan NCD sahaja. Gunakan kos repair dan excess sebenar, kemudian sahkan kategori tuntutan dengan syarikat.
          </p>

          <h2>Soalan lazim tentang NCD</h2>
        </article>

        <div class="my-6 space-y-0">
          <details class="faq-item" open>
            <summary>Boleh ke pindah NCD ke kereta lain?</summary>
            <p>
              NCD hanya boleh dipindahkan antara kenderaan atas nama pemegang polisi yang sama, bukan kepada pasangan, anak atau orang lain.
              Maklumkan syarikat insurans untuk menguruskan penarikan NCD daripada polisi lama. Rujuk <a href="https://piam.org.my/news-media/stay-ahead/articles/page/how-to-transfer-your-ncd-when-buying-a-new-car-in-malaysia/" target="_blank" rel="noopener noreferrer">panduan pemindahan PIAM</a> dan <a href="/guides/ncd-explained/">panduan NCD lengkap</a>.
            </p>
          </details>
          <details class="faq-item">
            <summary>Kalau kereta kena langgar dan bukan salah saya, NCD kena reset juga?</summary>
            <p>
              Tuntutan OD-KfK yang memenuhi syarat boleh mengekalkan NCD apabila pihak ketiga bersalah dan polis mengesahkan anda tidak bersalah.
              <a href="https://piam.org.my/insurance-101/individual/motor/" target="_blank" rel="noopener noreferrer">PIAM menerangkan syarat OD-KfK</a>. Tuntutan pihak ketiga terhadap polisi anda pula boleh menjejaskan NCD, mengikut <a href="https://www.etiqa.com.my/pdfs/en/insurance/Private+Car+Insurance+Policy+Contract.pdf" target="_blank" rel="noopener noreferrer">Seksyen C kontrak Etiqa</a>. Sahkan kategori tuntutan dan syarat polisi dengan syarikat; baca <a href="/guides/ncd-explained/">panduan NCD lengkap</a>.
            </p>
          </details>
          <details class="faq-item">
            <summary>Berapa lama NCD kekal kalau saya tak renew insurans?</summary>
            <p>
              Kontrak kereta Etiqa menyatakan NCD berundur mengikut jadual bagi setiap tahun NCD tidak digunakan.
              Semak tempoh tidak digunakan dan kadar sebenar dengan syarikat. Perlindungan insurans tetap mengikut tarikh dalam jadual polisi. Rujuk <a href="https://www.etiqa.com.my/pdfs/en/insurance/Private+Car+Insurance+Policy+Contract.pdf" target="_blank" rel="noopener noreferrer">Seksyen C kontrak Etiqa</a> dan <a href="/guides/ncd-explained/">panduan NCD lengkap</a>.
            </p>
          </details>
          <details class="faq-item">
            <summary>Boleh ke ada NCD untuk insurans kereta lagi dari satu?</summary>
            <p>
              Setiap kenderaan mempunyai rekod NCD sendiri. NCD boleh dipindahkan antara kenderaan milik anda selepas penarikan daripada polisi asal; satu rekod NCD tidak digunakan serentak untuk dua kereta. Rujuk <a href="https://piam.org.my/news-media/stay-ahead/articles/page/how-to-transfer-your-ncd-when-buying-a-new-car-in-malaysia/" target="_blank" rel="noopener noreferrer">penerangan PIAM</a>.
            </p>
          </details>
        </div>

        <!-- Related tools CTA -->
        <div class="bg-stone-50 border border-stone-200 p-6">
          <p class="text-sm font-semibold text-stone-700 mb-3">Langkah seterusnya</p>
          <div class="grid sm:grid-cols-2 gap-3">
            <a href="/car-insurance/" class="block p-4 bg-white border border-stone-200 hover:border-hijau-500 transition-colors group">
              <p class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700">Panduan Insurans Kereta →</p>
              <p class="text-xs text-stone-500 mt-0.5">Harga, jenis coverage, cara renew</p>
            </a>
