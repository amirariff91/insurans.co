---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TrustStrip from '../../../components/edisi/TrustStrip.astro';
import EditorialStamp from '../../../components/EditorialStamp.astro';
import Hero from '../../../components/Hero.astro';
import PageAnswer from '../../../components/edisi/PageAnswer.astro';
import { buildDescription, buildTitle } from '../../../lib/seo';

const asAt = '2026-09-12';
const pageTitle = 'EPF, Simpanan & Insurans: Mana Dulu?';
const title = buildTitle(pageTitle);
const description = buildDescription(
  'Dana kecemasan, EPF/i-Lindung atau insurans swasta — mana patut dulu? Panduan literasi kewangan ini bagi susunan asas supaya anda tak beli ikut turutan salah.',
);
const h1 = 'EPF, Simpanan & Insurans: Mana Dulu?';
const canonicalUrl = 'https://insurans.co/literasi-kewangan/epf-simpanan-insurans/';
const sources = [
  { label: 'mySalam', url: 'https://www.mysalam.com.my/mys/info/?url=ci' },
  { label: 'KWSP', url: 'https://www.kwsp.gov.my/' },
];

const faqs = [
  {
    q: 'Boleh guna duit EPF untuk beli insurans ke?',
    a: 'Boleh untuk produk yang tersenarai di i-Lindung dalam aplikasi KWSP. Contoh disahkan: Etiqa Critical Care Plus dan Critical Care Takaful. Terma dan had ikut produk masing-masing, dan pengeluaran mengurangkan baki persaraan. Semak produk yang aktif semasa memohon.',
  },
  {
    q: 'Ada cover majikan, masih perlu medical card sendiri?',
    a: 'Bergantung pada angka: bandingkan had tahunan cover majikan dengan kos hospital swasta di bandar anda dan risiko pertukaran kerja (cover majikan berhenti apabila anda berhenti kerja). Ada yang menggunakan cover majikan sebagai asas, dengan top-up swasta deductible tinggi sebagai jaring kedua.',
  },
  {
    q: 'mySalam dengan CI swasta: bertindih ke?',
    a: 'Fungsi berbeza: mySalam skim percuma untuk penerima STR (RM8,000 sekali bayar + RM50/hari di hospital, maksimum 14 hari setahun; mesti bermalam di hospital kerajaan/universiti/tentera panel); CI swasta membayar sekali gus (lump sum) ikut sum assured untuk menggantikan pendapatan dan membayar hutang. Penerima mySalam yang ada tanggungan besar mungkin masih ada jurang. Kira dulu; jangan anggap sudah cukup, dan jangan anggap perlu.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: asAt,
  dateModified: asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Literasi Kewangan', item: 'https://insurans.co/literasi-kewangan/' },
      { '@type': 'ListItem', position: 3, name: h1, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={asAt}
  modifiedTime={asAt}
  ads={true}
>
  <Hero title={h1}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Literasi Kewangan', href: '/literasi-kewangan/' },
        { label: h1 },
      ]}
    />
    <TrustStrip slot="trust" date={asAt} sources={sources} />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-900">
      Susunan asas ialah penampan tunai dahulu, audit skim sedia ada kemudian, barulah pertimbang i-Lindung dan top-up
      swasta untuk jurang yang masih tinggal.
    </p>
    <PageAnswer
      slot="answer"
      finding="Penampan tunai, audit, top-up"
      lead={{ value: '3–6 bulan', label: 'Panduan kasar: dana kecemasan, perbelanjaan asas', role: 'term' }}
      facts={[
        { label: 'Kenal pasti cover', value: 'EPF, PERKESO, majikan dan mySalam' },
        { label: 'Kemudian', value: 'tutup jurang saja' },
      ]}
    />
    <div class="mt-4 mr-2">
      <EditorialStamp articleDate={asAt} sources={sources} sourcesLabel="Rujukan" showReviewed={false} />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <article class="prose-editorial prose-bars">
      <p class="text-lg leading-7 text-stone-700">
        Susun ikut apa yang runtuh dulu jika musibah datang bulan ini: <strong>penampan tunai, audit skim percuma atau sedia ada,
        i-Lindung, kemudian top-up swasta untuk jurang</strong>.
      </p>
      <p class="note-plain text-sm leading-6">
        <strong>Kami bukan ejen, bukan broker. Maklumat am sahaja.</strong> Susunan ini ialah rangka literasi kewangan, bukan
        cadangan produk individu.
      </p>

      <h2 id="turutan">Polisi mudah luput jika dibeli sebelum ada dana kecemasan</h2>
      <p>
        Perlindungan yang dibeli sebelum asas kukuh selalu menjadi beban: caruman bulanan memakan dana kecemasan, kemudian polisi
        luput (lapse) apabila kereta rosak atau anda dibuang kerja.
      </p>

      <h2 id="dana-kecemasan">Langkah 1: Dana kecemasan (3–6 bulan perbelanjaan asas)</h2>
      <p>
        Ini wang tunai, berasingan daripada akaun belanja. Ia bukan pelaburan dan bukan EPF, kerana EPF tidak boleh dikeluarkan sesuka hati. Sasaran:
        3 bulan perbelanjaan keperluan minimum (makan, rumah, pengangkutan). Jika RM1,500 sebulan, sasaran awal RM4,500.
      </p>
      <p>
        Jika belum cukup, mula dengan RM1,000 sebagai penampan, sambil berhenti menambah komitmen baharu. Dana inilah yang mengelakkan
        anda daripada menyerahkan (surrender) polisi atau menggunakan kad kredit apabila tayar pecah serentak dengan bil perubatan.
      </p>

      <h2 id="skim-sedia-ada">Langkah 2: EPF + skim sedia ada (yang sudah dipotong daripada gaji)</h2>
      <p>Sebelum menambah apa-apa, audit apa yang anda sudah ada, kerana sesetengahnya mungkin tidak anda sedari:</p>
      <ul>
        <li>
          <strong>EPF</strong>: caruman wajib + dividen; ini asas persaraan, bukan dana perubatan. Tetapi simpanan EPF boleh
          ditolak dalam kiraan jurang coverage (keperluan kasar tolak simpanan sedia ada).
        </li>
        <li>
          <strong>PERKESO</strong>: Skim Keilatan memberi pencen atau elaun bulanan untuk hilang upaya kekal (bukan bayaran
          sekali gus seperti CI swasta). Pekerja berdaftar sudah dilindungi. Semak dulu sebelum membeli pengganti.
        </li>
        <li>
          <strong>Cover majikan</strong>: panel klinik, had hospital tahunan. Ketahui angkanya: jika majikan melindungi RM50,000
          setahun, semak manfaat majikan, syarat penyelarasan tuntutan dan tempoh perlindungannya sebelum menentukan sama ada perlindungan tambahan diperlukan.
        </li>
        <li>
          <strong>mySalam</strong>: skim percuma untuk penerima STR (kerajaan + Great Eastern Holdings), dengan RM8,000 tunai sekali bayar
          untuk 50 penyakit kritikal + RM50/hari pendapatan hospital (mesti bermalam; hospital kerajaan/universiti/tentera
          panel), maksimum 14 hari setahun (RM700). Penerima yang layak tidak perlu membeli perlindungan yang sama sekali lagi.
        </li>
      </ul>

      <h2 id="i-lindung">Langkah 3: i-Lindung (guna duit EPF, tetapi ingat itu duit anda)</h2>
      <p>
        i-Lindung ialah <strong>saluran</strong>, bukan produk. Melaluinya, anda membeli perlindungan guna dana Akaun EPF melalui aplikasi KWSP.
        Produk yang kami sahkan: Etiqa Critical Care Plus (42 kondisi) dan Etiqa Critical Care Takaful (39
        kondisi), serta barisan FWD i-Lindung (term, CI, medical). Kelebihannya, aliran tunai bulanan tidak terjejas,
        tetapi baki persaraan tetap berkurang. Semak had umur dan jumlah cover setiap produk dalam aplikasi sebelum memohon,
        dan jangan anggap “duit EPF” maksudnya percuma.
      </p>

      <h2 id="top-up">Langkah 4: Top-up swasta (tutup jurang sahaja)</h2>
      <p>
        Hanya pada langkah ini anda membeli dengan wang sendiri, dan hanya sebesar jurang: keperluan kasar tolak simpanan tolak coverage sedia
        ada. Ada cover majikan RM50,000 + bajet hospital swasta bandar besar? Mungkin top-up deductible-tinggi (<a href="/literasi-kewangan/deductible-co-insurance/">baca artikel deductible dan co-insurance</a>) memadai. Tiada tanggungan? Mungkin CI kecil dahulu, bukan medical besar. Setiap ringgit
        caruman patut menutup jurang yang anda kenal pasti dalam audit pada langkah 2.
      </p>
    </article>

    <nav class="mt-8 border-t border-stone-200 pt-6" aria-label="Bacaan berkaitan">
      <p class="text-sm text-stone-500">Baca juga:</p>
      <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
        <li><a href="/life-insurance/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Kaedah jurang coverage</a></li>
        <li><a href="/medical-cards/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Bila top-up medical swasta diperlukan</a></li>
        <li><a href="/critical-illness/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Produk CI dalam i-Lindung</a></li>
        <li><a href="/insurans-online/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Saluran beli terus online</a></li>
        <li><a href="/guides/insurance-vs-takaful/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Pilih takaful atau konvensional</a></li>
      </ul>
    </nav>

    <section id="faq" class="mt-10 sm:mt-14">
      <div class="prose-editorial prose-bars">
        <h2>Soalan lazim EPF, simpanan dan insurans</h2>
      </div>
      <div class="mt-5">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
