---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Byline from '../../../components/Byline.astro';
import EditorialStamp from '../../../components/EditorialStamp.astro';
import Hero from '../../../components/Hero.astro';
import { buildDescription, buildTitle } from '../../../lib/seo';

const asAt = '2026-09-12';
const pageTitle = 'Travel Insurance: Bila Perlu, Bila Membazir?';
const title = buildTitle(pageTitle);
const description = buildDescription(
  'Nak tahu bila travel insurance berbaloi dan bila membazir? Panduan financial planning Malaysia: domestik vs overseas, annual-trip math, evakuasi & Schengen.',
);
const h1 = 'Travel Insurance: Bila Perlu, Bila Membazir?';
const canonicalUrl = 'https://insurans.co/literasi-kewangan/travel-bila-perlu/';
const sources = [
  { label: 'Etiqa TripCare 360', url: 'https://www.etiqa.com.my/travel/tripcare-360-insurance' },
  { label: 'Zurich Z-Travel', url: 'https://www.zurich.com.my/insurance-products/protection/for-my-travel/z-travel-insurance-international' },
  { label: 'MSIG Travel SafeGuard', url: 'https://takeiteasy.msig.com.my/spa-assets/travelAddOnResource/Travel%20SafeGuard%20-%20Policy%20Wording_Single_No%20SD@16.06.26.pdf' },
];

const faqs = [
  {
    q: 'Travel domestik perlu travel insurance tak?',
    a: 'Bergantung trip: check ambang jarak (contoh Zurich domestik ≥50km dari rumah) dan apa yang dilindungi — delay, bagasi, kemasukan hospital. Trip drive dekat dengan hospital kerajaan sepanjang jalan biasanya tak berbaloi; trip domestik dengan penerbangan + hotel mahal mungkin berbaloi untuk cancellation atau delay.',
  },
  {
    q: 'Frequent flyer — single atau annual?',
    a: 'Kira: jumlahkan semua single-trip setahun, banding dengan harga annual (Zurich dan Zurich Takaful ada varian annual). Melepasi 3–4 trip setahun, annual biasanya menang — plus tak perlu ingat beli setiap kali. Semak juga penalti batal polisi tahunan (prorata, bukan refund penuh).',
  },
  {
    q: 'Travel insurance cover COVID sekarang?',
    a: 'Kena check satu-satu: Zurich Z-Travel dan Etiqa TripCare 360 = add-on berbayar; Generali = rider Pandemic Cover (overseas saja); Allianz Shopee = built-in tapi divaksin penuh saja + perlu diagnosis doktor dan laporan makmal. Jangan assume auto-cover.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: asAt,
  dateModified: asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Literasi Kewangan', item: 'https://insurans.co/literasi-kewangan/' },
      { '@type': 'ListItem', position: 3, name: h1, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={asAt}
  modifiedTime={asAt}
>
  <Hero title={h1}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Literasi Kewangan', href: '/literasi-kewangan/' },
        { label: h1 },
      ]}
    />
    <Byline slot="byline" dateModified={asAt} />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      Travel insurance berbaloi bila satu kejadian boleh menghasilkan bil perubatan, evakuasi atau kerugian trip yang besar;
      trip murah dan dekat tidak semestinya memerlukan polisi.
    </p>
    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <p class="label">Jawapan ringkas</p>
      <h2 class="mt-2 font-serif text-headline-sm text-stone-900">Nilai risiko, bukan jarak</h2>
      <p class="mt-3 text-sm leading-6 text-stone-700">
        Overseas dengan bil mahal, Schengen, aktiviti lasak atau trip yang mahal biasanya perlukan semakan serius. Domestik
        dekat dengan risiko rendah mungkin tidak berbaloi.
      </p>
    </div>
    <div class="mt-4 mr-2">
      <EditorialStamp articleDate={asAt} sources={sources} sourcesLabel="Rujukan" showReviewed={false} />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <article class="prose-editorial">
      <p class="text-lg leading-7 text-stone-700">
        Travel plan biasanya membayar empat perkara: <strong>bil perubatan overseas, evakuasi atau repatriasi, pembatalan
        trip, dan delay atau bagasi</strong>. Jarak dekat atau jauh bukan penentu — potensi bil dan kerugian yang penentu.
      </p>
      <p class="border-l-4 border-hijau-700 bg-hijau-50 px-4 py-3 text-sm leading-6 text-stone-700">
        <strong>Kami bukan ejen, bukan broker — maklumat am sahaja.</strong> Semak had, pengecualian dan hotline dalam wording
        polisi sebelum terbang.
      </p>

      <h2 id="membazir">Bila membazir (atau hampir)</h2>
      <ul>
        <li>
          <strong>Domestik dekat, sihat, trip murah</strong> — perjalanan bawah 50km dari rumah: ambil perhatian, Zurich Travel
          Takaful domestik hanya aktif pada <strong>≥50km dari rumah</strong> (pergi-balik kerja tak kira). Kalau trip macam ini,
          premium mungkin lebih mahal dari risiko sebenar.
        </li>
        <li>
          <strong>Dah ada cover tahunan</strong> — beli single-trip sedangkan anda fly 5–6 kali setahun = bayar lebih. Frequent
          flyer patut kira annual-trip math: jumlahkan harga single-trip setahun, banding dengan satu polisi tahunan (contoh
          Zurich Z-Travel dan Zurich Travel Takaful ada varian single dan annual). Melepasi 3–4 trip, annual biasanya menang.
        </li>
        <li>
          <strong>Expectation salah</strong> — outpatient biasa (demam, GP) bukan benda travel insurance bayar — ia untuk
          kecemasan, kemasukan hospital dan evakuasi. Jangan beli untuk “cover demam di hotel”.
        </li>
      </ul>

      <h2 id="perlu">Bila perlu (jangan skip)</h2>
      <ul>
        <li>
          <strong>Overseas jauh atau bil mahal</strong> — had perubatan mesti masuk akal — contoh data sebenar: Zurich Z-Travel
          Lite Basic RM100,000 hingga Diamond unlimited; evakuasi RM1 juta (Lite) atau unlimited (plan penuh). Pilih had ikut
          destinasi, bukan ikut harga termurah.
        </li>
        <li>
          <strong>Schengen (Eropah)</strong> — ini syarat visa, bukan pilihan — minimum <strong>€30,000 (~RM150k)</strong>
          perubatan + repatriasi, sah di semua negara Schengen, sepanjang tempoh visa. Sijil polisi kena tunjuk masa mohon.
        </li>
        <li>
          <strong>Sukan lasak, COVID atau Haji</strong> — plan penuh Zurich cover sukan amatur (scuba, winter sports, bungee);
          COVID pula berbeza ikut plan — Zurich Z-Travel dan Etiqa TripCare 360 letak COVID sebagai add-on, Allianz (Shopee)
          built-in tapi untuk divaksin penuh saja. Dan pengecualian kurang diketahui: Etiqa TripCare 360 mengecualikan perjalanan
          Haji.
        </li>
      </ul>

      <h3 id="claim">Dua peraturan yang selamatkan claim</h3>
      <ol>
        <li>
          <strong>Evakuasi mesti melalui hotline 24-jam insurer.</strong> Susun sendiri (contoh sewa transport perubatan) =
          claim boleh ditolak. Contoh disahkan: polisi MSIG wajibkan selaras melalui hotline +603-2166 3080 dan tak bayar
          evakuasi dari Malaysia ke destinasi asing. Simpan nombor dalam phone + salinan fizikal.
        </li>
        <li>
          <strong>Ambang delay berbeza tajam:</strong> Etiqa auto-payout dari <strong>2 jam</strong>; Zurich bayar dari
          <strong>6 jam</strong>. Bandingkan threshold, bukan jumlah saja. Polisi tahunan yang dibatalkan sendiri pula bukan
          refund penuh — Zurich Travel Takaful kira prorata (in-force ≤2 bulan caj 40%, &gt;6 bulan 100%).
        </li>
      </ol>
      <p>
        Formula mudah — trip murah + dekat + sihat: simpan duit premium. Trip jauh + bil mahal + visa + aktiviti: beli, dan
        baca klausa evakuasi serta COVID sebelum bayar.
      </p>
    </article>

    <nav class="mt-8 border-t border-stone-200 pt-6" aria-label="Bacaan berkaitan">
      <p class="text-sm text-stone-500">Baca juga:</p>
      <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
        <li><a href="/travel-insurance/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Banding plan travel sebenar</a></li>
        <li><a href="/insurans-online/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Beli travel online</a></li>
        <li><a href="/medical-cards/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Medical domestik berbanding travel medical</a></li>
        <li><a href="/critical-illness/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Kalau sakit overseas macam mana?</a></li>
        <li><a href="/guides/how-to-claim/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Disiplin dokumen claim</a></li>
      </ul>
    </nav>

    <section id="faq" class="mt-10 sm:mt-14">
      <div class="prose-editorial">
        <h2>Soalan lazim travel insurance</h2>
      </div>
      <div class="mt-5">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
