---
import Base from '../../../layouts/Base.astro';
import Byline from '../../../components/Byline.astro';

const faqItems = [
  {
    q: "Boleh renew roadtax sebelum beli insurans?",
    a: "JPJ mensyaratkan perlindungan insurans bagi seluruh tempoh LKM yang dipohon. Urus insurans dahulu, semak tarikh kuat kuasa dan kemudian buat transaksi pembaharuan roadtax. Bayaran insurans sahaja tidak bermakna roadtax sudah diperbaharui."
  },
  {
    q: "Bila boleh mula renew?",
    a: "JPJ membenarkan pembaharuan LKM yang akan tamat dalam masa dua bulan. Untuk insurans, ikut syarat syarikat anda. Etiqa menyatakan pembelian boleh dibuat sehingga dua bulan sebelum polisi tamat. Semak tarikh mula polisi baharu supaya tiada jurang perlindungan."
  },
  {
    q: "Adakah insurans masih melindungi saya selepas tamat?",
    a: "Perlindungan tidak bersambung secara automatik. Kontrak Etiqa menyatakan perlindungan berjalan dalam tempoh yang tercatat pada jadual polisi. Semak tarikh dan masa mula polisi baharu. Tempoh kelonggaran bayaran tidak membenarkan anda memandu tanpa perlindungan."
  },
  {
    q: "Kalau tukar syarikat, NCD kena mula semula?",
    a: "Pertukaran syarikat tidak menetapkan semula NCD kepada 0% jika anda masih layak menggunakan NCD tersebut. Minta syarikat baharu menyemak rekod NCD dan pastikan kadar itu tertera pada sebut harga sebelum anda membayar."
  },
  {
    q: "Apa perlu dibuat jika roadtax tamat lebih tiga tahun?",
    a: "Panduan JPJ menyatakan kenderaan dengan LKM terakhir tamat lebih tiga tahun perlu menjalani dan lulus pemeriksaan. Bagi kereta, rujuk pemeriksaan PUSPAKOM dan urus dokumen di JPJ. Semak urusan yang diperlukan dengan JPJ sebelum memandu ke pemeriksaan."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Cara Renew Insurans Kereta Online di Malaysia",
      "description": "Langkah pembaharuan insurans kereta, semakan NCD, dokumen, e-cover note dan urusan roadtax JPJ di Malaysia.",
      "url": "https://insurans.co/guides/renew-car-insurance/",
      "datePublished": "2026-01-22",
      "dateModified": "2026-10-10",
      "inLanguage": "ms",
      "publisher": { "@type": "Organization", "name": "Insurans.co" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
        { "@type": "ListItem", "position": 2, "name": "Panduan", "item": "https://insurans.co/guides/" },
        { "@type": "ListItem", "position": 3, "name": "Cara Renew Insurans Kereta Online di Malaysia", "item": "https://insurans.co/guides/renew-car-insurance/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    }
  ]
