---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import personalAccident from '../../data/personal-accident.json';
import { buildDescription, buildTitle } from '../../lib/seo';

const records = personalAccident.records;
const typeOrder = ['personal-accident', 'personal-accident-takaful'] as const;
const typeLabels: Record<string, string> = {
  'personal-accident': 'PA konvensional',
  'personal-accident-takaful': 'PA takaful',
};
const typeDescriptions: Record<string, string> = {
  'personal-accident': 'Pelan personal accident berasaskan polisi insurans.',
  'personal-accident-takaful': 'Pelan kemalangan diri berasaskan sijil takaful.',
};
const recordGroups = typeOrder
  .map((type) => ({
    type,
    label: typeLabels[type],
    description: typeDescriptions[type],
    records: records.filter((record) => record.type === type),
  }))
  .filter((group) => group.records.length > 0);
const publishedRecords = records.filter((record) => record.premiumPublished);
const sourceLabel = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const sourceLinks = Array.from(new Set(records.flatMap((record) => record.sources))).map((url) => ({
  label: sourceLabel(url),
  url,
}));

const faqs = [
  {
    q: 'Apa beza PA konvensional dan takaful?',
    a: 'Kedua-duanya bertujuan memberi perlindungan apabila berlaku kemalangan, tetapi PA konvensional menggunakan polisi insurans manakala PA takaful menggunakan sijil takaful dan struktur dana takaful. Manfaat, pengecualian, caruman atau premium serta syarat tuntutan tetap ikut dokumen produk masing-masing; jangan anggap label sahaja menjadikan terma sama.',
  },
  {
    q: 'SOCSO atau PERKESO sudah cover — masih perlu PA?',
    a: 'PERKESO ialah skim berkanun dengan kelayakan, caruman dan pencetus yang bergantung pada skim pekerjaan. PA pula ialah kontrak perlindungan kemalangan persendirian. Skop, bentuk bayaran dan proses tuntutan tidak sama, jadi semak perlindungan pekerjaan anda dahulu dan baca polisi PA sebelum menganggap satu menggantikan yang lain.',
  },
  {
    q: 'Boleh beli PA untuk keluarga dan anak?',
    a: 'Boleh atau tidak bergantung pada produk, umur dan definisi insured person dalam PDS. Rekod Tune Protect PA Easy menyatakan umur masuk 18-70 tahun, jadi angka itu tidak boleh dianggap sebagai kelayakan kanak-kanak. Rekod Etiqa menyebut manfaat kanak-kanak, tetapi sumber yang dibaca tidak menetapkan umur kemasukan kanak-kanak. Semak PDS dan sijil untuk setiap ahli keluarga.',
  },
  {
    q: 'Boleh beli PA online?',
    a: 'Ada produk yang menyatakan saluran dalam talian. Dalam data ini, Tune Protect PA Easy dinyatakan boleh dibeli online; itu bukan bukti semua pelan mempunyai proses yang sama. Gunakan laman rasmi penginsurans, baca PDS, semak kelas pekerjaan dan simpan polisi atau sijil selepas bayaran. Insurans.co tidak menjual polisi dan tidak menyediakan quotation langsung.',
  },
  {
    q: 'PA ada waiting period?',
    a: 'Sumber PDS dan laman produk yang dibaca untuk rekod ini tidak menyatakan satu waiting period PA yang universal. Jangan tukar ketiadaan kenyataan itu menjadi dakwaan “tiada waiting period”. Semak tarikh kuat kuasa, tempoh menunggu jika ada, pengecualian dan syarat notifikasi tuntutan dalam PDS atau wording polisi sebenar.',
  },
  {
    q: 'Apa itu PA?',
    a: 'PA ialah personal accident atau insurans kemalangan diri. Ia biasanya merujuk manfaat seperti AD (kematian akibat kemalangan) dan PPD (hilang upaya kekal mengikut takrif PDS), bersama manfaat tambahan yang dinyatakan produk seperti perubatan atau elaun hospital. PA bukan perlindungan sakit biasa dan tidak sama dengan medical card.',
  },
];

const pageTitle = 'Insurans PA Malaysia 2026';
const description = buildDescription(
  'Panduan personal accident Malaysia: faham AD dan PPD, bandingkan PA konvensional dengan takaful, serta semak harga yang diterbitkan daripada sumber rasmi.',
);
const canonicalUrl = 'https://insurans.co/personal-accident/';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: '2026-02-01',
  dateModified: personalAccident.asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Kemalangan Diri', item: canonicalUrl },
    ],
  },
};
---

<Base
  title={buildTitle(pageTitle)}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime="2026-02-01"
  modifiedTime={personalAccident.asAt}
>
  <section class="border-b border-stone-200 bg-white">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { label: 'Utama', href: '/' },
          { label: 'Insurans Kemalangan Diri' },
        ]}
      />
      <p class="label mb-3">Panduan Data</p>
      <h1 class="mb-4 font-serif text-headline-lg text-stone-900 sm:text-headline-xl">Insurans Kemalangan Diri (PA) Malaysia 2026</h1>
      <Byline dateModified={personalAccident.asAt} />
      <p class="mt-4 max-w-2xl text-lg leading-7 text-stone-600">
        Fahami apa yang PA lindungi, beza polisi konvensional dan sijil takaful, serta angka yang benar-benar diterbitkan oleh sumber rasmi. Tiada harga dianggar atau dikira semula.
      </p>
      <div class="mt-6 max-w-3xl">
        <EditorialStamp
          articleDate={personalAccident.asAt}
          sources={sourceLinks}
          sourcesLabel="Sumber rasmi"
          showReviewed={false}
        />
      </div>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div class="lg:col-span-2">
        <article class="prose-editorial">
          <p class="text-lg leading-7 text-stone-700">
            Personal accident (PA) memberi manfaat apabila kemalangan yang dilindungi menyebabkan kematian atau hilang upaya kekal, dengan manfaat tambahan mengikut pelan. Ia bukan medical card: medical card membayar bil rawatan yang layak, manakala PA boleh membayar manfaat tunai atau membayar balik kos tertentu mengikut PDS.
          </p>

          <h2 id="apa-itu">Apa itu PA? AD &amp; PPD akibat kemalangan, bukan sakit</h2>
          <p>
            AD ialah kematian akibat kemalangan. PPD merujuk hilang upaya kekal mengikut jadual atau takrif dalam dokumen produk. Jumlah manfaat boleh berbeza untuk jenis kecederaan, dan sesetengah pelan turut menyenaraikan perbelanjaan perubatan, elaun hospital, ambulans atau manfaat pemulihan. Sakit biasa bukan pencetus PA melainkan dokumen produk menyatakan manfaat berasingan.
          </p>

          <h2 id="konvensional-takaful">PA konvensional vs takaful</h2>
          <p>
            PA konvensional diterbitkan sebagai polisi oleh syarikat insurans. PA takaful menggunakan sijil dan struktur pengendali takaful. Soalan bandingan masih sama: AD dan PPD, jadual bayaran hilang upaya, manfaat perubatan, elaun hospital, pengecualian, umur masuk, kelas pekerjaan dan pembaharuan. Baca PDS atau wording setiap produk kerana struktur dan istilah tidak semestinya seragam.
          </p>

          <h2 id="cara-banding">Cara banding pelan PA</h2>
          <ol>
            <li><strong>Mulakan dengan AD dan PPD.</strong> Semak jumlah perlindungan dan jadual peratusan untuk kecederaan tertentu, bukan tajuk pemasaran sahaja.</li>
            <li><strong>Asingkan manfaat tunai dan bayaran balik.</strong> Hospital cash, elaun mingguan dan perbelanjaan perubatan mempunyai had, tempoh dan dokumen tuntutan berbeza.</li>
            <li><strong>Semak kelayakan.</strong> Umur masuk, kelas atau jenis pekerjaan, wilayah perlindungan, aktiviti berisiko dan syarat pembaharuan boleh menukar kelayakan.</li>
            <li><strong>Baca pengecualian dan tuntutan.</strong> Semak aktiviti yang dikecualikan, tarikh kuat kuasa, notifikasi kemalangan serta dokumen yang perlu disimpan.</li>
            <li><strong>Bandingkan harga yang diterbitkan sahaja.</strong> Jika sumber tidak menerbitkan harga, minta quotation rasmi; jangan isi jurang dengan purata pasaran.</li>
          </ol>
        </article>

        <div class="mt-10 space-y-10 sm:mt-14">
          {recordGroups.map((group) => (
            <section id={group.type}>
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div>
                  <h2 class="font-serif text-headline-md text-stone-900">{group.label}</h2>
                  <p class="mt-1 text-sm text-stone-600">{group.description}</p>
                </div>
                <span class="text-sm text-stone-500">{group.records.length} pelan</span>
              </div>

              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {group.records.map((record) => (
                  <a href={`/personal-accident/${record.slug}/`} class="card-editorial group block">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <h3 class="font-semibold text-stone-900 group-hover:text-hijau-700">{record.planName}</h3>
                        <p class="mt-1 text-xs leading-5 text-stone-500">{record.insurer}</p>
                      </div>
                      <span class="shrink-0 border border-stone-300 px-2 py-1 text-xs font-semibold text-stone-600">{group.label}</span>
                    </div>

                    <dl class="mt-5 space-y-2 text-sm">
                      {record.coversWhat && (
                        <div class="border-t border-stone-200 pt-2">
                          <dt class="text-stone-600">Cover utama</dt>
                          <dd class="mt-1 font-semibold leading-5 text-stone-900">{record.coversWhat}</dd>
                        </div>
                      )}
                      {record.plansAndBenefits && (
                        <div class="border-t border-stone-200 pt-2">
                          <dt class="text-stone-600">Pelan &amp; manfaat</dt>
                          <dd class="mt-1 font-semibold leading-5 text-stone-900">{record.plansAndBenefits}</dd>
                        </div>
                      )}
                      {record.entryAge && (
                        <div class="border-t border-stone-200 pt-2">
                          <dt class="text-stone-600">Umur masuk</dt>
                          <dd class="mt-1 font-semibold leading-5 text-stone-900">{record.entryAge}</dd>
                        </div>
                      )}
                      {record.premiumPublished ? (
                        <div class="border-t border-stone-200 pt-2">
                          <dt class="text-stone-600">Harga diterbitkan</dt>
                          <dd class="mt-1 font-semibold leading-5 text-hijau-800">{record.premiumPublished}</dd>
                        </div>
                      ) : (
                        <div class="border-t border-stone-200 pt-2">
                          <dt class="text-stone-600">Harga diterbitkan</dt>
                          <dd class="mt-1 font-semibold leading-5 text-stone-900">Tidak diterbitkan dalam sumber yang dibaca</dd>
                        </div>
                      )}
                    </dl>

                    {!record.figureVerified && (
                      <p class="mt-4 border-t border-emas-200 pt-3 text-sm leading-5 text-emas-800">
                        Nota ketelusan: butiran manfaat, umur masuk dan premium tidak dapat disahkan daripada sumber yang dibaca.
                      </p>
                    )}
                    <span class="mt-4 inline-block text-sm font-semibold text-hijau-700">Lihat butiran →</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>

        <section id="harga" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Harga yang diterbitkan</h2>
            <p>
              Berikut ialah angka yang muncul dalam sumber rasmi sahaja. Setiap baris mengekalkan qualifier asal; ia bukan quotation peribadi dan bukan harga yang dikira daripada jumlah perlindungan. Contoh PDS Etiqa ditanda sebagai contoh, bukan harga jualan umum.
            </p>
          </div>

          <div class="mt-6 grid gap-4">
            {publishedRecords.map((record) => {
              const isExample = record.premiumPublished?.startsWith('Contoh PDS');
              return (
                <div class="card-editorial">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <h3 class="font-serif text-headline-sm text-stone-900">{record.planName}</h3>
                      <p class="mt-1 text-sm text-stone-600">{record.insurer}</p>
                    </div>
                    <span class="border border-stone-300 px-2 py-1 text-xs font-semibold text-stone-600">
                      {isExample ? 'Contoh PDS' : 'Harga diterbitkan'}
                    </span>
                  </div>
                  <p class="mt-4 text-lg leading-7 text-stone-900">{record.premiumPublished}</p>
                  {isExample && <p class="mt-2 text-sm leading-5 text-emas-800">Contoh PDS ini bukan harga jualan umum atau quotation individu.</p>}
                  <div class="mt-4 border-t border-stone-200 pt-3 text-sm leading-5 text-stone-600">
                    <p><strong>Sumber:</strong> {record.sources.map((url, index) => (
                      <span>
                        {index > 0 && <span aria-hidden="true"> · </span>}
                        <a href={url} class="text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600">{sourceLabel(url)}</a>
                      </span>
                    ))}</p>
                    <p class="mt-1"><strong>Tarikh semakan:</strong> {record.asAt}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </section>

        <section id="banding-tiga" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>PA vs medical card vs life insurance</h2>
            <p>Ketiga-tiganya boleh melengkapi, tetapi pencetus tuntutan dan bentuk bayaran tidak sama.</p>
          </div>
          <div class="mt-6 overflow-x-auto">
            <table class="table-editorial">
              <thead>
                <tr>
                  <th scope="col">Aspek</th>
                  <th scope="col">PA</th>
                  <th scope="col">Medical card</th>
                  <th scope="col">Life insurance</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="font-medium text-stone-900">Pencetus utama</td>
                  <td>Kemalangan yang memenuhi polisi, termasuk AD atau PPD mengikut takrif</td>
                  <td>Rawatan hospital atau day surgery yang layak kerana sakit atau kemalangan</td>
                  <td>Kematian mengikut terma polisi dan pengecualian</td>
                </tr>
                <tr>
                  <td class="font-medium text-stone-900">Bentuk manfaat</td>
                  <td>Lump sum dan manfaat tambahan seperti yang dinyatakan</td>
                  <td>Bayaran bil rawatan yang layak, tertakluk pada had dan kos sendiri</td>
                  <td>Lump sum kepada benefisiari atau penama mengikut polisi</td>
                </tr>
                <tr>
                  <td class="font-medium text-stone-900">Sakit biasa</td>
                  <td>Tidak menjadi pencetus PA</td>
                  <td>Boleh dilindungi untuk rawatan yang layak</td>
                  <td>Bukan manfaat rawatan; pencetusnya ialah manfaat kematian</td>
                </tr>
                <tr>
                  <td class="font-medium text-stone-900">Semak dahulu</td>
                  <td>Jadual PPD, pengecualian, kelas pekerjaan dan tuntutan</td>
                  <td>Had tahunan, room &amp; board, deductible dan waiting period</td>
                  <td>Jumlah perlindungan, tempoh, premium dan pengecualian</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="group-pa" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Group PA</h2>
            <p>
              Group PA biasanya datang melalui majikan atau organisasi dan boleh menjadi lapisan tambahan kepada perlindungan peribadi. Minta sijil atau ringkasan manfaat dan semak siapa yang dilindungi, jumlah AD/PPD, waktu serta wilayah perlindungan, aktiviti yang dikecualikan, proses tuntutan dan sama ada cover tamat apabila anda berhenti kerja. Jangan anggap group PA boleh dipindahkan atau mencukupi untuk keluarga tanpa pengesahan bertulis.
            </p>
          </div>
        </section>

        <section id="beli-online" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Beli online</h2>
            <p>
              Beli terus melalui laman rasmi hanya selepas membaca PDS dan memastikan maklumat pekerjaan, umur serta orang yang dilindungi tepat. Rekod Tune Protect PA Easy menyatakan boleh beli online; untuk produk lain, ketersediaan saluran dan proses quotation perlu disahkan pada laman rasmi. Selepas membayar, simpan polisi atau sijil, resit, nombor kecemasan dan arahan tuntutan. Kami bukan ejen, broker atau platform quotation.
            </p>
          </div>
        </section>

        <section id="keluarga-anak" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>PA untuk keluarga &amp; anak</h2>
            <p>
              Jangan salin kelayakan seorang dewasa kepada ahli keluarga lain. Semak umur masuk setiap insured person, sama ada anak atau pasangan perlu sijil berasingan, had manfaat setiap orang, definisi penjaga atau benefisiari dan cara tuntutan. Dalam data ini, manfaat kanak-kanak Etiqa disebut dalam ringkasan pelan tetapi umur kemasukan tidak dinyatakan; Tune PA Easy pula menyatakan 18-70 tahun. Kekosongan ini perlu disemak dalam PDS atau quotation rasmi.
            </p>
          </div>
        </section>

        <section id="faq" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Soalan lazim PA</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:col-span-1">
        <div class="space-y-6 lg:sticky lg:top-20">
          <div class="border-2 border-stone-900 bg-white p-5">
            <h2 class="font-serif text-headline-sm text-stone-900">Ringkasan</h2>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-stone-500">Bilangan rekod</dt>
                <dd class="font-semibold text-stone-900">{records.length} pelan</dd>
              </div>
              <div>
                <dt class="text-stone-500">Kategori</dt>
                <dd class="font-semibold text-stone-900">PA konvensional dan takaful</dd>
              </div>
              <div>
                <dt class="text-stone-500">Angka diterbitkan</dt>
                <dd class="font-semibold text-stone-900">{publishedRecords.length} rekod</dd>
              </div>
              <div>
                <dt class="text-stone-500">Data dikemas kini</dt>
                <dd class="font-semibold text-hijau-700">{personalAccident.asAt}</dd>
              </div>
              <div>
                <dt class="text-stone-500">Harga dianggar</dt>
                <dd class="font-semibold text-stone-900">Tiada</dd>
              </div>
            </dl>
          </div>
          <div class="card-editorial">
            <h2 class="text-sm font-semibold text-stone-900">Baca juga</h2>
            <ul class="mt-3 space-y-2.5 text-sm">
              <li><a href="/medical-cards/" class="text-hijau-700 hover:text-hijau-600">Medical card</a></li>
              <li><a href="/life-insurance/" class="text-hijau-700 hover:text-hijau-600">Insurans hayat</a></li>
              <li><a href="/bantuan-insurans/perkeso/" class="text-hijau-700 hover:text-hijau-600">PERKESO</a></li>
              <li><a href="/takaful/" class="text-hijau-700 hover:text-hijau-600">Panduan takaful</a></li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
