---
/** A row of tiles that jump to sections on the same page by anchor. Labels are the page's own section names. */

interface Tile { href: string; label: string }
interface Props { tiles: Tile[]; label: string }
const { tiles, label } = Astro.props;
---
<nav class="ht" aria-label={label}>
  <ul>
    {tiles.map((t) => (
      <li><a href={t.href}><span>{t.label}</span></a></li>
    ))}
  </ul>
</nav>

<style>
  .ht ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ht a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.5rem 1rem;
    white-space: nowrap;
    border: 1px solid var(--mute);
    border-radius: var(--r-2);
    background: var(--card);
    color: var(--ink);
    text-align: center;
    text-decoration: none;
    font: 600 1rem/1.15 var(--fd);
    transition: background-color 150ms var(--ease-out);
  }
  .ht a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .ht a:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
</style>
