---
const navLinks = [
  { href: '/car-insurance/', label: 'Kereta' },
  { href: '/medical-cards/', label: 'Medical Card' },
  { href: '/travel-insurance/', label: 'Travel' },
  { href: '/tools/ncd-calculator/', label: 'Kalkulator NCD' },
  { href: '/perbandingan/', label: 'Bandingkan' },
  { href: '/companies/', label: 'Syarikat' },
  { href: '/takaful/', label: 'Takaful' },
  { href: '/panduan/renew-insurans-roadtax/', label: 'Renew Online' },
  { href: '/bantuan-insurans/', label: 'Bantuan & i-Lindung' },
];

const currentPath = Astro.url.pathname;
// The homepage already says "Bukan ejen. Bukan broker." under its H1, so the masthead tag is left out there.
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<!--
  Edisi masthead. The wordmark is the slider "i" (round4/logo-slider, study D), inlined so its
  colours come from the page tokens. In this step it is static: the knob rests seated (NCD 55%,
  the true logo) and is not a control yet. A tap anywhere on the wordmark goes home.
-->
<header class="mast">
  <div class="mast-in">
    <a class="wm-a" href="/" aria-label="Insurans.co — Utama">
      <svg class="wm-svg" viewBox="0 -400 4637 1201" width="170" height="44" aria-hidden="true" focusable="false">
