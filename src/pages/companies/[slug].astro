---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import companies from '../../data/companies.json';
import comparisons from '../../data/comparisons.json';

type CompanyRecord = (typeof companies)[number];

export function getStaticPaths() {
  return companies.map((company) => ({
    params: { slug: company.slug },
    props: { company },
  }));
}

const { company } = Astro.props as { company: CompanyRecord };
const relatedComparisons = comparisons.filter((comparison) =>
  comparison.company1 === company.slug || comparison.company2 === company.slug
).slice(0, 3);
const otherCompanies = companies.filter((candidate) => candidate.slug !== company.slug).slice(0, 5);
const sourceLinks = company.sources.map((url) => ({
  label: new URL(url).hostname.replace(/^www\./, ''),
  url,
}));
const canonicalUrl = `https://insurans.co/companies/${company.slug}/`;
const companyOgName = company.fullName !== company.name ? `${company.name} (${company.fullName})` : company.name;
const companyOgImageAlt = `${companyOgName} — entiti, produk, tuntutan dan sumber rasmi.`;
const productsSummary = company.productDetails.map((product) =>
  product.names.length ? `${product.line}: ${product.names.join(', ')}` : product.line
).join('; ');
const hotlineSummary = company.claims.hotlines
  .map((hotline) => `${hotline.label}: ${hotline.number}`)
  .join('; ');
const appSummary = `${company.app.name}: ${company.app.features.join('; ')}`;
const faqs = [
  {
    q: `Apakah entiti berlesen yang berkaitan dengan ${company.name}?`,
    a: `${company.entities.join(', ')}. ${company.history} Semak nama penerbit pada polisi atau sijil anda; nama kumpulan dan jenama tidak semestinya sama dengan entiti kontrak.`,
  },
  {
    q: `Apakah produk utama ${company.name}?`,
    a: `${company.name} menawarkan ${productsSummary}. Rujuk helaian pendedahan produk dan dokumen polisi atau sijil untuk manfaat, had dan pengecualian.`,
  },
  {
    q: `Bagaimana menghubungi ${company.name} untuk tuntutan?`,
    a: `${company.claims.steps.join(' ')} Talian yang diterbitkan: ${hotlineSummary}. Semak talian dan langkah mengikut jenis polisi sebelum menghantar dokumen atau mengatur bantuan.`,
  },
  {
    q: `Apakah aplikasi atau saluran digital ${company.name}?`,
    a: `${appSummary}. Semak fungsi yang tersedia untuk polisi atau sijil anda terus dengan ${company.name}.`,
  },
  {
    q: `Bolehkah pertikaian terhadap ${company.name} dirujuk kepada FMOS?`,
    a: 'Pertikaian motor dan perubatan/kesihatan termasuk takaful yang memenuhi syarat FMOS boleh dirujuk secara percuma selepas keputusan akhir penyedia. Had masa yang dinyatakan ialah enam bulan selepas keputusan akhir; semak skop kelayakan dan proses terus dengan FMOS.',
  },
];
const title = `Review ${company.name}${company.name.endsWith('Malaysia') ? '' : ' Malaysia'} 2026 — Entiti, produk dan tuntutan`;
// Company profiles were first published on 2026-09-28; asAt is the review date.
const COMPANY_PUBLISHED_AT = '2026-09-28';
const description = `${company.name}: sejarah entiti, produk, proses tuntutan, aplikasi, talian hubungan dan sumber rasmi. Data disemak pada ${company.asAt}.`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: canonicalUrl,
  datePublished: COMPANY_PUBLISHED_AT,
  dateModified: company.asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Syarikat', item: 'https://insurans.co/companies/' },
      { '@type': 'ListItem', position: 3, name: company.name, item: canonicalUrl },
    ],
  },
};
---
<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={COMPANY_PUBLISHED_AT}
  modifiedTime={company.asAt}
  ogImage={`/og/companies/${company.slug}.png`}
  ogImageAlt={companyOgImageAlt}
>
  <section class="border-b border-stone-200 bg-white">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { label: 'Utama', href: '/' },
          { label: 'Syarikat', href: '/companies/' },
          { label: company.name },
        ]}
      />
      <div class="mt-6 max-w-3xl">
        <p class="label mb-3">Profil syarikat</p>
        <h1 class="mb-3 font-serif text-headline-lg text-stone-900">{company.name}</h1>
        <p class="mb-4 text-sm text-stone-500">
          {company.fullName}{company.parent && <span> · {company.parent}</span>}
        </p>
        <p class="text-lg leading-7 text-stone-700">{company.descriptionBM}</p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-stone-600">
          {company.founded && <span>Tahun rujukan: {company.founded}</span>}
          {company.headquarters && <span>{company.headquarters}</span>}
          {company.takaful && <span>Pilihan takaful</span>}
        </div>
        <div class="mt-5">
          <Byline dateModified={company.asAt} />
        </div>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-stone-600">
          Insurans.co ialah penerbit kandungan bebas dan tidak menjual polisi. Semak helaian pendedahan produk serta dokumen polisi atau sijil semasa dengan penyedia sebelum membuat keputusan.
        </p>
        <div class="mt-6">
          <EditorialStamp
            articleDate={company.asAt}
            sources={sourceLinks}
            sourcesLabel="Rujukan rasmi"
            showReviewed={false}
          />
        </div>
      </div>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div class="lg:col-span-2">
        <article class="prose-editorial">
          <p class="text-lg leading-7 text-stone-700">
            Kenal pasti entiti yang mengeluarkan polisi atau sijil anda. Nama entiti tersebut membantu anda mencari saluran tuntutan dan khidmat pelanggan yang betul. Rujuk dokumen produk untuk manfaat, kelayakan dan had perlindungan.
          </p>

          <h2 id="latar-belakang">Latar belakang &amp; lesen</h2>
          <p>{company.history}</p>
          <p>
            Entiti berlesen yang disenaraikan dalam direktori BNM:
          </p>
          <ul>
            {company.entities.map((entity) => <li>{entity}</li>)}
          </ul>
          <p>
            Semak nama pengendali pada dokumen perlindungan anda. Insurans konvensional menggunakan polisi, manakala takaful menggunakan sijil. Tarikh sejarah kumpulan dan jenama boleh berbeza daripada tarikh penubuhan entiti yang mengeluarkan dokumen tersebut.
          </p>
          <p>
            Untuk membandingkan perlindungan dengan adil, kenal pasti dahulu entiti yang menanggung risiko, jenis produk dan saluran servisnya. Hubungan dengan kumpulan bank atau syarikat antarabangsa ialah maklumat korporat; ia tidak menggantikan semakan terma kontrak, had perlindungan, pengecualian atau proses aduan bagi produk tertentu.
          </p>

          <h2 id="produk-utama">Produk utama</h2>
          <p>
            Senarai berikut mengasingkan jenis perlindungan dan nama produk. Untuk nama dan butiran produk semasa, rujuk laman rasmi penyedia serta dokumen produk Malaysia yang berkaitan.
          </p>
        </article>

        <div class="my-6 grid gap-4 sm:grid-cols-2">
          {company.productDetails.map((product) => (
            <article class="border border-stone-200 bg-white p-5">
              <h3 class="font-semibold text-stone-900">{product.line}</h3>
              {product.names.length > 0 && (
                <ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-6 text-stone-700">
                  {product.names.map((name) => <li>{name}</li>)}
                </ul>
              )}
              <a href={product.url} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-sm text-hijau-700 underline">
                Lihat butiran produk →
              </a>
            </article>
          ))}
        </div>
        <article class="prose-editorial">
          <p>
            Untuk insurans motor, bandingkan jenis perlindungan, nilai diinsuranskan, excess, betterment, manfaat tambahan dan had tunda dalam quotation serta wording sebenar. Untuk perubatan atau hayat, semak had tahunan/seumur hidup, perkongsian kos, syarat kelayakan dan tempoh menunggu. Nama manfaat dalam ringkasan ini tidak menjamin tuntutan akan diluluskan.
          </p>
          <p>
            Harga insurans kereta bergantung pada butiran risiko, kenderaan, perlindungan dan pilihan tambahan. Dapatkan quotation terus daripada penyedia dan bandingkan skop perlindungan yang setara.
          </p>

          <h2 id="tuntutan">Cara buat tuntutan</h2>
          <p>
            Proses tuntutan berubah mengikut kategori perlindungan. Gunakan arahan yang sepadan dengan polisi atau sijil anda; nombor bantuan kemalangan, meja tuntutan dan careline umum tidak semestinya menjalankan fungsi yang sama.
          </p>
          <ol>
            {company.claims.steps.map((step) => <li>{step}</li>)}
          </ol>
          <p>
            Talian tuntutan dan bantuan:
          </p>
        </article>
        <div class="my-5 space-y-3">
          {company.claims.hotlines.filter((hotline) => hotline.number.trim()).map((hotline) => (
            <div class="flex flex-wrap items-baseline justify-between gap-2 border border-stone-200 bg-krim-50 p-4 text-sm">
              <span class="font-medium text-stone-700">{hotline.label}</span>
              <a href={`tel:${hotline.number.replace(/[^0-9+]/g, '')}`} class="font-semibold text-hijau-700 underline">
                {hotline.number}
              </a>
            </div>
          ))}
        </div>
        <article class="prose-editorial">
          {company.claims.roadside && <p><strong>Bantuan tepi jalan:</strong> {company.claims.roadside}</p>}
          <p>
            Jika melibatkan kemalangan, hubungi penyedia melalui saluran rasmi dan simpan maklumat berkaitan kejadian. Jangan anggap nombor hotline sebagai kelulusan tuntutan atau jaminan tempoh bayaran. Minta senarai dokumen serta arahan bertulis untuk tuntutan anda, dan gunakan bantuan tunda yang dilantik apabila penyedia mensyaratkannya.
          </p>
          <p>
            Jika aduan tidak selesai selepas keputusan akhir penyedia, Financial Markets Ombudsman Service (FMOS) ialah saluran ombudsman bersama untuk pertikaian kewangan yang layak. Pertikaian motor dan perubatan/kesihatan termasuk takaful boleh dipertimbangkan secara percuma; had masa yang dinyatakan ialah enam bulan selepas keputusan akhir. Sahkan skop bidang kuasa dan syarat terkini terus dengan FMOS.
          </p>

          <h2 id="digital">Aplikasi &amp; saluran digital</h2>
          <p>
            Gunakan aplikasi atau portal rasmi di bawah untuk urusan yang tersedia bagi polisi atau sijil anda.
          </p>
          <h3>{company.app.name}</h3>
          <ul>
            {company.app.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <p>
            Sebelum bergantung pada aplikasi ketika kecemasan, semak sama ada polisi anda telah dipautkan, kaedah log masuk berfungsi dan talian telefon masih tersedia. Semak fungsi yang tersedia untuk polisi anda dengan penyedia; portal web dan aplikasi mungkin menawarkan kemudahan yang berbeza.
          </p>

          <h2 id="hubungi">Hubungi</h2>
          <p>
            Gunakan saluran rasmi yang sepadan dengan urusan anda. Talian servis yang berasingan membantu membezakan pertanyaan polisi, tuntutan, bantuan jalan raya dan bantuan perubatan; periksa waktu operasi sebelum membuat panggilan bagi urusan bukan kecemasan.
          </p>
        </article>
        <div class="my-5 space-y-3">
          {company.contact.website && (
            <div class="flex flex-wrap gap-3 border-b border-stone-200 pb-3 text-sm">
              <span class="w-24 shrink-0 font-medium text-stone-500">Laman web</span>
              <a href={company.contact.website} target="_blank" rel="noopener noreferrer" class="break-all text-hijau-700 underline">{company.contact.website}</a>
            </div>
          )}
          {company.contact.email && (
            <div class="flex flex-wrap gap-3 border-b border-stone-200 pb-3 text-sm">
              <span class="w-24 shrink-0 font-medium text-stone-500">E-mel</span>
              <a href={`mailto:${company.contact.email}`} class="break-all text-hijau-700 underline">{company.contact.email}</a>
            </div>
          )}
          {company.contact.hours && (
            <div class="flex flex-wrap gap-3 border-b border-stone-200 pb-3 text-sm">
              <span class="w-24 shrink-0 font-medium text-stone-500">Waktu</span>
              <span class="text-stone-700">{company.contact.hours}</span>
            </div>
          )}
          {company.contact.notes && <p class="border border-stone-200 bg-krim-50 p-4 text-sm leading-6 text-stone-700">{company.contact.notes}</p>}
          <p class="text-sm leading-6 text-stone-600">
            Untuk isu yang tidak sesuai dengan talian khusus di atas, lawati laman penyedia dan cari saluran khidmat pelanggan terkini. Simpan nombor rujukan, tarikh komunikasi dan dokumen yang dihantar. Insurans.co tidak menerima permohonan, mengurus tuntutan atau mewakili pelanggan dengan syarikat ini.
          </p>
        </div>

        <article class="prose-editorial">
          <h2 id="fakta-penting">Fakta penting</h2>
          <p>
            Maklumat tentang produk dan perkhidmatan {company.name}, dengan pautan rasmi untuk setiap fakta.
          </p>
        </article>
        <div class="my-5 space-y-3">
          {company.notable.map((fact) => (
            <div class="border-l-2 border-hijau-600 bg-stone-50 p-4">
              <p class="text-sm leading-6 text-stone-700">{fact.text}</p>
              <a href={fact.source} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-xs text-hijau-700 underline">
                Buka sumber →
              </a>
            </div>
          ))}
        </div>

        <article class="prose-editorial">
          <h2 id="kesesuaian">Sesuai / Kurang sesuai</h2>
          <p>
            Padankan produk dan saluran perkhidmatan dengan keperluan anda. Pertimbangkan bajet, tanggungan, risiko dan syarat kelayakan sebelum membeli.
          </p>
          <h3>Sesuai untuk dipertimbangkan</h3>
          <ul>
            {company.sesuaiUntuk.map((item) => <li>{item}</li>)}
          </ul>
          {company.kurangSesuaiUntuk.length > 0 && (
            <>
              <h3>Kurang sesuai jika</h3>
              <ul>
                {company.kurangSesuaiUntuk.map((item) => <li>{item}</li>)}
              </ul>
            </>
          )}
          <p>
            Sebelum membeli, bandingkan sekurang-kurangnya dua quotation dengan jumlah diinsuranskan dan tambahan yang sama. Baca helaian pendedahan produk serta wording polisi/sijil untuk had, excess, pengecualian, kewajipan pemberitahuan tuntutan dan cara membuat aduan. Pastikan manfaat yang anda perlukan dinyatakan dalam dokumen polisi atau sijil.
          </p>

          <h2 id="sumber">Sumber</h2>
          <p>
            Maklumat di halaman ini disemak daripada laman rasmi {company.name} dan rujukan rasmi lain pada {company.asAt}. Rujuk pautan di bawah untuk butiran produk, tuntutan dan khidmat pelanggan terkini.
          </p>
          <ol>
            {sourceLinks.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="break-all text-hijau-700 underline">
                  {source.label}
                </a>
              </li>
            ))}
          </ol>
        </article>

        <section id="faq" class="mt-10 sm:mt-14">
          <div class="prose-editorial">
            <h2>Soalan lazim — {company.name}</h2>
            <p>Jawapan ini merumuskan rekod di atas; syarat kontrak dan keputusan tuntutan ditentukan oleh dokumen serta penilaian penyedia.</p>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>

        {relatedComparisons.length > 0 && (
          <section class="mt-10 border border-stone-200 bg-stone-50 p-5">
            <h2 class="font-serif text-xl text-stone-900">Perbandingan berkaitan</h2>
            <ul class="mt-3 space-y-2">
              {relatedComparisons.map((comparison) => {
                const company1 = companies.find((candidate) => candidate.slug === comparison.company1);
                const company2 = companies.find((candidate) => candidate.slug === comparison.company2);
                return (
                  <li>
                    <a href={`/perbandingan/${comparison.slug}/`} class="text-hijau-700 underline">
                      {company1?.name ?? comparison.company1} vs {company2?.name ?? comparison.company2}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}
      </div>

      <aside class="lg:col-span-1">
        <div class="space-y-6 lg:sticky lg:top-20">
          <div class="border-2 border-stone-900 bg-white p-5">
            <h2 class="mb-4 font-serif text-lg text-stone-900">Ringkasan</h2>
            <dl class="space-y-3 text-sm">
              <div class="flex justify-between gap-3">
                <dt class="text-stone-500">Jenis</dt>
                <dd class="text-right font-medium">{company.type === 'takaful' ? 'Takaful' : 'Konvensional'}</dd>
              </div>
              {company.takaful && (
                <div class="flex justify-between gap-3">
                  <dt class="text-stone-500">Takaful</dt>
                  <dd class="text-right font-medium">Ada pilihan takaful</dd>
                </div>
              )}
              {company.founded && (
                <div class="flex justify-between gap-3">
                  <dt class="text-stone-500">Tahun rujukan</dt>
                  <dd class="text-right font-medium">{company.founded}</dd>
                </div>
              )}
              {company.headquarters && (
                <div class="flex justify-between gap-3">
                  <dt class="text-stone-500">Ibu pejabat</dt>
                  <dd class="text-right font-medium">{company.headquarters}</dd>
                </div>
              )}
              <div class="flex justify-between gap-3">
                <dt class="text-stone-500">Entiti disenaraikan</dt>
                <dd class="text-right font-medium">{company.entities.length}</dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-stone-500">Baris produk</dt>
                <dd class="text-right font-medium">{company.productDetails.length}</dd>
              </div>
            </dl>
          </div>

          <div class="card-editorial">
            <h2 class="mb-3 text-sm font-semibold text-stone-900">Syarikat lain</h2>
            <ul class="space-y-2.5">
              {otherCompanies.map((otherCompany) => (
                <li>
                  <a href={`/companies/${otherCompany.slug}/`} class="text-sm font-medium text-hijau-700 hover:underline">
                    {otherCompany.name}
                  </a>
                </li>
              ))}
            </ul>
            <a href="/companies/" class="mt-4 block text-xs font-medium text-stone-500 hover:text-hijau-700">Lihat semua syarikat →</a>
          </div>

          <div class="card-editorial">
            <h2 class="mb-3 text-sm font-semibold text-stone-900">Baca juga</h2>
            <ul class="space-y-2.5 text-sm">
              {company.products.includes('car') && (
                <li><a href="/car-insurance/" class="text-hijau-700 hover:underline">Panduan insurans kereta</a></li>
              )}
              <li><a href="/guides/ncd-explained/" class="text-hijau-700 hover:underline">Panduan NCD</a></li>
              {company.takaful && <li><a href="/takaful/" class="text-hijau-700 hover:underline">Insurans dan takaful</a></li>}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  })} />
</Base>

