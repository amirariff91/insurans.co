---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import HubModelList from '../../components/edisi/HubModelList.astro';
import CarThumb from '../../components/CarThumb.astro';
import LogoTile from '../../components/LogoTile.astro';
import HubTiles from '../../components/edisi/HubTiles.astro';
import Dock from '../../components/edisi/Dock.astro';
import Ikon from '../../components/Ikon.astro';
import { rmRange } from '../../components/edisi/steps';
import '../../styles/edisi-answer.css';
import companies from '../../data/companies.json';
import carModels from '../../data/car-models.json';

const carInsurers = companies.filter(c => c.products.includes('car'));

// Group car models by brand
const brandGroups: Record<string, typeof carModels> = {};
carModels.forEach((car) => {
  if (!brandGroups[car.brand]) brandGroups[car.brand] = [];
  brandGroups[car.brand].push(car);
});
// Premium figures in the lead, price table and sidebar read from the same data as the model pages.
const bySlug = Object.fromEntries(carModels.map((car) => [car.slug, car])) as Record<string, any>;
const num = (value: number) => value.toLocaleString('en-MY');
const range = (min: number, max: number) => rmRange(min, max, (n) => `RM${num(n)}`);
const leadSmall55 = `RM${num(bySlug['perodua-axia'].premiumNCD55Min)}–RM${num(bySlug['perodua-myvi'].premiumNCD55Max)}`;
const leadSmall0 = `RM${num(bySlug['perodua-axia'].premiumNCD0Min)}–RM${num(bySlug['perodua-myvi'].premiumNCD0Max)}`;
const leadMid55 = `RM${num(Math.min(bySlug['honda-city'].premiumNCD55Min, bySlug['toyota-vios'].premiumNCD55Min))}–RM${num(Math.max(bySlug['honda-city'].premiumNCD55Max, bySlug['toyota-vios'].premiumNCD55Max))}`;
// Rows read name, market value and premium from car-models.json, so the hub cannot drift from the model pages.
const kValue = (n: number) => `RM${Math.round(n / 1000)}K`;
const tableRows = ['perodua-axia', 'perodua-myvi', 'proton-saga', 'proton-x50', 'toyota-vios', 'honda-city', 'honda-civic', 'toyota-hilux', 'mazda-cx5'].map((slug) => {
  const car = bySlug[slug];
  return { slug, label: car.fullName, marketValue: `${kValue(car.marketValueMin)} – ${kValue(car.marketValueMax)}`, car };
});
const brandOrder = ['Perodua', 'Proton', 'Honda', 'Toyota', 'Nissan', 'Mazda', 'Mitsubishi', 'Hyundai', 'Kia', 'BMW', 'Mercedes-Benz', 'Suzuki'];

// Jump tiles to the hub's own sections; the labels are the quick-link words and section headings already on the page.
const jumpTiles = [
  { href: '#harga', icon: 'i-harga', label: 'Harga' },
  { href: '#jenis', icon: 'i-lindung', label: 'Jenis perlindungan' },
  { href: '#ncd', icon: 'i-peratus', label: 'NCD' },
  { href: '#renew', icon: 'i-renew', label: 'Cara renew' },
  { href: '#add-ons', icon: 'i-tambah', label: 'Add-ons' },
  { href: '#murah', icon: 'i-dompet', label: 'Murah' },
  { href: '#tips', icon: 'i-syiling', label: 'Tips jimat' },
  { href: '#syarikat', icon: 'i-cop', label: 'Syarikat' },
  { href: '#istilah', icon: 'i-kamus', label: 'Istilah' },
  { href: '#soalan', icon: 'i-info', label: 'Soalan lazim' },
  { href: '#semua-model', icon: 'i-kereta', label: 'Ikut model' },
];

const pageTitle = `Harga Insurans & Roadtax Kereta 2026: ${carModels.length} Model`;
const pageDescription = 'Pilih model kereta anda (Perodua, Proton, Honda, Toyota & lain-lain) untuk anggaran insurans ikut NCD 0–55% dan roadtax setahun. Bukan quotation.';

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "url": "https://insurans.co/car-insurance/",
  "datePublished": "2026-01-15",
  "dateModified": "2026-11-15",
  "inLanguage": "ms",
  "publisher": {
    "@type": "Organization",
    "name": "Insurans.co",
    "url": "https://insurans.co"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
      { "@type": "ListItem", "position": 2, "name": "Insurans Kereta", "item": "https://insurans.co/car-insurance/" }
    ]
  }
};
---

<Base
  title={pageTitle}
  description={pageDescription}
  schema={schema}
  ogType="article"
  publishedTime="2026-01-15"
  modifiedTime="2026-11-15"
  ads={true}
>
  <!-- Breadcrumb + Header -->
  <section class="hub-top">
    <div class="container-wide hub-top-in">
      <nav class="hub-crumbs" aria-label="Breadcrumb">
        <a href="/">Utama</a>
        <span aria-hidden="true">›</span>
        <span>Insurans Kereta</span>
      </nav>
      <h1 class="ea-h1">
        {pageTitle}
      </h1>
      <!-- Quick summary card -->
      <section class="mod hub-sum" aria-labelledby="ringkasan">
        <h2 class="mod-bar" id="ringkasan">Wajib third-party, NCD sehingga 55%</h2>
        <dl class="text-sm">
          <div>
            <dt class="text-stone-500">Wajib?</dt>
            <dd class="font-semibold text-stone-900">Ya, sekurang-kurangnya perlindungan pihak ketiga</dd>
          </div>
          <div>
            <dt class="text-stone-500">Anggaran premium komprehensif Myvi, NCD 55%</dt>
            <dd class="font-semibold text-stone-900">{range(bySlug['perodua-myvi'].premiumNCD55Min, bySlug['perodua-myvi'].premiumNCD55Max)}/tahun</dd>
          </div>
          <div>
            <dt class="text-stone-500">Diskaun NCD maksimum</dt>
            <dd class="font-semibold text-hijau-700">55%</dd>
          </div>
          <div>
            <dt class="text-stone-500">Perlindungan paling luas</dt>
            <dd class="font-semibold text-stone-900">Komprehensif</dd>
          </div>
          <div>
            <dt class="text-stone-500">Beli online di</dt>
            <dd class="font-semibold text-stone-900">Platform diluluskan BNM atau terus</dd>
          </div>
        </dl>
      </section>

      <HubModelList />


      <p class="hub-lead">
        Insurans kereta wajib di Malaysia — tanpa polisi sah, anda tidak boleh renew roadtax. Premium komprehensif untuk Axia/Myvi sekitar {leadSmall55} setahun (NCD 55%) dan {leadSmall0} (NCD 0%); City/Vios {leadMid55} dengan NCD penuh.
      </p>
      <Byline dateModified={schema.dateModified} />

      <HubTiles tiles={jumpTiles} label="Bahagian panduan" />
    </div>
  </section>

  <div class="container-wide hub-body py-8 sm:py-12">
    <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <article class="prose-editorial">

          <!-- Intro -->
          <p class="text-lg text-stone-700 leading-relaxed">
            Panduan ini tunjuk harga ikut model, jadual NCD 25–55%, beza polisi komprehensif dan pihak ketiga, dan cara renew online.
            Insurans kereta <strong>wajib</strong> di Malaysia. Anda tidak boleh renew roadtax tanpa insurans yang sah.
            Jadi, berapa kosnya, dan bagaimana mahu memilih polisi yang betul?
            Kami terangkan satu per satu di bawah.
          </p>

          <!-- Harga Section -->
          <h2 id="harga" class="mod-bar hub-bar mod-lab">Harga ikut nilai kereta, NCD, perlindungan dan syarikat</h2>

          <p>
            Harga bergantung pada beberapa faktor: <strong>nilai pasaran kereta</strong>, <strong>NCD anda</strong>,
            <strong>jenis perlindungan</strong>, dan <strong>syarikat insurans</strong> yang dipilih.
          </p>

          <p>
            Selepas <strong>liberalisasi tarif motor 2017</strong>, setiap syarikat boleh menetapkan harga premium masing-masing.
            Maknanya harga boleh berbeza antara syarikat. Sebab itu penting untuk membandingkan harga.
          </p>

        </article>

        <!-- Price Table -->
        <div class="overflow-x-auto my-8">
          <table class="table-editorial">
            <thead>
              <tr>
                <th>Kereta</th>
                <th>Nilai pasaran</th>
                <th>Premium (0% NCD)</th>
                <th>Premium (55% NCD)</th>
              </tr>
            </thead>
            <tbody>
              {tableRows.map(({ label, marketValue, car }) => (
                <tr>
                  <td class="font-medium text-stone-900">{label}</td>
                  <td>{marketValue}</td>
                  <td>{range(car.premiumNCD0Min, car.premiumNCD0Max)}</td>
                  <td class="font-semibold text-hijau-700">{range(car.premiumNCD55Min, car.premiumNCD55Max)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="info-box mb-8">
          <p class="text-sm text-stone-700">
            <strong>Nota penting:</strong> Harga di atas ialah anggaran untuk polisi komprehensif, tahun 2026.
            Harga sebenar bergantung pada umur kereta, lokasi, rekod pemanduan, dan add-ons yang dipilih.
            Sentiasa dapatkan quotation daripada 2-3 syarikat sebelum membuat keputusan.
          </p>
        </div>

        <article class="prose-editorial">

          <!-- Jenis Coverage -->
          <h2 id="jenis" class="mod-bar hub-bar">Tiga jenis polisi: komprehensif paling luas</h2>

          <p>
            Di Malaysia, ada tiga jenis perlindungan utama. Mana satu sesuai untuk anda bergantung pada
            keadaan kereta dan bajet.
          </p>

        </article>

        <!-- Coverage Types -->
        <div class="space-y-4 my-8">
          <div class="card-editorial">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
              <h3 class="font-serif text-xl text-stone-900">1. Comprehensive (Komprehensif)</h3>
              <VerdictBadge tone="best" label="Perlindungan paling luas" />
            </div>
            <p class="text-sm text-stone-600 leading-relaxed mb-3">
              Melindungi kerosakan kereta sendiri, kereta orang lain, kecurian dan kebakaran. Banjir dan bencana alam hanya dilindungi jika anda tambah special perils.
              Jika anda menyebabkan kemalangan, kereta anda juga dilindungi. Antara tiga jenis polisi, ini yang memberi <strong>perlindungan paling luas</strong>.
            </p>
            <p class="text-sm text-stone-500">
              <strong>Sebelum memilih:</strong> Bandingkan perlindungan kerosakan sendiri, nilai kereta, syarat pinjaman dan kemampuan menanggung kerugian.
            </p>
          </div>

          <div class="card-editorial">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
              <h3 class="font-serif text-xl text-stone-900">2. Third-Party Only</h3>
              <span class="verdict border border-edisi-ink bg-edisi-card text-edisi-ink">Perlindungan pihak ketiga</span>
            </div>
            <p class="text-sm text-stone-600 leading-relaxed mb-3">
              Hanya melindungi kerosakan harta dan kecederaan <strong>orang lain</strong>. Kereta anda sendiri langsung tidak dilindungi.
              Jika anda melanggar tiang, anda menanggung kosnya sendiri. Polisi ini memenuhi keperluan perlindungan pihak ketiga untuk penggunaan kenderaan di jalan raya.
            </p>
            <p class="text-sm text-stone-500">
              <strong>Sebelum memilih:</strong> Bandingkan perlindungan kerosakan sendiri, nilai kereta, syarat pinjaman dan kemampuan menanggung kerugian.
            </p>
          </div>

          <div class="card-editorial">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
              <h3 class="font-serif text-xl text-stone-900">3. Third-Party, Fire & Theft (TPFT)</h3>
              <span class="verdict border border-edisi-ink bg-edisi-card text-edisi-ink">Tengah-tengah</span>
            </div>
            <p class="text-sm text-stone-600 leading-relaxed mb-3">
              Seperti polisi pihak ketiga, tetapi dengan tambahan perlindungan untuk <strong>kecurian</strong> dan <strong>kebakaran</strong>.
              Kerosakan kereta sendiri akibat kemalangan tetap tidak dilindungi.
            </p>
            <p class="text-sm text-stone-500">
              <strong>Sesuai untuk:</strong> Kereta yang nilainya sederhana dan diletakkan di kawasan berisiko tinggi kecurian.
              Jika beza premium dengan polisi komprehensif kecil, bandingkan kedua-duanya dahulu.
            </p>
          </div>
        </div>

        <article class="prose-editorial">

          <!-- NCD -->
          <h2 id="ncd" class="mod-bar hub-bar">NCD: diskaun sehingga 55% selepas 5 tahun tanpa claim</h2>

          <p>
            NCD (diskaun tanpa tuntutan) ialah <strong>diskaun yang anda dapat kerana tidak membuat claim</strong>. Setiap tahun anda tidak claim,
            diskaun naik. Maksimum 55% selepas 5 tahun berturut-turut tanpa claim.
          </p>

          <p>
            Ini perkara yang <strong>penting untuk difahami</strong> kerana ia boleh menjimatkan atau merugikan anda ribuan ringgit.
          </p>

        </article>

        <!-- NCD Table -->
        <div class="overflow-x-auto my-8">
          <table class="table-editorial">
            <thead>
              <tr>
                <th>Tahun tanpa claim</th>
                <th>NCD</th>
                <th>Contoh: premium asal RM2,000</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Tahun pertama polisi tanpa NCD terdahulu</td>
                <td class="font-semibold">0%</td>
                <td>Bayar penuh: <strong>RM2,000</strong></td>
              </tr>
              <tr>
                <td>Selepas 1 tahun tanpa claim</td>
                <td class="font-semibold">25%</td>
                <td>Bayar: <strong>RM1,500</strong></td>
              </tr>
              <tr>
                <td>Selepas 2 tahun</td>
                <td class="font-semibold">30%</td>
                <td>Bayar: <strong>RM1,400</strong></td>
              </tr>
              <tr>
                <td>Selepas 3 tahun</td>
                <td class="font-semibold">38.33%</td>
                <td>Bayar: <strong>RM1,233</strong></td>
              </tr>
              <tr>
                <td>Selepas 4 tahun</td>
                <td class="font-semibold">45%</td>
                <td>Bayar: <strong>RM1,100</strong></td>
              </tr>
              <tr>
                <td>Selepas 5+ tahun</td>
                <td class="font-semibold text-hijau-700">55%</td>
                <td>Bayar: <strong class="text-hijau-700">RM900</strong></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="hub-warn mb-6">
          <Ikon name="i-amaran" size={24} />
          <p class="text-sm text-edisi-ink">
            <strong>Hati-hati:</strong> Claim own damage biasa boleh menyebabkan NCD kembali kepada 0% pada renew seterusnya. Pengecualiannya termasuk claim OD-KfK yang layak apabila pihak satu lagi bersalah, dan claim windscreen di bawah add-on windscreen (lihat <a href="/guides/ncd-explained/">panduan NCD</a>).
            Katakan kereta anda calar sedikit dan kos baiki RM500. Jika anda claim ketika NCD anda 55%,
            anda mungkin membayar RM1,000+ lebih untuk premium tahun depan.
            <strong>Kadang-kadang, bayar sendiri lebih jimat.</strong>
          </p>
        </div>

        <!-- NCD Calculator CTA -->
        <div class="border-2 border-hijau-600 bg-hijau-50 p-5 mb-8">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <div class="flex-1">
              <p class="font-semibold text-stone-900 mb-1">Kalkulator NCD: kira premium anda secara percuma</p>
              <p class="text-sm text-stone-600">
                Masukkan premium asal anda dan NCD semasa — lihat berapa yang anda patut bayar, dan sama ada berbaloi untuk claim selepas kemalangan kecil.
              </p>
            </div>
            <a href="/tools/ncd-calculator/" class="flex-shrink-0 btn-hijau text-sm">
              Kira NCD anda →
            </a>
          </div>
        </div>

        <article class="prose-editorial">

          <!-- Cara Renew -->
          <h2 id="renew" class="mod-bar hub-bar mod-lab">Renew online dalam 4 langkah</h2>

          <p>
            Anda tidak perlu ke pejabat atau menunggu panggilan ejen. Ikut 4 langkah ini:
          </p>

          <ol class="list-decimal pl-5 space-y-3 mb-6">
            <li>
              <strong>Semak NCD anda</strong> — lihat di MyEG atau tanya syarikat semasa; NCD menentukan harga premium.
            </li>
            <li>
              <strong>Bandingkan quotation</strong> — melalui platform perbandingan yang diluluskan BNM atau terus di laman syarikat (lihat <a href="/insurans-online/">semakan platform insurans online</a>).
            </li>
            <li>
              <strong>Bayar dan simpan e-cover note</strong> — bayar melalui FPX/kad, dan PDF dihantar ke e-mel.
            </li>
            <li>
              <strong>Renew roadtax</strong> — di JPJ, MyEG, atau Pos Malaysia.
            </li>
          </ol>

          <p>
            Panduan langkah demi langkah: <a href="/guides/renew-car-insurance/">cara renew insurans kereta online</a>.
          </p>


          <!-- Add-ons -->
          <h2 id="add-ons" class="mod-bar hub-bar">Add-ons: bukan semua perlu</h2>

          <p>
            Selepas liberalisasi tarif, syarikat insurans menawarkan pelbagai add-on (perlindungan tambahan).
            Bukan semuanya perlu. Ini panduannya:
          </p>

        </article>

        <div class="space-y-3 my-8">
          <div class="hub-addon">
            <span aria-hidden="true">✓</span>
            <div>
              <p class="font-semibold text-sm text-stone-900">Windscreen cover — pertimbangkan</p>
              <p class="text-sm text-stone-600">Harga add-on dan kos menukar cermin depan berbeza mengikut syarikat dan model kereta; minta sebut harga.</p>
            </div>
          </div>
          <div class="hub-addon">
            <span aria-hidden="true">✓</span>
            <div>
              <p class="font-semibold text-sm text-stone-900">Special perils (banjir & ribut) — pertimbangkan jika kawasan berisiko</p>
              <p class="text-sm text-stone-600">Lazimnya sekitar 0.2%–0.5% daripada sum insured setahun (contoh: RM100–250 untuk sum insured RM50,000). Wajar dipertimbangkan jika anda tinggal di kawasan yang kerap banjir.</p>
            </div>
          </div>
          <div class="hub-addon">
            <span aria-hidden="true">~</span>
            <div>
              <p class="font-semibold text-sm text-stone-900">Breakdown towing — bergantung pada penggunaan</p>
              <p class="text-sm text-stone-600">Lebih relevan untuk kereta lama atau perjalanan jauh. Semak dahulu sama ada waranti pengeluar sudah termasuk bantuan tunda.</p>
            </div>
          </div>
          <div class="hub-addon">
            <span aria-hidden="true">~</span>
            <div>
              <p class="font-semibold text-sm text-stone-900">NCD protector — semak syarat dan kos dahulu</p>
              <p class="text-sm text-stone-600">Harga dan syarat berbeza mengikut syarikat; minta sebut harga dan baca syaratnya sebelum membeli.</p>
            </div>
          </div>
        </div>

        <article class="prose-editorial">

          <h2 id="murah" class="mod-bar hub-bar">Murah bermakna bayar kurang untuk perlindungan yang sama</h2>

          <p>
            Insurans kereta murah bermakna bayar kurang untuk perlindungan yang sama — bukan memilih perlindungan paling nipis.
            Lima cara: (1) <strong>Jaga NCD</strong> — NCD 55% memberi potongan 55% daripada premium asas, manakala perlindungan tambahan dan bayaran lain dikira berasingan;
            kira dahulu dengan <a href="/tools/ncd-calculator/">Kalkulator NCD</a> sama ada berbaloi claim atau bayar sendiri.
            (2) <strong>Semak sum insured</strong>: bagi polisi nilai pasaran, ikut penilaian semasa, bukan harga beli baru; bagi polisi nilai dipersetujui (agreed value), semak jumlah yang dipersetujui.
            (3) <strong>Bandingkan 2–3 quotation</strong> setiap tahun — harga berbeza ikut syarikat selepas liberalisasi 2017.
            (4) <strong>Ambil add-on yang perlu sahaja</strong> — windscreen, dan special perils jika anda tinggal di kawasan banjir.
            (5) <strong>Renew sebelum polisi tamat</strong> supaya tiada jurang perlindungan.
            Panduan penuh: <a href="/guides/cara-turun-premium-insurans-kereta/">cara turunkan premium insurans kereta</a>.
          </p>

        </article>
        <article class="prose-editorial">

          <h2 id="tips" class="mod-bar hub-bar">Enam tip, dari NCD hingga dashcam</h2>

          <ol class="list-decimal pl-5 space-y-3">
            <li>
              <strong>Jaga NCD anda.</strong> NCD 55% memberi potongan 55% daripada premium asas. Perlindungan tambahan dan bayaran lain dikira berasingan.
              Untuk kerosakan kecil (bawah RM1,000-2,000), pertimbangkan bayar sendiri daripada claim.
            </li>
            <li>
              <strong>Bandingkan harga.</strong> Selepas liberalisasi, harga berbeza antara syarikat.
              Minta sebut harga melalui platform perbandingan yang diluluskan BNM atau terus di laman syarikat.
            </li>
            <li>
              <strong>Jangan insuranskan secara berlebihan.</strong> Semak sama ada polisi menggunakan nilai pasaran atau nilai dipersetujui.
              Bagi polisi nilai pasaran, sum insured patut mengikut penilaian semasa kereta, bukan harga baru; bagi polisi nilai dipersetujui, semak jumlah dan syaratnya dengan syarikat.
            </li>
            <li>
              <strong>Pilih add-ons dengan bijak.</strong> Nilai setiap add-on ikut keperluan anda.
              Kad perubatan dan perlindungan kemalangan diri mempunyai manfaat berbeza: kad perubatan menanggung perbelanjaan rawatan yang layak, manakala pelan kemalangan diri boleh menyediakan manfaat kematian atau hilang upaya akibat kemalangan. Bandingkan manfaat sedia ada sebelum menganggapnya bertindih.
            </li>
            <li>
              <strong>Renew sebelum polisi tamat.</strong> Ini mengelakkan jurang perlindungan.
              Premium baharu tetap bergantung pada sebut harga dan syarat syarikat; renew awal tidak menjamin harga lebih rendah.
            </li>
            <li>
              <strong>Pasang dashcam.</strong> Ia tidak menjimatkan premium secara langsung, tetapi jika berlaku kemalangan,
              rakaman boleh membantu menunjukkan keadaan kemalangan dan menyokong proses claim.
            </li>
          </ol>

          <!-- Syarikat section -->
          <h2 id="syarikat" class="mod-bar hub-bar">Syarikat insurans kereta: senarai, bukan ranking</h2>

          <p>
            Senarai syarikat yang menawarkan insurans kereta, bukan ranking. Baca profil setiap syarikat untuk entiti, produk dan talian tuntutan.
          </p>

        </article>

        <!-- Insurer Rankings -->
        <details class="hub-fold my-6">
        <summary>Senarai {carInsurers.length} syarikat</summary>
        <div class="space-y-4 my-6">
          {carInsurers.map((company) => (
            <a href={`/companies/${company.slug}/`} class="card-editorial group block">
              <div class="flex items-start gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline flex-wrap gap-2 mb-1">
                    <h3 class="font-semibold text-stone-900 group-hover:text-hijau-700 transition-colors">
                      {company.name}
                    </h3>
                    {company.takaful && (
                      <span class="text-sm font-medium text-emas-700 bg-emas-50 px-2 py-0.5">Takaful</span>
                    )}
                  </div>
                  <p class="text-sm text-stone-600 mb-2">{company.verdictBM}</p>
                  <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-stone-500">
                    {company.claimLine && <span>Claim: {company.claimLine}</span>}
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
        </details>

        <article class="prose-editorial">
          <!-- Istilah penting -->
          <h2 id="istilah" class="mod-bar hub-bar mod-lab">Enam istilah penting, dari sum insured hingga betterment</h2>
        </article>

        <details class="hub-fold my-6">
        <summary>Lihat enam istilah</summary>
        <div class="my-6">
          <dl class="space-y-4">
            <div class="border-b border-stone-100 pb-4">
              <dt class="font-semibold text-stone-900 text-sm">Sum insured (jumlah diinsuranskan)</dt>
              <dd class="text-sm text-stone-600 mt-1">
                Jumlah maksimum yang syarikat insurans akan bayar jika kereta anda total loss.
                Bergantung pada asas polisi: nilai pasaran semasa kereta atau nilai yang dipersetujui (agreed value).
              </dd>
            </div>
            <div class="border-b border-stone-100 pb-4">
              <dt class="font-semibold text-stone-900 text-sm">Excess (ekses)</dt>
              <dd class="text-sm text-stone-600 mt-1">
                Jumlah pertama yang anda tanggung sendiri bagi sesuatu claim.
                Excess wajib tambahan boleh dikenakan jika pemandu tidak dinamakan, berumur bawah 21 tahun atau memegang lesen P atau L; contohnya, wording polisi Allianz menetapkan RM400 bagi keadaan tersebut. Pembelian dalam talian bukan sebab excess ini dikenakan.
              </dd>
            </div>
            <div class="border-b border-stone-100 pb-4">
              <dt class="font-semibold text-stone-900 text-sm">NCD (No Claim Discount)</dt>
              <dd class="text-sm text-stone-600 mt-1">
                Diskaun 25%–55% yang anda dapat kerana tidak membuat claim. Claim yang menjejaskan NCD boleh menyebabkan kadar kembali kepada 0% pada renew; claim OD-KfK yang layak dan claim windscreen di bawah add-on windscreen boleh mengekalkannya.
              </dd>
            </div>
            <div class="border-b border-stone-100 pb-4">
              <dt class="font-semibold text-stone-900 text-sm">Named driver (pemandu dinamakan)</dt>
              <dd class="text-sm text-stone-600 mt-1">
                Pemandu lain yang disenaraikan dalam polisi anda. Pemandu yang mendapat kebenaran pemilik boleh dilindungi
                tertakluk kepada polisi, tetapi excess wajib tambahan boleh dikenakan jika pemandu tidak dinamakan. Semak syarat polisi anda.
              </dd>
            </div>
            <div class="border-b border-stone-100 pb-4">
              <dt class="font-semibold text-stone-900 text-sm">Agreed value vs market value</dt>
              <dd class="text-sm text-stone-600 mt-1">
                Market value = bayaran ikut nilai kereta semasa claim (nilainya susut setiap tahun).
                Agreed value = jumlah tetap yang dipersetujui awal dengan syarikat. Bandingkan premium dan syarat kedua-duanya tanpa menganggap satu kaedah sentiasa lebih mahal.
              </dd>
            </div>
            <div class="pb-4">
              <dt class="font-semibold text-stone-900 text-sm">Betterment charge</dt>
              <dd class="text-sm text-stone-600 mt-1">
                Jika syarikat menggantikan alat ganti baharu pada kereta lama, mereka mungkin mengenakan caj perbezaan
                antara alat ganti baharu dan lama kepada anda. Ini perkara yang perlu dijangka semasa claim.
              </dd>
            </div>
          </dl>
        </div>
        </details>

        <!-- FAQ -->
        <article class="prose-editorial">
          <h2 id="soalan" class="mod-bar hub-bar">Soalan lazim: NCD ikut anda, bukan syarikat</h2>
        </article>

        <div class="my-8">
          <details class="faq-item" open>
            <summary>Kereta masih ada loan, insurans wajib komprehensif ke?</summary>
            <p>
              Dari segi undang-undang ia tidak wajib, tetapi bank atau pembiaya anda biasanya
              <strong>mensyaratkan perlindungan komprehensif</strong> sebagai syarat pinjaman.
              Sehingga pinjaman habis dibayar, anda perlu mengekalkan polisi komprehensif.
            </p>
          </details>

          <details class="faq-item">
            <summary>Boleh ke tukar syarikat insurans masa renew?</summary>
            <p>
              Ya, 100% boleh. NCD ikut anda, bukan syarikat. Boleh pindah ke mana-mana
              syarikat insurans berlesen dan NCD anda ikut sama.
              Ini salah satu sebab anda patut membandingkan harga setiap tahun.
            </p>
          </details>

          <details class="faq-item">
            <summary>Kalau kemalangan bukan salah saya, claim insurans sendiri ke insurans orang lain?</summary>
            <p>
              Kalau polisi anda komprehensif, anda boleh buat claim <strong>Own Damage Knock-for-Knock (OD-KfK)</strong> dengan syarikat insurans anda sendiri.
              PIAM menerangkan bahawa <strong>NCD anda tidak hilang</strong> apabila pihak satu lagi yang cuai dan polis mengesahkan anda tidak bersalah.
              OD-KfK tidak terpakai jika ada kecederaan pihak ketiga, jika kenderaan yang terlibat berdaftar di luar negara dan syarikat insuransnya bukan di Malaysia, atau untuk kenderaan komersial seperti teksi dan kereta sewa.
              Minta syarikat sahkan claim didaftarkan sebagai OD-KfK, bukan own damage biasa, sebelum kereta dibaiki. Simpan semua bukti: gambar, rakaman dashcam dan nombor laporan polis.
              Baca <a href="/guides/how-to-claim/">panduan claim</a> atau
              <a href="https://piam.org.my/insurance-101/individual/motor/" target="_blank" rel="noopener noreferrer">penerangan PIAM</a>.
            </p>
          </details>

          <details class="faq-item">
            <summary>Apa jadi kalau insurans lapse (tamat dan tak renew)?</summary>
            <p>
              Dua masalah besar: (1) Anda memandu tanpa insurans — <strong>tidak sah di sisi undang-undang</strong>.
              Jika ditangkap, denda RM1,000 atau penjara 3 bulan.
              (2) NCD yang tidak digunakan boleh berkurang mengikut skala dan syarat polisi; ia tidak semestinya terus menjadi 0%.
              Jadi, jangan tunggu saat akhir untuk renew.
            </p>
          </details>

          <details class="faq-item">
            <summary>Kereta import/recon, insurans lagi mahal ke?</summary>
            <p>
              Biasanya <strong>lebih mahal</strong> berbanding kereta CBU/CKD yang sama kerana alat ganti kereta recon lebih mahal dan lebih sukar didapati.
              Syarikat insurans mengambil kira risiko ini dalam pengiraan premium. Beza harga bergantung pada syarikat; minta sebut harga.
            </p>
          </details>
        </div>

        <!-- Car Models by Brand -->
        <article class="prose-editorial">
          <h2 id="semua-model" class="mod-bar hub-bar mod-lab">Harga NCD 55% setiap model, ikut jenama</h2>
          <p>
            Mahu tahu harga insurans untuk model kereta anda?
            Pilih model kereta di bawah untuk panduan lengkap — termasuk harga premium,
            penjimatan NCD, add-on untuk dipertimbangkan, dan tips jimat.
          </p>
        </article>

        <details class="hub-fold my-6">
        <summary>Semua model dengan butiran</summary>
        <div class="my-6 space-y-6">
          {brandOrder.filter(brand => brandGroups[brand]).map((brand) => (
            <div>
              <h3 class="font-serif text-headline-sm text-stone-900 mb-3 flex items-center gap-3"><LogoTile brand={brand} />{brand}</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {brandGroups[brand].map((car) => (
                  <a href={`/car-insurance/${car.slug}/`} class="card-editorial group block">
                    <div class="flex justify-between items-center gap-3">
                      <CarThumb slug={car.slug} />
                      <div class="flex-1 min-w-0">
                        <h4 class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700 transition-colors">
                          {car.fullName}
                        </h4>
                        <p class="text-sm text-stone-500 mt-0.5">{car.engineCC} · {car.segment}</p>
                      </div>
                      <span class="text-sm font-semibold text-hijau-700 whitespace-nowrap">{car.premiumNCD55}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>

        </details>

        <div class="info-box mb-8">
          <p class="text-sm text-stone-700">
            <strong>Nota:</strong> Harga di atas ialah anggaran premium komprehensif dengan NCD 55%.
            Harga sebenar bergantung pada umur kereta, lokasi, dan syarikat insurans.
            Klik pada model kereta untuk panduan penuh.
          </p>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-20 space-y-6">
          <!-- Where to buy -->
          <div class="card-editorial">
