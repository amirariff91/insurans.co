---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import states from '../../data/states.json';

export function getStaticPaths() {
  return states.map((state, i) => ({
    params: { state: state.slug },
    props: { state, relatedStates: states.filter((_, j) => j !== i).slice(0, 4) },
  }));
}

const { state, relatedStates } = Astro.props;

const faqItems = [
  {
    question: state.floodHistory.length
      ? `Apakah rekod banjir yang perlu diketahui oleh pemandu di ${state.displayName}?`
      : `Bagaimanakah pemandu di ${state.displayName} menyemak keadaan perjalanan ketika hujan?`,
    answer: state.floodHistory.length
      ? state.floodHistory.map((item: { text: string }) => item.text).join(' ')
      : `Semak amaran cuaca dan keadaan laluan sebelum bergerak. Jika perjalanan melalui kawasan yang dinaiki air, pilih laluan selamat dan pastikan skop perlindungan banjir dinyatakan dalam polisi.`,
  },
  {
    question: `Di manakah pejabat JPJ untuk urusan kenderaan di ${state.displayName}?`,
    answer: state.jpjOffice.text,
  },
  {
    question: `Adakah premium insurans kereta ditetapkan mengikut negeri ${state.displayName}?`,
    answer: `Sejak 1 Julai 2017, harga insurans motor komprehensif dan pihak ketiga, kebakaran serta kecurian (TPFT) ditentukan oleh insurer berdasarkan penilaian risiko masing-masing. Bandingkan sebut harga untuk kenderaan, jumlah diinsuranskan dan manfaat yang sama supaya anda dapat menilai harga serta perlindungan dengan jelas.`,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: `Insurans Kereta ${state.displayName}: Panduan Wilayah dan Perlindungan`,
      description: `Panduan insurans kereta ${state.displayName} dengan rekod banjir, cukai jalan, pejabat JPJ dan sumber semakan.`,
      url: `https://insurans.co/negeri/${state.slug}/`,
      datePublished: state.asAt,
      dateModified: state.asAt,
      inLanguage: 'ms',
      publisher: { '@type': 'Organization', name: 'Insurans.co', url: 'https://insurans.co' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
        { '@type': 'ListItem', position: 2, name: 'Negeri', item: 'https://insurans.co/negeri/' },
        { '@type': 'ListItem', position: 3, name: state.displayName, item: `https://insurans.co/negeri/${state.slug}/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<Base
  title={`Insurans Kereta ${state.displayName}: Panduan Negeri`}
  description={`Panduan insurans kereta ${state.displayName}: rekod banjir, wilayah tarif, cukai jalan, pejabat JPJ dan tip bersumber.`}
  schema={schema}
  ogType="article"
  publishedTime={state.asAt}
  modifiedTime={state.asAt}
>
  <section class="bg-white border-b border-stone-200">
    <div class="container-wide py-10 sm:py-14">
      <nav class="text-sm text-stone-400 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-hijau-700 text-stone-500">Utama</a>
        <span class="mx-2">›</span>
        <a href="/negeri/" class="hover:text-hijau-700 text-stone-500">Negeri</a>
        <span class="mx-2">›</span>
        <span class="text-stone-700">{state.displayName}</span>
      </nav>
      <p class="label mb-3">Panduan Insurans Mengikut Negeri</p>
      <h1 class="font-serif text-headline-lg sm:text-headline-xl text-stone-900 mb-4">
        Insurans Kereta {state.displayName}
      </h1>
      <Byline dateModified={state.asAt} />
      <p class="text-sm text-stone-500 mt-2 mb-4">Maklumat disemak setakat {state.asAt}</p>
      <p class="text-lg text-stone-600 max-w-2xl leading-relaxed">
        Rujukan untuk pemandu {state.displayName}: fakta wilayah, perlindungan yang wajar dibandingkan,
        pejabat JPJ dan pautan kepada sumber asal.
      </p>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
      <div class="lg:col-span-2">
        <div class="bg-stone-50 border border-stone-200 p-6 mb-8">
          <div class="flex flex-wrap gap-4 items-start">
            <div class="flex-1 min-w-0">
              <h2 class="font-serif text-xl text-stone-900 mb-1">{state.name}</h2>
              <p class="text-sm text-stone-500 mb-3">Ibu negeri: {state.capital}</p>
              <p class="text-stone-600 text-sm leading-relaxed">{state.notes}</p>
            </div>
            {state.floodRisk && (
              <div class="flex-shrink-0">
                <span class={`inline-block px-3 py-1.5 text-sm font-semibold border ${
                  state.floodRisk === 'Tinggi' ? 'bg-red-100 text-red-700 border-red-200' :
                  state.floodRisk === 'Sederhana' ? 'bg-yellow-100 text-yellow-700 border-yellow-200' :
                  'bg-green-100 text-green-700 border-green-200'
                }`}>
                  Risiko banjir: {state.floodRisk}
                </span>
              </div>
            )}
          </div>
        </div>

        <article class="prose-editorial">
          <h2>Wilayah tarif &amp; cukai jalan</h2>
          <p>
            Sejak 1 Julai 2017, BNM membenarkan insurer menentukan harga insurans motor komprehensif
            dan pihak ketiga, kebakaran serta kecurian (TPFT) berdasarkan penilaian risiko masing-masing.
            Bandingkan beberapa sebut harga untuk kenderaan dan jumlah diinsuranskan yang sama, kemudian
            teliti manfaat tambahan serta pengecualian.
            Rujuk <a href="https://www.bnm.gov.my/documents/20124/826874/Liberalisation+of+Motor+Insurance+Business.pdf/66a151fc-5dd5-4881-4498-f32bd2273bff" target="_blank" rel="noopener nofollow" class="text-hijau-700 underline">penerangan liberalisasi motor BNM</a>.
          </p>
          {state.slug !== 'labuan' ? (
            <p>
              Bagi {state.displayName}, wilayah tarif yang dirujuk ialah <strong>{state.tariffRegion}</strong>.
              Gunakan sebut harga insurer untuk harga sebenar dan semak skop polisi, bukannya membuat
              anggaran premium daripada nama negeri sahaja.
            </p>
          ) : (
            <p>
              Untuk kereta di Labuan, bandingkan sebut harga insurer secara terus. Asingkan premium
              insurans daripada cukai jalan supaya jumlah perlindungan, manfaat dan kos pembaharuan
              setiap tawaran mudah dibandingkan.
            </p>
          )}
          <p>{state.roadtaxNote}</p>
        </article>

        <article class="prose-editorial mt-10">
          <h2>{state.floodHistory.length ? `Sejarah banjir di ${state.displayName}` : 'Cuaca dan perlindungan banjir'}</h2>
          {state.floodHistory.length > 0 ? (
            <>
              <p>
                Semak lokasi kejadian banjir berikut bersama laluan dan tempat parkir yang anda gunakan.
                Periksa amaran semasa sebelum bergerak serta perlindungan banjir dalam dokumen polisi.
              </p>
              <ul>
                {state.floodHistory.map((item: { text: string; source: string }) => (
                  <li>
                    {item.text}{' '}
                    <a href={item.source} target="_blank" rel="noopener nofollow" class="text-hijau-700 underline">
                      Sumber kejadian
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <p>
              Semak amaran cuaca rasmi dan keadaan laluan sebelum perjalanan. PIAM menerangkan
              bahawa kerosakan banjir memerlukan perlindungan tambahan Special Perils dalam polisi
              motor komprehensif. Periksa bahagian perlindungan tambahan pada jadual polisi dan tanya
              insurer tentang skop tuntutan, termasuk kereta yang diletakkan di tempat parkir.
              Rujuk <a href="https://piam.org.my/news-media/stay-ahead/articles/page/Stronger-Storms-Ahead-How-Malaysians-Can-Prepare-for-the-Monsoon" target="_blank" rel="noopener nofollow" class="text-hijau-700 underline">panduan banjir PIAM</a>.
            </p>
          )}
        </article>

        {state.roadSafety && (
          <article class="prose-editorial mt-10">
            <h2>Keselamatan jalan raya</h2>
            <p>
              {state.roadSafety.text}{' '}
              <a href={state.roadSafety.source} target="_blank" rel="noopener nofollow" class="text-hijau-700 underline">
                Lihat laporan PDRM/JSPT
              </a>
            </p>
            <p>
              Angka tahunan ialah rekod kes seluruh wilayah, bukan kadar risiko bagi seseorang
              pemandu atau ramalan tuntutan individu. Gunakannya sebagai konteks semasa menyemak
              perjalanan dan manfaat polisi.
            </p>
          </article>
        )}

        <article class="prose-editorial mt-10">
          <h2>Pejabat JPJ di {state.displayName}</h2>
          <p>
            {state.jpjOffice.text}{' '}
            <a href={state.jpjOffice.source} target="_blank" rel="noopener nofollow" class="text-hijau-700 underline">
              Semak maklumat JPJ
            </a>
          </p>
          <p>
            Semak waktu kaunter, kaedah bayaran dan jenis urusan sebelum hadir. Jika anda perlu
            menyelesaikan beberapa urusan dalam satu lawatan, hubungi cawangan terlebih dahulu
            dan sediakan dokumen yang diminta untuk setiap urusan.
          </p>
        </article>

        {state.crossBorder && (
          <article class="prose-editorial mt-10">
            <h2>Merentas sempadan dari {state.displayName}</h2>
            <p>
              {state.crossBorder.text}{' '}
              <a href={state.crossBorder.source} target="_blank" rel="noopener nofollow" class="text-hijau-700 underline">
                Semak panduan perjalanan
              </a>
            </p>
            <p>
              Keperluan kemasukan dan perlindungan ialah dua perkara berasingan: pastikan insurer
              mengesahkan wilayah serta tempoh polisi, kemudian sediakan dokumen sempadan yang
              dinyatakan oleh pihak berkuasa negara destinasi.
            </p>
          </article>
        )}

        <article class="prose-editorial mt-10">
          <h2>Tip khusus {state.displayName}</h2>
          <p>
            Bandingkan perlindungan dengan mengambil kira perjalanan harian, tempat parkir dan urusan
            kenderaan anda. Semak jadual manfaat serta pengecualian, kemudian minta penjelasan bertulis
            daripada insurer untuk manfaat yang penting kepada anda.
          </p>
          <ol>
            {state.tips.map((tip: { text: string; source?: string }) => (
              <li>
                {tip.text}
                {tip.source && (
                  <>
                    {' '}
                    <a href={tip.source} target="_blank" rel="noopener nofollow" class="text-hijau-700 underline">
                      Rujukan
                    </a>
                  </>
                )}
              </li>
            ))}
          </ol>
        </article>

        <article class="prose-editorial mt-10">
          <h2>Soalan lazim — insurans kereta {state.displayName}</h2>
        </article>
        <div class="my-6">
          {faqItems.map((faq, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>

        <article class="prose-editorial mt-10">
          <h2>Sumber</h2>
          <p>Fakta dan alamat di halaman ini disemak setakat {state.asAt}. Rujuk dokumen asal untuk konteks penuh.</p>
          <ul>
            {state.sources.map((source: { title: string; url: string }) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener nofollow" class="text-hijau-700 underline">
                  {source.title}
                </a>
              </li>
            ))}
          </ul>
        </article>
      </div>

      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-20 space-y-6">
          <div class="bg-white border-2 border-stone-900 p-5">
            <h2 class="font-serif text-lg text-stone-900 mb-3">{state.displayName}</h2>
            <dl class="space-y-3 text-sm">
              <div>
                <dt class="text-stone-500">Ibu negeri</dt>
                <dd class="font-semibold text-stone-900">{state.capital}</dd>
              </div>
              {state.floodRisk && (
                <div>
                  <dt class="text-stone-500">Risiko banjir</dt>
                  <dd class="font-semibold text-stone-900">{state.floodRisk}</dd>
                </div>
              )}
              {state.slug !== 'labuan' && (
                <div>
                  <dt class="text-stone-500">Wilayah tarif</dt>
                  <dd class="font-semibold text-stone-900">{state.tariffRegion}</dd>
                </div>
              )}
            </dl>
          </div>

          {relatedStates.length > 0 && (
            <div class="card-editorial">
              <h2 class="font-semibold text-sm text-stone-900 mb-3">Panduan negeri lain</h2>
              <ul class="space-y-2 text-sm">
                {relatedStates.map((s: any) => (
                  <li>
                    <a href={`/negeri/${s.slug}/`} class="text-hijau-700 hover:text-hijau-600 font-medium">
                      {s.displayName}
                    </a>
                    <span class="text-xs ml-2 text-stone-500">Risiko banjir: {s.floodRisk}</span>
                  </li>
                ))}
              </ul>
              <a href="/negeri/" class="block mt-4 text-xs text-stone-500 hover:text-hijau-700 font-medium">
                Semua negeri
              </a>
            </div>
          )}

          <div class="card-editorial">
            <h2 class="font-semibold text-sm text-stone-900 mb-3">Baca juga</h2>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/guides/insurans-kereta-banjir/" class="text-hijau-700 hover:text-hijau-600">Insurans kereta banjir</a></li>
              <li><a href="/car-insurance/" class="text-hijau-700 hover:text-hijau-600">Panduan insurans kereta</a></li>
              <li><a href="/companies/" class="text-hijau-700 hover:text-hijau-600">Direktori syarikat insurans</a></li>
              <li><a href="/guides/ncd-explained/" class="text-hijau-700 hover:text-hijau-600">NCD — panduan lengkap</a></li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>
