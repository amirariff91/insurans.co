---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Byline from '../../../components/Byline.astro';
import EditorialStamp from '../../../components/EditorialStamp.astro';
import Hero from '../../../components/Hero.astro';
import PageAnswer from '../../../components/edisi/PageAnswer.astro';
import { buildDescription, buildTitle } from '../../../lib/seo';

const asAt = '2026-09-12';
const pageTitle = '36 Penyakit Kritikal BNM: Apa Yang Standard Cover?';
const title = buildTitle(pageTitle);
const description = buildDescription(
  'Apa sebenarnya 36 penyakit kritikal standard BNM cover — dan apa yang tak? Panduan literasi kewangan: rider vs standalone vs early-stage, dalam BM.',
);
const h1 = '36 Penyakit Kritikal: Apa Standard BNM Sebenarnya Cover?';
const canonicalUrl = 'https://insurans.co/literasi-kewangan/36-penyakit-kritikal-bnm/';
const sources = [
  { label: 'MSIG — standardisasi definisi CI', url: 'https://www.msig.com.my/highlights/standardization-of-critical-illness-definitions/' },
  { label: 'Senarai kondisi AIA', url: 'https://www.aia.com.my/content/dam/my/en/docs/our-products/36_Critical_Illnesses_Listing.pdf' },
];

const faqs = [
  {
    q: '36 penyakit — siapa tetapkan senarai ini?',
    a: 'Bank Negara Malaysia: definisi diseragamkan untuk polisi baharu atau diperbaharui berkuat kuasa 1 April 2016. Senarai verbatim dalam data kami diambil daripada PDF rasmi AIA; komposisi tepat boleh berbeza sedikit ikut penginsurans atau sijil.',
  },
  {
    q: 'Kanser peringkat awal dilindungi tak?',
    a: 'Ikut wording standard 36 — kanser sangat awal (very early) dikecualikan; syaratnya ialah “tahap tertentu”. Jika mahu perlindungan peringkat awal, cari plan dengan early-stage benefit yang jelas peratusnya (contoh 50% seperti Zurich) — jangan anggap standard 36 membayar pada peringkat awal.',
  },
  {
    q: 'SOCSO dah cover penyakit kritikal kan?',
    a: 'Tidak sama. Skim Keilatan PERKESO berasaskan pekerjaan — hilang upaya kekal hingga tidak mampu menjana 1/3 pendapatan biasa, dan faedahnya berbentuk pencen atau elaun bulanan, bukan bayaran sekali gus (lump sum). CI swasta atau takaful membayar sekali gus apabila didiagnos. Dua perkara berbeza yang boleh saling melengkapi.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: asAt,
  dateModified: asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Literasi Kewangan', item: 'https://insurans.co/literasi-kewangan/' },
      { '@type': 'ListItem', position: 3, name: h1, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={asAt}
  modifiedTime={asAt}
  ads={true}
>
  <Hero title={h1}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Literasi Kewangan', href: '/literasi-kewangan/' },
        { label: h1 },
      ]}
    />
    <Byline slot="byline" dateModified={asAt} />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      Standard BNM ialah 36 definisi penyakit kritikal peringkat teruk (severe-stage), bukan janji bahawa semua diagnosis awal
      akan dibayar. Rider, standalone dan early-stage mempunyai kesan berbeza.
    </p>
    <PageAnswer
      slot="answer"
      finding="Standard BNM: 36 definisi penyakit kritikal"
      facts={[
        { label: 'Standard BNM', value: '36 definisi penyakit kritikal' },
        { label: 'Definisi seragam BNM berkuat kuasa', value: '1 April 2016', role: 'term' },
        { label: 'Baca', value: 'wording, peratus payout dan baki sum assured' },
      ]}
    />
    <div class="mt-4 mr-2">
      <EditorialStamp articleDate={asAt} sources={sources} sourcesLabel="Rujukan" showReviewed={false} />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <article class="prose-editorial prose-bars">
      <p class="text-lg leading-7 text-stone-700">
        Bank Negara Malaysia mewajibkan semua penginsurans guna <strong>definisi seragam untuk 36 penyakit kritikal</strong>
        bagi polisi baharu atau diperbaharui berkuat kuasa <strong>1 April 2016</strong>. Set ini ialah standard rujukan
        peringkat teruk (severe-stage), bukan senarai yang automatik membayar semua diagnosis awal.
      </p>
      <p class="note-plain text-sm leading-6">
        <strong>Kami bukan ejen, bukan broker — maklumat am sahaja.</strong> Jangan bergantung pada angka besar di brosur; minta
        senarai dan definisi dalam PDS.
      </p>

      <h2 id="fakta">Fakta asas: standard sejak 1 April 2016</h2>
      <p>
        Tujuannya: definisi “kanser”, “strok” dan “serangan jantung” sama walau beli daripada syarikat mana — syarikat tidak boleh bersembunyi di
        sebalik takrifan pelik. Set 36 ini semuanya <strong>peringkat teruk (severe-stage)</strong> — syaratnya ketat. Contoh:
        kanser mesti tahap tertentu; kanser sangat awal (very early) tidak dilindungi ikut wording standard. Contoh lain dalam
        senarai: strok, serangan jantung, pembedahan pintasan arteri koronari, kegagalan buah pinggang, koma, lumpuh anggota,
        penyakit Alzheimer atau demensia teruk. Senarai penuh 36 dalam BM dan BI ada di halaman senarai kami.
      </p>
      <p>
        Nota jujur: komposisi tepat boleh berbeza sedikit ikut penginsurans — contoh appendix Hong Leong MSIG Takaful
        menggantikan item tertentu dengan Full-blown AIDS dan SLE dengan komplikasi buah pinggang teruk. Nombor besar seperti
        “180 kondisi” (contoh AIA) ialah pengembangan bagi setiap produk, bukan standard 36.
      </p>

      <h2 id="struktur">Rider vs standalone: dua cara beli, dua kesan</h2>
      <ul>
        <li>
          <strong>Rider (tumpangan)</strong> — menempel pada polisi asas; bayaran “accelerated” ditolak daripada sum assured polisi
          asas. Contoh disahkan: Prudential Crisis Cover Benefit — rider pada pelan asas seperti PRUCash, membayar pendahuluan daripada
          coverage pelan asas apabila didiagnos salah satu daripada 36 CI. Great Eastern SMART Early Payout CriticalCare — rider
          unit-deduction pada pelan investment-linked, mesti dilekatkan dengan IL Critical Illness Benefit Rider. Rider mungkin
          sesuai jika sudah ada polisi asas, tetapi claim mengecilkan polisi induk.
        </li>
        <li>
          <strong>Standalone (sendiri)</strong> — polisi berasingan, tidak menjejaskan polisi lain. Contoh disahkan: Etiqa Critical Care
          Plus — 42 kondisi, early cash payout, cancer care benefit, tanpa pemeriksaan perubatan. Caruman berasingan.
        </li>
        <li>
          <strong>Skim (bukan produk)</strong> — mySalam, skim percuma untuk penerima STR (RM8,000 sekali bayar + RM50/hari di hospital,
          maksimum 14 hari setahun). Bukan pengganti CI swasta, tetapi perlindungan asas yang tidak perlu dibeli semula.
        </li>
      </ul>

      <h2 id="early-stage">Early-stage: bayar awal, jumlah separa</h2>
      <p>
        Standard 36 membayar apabila penyakit sudah teruk. <strong>Early-stage benefit</strong> membayar lebih awal tetapi jumlahnya separa, dan
        mengurangkan sum assured — bakinya kekal untuk claim peringkat akhir. Contoh kerja yang disahkan (Zurich Early Care):
        carcinoma-in-situ bayar <strong>50% rider sum assured</strong> (tambah faedah pemulihan 12% keseluruhan, iaitu 1% sebulan selama 12 bulan, + RM2,000
        pendapat perubatan kedua); kegagalan buah pinggang peringkat akhir kemudian membayar 100% daripada baki 50%. Dalam plan itu, peringkat
        awal dilindungi hingga umur 85, peringkat akhir hingga 100.
      </p>
      <p>
        Soalan yang betul sebelum membeli bukan “cover berapa penyakit?” tetapi: <strong>“bayar pada tahap mana, berapa peratus, dan
        baki tinggal berapa?”</strong>
      </p>

      <h2 id="semak">Tiga soalan sebelum menandatangani</h2>
      <ol>
        <li>Produk ini rider atau standalone? Kalau rider — polisi asas apa, dan claim ditolak daripada mana?</li>
        <li>Early-stage termasuk atau severe-stage sahaja? Kalau termasuk — peratus dan umur tamat?</li>
        <li>Definisi ikut standard BNM 2016? Minta ditunjukkan senarai 36 dalam PDS, bukan brosur.</li>
      </ol>
      <p>
        Standard BNM melindungi anda daripada definisi tersembunyi — gunakan kelebihan itu. Baca <a href="/critical-illness/senarai-penyakit-kritikal/">senarai penuh</a>, fahami syarat “peringkat teruk”, kemudian barulah putuskan rider atau standalone.
      </p>
    </article>

    <nav class="mt-8 border-t border-stone-200 pt-6" aria-label="Bacaan berkaitan">
      <p class="text-sm text-stone-500">Baca juga:</p>
      <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
        <li><a href="/critical-illness/senarai-penyakit-kritikal/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Senarai penuh 36 dalam BM dan BI</a></li>
        <li><a href="/critical-illness/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Banding plan CI sebenar</a></li>
        <li><a href="/life-insurance/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">CI lump sum berbanding medical</a></li>
        <li><a href="/insurans-online/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">Beli CI terus online</a></li>
        <li><a href="/guides/insurance-vs-takaful/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">CI takaful dan akad</a></li>
      </ul>
    </nav>

    <section id="faq" class="mt-10 sm:mt-14">
      <div class="prose-editorial prose-bars">
        <h2>Soalan lazim 36 penyakit kritikal</h2>
      </div>
      <div class="mt-5">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
