---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Ikon from '../../components/Ikon.astro';
import states from '../../data/states.json';

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Panduan Insurans Kereta Mengikut Negeri di Malaysia",
  "description": "Panduan insurans kereta mengikut negeri di Malaysia — risiko banjir, syarikat disyorkan, dan tips khusus untuk setiap negeri.",
  "url": "https://insurans.co/negeri/",
  "inLanguage": "ms",
  "publisher": { "@type": "Organization", "name": "Insurans.co", "url": "https://insurans.co" },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
      { "@type": "ListItem", "position": 2, "name": "Negeri", "item": "https://insurans.co/negeri/" }
    ]
  }
};

const riskColor: Record<string, string> = {
  'Tinggi': 'risk-tinggi',
  'Sederhana': 'risk-sederhana',
  'Rendah': 'risk-rendah',
};
---

<Base
  title="Panduan Insurans Kereta Mengikut Negeri di Malaysia — Insurans.co"
  description="Cari panduan insurans kereta mengikut negeri di Malaysia. Risiko banjir, syarikat disyorkan, dan tips khusus untuk Selangor, KL, Johor, Kelantan dan semua negeri."
  schema={schema}

>
  <!-- Breadcrumb + Header -->
  <section class="bg-white">
    <div class="container-wide pt-6 pb-4 sm:pt-8">
      <Breadcrumbs items={[{ label: 'Utama', href: '/' }, { label: 'Negeri' }]} />
      <h1 class="ea-h1 mb-3">
        Panduan Insurans Kereta Mengikut Negeri di Malaysia
      </h1>
    <section class="mod my-4" aria-labelledby="fakta-negeri" data-section="page-answer">
      <h2 id="fakta-negeri" class="mod-bar">Fakta insurans kereta mengikut negeri</h2>
      <p class="text-stone-700 leading-relaxed max-w-2xl px-4 pt-3 pb-2">
        Rekod banjir, pejabat JPJ dan wilayah tarif bagi setiap negeri, daripada halaman negeri masing-masing.
        Wilayah tarif ialah Semenanjung atau Sabah/Sarawak; premium sebenar ditentukan oleh insurer.
      </p>
      <div class="overflow-x-auto px-4 pb-2" tabindex="0" role="region" aria-labelledby="fakta-negeri">
        <table class="w-full text-sm text-left border-collapse min-w-[48rem]">
          <thead>
            <tr class="border-b border-stone-300 text-stone-700">
              <th scope="col" class="py-2 pr-4 font-semibold">Negeri</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Risiko banjir</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Rekod banjir</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Pejabat JPJ</th>
              <th scope="col" class="py-2 font-semibold">Wilayah tarif</th>
            </tr>
          </thead>
          <tbody>
            {states.map((state) => (
              <tr class="border-b border-stone-200 align-top text-stone-700">
                <th scope="row" class="py-3 pr-4 font-medium text-stone-900">
                  <a href={`/negeri/${state.slug}/`} class="underline decoration-stone-300 underline-offset-2 hover:text-hijau-700">{state.displayName}</a>
                </th>
                <td class="py-3 pr-4 whitespace-nowrap">{state.floodRisk || '—'}</td>
                <td class="py-3 pr-4 leading-relaxed">
                  {state.floodHistory.length ? (
                    <>
                      {state.floodHistory[0].text}{' '}
                      <a href={state.floodHistory[0].source} target="_blank" rel="noopener nofollow" class="text-hijau-700 underline">Sumber</a>
                    </>
                  ) : '—'}
                </td>
                <td class="py-3 pr-4 leading-relaxed">
                  {state.jpjOffice.text}{' '}
                  <a href={state.jpjOffice.source} target="_blank" rel="noopener nofollow" class="text-hijau-700 underline">Sumber</a>
                </td>
                <td class="py-3 whitespace-nowrap">{state.tariffRegion}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

      <Byline />
      <p class="text-lg text-stone-700 max-w-2xl leading-relaxed">
        Tiada satu kadar premium tetap bagi setiap negeri. Premium semasa boleh mengambil kira lokasi kenderaan
        dan penilaian risiko syarikat insurans. Yang jelas berbeza antara negeri ialah risiko setempat seperti banjir, serta
        pejabat JPJ untuk urusan kenderaan. Jadual di atas meringkaskan fakta setiap negeri.
      </p>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <!-- Risk Legend -->
    <div class="flex flex-wrap gap-3 mb-8 text-sm">
      <span class="text-stone-500">Risiko Banjir:</span>
      <span class="risk-tinggi px-3 py-1 font-medium">Tinggi</span>
      <span class="risk-sederhana px-3 py-1 font-medium">Sederhana</span>
      <span class="risk-rendah px-3 py-1 font-medium">Rendah</span>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {states.map(state => (
        <a
          href={`/negeri/${state.slug}/`}
          class="card-editorial group block"
        >
          <div class="flex items-start justify-between mb-2">
            <h2 class="font-semibold text-stone-900 group-hover:text-hijau-700 transition-colors text-base">
              {state.displayName}
            </h2>
            {state.floodRisk ? (
              <span class={`text-xs font-medium px-2 py-0.5 ml-2 flex-shrink-0 ${riskColor[state.floodRisk] ?? 'bg-stone-100 text-stone-600'}`}>
                {state.floodRisk}
              </span>
            ) : (
              <span class="text-xs font-medium px-2 py-0.5 ml-2 flex-shrink-0 bg-stone-100 text-stone-500" title="Tiada label risiko banjir dalam data kami">—</span>
            )}
          </div>
          <p class="text-sm text-stone-700 mb-3">Ibu negeri: {state.capital}</p>
          <p class="text-sm text-stone-700 leading-relaxed line-clamp-2">{state.notes}</p>
          <p class="text-sm text-hijau-700 font-medium mt-3 group-hover:underline">Lihat panduan <Ikon name="i-kanan" size={16} class="inline" /></p>
        </a>
      ))}
    </div>

    <div class="mt-12 border-t border-stone-200 pt-10">
      <h2 class="font-serif text-2xl text-stone-900 mb-4">Kenapa lokasi penting untuk insurans kereta?</h2>
      <p class="text-stone-600 leading-relaxed max-w-2xl mb-4">
        Tiada satu kadar premium tetap bagi setiap negeri. Tarif motor lama berbeza mengikut wilayah (Semenanjung
        berbanding Sabah/Sarawak), dan sejak 1 Julai 2017 insurer menetapkan harga berdasarkan penilaian risiko
        masing-masing, yang boleh mengambil kira lokasi kenderaan. Yang patut anda nilai mengikut lokasi ialah skop perlindungan:
        pemilik kereta di negeri dengan rekod banjir seperti Kelantan, Terengganu dan Selangor (kawasan Klang)
        wajar mempertimbangkan <strong>special perils add-on</strong> untuk kerosakan banjir.
      </p>
      <p class="text-stone-600 leading-relaxed max-w-2xl">
        Kawasan bandar besar seperti KL dan Selangor juga ada risiko kemalangan lebih tinggi kerana kepadatan trafik.
        Pilih syarikat dengan panel bengkel yang luas di kawasan anda.
      </p>
    </div>
  </div>
</Base>
