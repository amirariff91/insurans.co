---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LogoTile from '../../components/LogoTile.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Ikon from '../../components/Ikon.astro';
import ModelAnswer from '../../components/edisi/ModelAnswer.astro';
import ModelRail from '../../components/edisi/ModelRail.astro';
import ToolsRail from '../../components/edisi/ToolsRail.astro';
import TerkiniRail from '../../components/edisi/TerkiniRail.astro';
import '../../styles/edisi-answer.css';
import NcdLadder from '../../components/NcdLadder.astro';
import carModels from '../../data/car-models.json';
import companies from '../../data/companies.json';
import { monthly, rm } from '../../lib/ncd';
import { modelPhotoPreload } from '../../components/edisi/photo';
import Dock from '../../components/edisi/Dock.astro';
import { rmRange, specialPerilsRange } from '../../components/edisi/steps';

export function getStaticPaths() {
  return carModels.map((car) => ({
    params: { model: car.slug },
    props: { car },
  }));
}

// Ads opt-in (Base defaults to ads off). Generated from the programmatic audit on 2026-11-15:
// a model is listed only if it has at least 700 words in <main> and a 5-gram Jaccard below 0.35
// against every sibling. Re-checked on the final build: perodua-alza (0.355), bmw-3-series and mercedes-c-class (0.351) are over the limit and left out. Re-run scripts/ads-gate-audit.py (word-token 5-grams on <main> text)
// on a fresh build before adding a model.
const adsEnabledSlugs = new Set([
  'bmw-x1',
  'honda-brv',
  'honda-civic',
  'honda-crv',
  'honda-hrv',
  'hyundai-elantra',
  'mazda-2',
  'mazda-3',
  'mazda-cx5',
  'mercedes-glb',
  'nissan-almera',
  'perodua-ativa',
  'perodua-axia',
  'perodua-bezza',
  'perodua-myvi',
  'proton-iriz',
  'proton-persona',
  'proton-saga',
  'proton-x50',
  'proton-x70',
  'suzuki-swift',
  'toyota-corolla',
  'toyota-corolla-cross',
  'toyota-raize',
  'toyota-vios',
  'toyota-yaris',
]);
const { car } = Astro.props;
const model = car as any;
const passesUniqueness = adsEnabledSlugs.has(model.slug);
const isEnriched = model.enriched === true;
const carInsurers = companies.filter((company) => company.products.includes('car')).slice(0, 5);
const relatedCars = model.relatedModels
  .map((slug: string) => carModels.find((candidate) => candidate.slug === slug))
  .filter(Boolean)
  .slice(0, 4);
const initialArticleDate = '2026-02-14';
// Last content revision across all model pages (no-"wajib" verdicts, special-perils estimate).
const contentRevised = '2026-11-15';
const articleDate = [initialArticleDate, model.premiumReviewed, contentRevised].filter(Boolean).sort().at(-1);
// Market value through the one range format (RM22,000–38,000); the raw marketValueRange string only when min/max are missing.
const marketValueText = Number.isFinite(model.marketValueMin) && Number.isFinite(model.marketValueMax)
  ? rmRange(model.marketValueMin, model.marketValueMax)
  : model.marketValueRange;
const specialPerils = specialPerilsRange(model);
const specialPerilsEstimate = specialPerils ? ` untuk sum insured ${marketValueText}: sekitar ${specialPerils} setahun, sebelum cukai` : '';
const hasPremiumRange = Number.isFinite(model.premiumNCD55Min) && Number.isFinite(model.premiumNCD55Max);
const hasRoadtax = Number.isFinite(model.roadtaxMin) && Number.isFinite(model.roadtaxMax);
// JPJ roadtax can carry sen (e.g. RM754.40); show it exactly so the row matches the roadtax note.
const rmExact = (n: number) => {
  const hasSen = Math.round(n * 100) % 100 !== 0;
  return `RM\u00a0${n.toLocaleString('ms-MY', { minimumFractionDigits: hasSen ? 2 : 0, maximumFractionDigits: 2 })}`;
};

// Search snippet: insurance + roadtax = yearly total at NCD 55%, with the same figures and rounding as the
// "Kos tahunan anggaran" box below. Compact form for the head tags: "RM350–690"; one value when min = max.
const searchName: string = model.searchName ?? model.fullName;
const compactRange = (min: number, max: number, format: (n: number) => string) => {
  const a = format(min).replace(/^RM\s/, '');
  const b = format(max).replace(/^RM\s/, '');
  return a === b ? `RM${a}` : `RM${a}–${b}`;
};
const insuranceText = hasPremiumRange ? compactRange(model.premiumNCD55Min, model.premiumNCD55Max, rm) : '';
const roadtaxText = hasRoadtax ? compactRange(model.roadtaxMin, model.roadtaxMax, rmExact) : '';
const totalText = hasPremiumRange && hasRoadtax
  ? compactRange(model.premiumNCD55Min + model.roadtaxMin, model.premiumNCD55Max + model.roadtaxMax, rm)
  : '';
// Engine sizes in the form people type them: "1.0", "1.3 & 1.5", "1.4, 1.5 & 1.6".
const engineSizes = [...new Set<string>(model.engineCC.match(/\d\.\d(?=\s*L)/g) ?? [])]
  .sort((a, b) => Number(a) - Number(b));
const engineText = engineSizes.length > 1
  ? `${engineSizes.slice(0, -1).join(', ')} & ${engineSizes.at(-1)}`
  : (engineSizes[0] ?? '');
const nameWithEngine = engineText ? `${searchName} ${engineText}` : searchName;

// Roadtax with sen (e.g. RM754.40) makes the whole-ringgit total an approximation: show "≈", not "=".
const roadtaxHasSen = [model.roadtaxMin, model.roadtaxMax].some((n: number) => Number.isFinite(n) && Math.round(n * 100) % 100 !== 0);
const totalSign = roadtaxHasSen ? '≈' : '=';
// A shorter name for the title only (e.g. "Mercedes C-Class"); the H1 and description keep the full name.
const titleName: string = model.titleName ?? searchName;

// Title within 60 characters, no site suffix. Every form keeps "Anggaran": full form, then without the year,
// then the short title name with and without the year.
const titleCandidates = totalText
  ? [
      `Insurans & Roadtax ${searchName} 2026: Anggaran ${totalText}`,
      `Insurans & Roadtax ${searchName}: Anggaran ${totalText}`,
      `Insurans & Roadtax ${titleName} 2026: Anggaran ${totalText}`,
      `Insurans & Roadtax ${titleName}: Anggaran ${totalText}`,
    ]
  : [];
const pageTitle = titleCandidates.find((t) => t.length <= 60)
  ?? titleCandidates.at(-1)
  ?? `Harga Insurans ${searchName} 2026: Anggaran Ikut NCD`;
// Roadtax and the total use Peninsular (Semenanjung) JPJ rates; say so whenever it fits.
const descriptionSums = `insurans ${insuranceText} + roadtax ${roadtaxText} ${totalSign} ${totalText}`;
const descriptionCandidates = totalText
  ? [
      `Insurance price & roadtax ${nameWithEngine} (anggaran, Semenanjung): ${descriptionSums} setahun pada NCD 55%. Semak ikut NCD 0–55%.`,
      `Insurance price & roadtax ${nameWithEngine} (anggaran, Semenanjung): ${descriptionSums} setahun pada NCD 55%.`,
      `Insurance price & roadtax ${nameWithEngine} (anggaran, Semenanjung): ${descriptionSums}/tahun, NCD 55%.`,
      `Insurance price & roadtax ${nameWithEngine} (anggaran): ${descriptionSums}/tahun, NCD 55%.`,
    ]
  : [];
const description = descriptionCandidates.find((d) => d.length <= 155)
  ?? descriptionCandidates.at(-1)
  ?? `${model.fullName}: anggaran premium ikut NCD 0–55%, add-on yang penting dan cara renew insurans kereta. Banding syarikat dan perlindungan sebelum bayar.`;
const initialMonthly = monthly(model.premiumNCD55Min, model.premiumNCD55Max);
const zeroMonthly = monthly(model.premiumNCD0Min, model.premiumNCD0Max);
// Bold only the price range of the windscreen string; the variant note after it stays plain.
const windscreenMatch = typeof model.windscreenPrice === 'string' ? model.windscreenPrice.match(/^(RM[\d,]+–RM[\d,]+)(.*)$/) : null;
const windscreenRange = windscreenMatch ? windscreenMatch[1] : model.windscreenPrice;
const windscreenRest = windscreenMatch ? windscreenMatch[2] : '';
const modelYearNotes = isEnriched && Array.isArray(model.modelYearNotes) ? model.modelYearNotes : [];
const addOnsDetail = isEnriched && Array.isArray(model.addOnsDetail) ? model.addOnsDetail : [];
// Published add-on rates, shared by every model page and linked from the note in #addons (#nota-addon).
// Not added to the EditorialStamp: a second copy of the labels raises sibling overlap for the ads gate.
// Read 2026-11-15. Zurich PDS p3 (rate table); HSBC PDS p2 (premium example, RM150 on a RM1,000 windscreen, RM102 on RM51,000).
const addOnRateSources = {
  zurich: 'https://www.zurich.com.my/-/media-assets/project/zurich-headless/malaysia/docs/insurance-products/product-disclosure-sheets/zgimb-z-driver-pds-bm.pdf',
  hsbc: 'https://hsbc.com.my/content/dam/hsbc/my/docs/motor-insurance-pds.pdf',
};
const modelFaqs = isEnriched && Array.isArray(model.modelFAQs) ? model.modelFAQs : [];
const faqSchemaItems = modelFaqs.length > 0
  ? modelFaqs.map((faq: any) => ({ question: faq.q, answer: faq.a }))
  : [];

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": description,
  "url": `https://insurans.co/car-insurance/${model.slug}/`,
  "datePublished": "2026-02-01",
  "dateModified": articleDate,
  "inLanguage": "ms",
  "publisher": {
    "@type": "Organization",
    "name": "Insurans.co",
    "url": "https://insurans.co"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
      { "@type": "ListItem", "position": 2, "name": "Insurans Kereta", "item": "https://insurans.co/car-insurance/" },
      { "@type": "ListItem", "position": 3, "name": model.fullName, "item": `https://insurans.co/car-insurance/${model.slug}/` }
    ]
  }
};

// No ?ncd= in the HTML: edisi-ncd.ts adds the chosen step, so a link without JavaScript is never on the wrong step.
const primaryCalculatorUrl = `/tools/ncd-calculator/?model=${model.slug}`;
---

<Base
  title={pageTitle}
  description={description}
  schema={schema}
  ogType="article"
  publishedTime="2026-02-01"
  modifiedTime={articleDate}
  ogImage={`/og/car-insurance/${model.slug}.png`}
  ogImageAlt={`Insurans ${model.fullName}: NCD 55% ${rm(model.premiumNCD55Min)}–${rm(model.premiumNCD55Max)} setahun; tanpa NCD ${rm(model.premiumNCD0Min)}–${rm(model.premiumNCD0Max)}.`}
  siteSuffix={false}
  ads={passesUniqueness}
  preloadImage={modelPhotoPreload(model.slug)}
>
  <div class="ep">
    <div class="ep-main">
      <div class="ep-crumbs">
        <div class="ep-crumb-row">
        <Breadcrumbs
          items={[
            { label: 'Utama', href: '/' },
            { label: 'Insurans Kereta', href: '/car-insurance/' },
            { label: model.fullName },
          ]}
        />
        <LogoTile brand={model.brand} eager />
        </div>
        <Byline dateModified={articleDate} />
        <div class="mt-4">
          <EditorialStamp
            articleDate={schema.dateModified}
            premiumReviewed={model.premiumReviewed}
            sources={model.sources}
          />
        </div>
      </div>
      <ModelAnswer model={model} h1={`Harga insurans & roadtax ${searchName} 2026`} nameWithEngine={nameWithEngine} totalSign={totalSign} calculatorUrl={primaryCalculatorUrl} />

      <!-- Apa yang termasuk? -->
      <section class="mod" aria-labelledby="harga">
        <h2 class="mod-bar" id="harga">Apa yang termasuk dalam anggaran komprehensif {model.model}</h2>
        <div class="mod-in">
          <p class="ix-s">{model.description}</p>
          <h3 class="rows-h">Biasanya dilindungi</h3>
          <ul class="rows">
            <li><div><b>Kerosakan kereta sendiri</b></div></li>
            <li><div><b>Liabiliti pihak ketiga</b></div></li>
            <li><div><b>Kecurian</b><p>Semak had, pengecualian dan syarat perlindungan kecurian dalam polisi anda.</p></div></li>
            <li><div><b>Kebakaran</b></div></li>
          </ul>
          <p class="ix-s">Butiran sebenar bergantung pada polisi dan syarikat.</p>
          <h3 class="rows-h">Kena tambah, setahun (anggaran)</h3>
          <ul class="rows">
            <li id="nota-banjir"><div><b>Banjir (special perils)</b><p>{model.floodRiskNote || model.riskProfile.notes}{specialPerilsEstimate && <> Anggaran{specialPerilsEstimate}.</>}</p></div></li>
          </ul>
          {model.windscreenPrice && (
            <>
            <h3 class="rows-h">Kos gantian cermin</h3>
            <ul class="rows">
              <li><div><b>Cermin depan</b><p>Anggaran <strong>{windscreenRange}</strong>{windscreenRest}. Sahkan harga dan keperluan penentukuran (calibration) dengan bengkel panel sebelum memilih windscreen cover.</p></div></li>
            </ul>
            </>
          )}
        </div>
      </section>

      <!-- Butiran model -->
      <section class="mod" aria-labelledby="butiran">
        <h2 class="mod-bar" id="butiran">Nilai pasaran {model.fullName} dianggarkan {marketValueText}</h2>
        <div class="mod-in">
          <dl class="facts">
            <div><dt>Enjin / kapasiti</dt><dd>{model.engineCC}</dd></div>
            <div><dt>Varian</dt><dd>{model.variants.join(', ')}</dd></div>
            <div><dt>Tahun model</dt><dd>{model.yearRange}</dd></div>
            <div><dt>Segmen</dt><dd>{model.segment}</dd></div>
            <div><dt>Nilai pasaran</dt><dd>{marketValueText}</dd></div>
          </dl>
          <details class="baca">
            <summary><Ikon name="i-bawah" size={20} class="baca-i" /><span>Baca penuh: cara harga dianggar{modelYearNotes.length > 0 && ' & nota mengikut tahun'}</span></summary>
            <div class="baca-in">
              <p>{model.premiumMethodology || 'Harga ialah anggaran premium polisi komprehensif; umur kereta, lokasi, varian, rekod pemanduan dan syarikat boleh mengubah quotation.'}</p>
              {modelYearNotes.length > 0 && (
                <>
                  <h3 class="rows-h">Nota mengikut tahun</h3>
                  <ul class="rows">
                    {modelYearNotes.map((item: any) => (
                      <li><div><b>{item.range}:</b> {item.note}</div></li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          </details>
        </div>
      </section>

      <!-- NCD Section -->
      <section id="ncd" class="mod" data-tint="sky" aria-labelledby="ncd-h">
        <h2 class="mod-bar" id="ncd-h">Diskaun NCD ikut berapa tahun anda tidak claim</h2>
        <div class="mod-in">
          <details class="baca">
            <summary><Ikon name="i-bawah" size={20} class="baca-i" /><span>Baca penuh: tangga NCD</span></summary>
            <div class="baca-in"><NcdLadder mode="diagram" selectedTier={55} /></div>
          </details>
          <p class="ix-s">Sesetengah tuntutan boleh menjejaskan NCD. Semak jenis tuntutan dan syarat polisi sebelum membuat keputusan.</p>
          <p><a href="/guides/ncd-explained/" class="inline-flex min-h-11 items-center">Panduan NCD →</a></p>
        </div>
      </section>

      <!-- Add-ons Section -->
      <section id="addons" class="mod" aria-labelledby="addons-h">
        <h2 class="mod-bar" id="addons-h">Perlindungan tambahan bukan automatik untuk semua polisi</h2>
        <div class="mod-in">
          <p class="ix-s">Pilih berdasarkan penggunaan kereta, lokasi dan kos yang anda sanggup tanggung sendiri.</p>
          {addOnsDetail.length > 0 ? (
            <ul class="rows">
              {addOnsDetail.map((addon: any) => (
                <li>
                  <div>
                    <b>{addon.name}: {addon.verdict}</b>
                    <p>Anggaran: {addon.priceBM}.{/special perils/i.test(addon.name) && specialPerilsEstimate && <> <a href="#nota-banjir">Anggaran untuk {model.model}: lihat nota banjir di atas</a>.</>} Perlindungan tertakluk pada had, pengecualian dan syarat tuntutan dalam polisi.</p>
                    <details class="baca" open={/special perils/i.test(addon.name)}><summary><Ikon name="i-bawah" size={20} class="baca-i" /><span>Baca penuh</span></summary><div class="baca-in"><p>{addon.whyBM}</p></div></details>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <ul class="rows">
              {model.popularAddOns.map((addon: any) => (
                <li>
                  <div>
                    <b>{addon.name}: {addon.recommended ? 'Wajar dipertimbangkan' : 'Bergantung pada keperluan'}</b>
                    <p>{addon.price} setahun untuk {model.model}.</p>
                  </div>
                </li>
              ))}
            </ul>
          )}
          <p class="ix-s" id="nota-addon">Harga add-on {model.model} di halaman ini ialah anggaran kami, bukan quotation. Kadar yang diterbitkan: windscreen cover 15% daripada sum insured cermin, special perils 0.2% daripada sum insured {model.model} (<a href={addOnRateSources.zurich}>PDS Zurich Z-Driver, 15 Nov 2025</a>; <a href={addOnRateSources.hsbc}>contoh PDS HSBC/Allianz, sah 1 Jan 2026</a>). Kadar syarikat lain boleh berbeza, jadi semak quotation anda.</p>
        </div>
      </section>

      <!-- Risk Profile -->
      <section id="risiko" class="mod" aria-labelledby="risiko-h">
        <h2 class="mod-bar" id="risiko-h">Risiko yang mempengaruhi premium {model.model}</h2>
        <div class="mod-in">
          <ul class="rows">
            {model.theftCoverNote && <li><div><b>Semakan perlindungan kecurian</b><p>{model.theftCoverNote}</p></div></li>}
            <li><div><b>Kos baiki</b><p>{model.riskProfile.repairCost}</p></div></li>
            <li><div><b>Contoh risiko kerosakan</b><p>{model.claimFrequencyNote || model.riskProfile.claimFrequency}</p></div></li>
            {!model.floodRiskNote && model.riskProfile.notes && <li><div><b>Nota</b><p>{model.riskProfile.notes}</p></div></li>}
          </ul>
          <p class="ix-s">Lokasi, cara penggunaan, umur kereta dan syarat syarikat juga mempengaruhi premium.</p>
        </div>
      </section>

      <!-- Tips Section -->
      <section id="tips" class="mod" aria-labelledby="tips-h">
        <h2 class="mod-bar mod-lab" id="tips-h">Tip untuk pemilik {model.model}</h2>
        <div class="mod-in">
          <details class="baca">
            <summary><Ikon name="i-bawah" size={20} class="baca-i" /><span>Baca penuh: {model.tips.length} tip</span></summary>
            <ol class="baca-in list-decimal pl-5">
              {model.tips.map((tip: string) => <li>{tip}</li>)}
            </ol>
          </details>
        </div>
      </section>

      <!-- Neutral company directory -->
      <section class="mod" aria-labelledby="syarikat-h">
        <h2 class="mod-bar" id="syarikat-h">Syarikat insurans kereta untuk quotation {model.model}</h2>
        <div class="mod-in">
          <p class="ix-s">Harga dan ciri polisi boleh berbeza antara syarikat, jadi semak syarat dan quotation sebenar setiap satu.</p>
          <ul class="grid gap-x-8 sm:grid-cols-2">
            {carInsurers.map((company) => (
              <li><a href={`/companies/${company.slug}/`} class="inline-flex min-h-11 items-center font-semibold">{company.name}</a></li>
            ))}
          </ul>
          <p><a href="/perbandingan/" class="inline-flex min-h-11 items-center">Lihat perbandingan syarikat →</a></p>
        </div>
      </section>

      <nav aria-label="Panduan berkaitan" class="text-base">
        <p class="font-semibold">Panduan berkaitan</p>
        <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1">
          <li><a href="/guides/renew-car-insurance/" class="inline-flex min-h-11 items-center">Cara renew insurans kereta online →</a></li>
          <li><a href="/guides/how-to-claim/" class="inline-flex min-h-11 items-center">Cara buat claim →</a></li>
          <li><a href="/car-insurance/" class="inline-flex min-h-11 items-center">Semua model →</a></li>
        </ul>
      </nav>

      <!-- FAQ -->
      <section id="faq" class="mod" aria-labelledby="faq-h">
        <h2 class="mod-bar mod-lab" id="faq-h">Soalan lazim tentang insurans {model.fullName}</h2>
        <div class="mod-in">
          {modelFaqs.length > 0 ? (
            modelFaqs.map((faq: any, i: number) => (
              <details class="faq-item" open={i === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))
          ) : (
            <>
              <details class="faq-item" open>
                <summary>Berapa harga insurans {model.model} sebulan?</summary>
                <p>
                  Jika dibahagi secara bulanan, insurans {model.model} sekitar
                  <strong>{rmRange(initialMonthly.min, initialMonthly.max)}</strong> sebulan dengan NCD 55%.
                  Tanpa NCD, sekitar <strong>{rmRange(zeroMonthly.min, zeroMonthly.max)}</strong> sebulan.
                  Ini setara tahunan ÷ 12, bukan pelan ansuran.
                </p>
              </details>
              <details class="faq-item">
                <summary>{model.model} patut ambil komprehensif atau pihak ketiga?</summary>
                <p>
                  Kalau {model.model} anda masih bernilai (lebih RM15,000), <strong>polisi komprehensif</strong> biasanya memberi perlindungan lebih luas.
                  Ia boleh melindungi kerosakan kereta sendiri, kereta orang lain dan kecurian, mengikut polisi.
                  Banjir dan bencana alam lain tidak termasuk dalam polisi asas: ia memerlukan add-on special perils dengan premium tambahan.
                  Polisi pihak ketiga hanya melindungi liabiliti kepada pihak ketiga.
                  <a href="/car-insurance/">Baca perbandingan jenis perlindungan →</a>
                </p>
              </details>
              <details class="faq-item">
                <summary>Boleh ke saya tukar syarikat insurans untuk {model.model} saya?</summary>
                <p>
                  Ya. NCD ikut pemilik dan kereta, bukan syarikat. Semasa renew, anda boleh membandingkan syarikat insurans berlesen dan memilih polisi yang sesuai.
                </p>
              </details>
              <details class="faq-item">
                <summary>Kenapa harga insurans {model.model} saya berbeza daripada kawan?</summary>
                <p>
                  Premium bergantung pada <strong>umur kereta</strong>, <strong>NCD</strong>,
                  <strong>lokasi</strong>, <strong>add-on</strong> dan <strong>syarikat</strong> yang dipilih.
                  Dua orang dengan {model.model} yang sama boleh menerima quotation yang berbeza.
                </p>
              </details>
              <details class="faq-item">
                <summary>Apa add-on yang sesuai untuk {model.model}?</summary>
                <p>
                  Windscreen cover dan special perils boleh dipertimbangkan berdasarkan penggunaan dan lokasi anda.
                  Semak had, pengecualian dan syarat claim sebelum memilih.
                  <a href="/car-insurance/#addons">Baca panduan add-on lengkap →</a>
                </p>
              </details>
            </>
          )}
        </div>
      </section>

      <CtaBand
        quiet
        heading={`Kira NCD dan semak quotation ${model.fullName}`}
        body="Masukkan premium asal daripada polisi anda. Kalkulator ini tidak menganggap julat editorial sebagai quotation sebenar."
        primary={{ label: 'Kira NCD saya →', href: primaryCalculatorUrl }}
      >
        <Fragment slot="disclosure">Untuk sebut harga sebenar, minta terus daripada syarikat insurans (lihat <a href="/insurans-online/">senarai beli online</a>). Tiada hubungan berbayar atau affiliate; pembelian dibuat di laman syarikat, bukan di sini.</Fragment>
      </CtaBand>
      <Dock answer="[data-ea]" control=".ea-ncd" car={model.model} />
    </div>

    <aside class="ep-tools" aria-label="Alat">
      <ToolsRail model={model} related={relatedCars} calculatorUrl={primaryCalculatorUrl} />
      <TerkiniRail />
    </aside>

    <div class="ep-models">
      <ModelRail current={model.slug} />
    </div>
  </div>

  {faqSchemaItems.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqSchemaItems.map((item: { question: string; answer: string }) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer,
        },
      })),
    })} />
  )}
</Base>
