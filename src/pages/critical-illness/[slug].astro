---
import Base from '../../layouts/Base.astro';
import TrustStrip from '../../components/edisi/TrustStrip.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import LogoTile from '../../components/LogoTile.astro';
import { shortCompanyName } from '../../lib/logos';
import PageAnswer from '../../components/edisi/PageAnswer.astro';
import ProductCss from '../../components/edisi/ProductCss.astro';
import SourceMark from '../../components/edisi/SourceMark.astro';
import SourceNote from '../../components/edisi/SourceNote.astro';
import { containedMarks, sourceMark } from '../../lib/fact-sources';
import { factRole, tarikh } from '../../components/edisi/ProductFormat';
import ci from '../../data/critical-illness.json';
import { buildDescription, buildTitle } from '../../lib/seo';
import { freshFaqs } from '../../lib/plan-faq';

type CriticalIllnessRecord = (typeof ci.records)[number];

const records = ci.records;
const typeLabels: Record<string, string> = {
  standalone: 'Pelan berdiri sendiri',
  rider: 'Rider',
  takaful: 'Takaful',
  scheme: 'Skim',
};

export function getStaticPaths() {
  return ci.records.map((record) => ({
    params: { slug: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props as { record: CriticalIllnessRecord };
// Measured built main text on 2026-10-10: >=700 words and every sibling Jaccard <0.35.
const adsEnabledSlugs = new Set([
  'aia-a-life-beyond-critical-care',
  'prudential-crisis-cover-benefit',
  'great-eastern-smart-early-payout-criticalcare',
  'etiqa-critical-care-plus',
  'etiqa-critical-care-takaful',
  'zurich-early-care-critical-illness',
  'mysalam',
]);
const passesUniqueness = adsEnabledSlugs.has(record.slug);
const canonicalUrl = `https://insurans.co/critical-illness/${record.slug}/`;
const typeLabel = typeLabels[record.type] ?? record.type;
const { analysis } = record;
const sibling = records.find((candidate) => candidate.slug === analysis.siblingSlug)!;
const sourceUrls = [...new Set([...record.sources, ...analysis.facts.map((fact) => fact.source)])];
const sourceLinks = sourceUrls.map((url) => ({
  label: new URL(url).hostname.replace(/^www\./, ''),
  url,
}));
const specItems = analysis.facts.filter((fact) =>
  ['Penyakit yang dilindungi', 'Bayaran mengikut peringkat', 'Tempoh perlindungan'].includes(fact.label),
);

const title = buildTitle(`${record.planName} — Penyakit Kritikal`);
const description = buildDescription(
  `${record.planName}: kelayakan, manfaat penyakit kritikal, had tuntutan dan perbandingan dengan ${sibling.planName} berdasarkan dokumen rasmi.`,
);

const faqTopics = [
  { q: `Macam mana ${record.planName} dibeli?`, labels: ['Jenis dan saluran pelan'] },
  { q: 'Penyakit apa yang dilindungi?', labels: ['Penyakit yang dilindungi', 'Definisi kanser'] },
  { q: 'Berapa yang dibayar ikut peringkat penyakit?', labels: ['Bayaran mengikut peringkat', 'Peraturan tuntutan'] },
  { q: 'Berapa lama perlu tunggu sebelum boleh claim?', labels: ['Tempoh menunggu', 'Tempoh hidup selepas diagnosis', 'Keadaan yang memburuk selepas 2025'] },
  { q: 'Siapa layak, dan sampai umur berapa dilindungi?', labels: ['Umur kemasukan', 'Umur dalam jadual kadar', 'Kelayakan dan umur', 'Tempoh perlindungan'] },
];
const faqCandidates = faqTopics.map((topic) => ({
  q: topic.q,
  a: analysis.facts.filter((fact) => topic.labels.includes(fact.label)).map((fact) => fact.value).join(' '),
}));
// Each answer joins fact rows printed in full above; freshFaqs drops answers that only repeat the page.
const faqs = freshFaqs(faqCandidates.filter((faq) => faq.a), [
  analysis.bestFor,
  ...analysis.facts.map((fact) => fact.value),
  analysis.tradeoffs,
  ...analysis.siblingDifferences,
]);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${record.planName} — Penyakit Kritikal`,
  description,
  url: canonicalUrl,
  datePublished: record.asAt,
  dateModified: record.analysisAsAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Penyakit Kritikal', item: 'https://insurans.co/critical-illness/' },
      { '@type': 'ListItem', position: 3, name: record.planName, item: canonicalUrl },
    ],
  },
};
// Page answer (Edisi): the plan's own key facts that the old summary box showed, at most four.
// PA: the death benefit is already the intro line under the byline, so it is not repeated in the box.
// Lead: the count of covered conditions as stated at the start of "Penyakit yang dilindungi" ("180 keadaan
// merentas 76 kategori"); the full row moves to the details list under the box. The plan type sits in the bar.
const coveredFact = analysis.facts.find((fact) => fact.label === 'Penyakit yang dilindungi');
const coveredMatch = coveredFact?.value.match(/^(\d+)\s+([^.:;,(]+)/);
const lead = coveredMatch ? { value: coveredMatch[1], label: coveredMatch[2].trim(), role: 'term' as const, source: sourceMark(sourceUrls, coveredFact?.source) } : undefined;
const finding = `${typeLabel} oleh ${record.insurer.replace(/\.$/, '')}`;
const answerSkip: string[] = lead ? ['Penyakit yang dilindungi'] : [];
const answerAll = [...specItems.filter((spec) => !answerSkip.includes(spec.label))]
  .filter((spec, index, all) => all.findIndex((other) => other.label === spec.label) === index);
// Rows whose value is a paragraph (over 160 characters) move to the details list below, so the box ends inside the
// first phone screen; short facts keep their order.
const answerTop = answerAll.filter((spec) => String(spec.value ?? '').length <= 160).slice(0, 4);
const answerFacts = answerTop.map((spec) => ({
  label: spec.label,
  value: spec.value,
  role: spec.label === 'Jenis pelan' ? undefined : factRole(spec.label),
  source: sourceMark(sourceUrls, spec.source),
}));
const answerRest = [
  ...specItems.filter((spec) => answerSkip.includes(spec.label)),
  ...answerAll.filter((spec) => !answerTop.includes(spec)),
];

---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ads={passesUniqueness}
  ogType="article"
  publishedTime={record.asAt}
  modifiedTime={record.analysisAsAt}
>
  <Hero title={`Insurans penyakit kritikal: ${record.planName}`}>
    {/* Insurer logo (identification only); a plain wordmark when no licensed logo is on file. A government
        scheme carries no insurer mark. */}
    <LogoTile slot="mark" company={record.insurer} name={/^kerajaan/i.test(record.insurer) ? undefined : shortCompanyName(record.insurer)} size="m" eager wordmark />
    <TrustStrip slot="trust" date={record.analysisAsAt} sources={sourceLinks} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Insurans Penyakit Kritikal', href: '/critical-illness/' },
        { label: record.planName },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-900">
      {analysis.facts.find((fact) => fact.label === 'Jenis dan saluran pelan')?.value}
    </p>

    <PageAnswer slot="answer" finding={finding} lead={lead} facts={answerFacts} />
    <ProductCss />

    {answerRest.length > 0 && (
      <div class="mod">
        <dl class="pa-rows">
          {answerRest.map((spec) => (
            <div class="pa-r">
              <dt>{spec.label}</dt>
              <dd>{spec.value}<SourceMark marks={[sourceMark(sourceUrls, spec.source)]} /></dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={record.analysisAsAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial prose-bars">
        <h2 id="sesuai">Untuk siapa pelan ini</h2>
        <p>{analysis.bestFor}</p>
        <SourceNote text={analysis.bestFor} facts={analysis.facts} list={sourceUrls} fallbackHref="#sumber" />

        <h2 id="fakta">Manfaat, had dan syarat</h2>
        <dl class="not-prose my-6 divide-y divide-stone-200 border-y border-stone-200">
          {analysis.facts.map((fact) => (
            <div class="py-4 sm:grid sm:grid-cols-[12rem_1fr] sm:gap-6">
              <dt class="font-semibold text-stone-900">{fact.label}</dt>
              <dd class="mt-1 leading-7 text-stone-700 sm:mt-0">
                {fact.value}{' '}
                <sup>
                  <a
                    href={fact.source}
                    aria-label={`Sumber rasmi: ${fact.label}`}
                    class="text-hijau-700 underline underline-offset-2"
                  >[{sourceUrls.indexOf(fact.source) + 1}]</a>
                </sup>
              </dd>
            </div>
          ))}
        </dl>

        <h2 id="had">Had dan perkara yang perlu ditimbang</h2>
        <p>{analysis.tradeoffs}</p>
        <SourceNote text={analysis.tradeoffs} facts={analysis.facts} list={sourceUrls} fallbackHref="#sumber" />

        <h2 id="perbandingan">{record.planName} berbanding {sibling.planName}</h2>
        <ul>
          {analysis.siblingDifferences.map((difference) => <li>{difference}</li>)}
        </ul>
        <SourceNote text={analysis.siblingDifferences} facts={analysis.facts} list={sourceUrls} fallbackHref="#sumber" sibling={{ name: sibling.planName, href: `/critical-illness/${sibling.slug}/#fakta`, facts: sibling.analysis.facts }} />
        <p>
          Baca manfaat dan syarat <a href={`/critical-illness/${sibling.slug}/`}>{sibling.planName}</a>
          {' '}untuk melihat kesan perbezaan ini pada pilihan perlindungan anda.
        </p>
      </article>

      {faqs.length > 0 && (
        <section id="faq">
          <div class="prose-editorial prose-bars">
            <h2>Soalan lazim</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}<SourceMark marks={containedMarks(faq.a, analysis.facts, sourceUrls)} /></p>
              </details>
            ))}
          </div>
        </section>
      )}

      <section id="sumber" class="prose-editorial prose-bars">
        <h2>Sumber rasmi {record.planName}</h2>
        <ol>
          {sourceUrls.map((url) => {
            const source = new URL(url);
            const document = source.pathname.endsWith('.pdf')
              ? decodeURIComponent(source.pathname.split('/').pop()!)
              : source.searchParams.get('url') ?? 'Halaman produk';
            return <li><a href={url} class="break-words">{source.hostname.replace(/^www\./, '')}: {document}</a></li>;
          })}
        </ol>
      </section>

      <CtaBand
        heading="Bandingkan semua insurans penyakit kritikal"
        body="Bandingkan kelayakan, tahap penyakit dan baki manfaat dalam panduan penyakit kritikal sebelum memilih perlindungan."
        primary={{ label: 'Lihat semua penyakit kritikal', href: '/critical-illness/' }}
        disclosure="Tiada hubungan berbayar atau affiliate. Pautan luar, jika ada, hanya rujukan; pembelian polisi dibuat di laman penyedia, bukan di Insurans.co."
      />
    </div>
  </div>

  {faqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />}
</Base>
