---
interface PrimaryAction {
  label: string;
  href: string;
}

interface OutboundAction {
  label: string;
  href: string;
  relationship?: 'paid' | 'unpaid' | 'unknown';
}

interface Props {
  heading: string;
  body?: string;
  primary: PrimaryAction;
  outbound?: OutboundAction[];
  disclosure?: string;
  trackingSection?: string;
}

const {
  heading,
  body,
  primary,
  outbound = [],
  disclosure,
  trackingSection = 'cta-band',
} = Astro.props;
---

<section class="border-2 border-stone-900 bg-krim-100 p-5 sm:p-6" data-section={trackingSection}>
  <div class="lg:flex lg:items-start lg:justify-between lg:gap-10">
    <div class="max-w-2xl">
      <h2 class="font-serif text-headline-sm text-stone-900">{heading}</h2>
      {body && <p class="mt-2 text-base leading-6 text-stone-700">{body}</p>}
    </div>
    <a href={primary.href} data-cta="cta-band-primary" class="btn-hijau mt-5 w-full justify-center lg:mt-0 lg:w-auto">
      {primary.label}
    </a>
  </div>

  {outbound.length > 0 && (
    <div class="mt-6 border-t border-stone-300 pt-5">
      <h3 class="text-base font-semibold text-stone-900">Pilihan quotation · Laman luar</h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {outbound.map((action) => {
          const relationship = action.relationship ?? 'unknown';
          const rel = relationship === 'paid' ? 'sponsored noopener' : 'noopener';
          return (
            <a
              href={action.href}
              target="_blank"
              rel={rel}
              data-relationship={relationship}
              class="btn-outline"
            >
              {action.label} <span aria-hidden="true">↗</span><span class="sr-only"> (buka tab baharu)</span>
            </a>
          );
        })}
      </div>
      {disclosure && <p class="mt-3 text-sm leading-5 text-stone-600">{disclosure}</p>}
    </div>
  )}
  {outbound.length === 0 && disclosure && (
    <p class="mt-5 border-t border-stone-300 pt-5 text-sm leading-5 text-stone-600">{disclosure}</p>
  )}
</section>
