---
interface Source {
  label: string;
  url?: string;
  href?: string;
}

interface Props {
  articleDate?: string;
  premiumReviewed?: string;
  sources?: Source[];
  sourcesLabel?: string;
  reviewedLabel?: string;
  showReviewed?: boolean;
}

const {
  premiumReviewed,
  sources = [],
  sourcesLabel = 'Sumber harga',
  reviewedLabel = 'Anggaran premium dikira',
  showReviewed = true,
} = Astro.props;

function formatDate(value: string): string {

  const date = new Date(`${value}T00:00:00Z`);
  if (Number.isNaN(date.getTime())) return value;

  return new Intl.DateTimeFormat('ms-MY', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
}

// A bare root domain (PIAM/BNM homepage) is a general reference, never a price source.
const isRootUrl = (u?: string) => !!u && /^https?:\/\/[^/]+\/?$/.test(u);
const priceSources = sources.filter((source) => source.label && (source.url || source.href) && !isRootUrl(source.url || source.href));
const generalRefs = sources.filter((source) => source.label && isRootUrl(source.url || source.href));
const linkClass = 'inline-flex min-h-11 items-center text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:decoration-hijau-600';
---

<!-- Every page that renders this stamp also renders <Byline>, so the author and article date live there only
     (articleDate stays accepted for compatibility). Sources are a plain list, not a middle-dot run. -->
<div data-editorial-stamp class="text-sm leading-5 text-stone-600">
  {showReviewed && premiumReviewed && (
    <p data-editorial-price-reviewed>{reviewedLabel}: {formatDate(premiumReviewed)}</p>
  )}
  {priceSources.length > 0 && (
    <p data-editorial-sources>
      <span>{sourcesLabel}:</span>
    </p>
    <ul data-editorial-source-links class="flex flex-wrap gap-x-4">
      {priceSources.map((source) => (
        <li><a href={source.url || source.href} class={linkClass}>{source.label}</a></li>
      ))}
    </ul>
  )}
  {generalRefs.length > 0 && (
    <p data-editorial-general-refs class="mt-1">Rujukan umum:</p>
    <ul class="flex flex-wrap gap-x-4">
      {generalRefs.map((source) => (
        <li><a href={source.url || source.href} class={linkClass}>{source.label}</a></li>
      ))}
    </ul>
  )}
</div>
