        <!-- Car model quick links -->
        <div class="bg-white border border-stone-200 p-6">
          <p class="text-sm font-semibold text-stone-700 mb-3">Semak harga premium untuk kereta anda</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            <a href="/car-insurance/perodua-myvi/" class="text-sm text-hijau-700 hover:text-hijau-600 font-medium p-2 border border-stone-100 hover:border-hijau-300 transition-colors">Perodua Myvi</a>
            <a href="/car-insurance/honda-city/" class="text-sm text-hijau-700 hover:text-hijau-600 font-medium p-2 border border-stone-100 hover:border-hijau-300 transition-colors">Honda City</a>
            <a href="/car-insurance/honda-jazz/" class="text-sm text-hijau-700 hover:text-hijau-600 font-medium p-2 border border-stone-100 hover:border-hijau-300 transition-colors">Honda Jazz</a>
            <a href="/car-insurance/toyota-vios/" class="text-sm text-hijau-700 hover:text-hijau-600 font-medium p-2 border border-stone-100 hover:border-hijau-300 transition-colors">Toyota Vios</a>
            <a href="/car-insurance/toyota-corolla-cross/" class="text-sm text-hijau-700 hover:text-hijau-600 font-medium p-2 border border-stone-100 hover:border-hijau-300 transition-colors">Toyota Corolla Cross</a>
