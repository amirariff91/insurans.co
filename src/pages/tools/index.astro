---
import Base from '../../layouts/Base.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": "Tools Insurans Percuma — Kalkulator & Panduan",
      "url": "https://insurans.co/tools/",
      "description": "Tools percuma untuk bantu anda faham insurans Malaysia. Kalkulator NCD, panduan claim, dan lebih banyak lagi.",
      "inLanguage": "ms"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
        { "@type": "ListItem", "position": 2, "name": "Alat", "item": "https://insurans.co/tools/" }
      ]
    }
  ]
};
---

<Base
  title="Tools Insurans Percuma — Kalkulator & Panduan"
  description="Tools percuma untuk bantu anda faham insurans Malaysia. Kalkulator NCD, panduan claim, dan lebih banyak lagi."
  schema={schema}
>
  <section class="bg-white border-b border-stone-200">
    <div class="container-wide py-10 sm:py-14">
      <nav class="text-sm text-stone-400 mb-5">
        <a href="/" class="hover:text-hijau-700 text-stone-500">Utama</a>
        <span class="mx-2">›</span>
        <span class="text-stone-700">Tools</span>
      </nav>
      <p class="label mb-3">Percuma</p>
      <h1 class="font-serif text-headline-lg sm:text-headline-xl text-stone-900 mb-4">Tools Insurans</h1>
      <p class="text-lg text-stone-600 max-w-2xl">Kalkulator dan tools percuma untuk bantu anda buat keputusan insurans yang lebih bijak.</p>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-14">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <a href="/tools/ncd-calculator/" class="card-editorial group block">
        <div class="text-3xl mb-3">🧮</div>
        <h2 class="font-serif text-xl text-stone-900 group-hover:text-hijau-700 transition-colors mb-1">Kalkulator NCD</h2>
        <p class="text-sm text-stone-600">Kira berapa anda jimat dengan NCD anda. Termasuk kalkulator "patut ke claim?"</p>
        <p class="text-xs text-hijau-700 font-semibold mt-3">Cuba sekarang →</p>
      </a>
      <a href="/tools/kalkulator-coverage-nyawa/" class="card-editorial group block">
        <div class="mb-3 text-xs font-bold uppercase tracking-widest text-hijau-700">Life</div>
        <h2 class="font-serif text-xl text-stone-900 group-hover:text-hijau-700 transition-colors mb-1">Kalkulator Coverage Nyawa</h2>
        <p class="text-sm text-stone-600">Kira jurang coverage kasar berdasarkan nombor pendapatan, hutang, simpanan dan coverage sedia ada.</p>
        <p class="text-xs text-hijau-700 font-semibold mt-3">Cuba sekarang →</p>
      </a>
    </div>
  </div>
</Base>
