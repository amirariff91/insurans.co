---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Ikon from '../../components/Ikon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageAnswer from '../../components/edisi/PageAnswer.astro';
import { withAuthor } from '../../lib/schema';
import { terkini, KIND_LABEL, TERKINI_URL, formatTarikh, bodySegments, mainWordCount, TERKINI_INDEX_MIN_WORDS, type TerkiniItem } from '../../lib/terkini';
import '../../styles/terkini.css';

export function getStaticPaths() {
  return terkini.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props { item: TerkiniItem }
const { item } = Astro.props;
const url = `${TERKINI_URL}${item.slug}/`;
const facts = [
  { label: 'Tarikh', value: formatTarikh(item.date) },
  ...(item.effectiveDate ? [{ label: 'Berkuat kuasa', value: formatTarikh(item.effectiveDate) }] : []),
  { label: 'Sumber', value: item.sources[0].label, href: item.sources[0].url },
];
// Short entries leave the index; the /terkini/ list still links them (see TERKINI_INDEX_MIN_WORDS).
const thin = mainWordCount(item) < TERKINI_INDEX_MIN_WORDS;
const description = item.summary.length > 160 ? `${item.summary.slice(0, 157).trimEnd()}…` : item.summary;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    withAuthor({
      "@type": "Article",
      "headline": item.title,
      "description": item.summary,
      "url": url,
      "mainEntityOfPage": url,
      "datePublished": item.date,
      "dateModified": item.date,
      "inLanguage": "ms",
      "articleSection": KIND_LABEL[item.kind],
      "citation": item.sources.map((s) => s.url),
    }),
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
        { "@type": "ListItem", "position": 2, "name": "Terkini", "item": TERKINI_URL },
        { "@type": "ListItem", "position": 3, "name": item.title, "item": url },
      ],
    },
  ],
};
---

<Base
  title={item.title}
  description={description}
  canonical={url}
  schema={schema}
  ogType="article"
  publishedTime={item.date}
  modifiedTime={item.date}
  ads={false}
  noindex={thin}
  noindexFollow={thin}
  rss={{ href: '/terkini/rss.xml', title: 'Insurans.co Terkini' }}
>
  <article class="bg-white">
    <div class="container-article pt-6 pb-10 sm:pt-8 sm:pb-14">
      <Breadcrumbs items={[{ label: 'Utama', href: '/' }, { label: 'Terkini', href: '/terkini/' }, { label: item.title }]} />
      <h1 class="ea-h1 mb-1">{item.title}</h1>
      <PageAnswer finding={item.summary} facts={facts} />
      <Byline dateModified={item.date} />

      <div class="tk-body">
        {item.body.map((para) => (
          <p>{bodySegments(para).map((seg) => ('href' in seg
            ? (seg.href.startsWith('/') ? <a href={seg.href}>{seg.text}</a> : <a href={seg.href} target="_blank" rel="noopener">{seg.text}</a>)
            : seg.text))}</p>
        ))}
      </div>

      <div class="tk-refs">
        <section class="mod" aria-labelledby="sumber">
          <h2 class="mod-bar mod-lab" id="sumber">Sumber rasmi</h2>
          <ul>
            {item.sources.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener" data-source>{s.label}</a></li>
            ))}
          </ul>
        </section>
        <section class="mod" aria-labelledby="dikemas-kini">
          <h2 class="mod-bar mod-lab" id="dikemas-kini">Halaman yang dikemas kini</h2>
          <ul>
            {item.updates.map((u) => (
              <li><a href={u.href} data-updates>{u.label}</a></li>
            ))}
          </ul>
        </section>
      </div>

      <nav class="tk-foot" aria-label="Pautan lanjut">
        <a href="/terkini/"><Ikon name="i-kiri" size={18} /> Semua kemas kini</a>
        <a href="/kaedah-editorial/#log-pembetulan">Log pembetulan</a>
      </nav>
    </div>
  </article>
</Base>
