---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import ci from '../../data/critical-illness.json';
import { buildDescription, buildTitle } from '../../lib/seo';

type CriticalIllnessRecord = (typeof ci.records)[number];

const records = ci.records;
const typeLabels: Record<string, string> = {
  standalone: 'Pelan berdiri sendiri',
  rider: 'Rider',
  takaful: 'Takaful',
  scheme: 'Skim',
};

export function getStaticPaths() {
  return ci.records.map((record) => ({
    params: { slug: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props as { record: CriticalIllnessRecord };
// Measured built main text on 2026-10-10: >=700 words and every sibling Jaccard <0.35.
const adsEnabledSlugs = new Set([
  'aia-a-life-beyond-critical-care',
  'prudential-crisis-cover-benefit',
  'great-eastern-smart-early-payout-criticalcare',
  'etiqa-critical-care-plus',
  'etiqa-critical-care-takaful',
  'zurich-early-care-critical-illness',
  'mysalam',
]);
const passesUniqueness = adsEnabledSlugs.has(record.slug);
const canonicalUrl = `https://insurans.co/critical-illness/${record.slug}/`;
const typeLabel = typeLabels[record.type] ?? record.type;
const { analysis } = record;
const sibling = records.find((candidate) => candidate.slug === analysis.siblingSlug)!;
const sourceUrls = [...new Set([...record.sources, ...analysis.facts.map((fact) => fact.source)])];
const sourceLinks = sourceUrls.map((url) => ({
  label: new URL(url).hostname.replace(/^www\./, ''),
  url,
}));
const specItems = analysis.facts.filter((fact) =>
  ['Penyakit yang dilindungi', 'Bayaran mengikut peringkat', 'Tempoh perlindungan'].includes(fact.label),
);

const title = buildTitle(`${record.planName} — Penyakit Kritikal`);
const description = buildDescription(
  `${record.planName}: kelayakan, manfaat penyakit kritikal, had tuntutan dan perbandingan dengan ${sibling.planName} berdasarkan dokumen rasmi.`,
);

const faqTopics = [
  { q: `Bagaimana ${record.planName} dibeli atau diperoleh?`, labels: ['Jenis dan saluran pelan'] },
  { q: `Apakah penyakit yang dilindungi oleh ${record.planName}?`, labels: ['Penyakit yang dilindungi', 'Definisi kanser'] },
  { q: `Bagaimana manfaat ${record.planName} dibayar?`, labels: ['Bayaran mengikut peringkat', 'Peraturan tuntutan'] },
  { q: `Apakah syarat masa tuntutan ${record.planName}?`, labels: ['Tempoh menunggu', 'Tempoh hidup selepas diagnosis', 'Keadaan yang memburuk selepas 2025'] },
  { q: `Siapa layak dan berapa lama ${record.planName} melindungi mereka?`, labels: ['Umur kemasukan', 'Umur dalam jadual kadar', 'Kelayakan dan umur', 'Tempoh perlindungan'] },
];
const faqs = faqTopics.map((topic) => ({
  q: topic.q,
  a: analysis.facts.filter((fact) => topic.labels.includes(fact.label)).map((fact) => fact.value).join(' '),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${record.planName} — Penyakit Kritikal`,
  description,
  url: canonicalUrl,
  datePublished: record.asAt,
  dateModified: record.analysisAsAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Insurans Penyakit Kritikal', item: 'https://insurans.co/critical-illness/' },
      { '@type': 'ListItem', position: 3, name: record.planName, item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ads={passesUniqueness}
  ogType="article"
  publishedTime={record.asAt}
  modifiedTime={record.analysisAsAt}
>
  <Hero title={`Insurans penyakit kritikal: ${record.planName}`}>
    <Byline slot="byline" dateModified={record.analysisAsAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Insurans Penyakit Kritikal', href: '/critical-illness/' },
        { label: record.planName },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      {analysis.facts.find((fact) => fact.label === 'Jenis dan saluran pelan')?.value}
    </p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="label">Insurans penyakit kritikal</p>
          <h2 class="mt-2 font-serif text-headline-sm text-stone-900">{record.planName}</h2>
          <p class="mt-1 text-sm leading-5 text-stone-600">{record.insurer}</p>
        </div>
        <span class="inline-flex w-fit border border-hijau-700 bg-hijau-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-hijau-800">
          {typeLabel}
        </span>
      </div>

      <h2 class="mt-7 font-serif text-headline-sm text-stone-900">Apa yang anda dapat</h2>
      <dl class="mt-4 space-y-3 text-sm">
        {specItems.map((spec) => (
          <div class="border-t border-stone-200 pt-3 first:border-t-0 first:pt-0">
            <dt class="text-stone-500">{spec.label}</dt>
            <dd class="mt-1 font-semibold leading-5 text-stone-900">{spec.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={record.analysisAsAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial">
        <h2 id="sesuai">Siapa yang sesuai dengan {record.planName}</h2>
        <p>{analysis.bestFor}</p>

        <h2 id="fakta">Fakta utama {record.planName}</h2>
        <dl class="not-prose my-6 divide-y divide-stone-200 border-y border-stone-200">
          {analysis.facts.map((fact) => (
            <div class="py-4 sm:grid sm:grid-cols-[12rem_1fr] sm:gap-6">
              <dt class="font-semibold text-stone-900">{fact.label}</dt>
              <dd class="mt-1 leading-7 text-stone-700 sm:mt-0">
                {fact.value}{' '}
                <sup>
                  <a
                    href={fact.source}
                    aria-label={`Sumber rasmi: ${fact.label}`}
                    class="text-hijau-700 underline underline-offset-2"
                  >[{sourceUrls.indexOf(fact.source) + 1}]</a>
                </sup>
              </dd>
            </div>
          ))}
        </dl>

        <h2 id="had">Had dan perkara yang perlu ditimbang</h2>
        <p>{analysis.tradeoffs}</p>

        <h2 id="perbandingan">{record.planName} berbanding {sibling.planName}</h2>
        <ul>
          {analysis.siblingDifferences.map((difference) => <li>{difference}</li>)}
        </ul>
        <p>
          Baca manfaat dan syarat <a href={`/critical-illness/${sibling.slug}/`}>{sibling.planName}</a>
          {' '}untuk melihat kesan perbezaan ini pada pilihan perlindungan anda.
        </p>
      </article>

      <section id="faq">
        <div class="prose-editorial">
          <h2>Soalan lazim — {record.planName}</h2>
        </div>
        <div class="mt-5">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="sumber" class="prose-editorial">
        <h2>Sumber rasmi {record.planName}</h2>
        <ol>
          {sourceUrls.map((url) => {
            const source = new URL(url);
            const document = source.pathname.endsWith('.pdf')
              ? decodeURIComponent(source.pathname.split('/').pop()!)
              : source.searchParams.get('url') ?? 'Halaman produk';
            return <li><a href={url} class="break-words">{source.hostname.replace(/^www\./, '')} — {document}</a></li>;
          })}
        </ol>
      </section>

      <CtaBand
        heading="Bandingkan semua insurans penyakit kritikal"
        body="Bandingkan kelayakan, tahap penyakit dan baki manfaat dalam panduan penyakit kritikal sebelum memilih perlindungan."
        primary={{ label: 'Lihat semua penyakit kritikal →', href: '/critical-illness/' }}
        disclosure="Tiada hubungan berbayar atau affiliate. Pautan luar, jika ada, hanya rujukan; pembelian polisi dibuat di laman penyedia, bukan di Insurans.co."
      />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
