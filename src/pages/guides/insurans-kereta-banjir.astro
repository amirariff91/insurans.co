---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Base from '../../layouts/Base.astro';
import TrustStrip from '../../components/edisi/TrustStrip.astro';
import PageAnswer from '../../components/edisi/PageAnswer.astro';

const faqItems = [
  {
    q: "Insurans kereta standard cover banjir ke?",
    a: "Tidak. Insurans komprehensif standard tidak melindungi kerosakan banjir. Anda perlu menambah perlindungan tambahan 'Special Perils' atau 'Bencana Khas' secara berasingan untuk mendapat perlindungan banjir."
  },
  {
    q: "Berapa kos special perils untuk banjir?",
    a: "Kadar berbeza mengikut syarikat dan jenis perlindungan. PIAM menyatakan lanjutan ini lazimnya kurang daripada 0.5% daripada jumlah diinsuranskan (sum insured) pada 14 Nov 2025. RHB dan MSIG menerbitkan contoh pada nilai kenderaan RM50,000: RHB RM125 penuh dan RM50 terhad, MSIG RM100 penuh dan RM62.50 terhad. Semua angka itu sebelum cukai dan contoh syarikat itu sendiri, bukan kadar pasaran. Minta sebut harga untuk angka tepat."
  },
  {
    q: "Kereta kena banjir, apa yang perlu dibuat?",
    a: "Jangan hidupkan enjin selepas kereta ditenggelami air kerana ini boleh menambah kerosakan dan menjejaskan claim. Ambil gambar/video kerosakan segera. Maklumkan syarikat insurans anda secepat mungkin dan semak tempoh pemberitahuan dalam polisi anda. Bawa kereta ke panel bengkel yang dilantik oleh syarikat insurans anda."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Insurans Kereta Banjir di Malaysia: Apa Yang Dilindungi?",
      "description": "Panduan insurans kereta banjir — special perils, kadar PIAM, contoh RHB dan MSIG, kesan NCD, takaful, dan langkah tuntutan.",
      "url": "https://insurans.co/guides/insurans-kereta-banjir/",
      "datePublished": "2026-01-15",
      "dateModified": "2026-11-27",
      "inLanguage": "ms",
      "publisher": { "@type": "Organization", "name": "Insurans.co", "url": "https://insurans.co" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://insurans.co/" },
        { "@type": "ListItem", "position": 2, "name": "Panduan", "item": "https://insurans.co/guides/" },
        { "@type": "ListItem", "position": 3, "name": "Insurans Kereta Banjir", "item": "https://insurans.co/guides/insurans-kereta-banjir/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
