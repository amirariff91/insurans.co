---
import Base from '../layouts/Base.astro';
import AnswerCard from '../components/AnswerCard.astro';
import CtaBand from '../components/CtaBand.astro';
import EditorialStamp from '../components/EditorialStamp.astro';
import ModelPicker from '../components/ModelPicker.astro';
import companies from '../data/companies.json';
import carModels from '../data/car-models.json';
import comparisons from '../data/comparisons.json';

const topMotorInsurers = companies.filter(c => c.products.includes('car')).slice(0, 6);
const popularCars = carModels.filter(car => ['perodua-axia', 'perodua-myvi', 'proton-saga', 'toyota-vios', 'honda-city', 'honda-civic'].includes(car.slug));
const exampleModel = carModels.find((car) => car.slug === 'perodua-axia') ?? carModels[0];
const companyCount = companies.length;
const carModelCount = carModels.length;
const comparisonCount = comparisons.length;


const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Insurans.co",
  "url": "https://insurans.co",
  "description": "Panduan insurans Malaysia — ditulis untuk rakyat Malaysia yang nak faham insurans tanpa jargon.",
  "inLanguage": ["ms", "en"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wajib ke beli insurans kereta?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ya, wajib. Minimum kena ada third-party insurance. Tanpa insurans, anda tak boleh renew roadtax. Kalau kena tangkap memandu tanpa insurans, denda sehingga RM1,000 atau penjara 3 bulan."
      }
    },
    {
      "@type": "Question",
      "name": "Boleh ke renew insurans kereta online?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Boleh, dan lagi senang dari pergi pejabat. Semak NCD dulu dengan Kalkulator NCD, lepas tu bandingkan quotation di Bjak.my, PolicyStreet, atau terus di website syarikat macam etiqa.com.my. Bayar online, dapat e-cover note terus, lepas tu renew roadtax di MyEG atau Pos Malaysia. Langkah penuh: cara renew insurans kereta online."
      }
    },
    {
      "@type": "Question",
      "name": "Apa jadi kalau NCD reset sebab claim?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NCD anda reset ke 0% lepas satu claim. Kalau NCD anda 55%, premium tahun depan boleh naik RM1,000+. Sebab tu untuk calar kecil bawah RM1,000–RM2,000, ramai pilih bayar sendiri. Jangan agak-agak — kira dulu dengan Kalkulator NCD: masukkan premium asal, NCD semasa, dan kos repair, tool akan tunjuk sama ada berbaloi claim atau tidak."
      }
    },
    {
      "@type": "Question",
      "name": "Insurans dan takaful — sama ke beza?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Takaful adalah alternatif insurans yang patuh Syariah. Konsep utama: peserta saling bantu-membantu (ta'awun). Lebihan dana dikongsi semula kepada peserta. Insurans konvensional — keuntungan milik syarikat."
      }
    }
  ]
};
---

<Base
  title="Harga Insurans Kereta Malaysia 2026 — Kalkulator & Perbandingan | Insurans.co"
  description="Ketahui harga insurans kereta di Malaysia untuk 39 model — Axia, Myvi, Saga, Vios. Kalkulator NCD, anggaran premium 12 syarikat, dan cara renew online."
  schema={schema}
  pageType="home"
>
  <!-- Utility Masthead -->
  <section class="border-b-2 border-stone-900 bg-krim-50">
    <div class="container-wide py-10 sm:py-16">
      <div class="mx-auto max-w-3xl">
        <p class="label mb-4">Panduan Insurans Malaysia 2026</p>
        <h1 class="font-serif text-headline-lg sm:text-headline-xl text-stone-900 mb-5 max-w-4xl">
          Harga Insurans Kereta Malaysia 2026
        </h1>
        <p class="text-lg font-semibold leading-relaxed text-stone-800">
          Bukan ejen. Bukan broker.
        </p>
        <p class="mt-4 text-lg sm:text-xl text-stone-700 leading-relaxed max-w-2xl mb-3">
          Berapa patut anda bayar untuk insurans kereta?
        </p>
        <p class="text-lg sm:text-xl text-stone-700 leading-relaxed max-w-2xl">
          Harga insurans kereta di Malaysia untuk Axia/Myvi sekitar RM550–RM1,000 setahun dengan NCD 55%, dan RM1,200–RM2,200 tanpa NCD. Insurans.co bantu anda semak anggaran ikut 39 model, kira NCD, bandingkan 12 syarikat, dan renew online — tanpa jargon, bukan ejen, bukan broker.
        </p>

        <div class="mt-7">
          <ModelPicker />
        </div>

        <div class="mt-6">
          <AnswerCard
            slug={exampleModel.slug}
            model={exampleModel.fullName}
            year="2026"
            premium0={{ min: exampleModel.premiumNCD0Min, max: exampleModel.premiumNCD0Max }}
            premium55={{ min: exampleModel.premiumNCD55Min, max: exampleModel.premiumNCD55Max }}
            compact
          />
        </div>
        <div class="mt-4 mr-2">
          <EditorialStamp
            premiumReviewed={exampleModel.premiumReviewed}
            sources={exampleModel.sources}
          />
        </div>
        <a
          href="/tools/ncd-calculator/"
          data-cta="hero_secondary"
          class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-hijau-700 underline decoration-hijau-300 underline-offset-2 hover:text-hijau-600"
        >
          Tak pasti NCD? Kira NCD saya →
        </a>
      </div>
    </div>
  </section>

  <!-- Main Actions -->
  <section class="container-wide py-10 sm:py-12">
    <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-6 sm:gap-8">
      <a href="/car-insurance/" data-cta="card_car" class="card-editorial group block border-2 border-stone-900">
        <h2 class="font-serif text-headline-md text-stone-900 mb-3 group-hover:text-hijau-700 transition-colors">
          Harga insurans kereta popular 2026
        </h2>
        <p class="text-stone-600 leading-relaxed mb-5">
          Terus tengok range premium untuk Axia, Myvi, Saga, Vios, City dan model lain — termasuk NCD 0% vs 55%.
        </p>
        <div class="grid sm:grid-cols-2 gap-3 numeric">
          {popularCars.slice(0, 4).map(car => (
            <div class="bg-krim-100 border border-stone-200 p-4">
              <p class="font-semibold text-stone-900">{car.fullName}</p>
              <p class="text-xs text-stone-500 mt-1">NCD 55%</p>
              <p class="font-serif text-xl text-hijau-800 mt-1">{car.premiumNCD55}</p>
            </div>
          ))}
        </div>
        <span class="mt-5 inline-block text-sm font-semibold text-hijau-700 group-hover:text-hijau-600">
          Bandingkan ikut model →
        </span>
      </a>

      <div class="space-y-6">
        <a href="/tools/ncd-calculator/" data-cta="card_ncd" class="card-editorial group block border-2 border-hijau-700 bg-hijau-50 hover:bg-hijau-100 transition-colors">
          <h2 class="font-serif text-headline-sm text-stone-900 mb-2 group-hover:text-hijau-700 transition-colors">
            Kalkulator NCD — kira berapa anda jimat
          </h2>
          <p class="text-stone-700 text-sm leading-relaxed mb-3">
            Masukkan premium asal, pilih NCD level. Termasuk kira-kira “patut ke claim?” sebelum NCD reset.
          </p>
          <span class="text-sm font-semibold text-hijau-700">Kira NCD sekarang →</span>
        </a>

        <div class="card-editorial">
          <a href="/perbandingan/" data-cta="card_compare" class="group block">
            <h2 class="font-serif text-headline-sm text-stone-900 mb-2 group-hover:text-hijau-700 transition-colors">
              Pilih antara dua syarikat?
            </h2>
            <p class="text-stone-600 text-sm leading-relaxed">
              {comparisonCount} perbandingan head-to-head — Etiqa vs Allianz, Takaful vs konvensional, harga, rating dan claim line.
            </p>
          </a>
          <ul class="mt-4 space-y-2 text-sm">
            <li><a href="/perbandingan/prudential-vs-aia/" class="text-hijau-700 hover:text-hijau-600 hover:underline">Prudential vs AIA — mana medical card lagi power?</a></li>
            <li><a href="/perbandingan/etiqa-vs-zurich/" class="text-hijau-700 hover:text-hijau-600 hover:underline">Etiqa vs Zurich — insurans kereta mana lagi murah?</a></li>
            <li><a href="/perbandingan/allianz-vs-zurich/" class="text-hijau-700 hover:text-hijau-600 hover:underline">Allianz vs Zurich — coverage premium, mana berbaloi?</a></li>
          </ul>
        </div>

        <a href="/takaful/" data-cta="card_takaful" class="card-editorial group block">
          <h2 class="font-serif text-headline-sm text-stone-900 mb-2 group-hover:text-hijau-700 transition-colors">
            Takaful atau insurans konvensional?
          </h2>
          <p class="text-stone-600 text-sm leading-relaxed">
            Coverage lebih kurang sama. Beza utama: takaful patuh Syariah, lebihan dana boleh dikongsi.
          </p>
        </a>
      </div>
    </div>
  </section>
  <!-- Factual Trust Bar -->
  <section class="bg-krim-100 border-b border-stone-200">
    <div class="container-wide grid grid-cols-2 md:grid-cols-4 divide-x-0 md:divide-x divide-stone-300 border-x-0 md:border-x border-stone-300">
      <div class="py-4 pr-4">
        <p class="text-xs uppercase tracking-widest text-stone-500 font-bold">Syarikat</p>
        <p class="font-serif text-2xl text-stone-900">{companyCount}</p>
      </div>
      <div class="py-4 md:px-4">
        <p class="text-xs uppercase tracking-widest text-stone-500 font-bold">Model kereta</p>
        <p class="font-serif text-2xl text-stone-900">{carModelCount}</p>
      </div>
      <div class="py-4 pr-4 md:px-4">
        <p class="text-xs uppercase tracking-widest text-stone-500 font-bold">Perbandingan</p>
        <p class="font-serif text-2xl text-stone-900">{comparisonCount}</p>
      </div>
      <div class="py-4 md:pl-4">
        <p class="text-xs uppercase tracking-widest text-stone-500 font-bold">Status</p>
        <p class="font-serif text-xl text-stone-900">Bebas</p>
      </div>
    </div>
  </section>

  <div class="divider-bold container-wide"></div>

  <!-- Cara Renew — Practical Section -->
  <section data-section="renew" class="bg-hijau-50 border-y border-hijau-200 py-10 sm:py-12">
    <div class="container-wide">
      <h2 class="font-serif text-headline-md text-stone-900 mb-4">
        Nak renew insurans kereta online?
      </h2>
      <p class="text-stone-600 mb-8 max-w-2xl">
        Tak perlu pergi pejabat insurans. Semak NCD, bandingkan harga, bayar online, kemudian renew roadtax.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="relative pl-10">
          <span class="absolute left-0 top-0 font-serif text-2xl text-hijau-600">1.</span>
          <h3 class="font-semibold text-stone-900 mb-1 text-sm">Semak NCD anda</h3>
          <p class="text-sm text-stone-600">
            Pergi <a href="https://www.myeg.com.my" target="_blank" rel="noopener" class="text-hijau-700 underline">MyEG</a>
            atau check dengan ejen. Penting sebab NCD affect harga premium.
          </p>
        </div>
        <div class="relative pl-10">
          <span class="absolute left-0 top-0 font-serif text-2xl text-hijau-600">2.</span>
          <h3 class="font-semibold text-stone-900 mb-1 text-sm">Dapatkan quotation</h3>
          <p class="text-sm text-stone-600">
            Guna aggregator macam <strong>Bjak.my</strong> atau <strong>PolicyStreet</strong> untuk bandingkan harga dari banyak syarikat sekaligus.
          </p>
        </div>
        <div class="relative pl-10">
          <span class="absolute left-0 top-0 font-serif text-2xl text-hijau-600">3.</span>
          <h3 class="font-semibold text-stone-900 mb-1 text-sm">Bayar &amp; dapat e-cover note</h3>
          <p class="text-sm text-stone-600">
            Bayar online (FPX, kad kredit). E-cover note terus masuk email. Simpan PDF tu.
          </p>
        </div>
        <div class="relative pl-10">
          <span class="absolute left-0 top-0 font-serif text-2xl text-hijau-600">4.</span>
          <h3 class="font-semibold text-stone-900 mb-1 text-sm">Renew roadtax</h3>
          <p class="text-sm text-stone-600">
            Boleh renew di <strong>JPJ</strong>, <strong>MyEG</strong>, <strong>Pos Malaysia</strong>, atau kaunter di shopping mall.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="container-wide py-10 sm:py-12">
    <CtaBand
      trackingSection="renew"
      heading="Dapatkan quotation · Laman luar"
      primary={{ label: 'Kira NCD saya →', href: '/tools/ncd-calculator/' }}
      outbound={[
        { label: 'Bjak.my', href: 'https://www.bjak.my', relationship: 'paid' },
        { label: 'PolicyStreet', href: 'https://www.policystreet.com', relationship: 'paid' },
      ]}
      disclosure="Kami pautkan ke platform luar; pembelian polisi dibuat di laman mereka, bukan di Insurans.co."
    />
  </div>

  <!-- Company Directory — Editorial Style -->
  <section class="container-wide py-10 sm:py-12">
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <h2 class="font-serif text-headline-md text-stone-900 mb-2">Syarikat Insurans Motor Popular</h2>
        <p class="text-stone-500 text-sm">Ranking berdasarkan populariti, harga, dan pengalaman claim.</p>
      </div>
      <a href="/companies/" class="hidden sm:inline text-sm font-semibold text-hijau-700 hover:text-hijau-600">
        Semua syarikat →
      </a>
    </div>

    <div class="space-y-4">
      {topMotorInsurers.map((company, i) => (
        <a href={`/companies/${company.slug}/`} class="card-editorial group flex flex-col sm:flex-row sm:items-start gap-4 block">
          <div class="flex-shrink-0 w-8 font-serif text-2xl text-stone-300">
            {i + 1}.
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline gap-3 mb-1.5">
              <h3 class="font-semibold text-stone-900 group-hover:text-hijau-700 transition-colors">
                {company.name}
              </h3>
              {company.takaful && (
                <span class="text-xs font-medium text-emas-700 bg-emas-50 px-2 py-0.5 rounded">Takaful</span>
              )}
            </div>
            <p class="text-sm text-stone-600 mb-2">{company.verdictBM}</p>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-stone-500">
              {company.carPremiumRange && (
                <span>Kereta: <strong class="text-stone-700">{company.carPremiumRange}</strong></span>
              )}
              <span>★ {company.rating}/5</span>
              {company.claimLine && <span>Claim: {company.claimLine}</span>}
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-6 sm:hidden">
      <a href="/companies/" class="text-sm font-semibold text-hijau-700">Lihat semua syarikat →</a>
    </div>
  </section>

  <div class="divider-bold container-wide"></div>

  <!-- Harga Sebenar Section -->
  <section class="container-wide py-10 sm:py-12">
    <h2 class="font-serif text-headline-md text-stone-900 mb-3">
      Berapa harga insurans kereta sebenar?
    </h2>
    <p class="text-stone-600 mb-8 max-w-2xl">
      Kami compile anggaran harga untuk kereta-kereta popular di Malaysia.
      Harga di bawah adalah untuk polisi <strong>comprehensive</strong> setahun.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 numeric">
      {popularCars.map(car => (
        <a href={`/car-insurance/${car.slug}/`} class="card-editorial group block">
          <p class="font-semibold text-stone-900 group-hover:text-hijau-700 transition-colors">{car.fullName}</p>
          <p class="text-xs text-stone-500 mt-1">Harga pasaran: {car.marketValueRange}</p>
          <div class="mt-4 pt-4 border-t border-stone-200">
            <p class="text-xs uppercase tracking-widest text-stone-500 font-bold">NCD 55%</p>
            <p class="font-serif text-2xl text-hijau-800 mt-1">{car.premiumNCD55}</p>
            <p class="text-sm text-stone-500 mt-1">NCD 0%: {car.premiumNCD0}</p>
          </div>
          <span class="mt-4 inline-block text-sm font-semibold text-hijau-700">Bandingkan syarikat →</span>
        </a>
      ))}
    </div>

    <div class="info-box mt-6">
      <p class="text-sm text-stone-700">
        <strong>Nota:</strong> Harga di atas adalah anggaran untuk tahun 2026. Harga sebenar bergantung pada
        umur kereta, lokasi, rekod pemanduan, dan syarikat insurans yang dipilih.
        Selepas liberalisasi tarif motor 2017, setiap syarikat boleh set harga sendiri.
      </p>
    </div>
  </section>

  <div class="divider container-wide"></div>

  <!-- FAQ — Conversational BM -->
  <section class="container-article py-10 sm:py-12">
    <h2 class="font-serif text-headline-md text-stone-900 mb-8">
      Soalan yang ramai orang tanya
    </h2>

    <div>
      <details class="faq-item" open>
        <summary>Wajib ke beli insurans kereta?</summary>
        <p>
          Ya, memang wajib. Minimum kena ada <strong>third-party insurance</strong>. Tanpa insurans yang sah,
          anda tak boleh renew roadtax. Kalau kena tangkap polis memandu tanpa insurans,
          boleh kena denda sehingga <strong>RM1,000</strong> atau penjara sehingga 3 bulan.
          Ini bukan optional — memang dalam Road Transport Act 1987.
        </p>
      </details>

      <details class="faq-item">
        <summary>Third-party je cukup ke, atau kena ambil comprehensive?</summary>
        <p>
          Third-party cuma cover kerosakan kereta <em>orang lain</em>. Kereta sendiri langsung tak dilindungi.
          Kalau kereta anda masih bernilai dan anda tak mampu bayar cash kalau accident, ambil <strong>comprehensive</strong>.
          Third-party sesuai untuk kereta lama yang nilai dah sangat rendah — contohnya kereta bawah RM10,000.
        </p>
      </details>

      <details class="faq-item">
        <summary>Boleh ke renew insurans kereta online?</summary>
        <p>
          Boleh, dan lagi senang dari pergi pejabat. Semak NCD dulu dengan <a href="/tools/ncd-calculator/">Kalkulator NCD</a>, lepas tu bandingkan quotation di Bjak.my, PolicyStreet, atau terus di website syarikat macam etiqa.com.my.
          Bayar online, dapat e-cover note terus, lepas tu renew roadtax di MyEG atau Pos Malaysia. Langkah penuh:
          <a href="/guides/renew-car-insurance/">cara renew insurans kereta online</a>.
        </p>
      </details>

      <details class="faq-item">
        <summary>Apa jadi kalau NCD reset sebab claim?</summary>
        <p>
          NCD anda reset ke <strong>0%</strong> lepas satu claim. Kalau NCD anda 55%, premium tahun depan boleh naik RM1,000+.
          Sebab tu untuk calar kecil bawah RM1,000–RM2,000, ramai pilih bayar sendiri. Jangan agak-agak — kira dulu dengan
          <a href="/tools/ncd-calculator/">Kalkulator NCD</a>: masukkan premium asal, NCD semasa, dan kos repair, tool akan tunjuk sama ada berbaloi claim atau tidak.
        </p>
      </details>

      <details class="faq-item">
        <summary>Insurans dan takaful — sama ke beza?</summary>
        <p>
          Beza dari segi konsep. <strong>Takaful</strong> guna prinsip saling bantu-membantu (ta'awun) dan patuh Syariah.
          Lebihan dana dikongsi balik kepada peserta. <strong>Insurans konvensional</strong> — premium masuk syarikat,
          untung pun milik syarikat. Dari segi coverage dan proses claim, lebih kurang sama je.
          Kalau anda nak yang patuh Syariah, pilih takaful. Kalau tak kisah, pilih mana yang harga dan servis paling sesuai.
        </p>
      </details>

      <details class="faq-item">
        <summary>Apa tu "agreed value" dan "market value"?</summary>
        <p>
          <strong>Market value</strong> — syarikat bayar berdasarkan nilai kereta masa claim (kereta depreciate setiap tahun,
          so payout mungkin kurang dari yang dijangka). <strong>Agreed value</strong> — anda dan syarikat setuju satu jumlah
          tetap masa beli polisi. Premium agreed value lebih mahal, tapi anda tahu exactly berapa dapat kalau total loss.
          Untuk kereta baru atau kereta mahal, agreed value lagi selamat.
        </p>
      </details>
    </div>
  </section>

  <!-- Type Categories -->
  <section class="bg-white border-t border-stone-200 py-10 sm:py-12">
    <div class="container-wide">
      <h2 class="font-serif text-headline-md text-stone-900 mb-6">Jenis-jenis insurans lain</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <a href="/car-insurance/" class="p-4 border border-stone-200 hover:border-hijau-400 hover:bg-hijau-50 transition-colors group">
          <p class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700">Insurans Kereta</p>
          <p class="text-xs text-stone-500 mt-1">Motor & motosikal</p>
        </a>
        <a href="/health-insurance/" class="p-4 border border-stone-200 hover:border-hijau-400 hover:bg-hijau-50 transition-colors group">
          <p class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700">Insurans Kesihatan</p>
          <p class="text-xs text-stone-500 mt-1">Medical card</p>
        </a>
        <a href="/life-insurance/" class="p-4 border border-stone-200 hover:border-hijau-400 hover:bg-hijau-50 transition-colors group">
          <p class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700">Insurans Nyawa</p>
          <p class="text-xs text-stone-500 mt-1">Life & investment-linked</p>
        </a>
        <a href="/personal-accident/" class="p-4 border border-stone-200 hover:border-hijau-400 hover:bg-hijau-50 transition-colors group">
          <p class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700">Insurans Kemalangan Diri</p>
          <p class="text-xs text-stone-500 mt-1">Perlindungan kemalangan</p>
        </a>
        <a href="/takaful/" class="p-4 border border-stone-200 hover:border-hijau-400 hover:bg-hijau-50 transition-colors group">
          <p class="font-semibold text-sm text-stone-900 group-hover:text-hijau-700">Takaful</p>
          <p class="text-xs text-stone-500 mt-1">Patuh Syariah</p>
        </a>
      </div>
    </div>
  </section>

  {/* Inject FAQ schema separately */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
