---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import PageAnswer from '../../components/edisi/PageAnswer.astro';
import BarFigure from '../../components/edisi/BarFigure.astro';
import ProductCss from '../../components/edisi/ProductCss.astro';
import { archivedCopy, factRole, tarikh } from '../../components/edisi/ProductFormat';
import medicalCards from '../../data/medical-cards.json';
import { buildDescription, buildTitle } from '../../lib/seo';
import { freshFaqs } from '../../lib/plan-faq';

type MedicalCard = (typeof medicalCards.records)[number];

const cards = medicalCards.records;
// Built <main> audit, 2026-10-10: at least 700 words and pairwise 5-word Jaccard below 0.35.
const adsEnabledSlugs = new Set([
  'aia-a-plus-health-360',
  'great-eastern-smartmedic-shield',
  'great-eastern-great-medcare',
  'etiqa-one-medical',
  'etiqa-i-medicalcard-elite',
  'prudential-prumillion-med-2',
  'takaful-malaysia-mymedik',
  'takaful-ikhlas-ikhlas-medik',
  'tokio-marine-medic-plus',
  'takaful-malaysia-kaotim-medikad',
]);
const typeLabels: Record<string, string> = {
  standalone: 'Standalone',
  rider: 'Rider',
  takaful: 'Takaful',
};

export function getStaticPaths() {
  return medicalCards.records.map((card) => ({
    params: { slug: card.slug },
    props: { card },
  }));
}

const { card } = Astro.props as { card: MedicalCard };
const canonicalUrl = `https://insurans.co/medical-cards/${card.slug}/`;
const typeLabel = typeLabels[card.type] ?? card.type;
const passesUniqueness = adsEnabledSlugs.has(card.slug);
const { analysis } = card;
const sibling = cards.find((candidate) => candidate.slug === analysis.siblingSlug)!;
const sourceUrls = [...new Set([...card.sources, ...analysis.facts.map((fact) => fact.source)])];
const sourceLinks = sourceUrls.map((url, index) => {
  const file = decodeURIComponent(new URL(url).pathname.split('/').filter(Boolean).pop()!);
  const archived = archivedCopy(url);
  const where = archived
    ? `salinan arkib ${archived.site}, ${archived.captured}`
    : new URL(url).hostname.replace(/^www\./, '');
  return { label: `[${index + 1}] ${file} (${where})`, url };
});
const specItems = analysis.facts.filter((fact) =>
  ['Had tahunan', 'Bilik dan penginapan', 'Had seumur hidup', 'Deductible', 'Perkongsian kos'].includes(fact.label),
);

const faqFacts = [
  { label: 'Struktur pelan', q: `Macam mana ${card.planName} dibeli?` },
  { label: 'Umur kemasukan', q: 'Siapa boleh memohon?' },
  { label: 'Had tahunan', q: 'Berapa had tahunannya?' },
  { label: 'Deductible', q: 'Ada deductible ke?' },
  { label: 'Perkongsian kos', q: 'Kena bayar sebahagian kos ke?' },
  { label: 'Tempoh menunggu', q: 'Bila perlindungan penyakit bermula?' },
  { label: 'Panel dan kemasukan tanpa tunai', q: 'Boleh masuk hospital panel tanpa tunai?' },
  ...analysis.facts.filter((fact) => fact.label.startsWith('Manfaat: ')).slice(0, 2).map((fact) => ({
    label: fact.label,
    q: `Apa yang dibayar untuk ${fact.label.replace('Manfaat: ', '').toLowerCase()}?`,
  })),
];
// Every candidate answer is a fact row printed in full under "Manfaat, had dan syarat"; freshFaqs drops an answer
// that only repeats the page, and drops the block when fewer than two answers are left.
const faqs = freshFaqs(
  faqFacts.flatMap(({ label, q }) => {
    const fact = analysis.facts.find((candidate) => candidate.label === label);
    return fact ? [{ q, a: fact.value }] : [];
  }),
  [
    analysis.facts.find((fact) => fact.label === 'Struktur pelan')?.value,
    analysis.bestFor,
    ...analysis.facts.map((fact) => fact.value),
    analysis.tradeoffs,
    ...analysis.siblingDifferences,
  ],
);

const title = buildTitle(`${card.planName} — Medical Card`);
const description = buildDescription(
  `${card.planName} oleh ${card.insurer}: kelayakan, manfaat, kos sendiri, pengecualian dan perbandingan dengan ${sibling.planName}, berserta rujukan dokumen rasmi.`,
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${card.planName} — Medical Card`,
  description,
  url: canonicalUrl,
  datePublished: card.asAt,
  dateModified: card.analysisAsAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'Medical Card', item: 'https://insurans.co/medical-cards/' },
      { '@type': 'ListItem', position: 3, name: card.planName, item: canonicalUrl },
    ],
  },
};
// Page answer (Edisi): the plan's own key facts that the old summary box showed, at most four.
// PA: the death benefit is already the intro line under the byline, so it is not repeated in the box.
// Lead: the annual limit as a loud number only when the record states one single figure ("RM3,000,000");
// the full "Had tahunan" fact row then moves to the details list under the box. The plan type sits in the bar.
const leadValue = /^RM[\d,]+$/.test(card.annualLimit ?? '') ? card.annualLimit : undefined;
// The lead label comes from the record when it scopes the limit (AIA: benefits 1–14); otherwise 'Had tahunan'.
const lead = leadValue ? { value: leadValue, label: card.annualLimitLabel ?? 'Had tahunan', role: 'term' as const } : undefined;
const insurerName = card.insurer.replace(/\.$/, '');
const finding = `${typeLabel} oleh ${insurerName}`;
// Figure: "RM50,000 / 100,000 / 150,000 (Plan 1/2/3)" becomes one bar per plan. Anything that does not parse
// exactly this way (a range, a rider, unequal counts) gets no figure rather than a guessed one.
const tierMatch = /^((?:RM)?[\d,]+(?: \/ (?:RM)?[\d,]+)+) \(([^();]+)\)$/.exec(card.annualLimit ?? '');
const tierValues = tierMatch ? tierMatch[1].split(' / ').map((v) => Number(v.replace(/[^\d]/g, ''))) : [];
const tierNames = tierMatch ? tierMatch[2].replace(/^Plan /, '').split('/').map((n) => n.trim()) : [];
// Names must be either "Plan 1/2/3" or all words (MPE/MPD/…). "GX200/250/300" mixes the two and is left out.
const namesClear = tierMatch ? /^Plan \d+(\/\d+)+$/.test(tierMatch[2]) || tierNames.every((n) => /^[A-Za-z-]+$/.test(n)) : false;
const tierBars =
  namesClear && tierValues.length >= 2 && tierValues.length === tierNames.length && tierValues.every((v) => v > 0)
    ? tierValues.map((v, i) => ({ label: /^\d+$/.test(tierNames[i]) ? `Plan ${tierNames[i]}` : tierNames[i], value: v, text: v >= 1e6 ? `${v / 1e6} juta` : `${v / 1000}k` }))
    : [];
const answerSkip: string[] = lead ? ['Had tahunan'] : [];
const answerAll = [...specItems.filter((spec) => !answerSkip.includes(spec.label))]
  .filter((spec, index, all) => all.findIndex((other) => other.label === spec.label) === index);
// Rows whose value is a paragraph (over 160 characters) move to the details list below, so the box ends inside the
// first phone screen; short facts keep their order.
const answerTop = answerAll.filter((spec) => String(spec.value ?? '').length <= 160).slice(0, 4);
const answerFacts = answerTop.map((spec) => ({
  label: spec.label,
  value: spec.value,
  role: spec.label === 'Jenis pelan' ? undefined : factRole(spec.label),
}));
const answerRest = [
  ...specItems.filter((spec) => answerSkip.includes(spec.label)),
  ...answerAll.filter((spec) => !answerTop.includes(spec)),
];

---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ads={passesUniqueness}
  ogType="article"
  publishedTime={card.asAt}
  modifiedTime={card.analysisAsAt}
>
  <Hero title={`Medical card ${card.planName}`}>
    <Byline slot="byline" dateModified={card.analysisAsAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'Medical Card', href: '/medical-cards/' },
        { label: card.planName },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-900">
      Analisis manfaat dikemas kini pada {tarikh(card.analysisAsAt)}.{' '}
      {analysis.facts.find((fact) => fact.label === 'Struktur pelan')?.value}
    </p>

    <PageAnswer slot="answer" finding={finding} lead={lead} facts={answerFacts} />
    <ProductCss />

    {answerRest.length > 0 && (
      <div class="mod">
        <dl class="pa-rows">
          {answerRest.map((spec) => (
            <div class="pa-r">
              <dt>{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={card.analysisAsAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      {tierBars.length > 0 && (
        <BarFigure caption={`Had tahunan ${card.planName} ikut pelan (RM).`} bars={tierBars} />
      )}
      <article class="prose-editorial prose-bars">
        <h2 id="sesuai">Untuk siapa pelan ini</h2>
        <p class="text-lg text-stone-700">{analysis.bestFor}</p>

        <h2 id="fakta">Manfaat, had dan syarat</h2>
        <dl class="space-y-5">
          {analysis.facts.map((fact) => (
            <div class="border-t border-stone-200 pt-4">
              <dt class="font-semibold text-stone-900">{fact.label}</dt>
              <dd class="mt-1 ml-0">
                {fact.value}{' '}
                <sup>
                  <a href={fact.source} aria-label={`Sumber untuk ${fact.label}`}>
                    [{sourceUrls.indexOf(fact.source) + 1}]
                  </a>
                </sup>
              </dd>
            </div>
          ))}
        </dl>

        <h2 id="pertimbangan">Had dan perkara yang perlu ditimbang</h2>
        <p>{analysis.tradeoffs}</p>

        <h2 id="perbandingan">{card.planName} berbanding {sibling.planName}</h2>
        <ul>
          {analysis.siblingDifferences.map((difference) => <li>{difference}</li>)}
        </ul>
        <p>
          <a href={`/medical-cards/${sibling.slug}/`}>Baca manfaat dan syarat {sibling.planName}</a>.
        </p>
        <p>
          Untuk membandingkan jenis pelan, had dan kos sendiri merentas penyedia, gunakan
          <a href="/medical-cards/"> panduan perbandingan medical card</a>.
        </p>
      </article>

      {faqs.length > 0 && (
        <section id="faq">
          <div class="prose-editorial prose-bars">
            <h2>Soalan lazim</h2>
          </div>
          <div class="mt-5">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <CtaBand
        heading={`Semak semua pilihan medical card`}
        body="Senarai semua medical card di laman ini, dengan sumber rasmi setiap pelan."
        primary={{ label: 'Lihat semua medical card', href: '/medical-cards/' }}
        disclosure="Tiada hubungan berbayar atau affiliate. Pautan luar, jika ada, hanya rujukan; pembelian polisi dibuat di laman penyedia, bukan di Insurans.co."
      />
    </div>
  </div>

  {faqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />}
</Base>
