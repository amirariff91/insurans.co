---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Hero from '../../components/Hero.astro';
import schemes from '../../data/schemes.json';
import { buildDescription, buildTitle } from '../../lib/seo';

const scheme = schemes.records.find((record) => record.slug === 'i-lindung')!;
const asAt = '2026-09-12';
const pageTitle = 'i-Lindung KWSP 2026: Produk, Harga & Cara Beli';
const title = buildTitle(pageTitle);
const description = buildDescription(
  'i-Lindung ialah saluran beli insurans guna KWSP: produk disahkan dari RM12 setahun, potongan Akaun Sejahtera, fasa keluarga dan cara beli melalui i-Akaun.',
);
const canonicalUrl = 'https://insurans.co/i-lindung/';
const sourceLinks = scheme.sources.map((url) => ({
  label: new URL(url).hostname.replace(/^www\./, ''),
  url,
}));
const products = [
  {
    operator: 'Etiqa',
    product: 'Term Plus / Term Takaful Plus',
    type: 'Hayat / term',
    details: 'Dari RM12 setahun, RM10,000–RM200,000',
  },
  {
    operator: 'Etiqa',
    product: 'Critical Care Plus / Critical Care Takaful Plus',
    type: '42 penyakit kritikal',
    details: 'Dari RM16 setahun; manfaat kanser +50%',
  },
  {
    operator: 'Prudential',
    product: 'PRUGuard Family',
    type: 'Hayat / term keluarga',
    details: 'Kematian + TPD hingga RM200,000 setiap nyawa; boleh diperbaharui hingga 75',
  },
  {
    operator: 'Prudential',
    product: 'PRUCare Family',
    type: '43 penyakit kritikal',
    details: 'RM10,000–RM200,000',
  },
  {
    operator: 'PruBSN',
    product: 'Lindung Famili + Cegah Famili',
    type: 'Takaful hayat + 43 penyakit kritikal',
    details: 'Ikut umur dan jumlah; semak di portal pengendali',
  },
  {
    operator: 'FWD',
    product: 'Pelan i-Lindung',
    type: 'Term / penyakit kritikal',
    details: 'Wujud; nama disahkan di tahap tajuk/meta sahaja',
  },
];
const faqs = [
  {
    q: 'Apa itu i-Lindung KWSP?',
    a: 'Saluran dalam aplikasi KWSP i-Akaun untuk membeli insurans hayat dan penyakit kritikal daripada pengendali panel menggunakan simpanan Akaun Sejahtera sendiri. Bukan bantuan percuma.',
  },
  {
    q: 'Apakah pelan i-Lindung yang ada?',
    a: 'Yang disahkan: Etiqa Term Plus dari RM12 setahun, Etiqa Critical Care Plus 42 penyakit kritikal dari RM16 setahun, Prudential PRUGuard dan PRUCare Family, PruBSN takaful, serta FWD. Sahkan senarai penuh dalam aplikasi KWSP.',
  },
  {
    q: 'Akaun KWSP mana ditolak?',
    a: 'Akaun Sejahtera, dahulunya Akaun 2. Akaun 1 (Persaraan) tidak terjejas.',
  },
  {
    q: 'Boleh lindungi keluarga?',
    a: 'Ya. Fasa keluarga sejak Februari 2024 membenarkan perlindungan pasangan dan anak, tertakluk pada syarat umur dan produk.',
  },
  {
    q: 'i-Lindung PERKESO itu apa?',
    a: 'Bukan produk. Ia kekeliruan antara i-Lindung KWSP dan skim pekerjaan sendiri PERKESO, iaitu SPS atau Lindung Kendiri. Dua sistem dan dua saluran bayaran berbeza.',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  url: canonicalUrl,
  datePublished: asAt,
  dateModified: asAt,
  inLanguage: 'ms',
  publisher: {
    '@type': 'Organization',
    name: 'Insurans.co',
    url: 'https://insurans.co',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: 'https://insurans.co/' },
      { '@type': 'ListItem', position: 2, name: 'i-Lindung', item: canonicalUrl },
    ],
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  ogType="article"
  publishedTime={asAt}
  modifiedTime={asAt}
>
  <Hero title="i-Lindung — Beli Insurans Guna Duit KWSP Sendiri">
    <Byline slot="byline" dateModified={asAt} />
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Utama', href: '/' },
        { label: 'i-Lindung' },
      ]}
    />
    <p slot="description" class="max-w-2xl text-lg leading-7 text-stone-600">
      i-Lindung bukan produk dan bukan bantuan — ia saluran beli-diri dalam aplikasi KWSP i-Akaun di bawah Pelan Perlindungan Ahli. Premium tahunan ditolak daripada Akaun Sejahtera. Akaun 1 tidak terjejas. Ini bermaksud anda menggunakan duit KWSP sendiri.
    </p>

    <div class="border-2 border-stone-900 bg-white p-5 sm:p-6">
      <p class="label">Jawapan ringkas</p>
      <h2 class="mt-2 font-serif text-headline-sm text-stone-900">Saluran, bukan produk</h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="text-stone-500">Akaun yang digunakan</dt>
          <dd class="font-semibold text-stone-900">Akaun Sejahtera (dahulu Akaun 2)</dd>
        </div>
        <div>
          <dt class="text-stone-500">Akaun Persaraan</dt>
          <dd class="font-semibold text-hijau-700">Akaun 1 tidak terjejas</dd>
        </div>
        <div>
          <dt class="text-stone-500">Harga disahkan</dt>
          <dd class="font-semibold text-stone-900">Dari RM12 setahun untuk produk tertentu</dd>
        </div>
      </dl>
    </div>

    <div class="mt-4 mr-2">
      <EditorialStamp
        articleDate={asAt}
        sources={sourceLinks}
        sourcesLabel="Sumber"
        showReviewed={false}
      />
    </div>
  </Hero>

  <div class="container-article py-8 sm:py-12">
    <div class="space-y-10 sm:space-y-14">
      <article class="prose-editorial">
        <p class="text-lg leading-7 text-stone-700">
          i-Lindung bukan produk dan bukan bantuan — ia saluran beli-diri dalam aplikasi KWSP i-Akaun di bawah Pelan Perlindungan Ahli (PPA). Ahli membeli pelan hayat dan penyakit kritikal daripada pengendali panel, kemudian premium tahunan ditolak terus daripada Akaun Sejahtera (dahulu Akaun 2). Akaun 1 tidak terjejas. Guna duit KWSP sendiri — bukan bantuan percuma.
        </p>

        <h2 id="akaun">Duit dari akaun mana?</h2>
        <p>
          Akaun Sejahtera ialah nama Akaun 2 selepas penstrukturan semula Akaun 1, 2 dan 3 pada Mei 2024. Potongan tahunan dibuat daripada baki Akaun Sejahtera; Akaun 1 atau Akaun Persaraan tidak disentuh. Kementerian Kewangan mengesahkan perkara ini semula pada Mac 2026.
        </p>
        <p>
          Ahli berumur 55 tahun ke atas layak jika mempunyai sekurang-kurangnya RM100 dalam Akaun 55 atau Akaun Emas, tertakluk pada syarat produk. Permohonan tidak memerlukan pemeriksaan perubatan; soalan kesihatan ringkas tetap perlu dijawab.
        </p>

        <h2 id="produk">Produk disahkan</h2>
        <p>
          Jadual ini menyenaraikan produk dan pengendali yang disahkan daripada sumber yang dibaca. Ia bukan ranking dan bukan cadangan produk.
        </p>
      </article>

      <div class="overflow-x-auto">
        <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
          <caption class="mb-3 text-left text-sm text-stone-600">Produk i-Lindung yang direkodkan setakat {asAt}</caption>
          <thead>
            <tr class="border-b-2 border-stone-900">
              <th scope="col" class="px-3 py-3 font-semibold text-stone-900">Pengendali</th>
              <th scope="col" class="px-3 py-3 font-semibold text-stone-900">Produk</th>
              <th scope="col" class="px-3 py-3 font-semibold text-stone-900">Jenis</th>
              <th scope="col" class="px-3 py-3 font-semibold text-stone-900">Harga / jumlah</th>
            </tr>
          </thead>
          <tbody>
            {products.map((product) => (
              <tr class="border-b border-stone-200 align-top">
                <td class="px-3 py-3 font-semibold text-stone-900">{product.operator}</td>
                <td class="px-3 py-3 text-stone-700">{product.product}</td>
                <td class="px-3 py-3 text-stone-700">{product.type}</td>
                <td class="px-3 py-3 text-stone-700">{product.details}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-sm leading-6 text-stone-600">
        Operator yang disahkan: {(scheme.operators ?? []).slice(0, 3).join(', ')}. FWD disahkan di tahap tajuk/meta sahaja. <strong>Senarai penuh dalam app KWSP i-Akaun</strong>; semak senarai itu sebelum membeli kerana halaman awam tidak mengesahkan keseluruhan senarai 2026.
      </p>

      <article class="prose-editorial">
        <h2 id="beli">Cara beli</h2>
        <ol>
          <li>Buka aplikasi KWSP i-Akaun dan pilih tab i-Lindung.</li>
          <li>Pilih produk panel yang mahu dipertimbangkan.</li>
          <li>Lengkapkan permohonan di portal pengendali.</li>
          <li>Benarkan potongan daripada Akaun Sejahtera. Dokumen polisi dihantar melalui emel atau portal pengendali.</li>
        </ol>
        <p>
          Jika mahu rujukan saluran, <a href="https://www.kwsp.gov.my/i-lindung" target="_blank" rel="noopener" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">semak di portal rasmi KWSP</a>. Pembelian, terma polisi dan soalan kesihatan dibuat di saluran KWSP atau pengendali; Insurans.co tidak mengambil permohonan.
        </p>
        <p>
          Polisi biasanya bertempoh satu tahun dan merupakan perlindungan tulen tanpa nilai tunai; pelepasan cukai tertakluk pada syarat LHDN serta produk.
        </p>

        <aside class="info-box not-prose my-8">
          <h2 class="font-serif text-headline-sm text-stone-900">MHIT — dalam kajian, belum aktif</h2>
          <p class="mt-3 text-sm leading-6 text-stone-700">
            Belanjawan 2026 membenarkan kajian pengeluaran Akaun Sejahtera untuk pelan asas MHIT, iaitu insurans atau takaful perubatan dan kesihatan asas. Setakat 2026-09-12, MHIT belum menjadi produk i-Lindung yang boleh dibeli. Jangan anggap i-Lindung sudah cover bil hospital swasta — untuk itu baca <a href="/medical-cards/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">panduan medical card</a>.
          </p>
        </aside>

        <h2 id="perkeso">“i-Lindung PERKESO” — penjelasan kekeliruan</h2>
        <p>
          Tiada produk bernama “i-Lindung PERKESO” dalam sumber yang disemak. Istilah itu mencampurkan dua benda berbeza: i-Lindung KWSP, iaitu pembelian insurans menggunakan Akaun Sejahtera, dan skim PERKESO untuk orang bekerja sendiri — Skim Perlindungan Sosial Pekerjaan Sendiri atau SPS/Lindung Kendiri. Caruman SPS dibayar terus kepada PERKESO melalui portal dan aplikasi PERKESO, bukan melalui akaun KWSP. Baca <a href="/bantuan-insurans/perkeso/" class="text-hijau-700 underline decoration-hijau-300 underline-offset-2">panduan PERKESO</a> untuk beza kedua-duanya.
        </p>
      </article>

      <section id="faq">
        <div class="prose-editorial">
          <h2>Soalan lazim — i-Lindung</h2>
        </div>
        <div class="mt-5">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <p class="text-sm leading-5 text-stone-600">Kami bukan ejen atau broker dan tidak mengambil permohonan polisi.</p>
      <p class="border-t border-stone-200 pt-4 text-sm leading-5 text-stone-600">Maklumat dikemaskini 2026-09-12 — semak portal rasmi untuk status terkini</p>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  })} />
</Base>
