---
/**
 * Phone dock (below 48rem): once the answer block has scrolled out of view, a bar at the bottom repeats the
 * current context on two lines ("Anggaran Axia  NCD 55%", the name truncated if long; then "RM330–670/tahun") with one action
 * that goes back to the NCD control. Every value is read from what the page already shows for the chosen step
 * (the same Px data attributes the NCD control switches, or the calculator's result text): the dock never computes
 * a price. Rendered `hidden`: without JavaScript it never shows. It steps aside while a native dialog is open or a
 * consent message is actually visible.
 */
interface Props {
  /** The block whose leaving the screen shows the dock. */
  answer: string;
  /** Where "Tukar" goes: the NCD control. */
  control: string;
  /** Element whose text is the car's short name (home and model pages). */
  name?: string;
  /** The car's short name when it never changes on the page (model pages). */
  car?: string;
  /** Element whose text is the current calculated price (NCD calculator: '#result-premium'). */
  result?: string;
  /** Unit appended to the `result` price when one is shown (NCD calculator: '/tahun', the premium is yearly). */
  unit?: string;
}
const { answer, control, name = '', car = '', result = '', unit = '' } = Astro.props;
---
<div class="dock" data-dock data-answer={answer} data-control={control} data-name={name} data-car={car} data-result={result} data-unit={unit || undefined} hidden>
  <p class="dock-t"><span class="dock-r"><span class="dock-n" data-dock-n></span><span class="dock-k" data-dock-k></span></span><span class="dock-v" data-dock-v></span></p>
  <button type="button" class="dock-b" data-dock-b>Tukar</button>
</div>

<style is:global>
  .dock {
    /* A full-bleed paper band on the bottom edge with a 1px mute rule on top: nothing shows beside, under or
       through it. Its content keeps the old 30rem measure, centred. */
    position: fixed; z-index: 30; left: 0; right: 0; bottom: 0;
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem max(var(--gutter), calc((100% - 30rem) / 2)) calc(0.5rem + env(safe-area-inset-bottom));
    color: var(--ink); background: var(--paper); border-top: 1px solid var(--mute);
    transform: translateY(calc(100% + 1rem)); visibility: hidden;
    transition: transform 200ms var(--ease-out), visibility 0s linear 200ms;
  }
  /* With more contrast its top rule becomes ink. */
  @media (prefers-contrast: more) {
    .dock { border-top-color: var(--ink); }
  }
  /* Forced colours: the top rule in CanvasText keeps the dock apart from the page under it. */
  @media (forced-colors: active) {
    .dock { border-top-color: CanvasText; }
    .dock-b { border: 1px solid ButtonText; }
  }
  html.dock-on .dock { transform: none; visibility: visible; transition: transform 200ms var(--ease-out); }
  /* --dock-h is the band's measured height, safe-area inset included. */
  html.dock-on body { padding-bottom: calc(var(--dock-h, 4rem) + 1rem); }
  html.dock-on { scroll-padding-bottom: calc(var(--dock-h, 4rem) + 1rem); }
  .dock-t { flex: 1; min-width: 0; margin: 0; display: grid; font-variant-numeric: tabular-nums; }
  /* Two lines, each one line high. Line 1: the car's name, which alone truncates (full name in its title), then
     the NCD step, never cut. Line 2: the price and its unit, which fit at 320px for every model. */
  .dock-r { display: flex; gap: 0.5rem; min-width: 0; font: 600 0.875rem/1.25 var(--f); }
  .dock-n { flex: 0 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--ink-2); }
  .dock-k { flex: none; white-space: nowrap; font-weight: 800; }
  .dock-n:empty { display: none; }
  .dock-v { display: block; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font: 800 1.125rem/1.25 var(--fd); }
  .dock-v:empty { display: none; }
  .dock-b {
    flex: none; min-height: 2.75rem; min-width: 2.75rem; padding: 0 1rem; border: 0; border-radius: var(--r-pill);
    background: var(--kick); color: var(--kick-ink); font: 600 1rem/1 var(--fd); cursor: pointer;
  }
  .dock-b:hover { background: var(--ink); }
  .dock-b:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .dock[hidden] { display: none; }
  @media (min-width: 48rem) { .dock { display: none !important; } }
  @media (prefers-reduced-motion: reduce) { .dock, html.dock-on .dock { transition: none; } }
  @media print { .dock { display: none !important; } }
</style>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const answer = dock && document.querySelector<HTMLElement>(dock.dataset.answer!);
  const phone = matchMedia('(max-width: 47.99rem)');
  if (dock && answer && 'IntersectionObserver' in window && !dock.dataset.on) {
    dock.dataset.on = '1';
    const html = document.documentElement;
    const nameEl = dock.querySelector<HTMLElement>('[data-dock-n]')!;
    const valEl = dock.querySelector<HTMLElement>('[data-dock-v]')!;
    const ncdEl = dock.querySelector<HTMLElement>('[data-dock-k]')!;
    let past = false;
    const txt = (sel?: string) => (sel ? document.querySelector(sel)?.textContent?.replace(/\s+/g, ' ').trim() ?? '' : '');
    // Read what the page shows now: the checked step, the car's name and the price of that step (car pages: the
    // Px data attributes; calculator: the result's text). Nothing is computed here.
    const fill = () => {
      const r = document.querySelector<HTMLInputElement>('input[name="ncd"]:checked');
      let pct = r ? r.dataset.tier ?? r.value : '';
      if (!pct) { try { const k = localStorage.getItem('edisi.ncd'); pct = k === '38' ? '38.33' : k ?? ''; } catch { /* storage blocked */ } }
      const name = dock.dataset.car || txt(dock.dataset.name);
      let price = '';
      let unit = '';
      if (dock.dataset.result) {
        price = txt(dock.dataset.result);
        if (price) unit = dock.dataset.unit ?? '';
      }
      else {
        const px = document.querySelector<HTMLElement>('[data-ea] .ea-pnum');
        const k = r?.value ?? '55';
        const v = px && r ? (k === '55' ? px.querySelector('.pv')?.textContent : px.dataset[`p${k}`]) : '';
        price = v ? `RM${v}` : '';
        // The unit only when the page states it beside the price ("setahun").
        if (price && /^setahun\b/.test(txt('[data-ea] .ea-sub'))) unit = '/tahun';
      }
      const n = price ? `Anggaran${name ? ` ${name}` : ''}` : name;
      if (nameEl.textContent !== n) nameEl.textContent = n;
      nameEl.title = name;
      const k = `NCD ${pct || '55'}%`;
      if (ncdEl.textContent !== k) ncdEl.textContent = k;
      const v = price ? `${price}${unit}` : '';
      if (valEl.textContent !== v) valEl.textContent = v;
    };
    // Hide while a native dialog is open or a consent message (Funding Choices) is actually on screen: its root
    // can sit in the DOM hidden, so test visibility and size, not presence.
    const CMP = '.fc-consent-root, .fc-dialog-container';
    const shown = (el: Element) => {
      const cs = getComputedStyle(el);
      if (cs.display === 'none' || cs.visibility === 'hidden' || +cs.opacity === 0) return false;
      const b = el.getBoundingClientRect();
      return b.width > 0 && b.height > 0;
    };
    const blocked = () => Boolean(document.querySelector('dialog[open]')) || [...document.querySelectorAll(CMP)].some(shown);
    const set = () => {
      const on = past && phone.matches && !blocked();
      if (on) { fill(); html.style.setProperty('--dock-h', `${dock.offsetHeight / 16}rem`); }
      html.classList.toggle('dock-on', on);
    };
    let queued = false;
    const later = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; set(); }); } };
    // Only dialog and consent changes matter; the dock's own text and the page's price ticks are ignored, so
    // updating the dock can never retrigger this observer. That includes a wrapper that holds a consent root or a
    // dialog: un-hiding it (hidden, class, style, aria-hidden) can put the consent message on screen. The dock only
    // writes to itself and to <html> (outside the observed body), so its own changes never match.
    const isBlocker = (n: Node) => n instanceof Element && (n.tagName === 'DIALOG' || n.matches(CMP) || Boolean(n.querySelector(`dialog, ${CMP}`)));
    const relevant = (m: MutationRecord) => {
      const t = m.target;
      if (dock.contains(t)) return false;
      if (t instanceof Element && (t.tagName === 'DIALOG' || t.closest(CMP))) return true;
      if (m.type === 'attributes' && t instanceof Element && t.querySelector(`dialog, ${CMP}`)) return true;
      return [...m.addedNodes, ...m.removedNodes].some(isBlocker);
    };
    new MutationObserver((ms) => { if (ms.some(relevant)) later(); })
      .observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['open', 'style', 'class', 'hidden', 'aria-hidden'] });
    document.addEventListener('toggle', later, true);
    document.addEventListener('close', later, true);
    dock.hidden = false;
    new IntersectionObserver(([e]) => { past = !e.isIntersecting && e.boundingClientRect.top < 0; set(); }).observe(answer);
    phone.addEventListener('change', set);
    // A restored page (back/forward cache) keeps these observers; only re-read the state.
    addEventListener('pageshow', (e) => { if (e.persisted) set(); });
    document.addEventListener('change', () => past && fill());
    if (dock.dataset.result) {
      const res = document.querySelector(dock.dataset.result);
      if (res) new MutationObserver(() => past && fill()).observe(res, { childList: true, characterData: true, subtree: true });
    }
    // Never cover the focused element. Not for the focus "Tukar" moves itself: its target is still below the dock
    // while the smooth scroll runs, and a scrollBy here would cut that scroll short.
    let moving = false;
    document.addEventListener('focusin', (ev) => {
      const t = ev.target as HTMLElement;
      if (moving || !html.classList.contains('dock-on') || dock.contains(t)) return;
      const over = t.getBoundingClientRect().bottom - dock.getBoundingClientRect().top + 8;
      if (over > 0) scrollBy(0, over);
    });
    dock.querySelector('[data-dock-b]')!.addEventListener('click', () => {
      const c = document.querySelector<HTMLElement>(dock.dataset.control!);
      if (!c) return;
      // A control (checked step) goes mid-screen; a section heading (the car hub's #ncd) goes to the top, so the
      // reader lands on its first lines instead of the prose before it.
      const ctl = c.querySelector<HTMLElement>('input:checked');
      c.scrollIntoView({ block: ctl ? 'center' : 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      const f = ctl ?? c;
      if (f === c && !c.hasAttribute('tabindex')) c.tabIndex = -1;
      moving = true;
      f.focus({ preventScroll: true });
      moving = false;
    });
  }
</script>
